/* Structure and tokens only, no literal colour: a theme retunes the whole set
   without touching a selector. `.active` / `.in-path` come from
   Router.mark_links(), so the selected tab needs no JS.

   THE FLOOR (the owner, 2026-09-05): a click changes what's inside a rectangle
   you can already see; the rectangle stays. Every set now draws that rectangle —
   the strip's own rule becomes the panel's top edge, and the selected tab is cut
   out of it, so the label and the box read as one thing with no line between
   them. `.underline` asks for the old, unbounded strip (doc/decisions.md). */

@layer util {

	/* ⚠ In `util` beside the arrangement contract it belongs to (Page.css), and for
	   the same reason: a `.page.default` is a page, and a page may wear a `display`
	   utility. ⚠ Reads BOTH `.active-page` and `.active-ancestor` — one question
	   asked two ways, and a rule reading one breaks a level deeper. */
	.tab-panel:has(> .page:is(.active-page, .active-ancestor))
		> .page.default:not(.active-page, .active-ancestor) { display: none; }
}

@layer theme {

	/* `--tab-pad-x` is exposed so a host can pull the strip left by exactly one tab's
	   padding and land the LABELS on its own text axis — ext/Doc's well does. */
	.tabs { display: flex; flex-direction: column; min-width: 0; --tab-pad-x: 0.9rem; }

	/* ⚠ One strip that scrolls, never a wrapping block: a fifty-member rail flipped to
	   a wrapped bar was 500px of links above the content it navigates.
	   ⚠ The edge fade (`--tab-fade`, a two-layer `mask-image`) was REMOVED 2026-08-18 at
	     the owner's call — misplaced on `.tab-bar`. What it was for, and what comes back
	     without it, is [`doc/overflow.md`](/framework/ext/tabs/doc/overflow.md).
	     Don't re-add it without asking. */
	.tab-bar {
		display: flex; flex-wrap: nowrap;
		overflow: auto; scrollbar-width: none;
		border-bottom: 1px solid var(--line);
	}

	/* Quiet by construction: a text label, a hairline under the set, a 2px mark under
	   the selected one. No box, no fill, no gap between tabs — the strip is the group. */
	.tab {
		/* ⚠ The fallback is not redundant: `styles/elements/text` shows a BARE `.tab`
		   with no `.tabs` above it, and an undeclared var takes `padding` to 0. */
		padding: 0.5rem var(--tab-pad-x, 0.9rem);
		font-size: 0.95em;
		font-weight: 500;
		color: var(--subtle);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;               /* sit ON the bar's rule, not above it */
		white-space: nowrap;
	}
	.tab:hover { color: var(--ink); }

	/* ⚠ `.in-path` but NOT on `.tab-default`, whose href is this page's own url and
	   so is a prefix of every sibling's — it would read as selected on every tab.
	   ⚠ `[aria-current]` is the third mark: a stand-in app (ext/demo's demo.app) has no
	   Router to set the two classes. Same exclusion for the same reason — and on the
	   default's own url nothing matches, so the fallback below lights it instead. */
	.tab.active,
	.tab:is(.in-path, [aria-current]):not(.tab-default) { color: var(--ink); border-bottom-color: var(--prim); }

	/* A set with NOTHING of its own in the url highlights its first tab, so a panel is
	   never showing content with nothing marked. Mirrors the panel's own default rule.
	   ⚠ `in-path` counts as selected here: a nested set puts the url two levels down,
	     so the outer bar has no `.active` at all and lit two tabs — the first and the
	     one actually in the path. */
	.tab-bar:not(:has(.tab.active, .tab:is(.in-path, [aria-current]):not(.tab-default))) > .tab:first-child {
		color: var(--ink); border-bottom-color: var(--prim);
	}

	/* ⚠ Resets Page's measure tokens: they inherit, and a panel sits inside a page
	   that already has the sheet — without this a method page paid it twice. */
	.tab-panel { padding-top: 3em; min-width: 0; --measure: none; --page-pad: 0; }

	/* A rail of one is not a rail: the panel is still a region, the bar is noise.
	   Also covers the window before the bar is filled. */
	.tab-bar:not(:has(> .tab + .tab)) { display: none; }

	/* `block` — folder tabs: the selected one is a box open onto the page below.
	   ⚠ The rule moves off the bar and ONTO the tabs, so under the selected tab it is
	     absent rather than covered. Unfilled by default, so the tab's interior simply
	     IS the page — `--tab-fill` is for a host that tints the strip and needs the
	     selected tab to cut back to whatever its content sits on. */
	.tabs.block > .tab-bar { border-bottom: none; }

	/* carries the rule past the last tab; collapses to nothing once the strip scrolls */
	.tabs.block > .tab-bar::after { content: ""; flex: 1; border-bottom: 1px solid var(--line); }

	/* Folder tabs wear the scale's `h4` — the annotation level, which is what a strip of
	   section labels is. ⚠ Restated rather than handed to the element as `.h4`: the
	   variant is a class on the SET and `.tab` is emitted by this module's JS, so no
	   call site can put the level on the anchor. Keep in step with framework.css. */
	.tabs.block { --tab-pad-x: 1.35rem; }

	.tabs.block > .tab-bar > .tab {
		font-size: 0.8em; font-weight: 700;
		letter-spacing: 0.05em; text-transform: uppercase;
		border: 1px solid transparent;
		border-top-width: 2px;             /* reserved on EVERY tab: the accent must not shift one label */
		border-bottom-color: var(--line);
		border-radius: var(--radius) var(--radius) 0 0;
		margin-bottom: 0;
	}

	.tabs.block > .tab-bar > .tab.active,
	.tabs.block > .tab-bar > .tab:is(.in-path, [aria-current]):not(.tab-default),
	.tabs.block > .tab-bar:not(:has(.tab.active, .tab:is(.in-path, [aria-current]):not(.tab-default))) > .tab:first-child {
		border-color: var(--line);
		border-top-color: var(--prim);
		border-bottom-color: transparent;
		background: var(--tab-fill, transparent);
	}

	/* `underline` — the one word that asks for the OLD look: no floor, the strip's
	   hairline stays the only mark. Needs no rules of its own; it only has to stop
	   the floor rules below from matching, which `:not(.underline)` does for free.

	   THE FLOOR ITSELF — default now, for every set that is not `.underline` and
	   not `.vertical` (whose rail is its own shape, floored separately below).
	   ⚠ `:not(.underline):not(.vertical)` outweighs `.tabs.block` on every
	     overlapping property (3 classes vs. 2), so this composes with `block`
	     automatically: the folder skin's type stays, the floor's colours win. */
	.tabs:not(.underline):not(.vertical) > .tab-bar { border-bottom: none; }

	/* ⚠ The 2px top border is reserved on EVERY tab, transparent until selected: a
	     mark that ADDS height would shift its own label by 1px on every click. */
	.tabs:not(.underline):not(.vertical) > .tab-bar > .tab {
		border: 1px solid transparent;
		border-top-width: 2px;
		border-bottom: 1px solid var(--line);
		border-radius: var(--radius) var(--radius) 0 0;
		margin-bottom: 0;
	}

	/* carries the strip's rule past the last tab, so the panel's top edge is whole */
	.tabs:not(.underline):not(.vertical) > .tab-bar::after { content: ""; flex: 1; border-bottom: 1px solid var(--line); }

	/* THE SELECTED TAB IS PART OF THE PANEL: same surface, top accent kept, the
	   bottom border painted in the panel's OWN colour rather than in the rule — so
	   the eye runs straight from the label down into the box with no seam. */
	.tabs:not(.underline):not(.vertical) > .tab-bar > .tab.active,
	.tabs:not(.underline):not(.vertical) > .tab-bar > .tab:is(.in-path, [aria-current]):not(.tab-default),
	.tabs:not(.underline):not(.vertical) > .tab-bar:not(:has(.tab.active, .tab:is(.in-path, [aria-current]):not(.tab-default))) > .tab:first-child {
		color: var(--ink);
		border-color: var(--line);
		border-top-color: var(--prim);
		background: var(--tab-fill, var(--surface));
		border-bottom-color: var(--tab-fill, var(--surface));
	}

	/* THE PANEL. No top border — the strip above IS its top edge, with the selected
	   tab cut out of it. ⚠ Top padding stays the pre-floor `3em` (the whole site's
	   vertical rhythm around a tab-panel was tuned to it — a doc page included);
	   only the sides and bottom take the standard pad token, since those were
	   never anything before. */
	.tabs:not(.underline):not(.vertical) > .tab-panel {
		padding: 3em var(--pad, var(--pad-default)) var(--pad, var(--pad-default));
		background: var(--tab-fill, var(--surface));
		border: 1px solid var(--line);
		border-top: none;
		border-radius: 0 var(--radius) var(--radius) var(--radius);
	}

	/* ⚠ "A rail of one is not a rail" (above) hides the bar, so there is nothing
	   left to draw the panel's top edge — close the box on that side instead of
	   leaving it open. */
	.tabs:not(.underline):not(.vertical):has(> .tab-bar:not(:has(> .tab + .tab))) > .tab-panel {
		border-top: 1px solid var(--line);
		border-radius: var(--radius);
	}

	/* A rail PLUS a column takes the room: `wide` — main's left edge, so the rail
	   lands on the title's axis, and every leftover pixel to the right. The sub pages
	   inside pay their own gutters, so their content bleeds to the panel's edge,
	   padded, never to the region's. Was a 78em `--measure` cap (until 2026-08-19):
	   a nested page's `bleed` could never leave it — the owner's "locked down". */
	.page > .tabs.vertical { grid-column: wide; }

	/* The same set, turned on its side — only the axis changes. The bar is sticky
	   because the panel is usually taller. */
	.tabs.vertical { flex-direction: row; align-items: flex-start; gap: 4em; }

	/* ⚠ NOT framework.css's `.basis` utility: `.tabs` is a COLUMN and
	   `.tabs.vertical` is a ROW, so `flex-basis` — the MAIN size — would give every
	   horizontal tab bar a fixed 14em HEIGHT. A utility class cannot be conditional.
	   ⚠ The max-height is what makes `sticky` mean anything: a rail taller than the
	     viewport sticks its top and puts its own last members out of reach forever. */
	/* ⚠ `mask-image: none`: the fade is a RIGHT-edge fade, and a column rail's right
	     edge is its rule and its wrapped labels, not its overflow. It comes back in
	     the query below, where this bar is a row again. */
	.tabs.vertical > .tab-bar {
		flex-direction: column;
		flex: 0 0 clamp(9em, 18%, 14em); min-width: 0;
		position: sticky; top: 1em;
		max-height: calc(100vh - 2em);
		mask-image: none;
		border-bottom: none;
		border-inline-end: 1px solid var(--line);
	}

	.tabs.vertical > .tab-bar > .tab {
		padding: 0.35rem 0.8rem;
		white-space: normal;
		border-bottom: none;
		border-inline-end: 2px solid transparent;
		margin-bottom: 0;
		margin-inline-end: -1px;          /* sit ON the bar's rule, not beside it */
	}

	.tabs.vertical > .tab-bar > .tab.active,
	.tabs.vertical > .tab-bar > .tab:is(.in-path, [aria-current]):not(.tab-default),
	.tabs.vertical > .tab-bar:not(:has(.tab.active, .tab:is(.in-path, [aria-current]):not(.tab-default))) > .tab:first-child {
		border-inline-end-color: var(--prim);
	}

	.tabs.vertical > .tab-panel { flex: 1 1 0; min-width: 0; padding-top: 0; }

	/* The rail floors too, unless `underline` — a plain box beside it, not cut
	   into (the rail sits beside the panel, not above it, so there is no shared
	   edge to open onto). ⚠ (0,4,0) beats the `padding-top: 0` above AND the
	   narrow-width `padding-top: 1rem` below (0,2,0 each), on purpose: a floored
	   rail keeps its own padding at every width. */
	.tabs.vertical:not(.underline) > .tab-panel {
		padding: var(--pad, var(--pad-default));
		background: var(--tab-fill, var(--surface));
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	/* ⚠ `64em`, not the rail's own 9–14em: this set can sit inside a topic's region
	   (viewport minus a 19em sidebar), so the breakpoint has to clear both boxes. */
	@media (max-width: 64em) {
		/* ⚠ `align-items: stretch` is the easy one to miss: in a COLUMN container the
		   cross axis is width, so the `flex-start` above sizes each child to its own
		   content — the panel went to max-content inside a 262px box and scrolled. */
		.tabs.vertical { flex-direction: column; gap: 0; align-items: stretch; }
		.tabs.vertical > .tab-bar {
			flex-direction: row; flex: 0 0 auto;
			position: static; max-height: none;
			border-inline-end: none; border-bottom: 1px solid var(--line);
		}
		.tabs.vertical > .tab-bar > .tab {
			border-inline-end: none; border-bottom: 2px solid transparent;
			margin-inline-end: 0; margin-bottom: -1px;
		}
		.tabs.vertical > .tab-bar > .tab.active,
		.tabs.vertical > .tab-bar > .tab:is(.in-path, [aria-current]):not(.tab-default),
		.tabs.vertical > .tab-bar:not(:has(.tab.active, .tab:is(.in-path, [aria-current]):not(.tab-default))) > .tab:first-child {
			border-bottom-color: var(--prim);
		}
		.tabs.vertical > .tab-panel { padding-top: 1rem; }
	}
}

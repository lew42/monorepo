node_modules

# generated by the dev server (Directory plugin) on every start
public/directory.json
public/framework/directory.json

# editor documents — user data, not site content (deployed editor uses localStorage)
public/data/

# live usage snapshot for the ai dashboard — written by the check-claude-usage skill
public/framework/ai/usage.json

# stalled/budget rows for the Dashboard — regenerated every ~60s by Servex/asks/tasks.js,
# same reason as usage.json above: machine state, not a record (stalled-and-budgets, 2026-10-02)
public/framework/ai/tasks.json

# the Sessions tab's own snapshot — written by sessions.mjs from this machine's own
# .claude/projects/*.jsonl files, same shape as usage.json above: machine state, not
# a record, regenerated by re-running the script. Also keeps the owner's own dictated
# prompt text (the transcript files) out of the public, statically-deployed site —
# review finding, 2026-10-02 (public/framework/ai/2026-10-02/panel2-sessions/
# part2-sessions-dashboard/doc/decisions.md).
public/framework/ai/sessions/sessions.json
public/framework/ai/sessions/transcripts/

# bulk screenshot dirs under the ai log — browsable on the dev server, never committed (Mike, 2026-08-17)
public/framework/ai/**/shots/

# the owner's own voice, saved by Server/plugins/Recordings.js and read by Server/whisper-test.mjs — never committed
public/framework/ai/recordings/

# page-health's day logs — machine-written console/error findings from
# Server/health.mjs, one file a day, regenerated just by running the watcher;
# bulky and disposable the way the usage snapshot above is, unlike a task's own
# task.jsonl (a human's own log, kept). The module's own files (page.js,
# devbar.js, log.js, health.css, readme.md, doc/) are NOT matched by this and
# stay tracked normally. public/framework/ai/2026-09-19/page-health/requirements.md
public/framework/ai/health/*.jsonl
public/framework/ai/health/archive/

# health-revive, 2026-09-19: Server/health-supervisor.mjs's own liveness readout,
# rewritten every ~10s while it runs — machine state, not a record, same shape
# as usage.json above.
public/framework/ai/health/heartbeat.json

.wrangler/

# the live-reload hold's lock file — describes only this machine's running
# agents, right now; Server/hold.mjs, public/framework/ai/2026-09-19/reload-hold/
.reload-hold.json

# which worktrees are up right now, on this machine — Server/worktree-up.mjs / worktree-down.mjs,
# public/framework/ai/2026-09-21/safe-rollout/
.worktrees.json
.worktree-pool.json
.merge.lock

# merge.mjs's own 1920 screenshots of a NEW page in the diff — machine output, regenerated by
# the next merge, never committed. Server/merge.mjs, public/framework/ai/2026-09-28/smoke-links/
.merge-shots/

# the owner's raw prompt transcripts, one file a day — never served, never committed
.claude/prompts/

# server.js's own supervisor writes this when a boot test fails, so an agent or the
# owner's tools can see why without the site being up; deleted on the next pass —
# public/framework/ai/2026-09-19/server-boot-test/
.server-boot-failed.json

branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
ui-test-out/
public/notes/inbox/

# the owner's voice recordings for whisper tests (2026-09-22) — never committed
public/framework/ai/recordings/

# worktree servers write their stdout here (Server/worktree-up.mjs) — never committed
.worktree-logs/

# Server/layout-check.mjs's own contact-sheet screenshots — machine output, regenerated on demand
layout-check-out/

# merge.mjs's own record of the last landed branch/head — machine state, not a record
.merge-landed.json

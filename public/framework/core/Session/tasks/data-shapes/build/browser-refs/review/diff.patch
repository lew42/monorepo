diff --git a/public/framework/core/Item/Ref.js b/public/framework/core/Item/Ref.js
new file mode 100644
index 000000000..626e58acc
--- /dev/null
+++ b/public/framework/core/Item/Ref.js
@@ -0,0 +1,163 @@
+import Item from "./Item.js";
+import Store from "./Store.js";
+
+/* Ref — a small Item that points at an item living somewhere else, instead of holding a copy (ids-and-paths.md §6).
+   It stores WHERE the target is, never its title or state, so it cannot drift:
+     {"type":"Ref","path":"tasks.ui.tasks.c3"}                                  the same file
+     {"type":"Ref","url":"/framework/ai/sessions/…/v-7k2q/","path":"tasks.ui"}  another file (a folder url opens its record)
+
+   Replay makes the Ref and nothing more. It is resolved when first needed (`resolve()`, or drawn by RefView):
+     1. the root: its own file's root (`this.root()`), or `Item.open(url)`, one root per url, the same live object everywhere;
+     2. `root.get(path)`; on a miss, the path's last part (the id) through `root.find(id)`, whose index is built on that first
+        miss and never saved (Item.find);
+     3. a target holding `{moved_to: {url, path}}` is a forward left at the old place: followed, and this Ref quietly takes the
+        new address (one line), so the next load goes straight there;
+     4. nothing found: `target` is null and RefView draws a visible "gone" row naming the path. Never silently empty.
+   Within one file, `Ref.backlinks(root)` is a Map from each path to the Refs pointing at it, computed in memory (never saved);
+   `Ref.shown(item)` answers "where is this shown", and `Ref.repath(item, old_path)` re-paths every Ref after a move, one line per Ref.
+   Node: Item.open fetches the url, so an absolute http url resolves (Ref.test.mjs); a task's {"task":"<folder>"} keeps Task.resolver. */
+export class Ref extends Item {
+
+	static fields = ["url", "path"];
+	static HOPS = 8;   // forwards followed before a chain is called a loop
+	static changes = 0;   // bumped when any Ref changes its address: the backlinks are walked again
+
+	put(key, value){ super.put(key, value); if (key === "path" || key === "url") Ref.changes++; }
+
+	/** The resolved item: undefined until resolve() has run, null when it is gone. */
+	get target(){ return this._target; }
+	get gone(){ return this._target === null; }
+
+	/** Resolve (again): find the root, the target, follow forwards; returns the target or null. A live root's change re-runs it. */
+	async resolve(){
+		const root = await this.root_of(this.url);
+		return this.settle(root, this.url);
+	}
+
+	// Steps 2 to 4 above, from a root already open.
+	async settle(root, url){
+		let path = this.path ?? "", hit = Ref.lookup(root, path), hops = 0, moved = false;
+		for (let to = Ref.forward_of(hit); to && hops < Ref.HOPS; to = Ref.forward_of(hit), hops++){
+			if (to.url){ url = to.url; root = await this.root_of(url); }
+			path = to.path ?? "";
+			hit = Ref.lookup(root, path);
+			moved = true;
+		}
+		if (Ref.forward_of(hit)){ hit = null; this._why = "the forwards loop"; }
+		if (moved && hit) this.set(url && url !== this.url ? { url, path } : { path });   // the new address, one line: next load goes straight there
+		this.watch(root);
+		return this.found(hit ?? null, root);
+	}
+
+	// The root of `url` (its own file's when none), opened once per url.
+	async root_of(url){
+		if (!url) return this.root();
+		return Item.open(await Ref.file_of(url));
+	}
+
+	found(hit, root){
+		const was = this._target;
+		this._target = hit;
+		this._root_of_target = root;
+		if (hit === null) this._why ??= `nothing at "${this.path ?? ""}"` + (this.url ? ` in ${this.url}` : "");
+		else this._why = null;
+		if (was !== hit){
+			if (was) was.off?.("delta", this._on_target);
+			if (hit) hit.on?.("delta", this._on_target ??= () => this.emit("target", this._target));
+		}
+		// Redraw only when what a row shows changed (the target, its title, its state): a replayed line fires no "delta" on the
+		// item, so the root's "read" re-settles and this compares; a read that touched nothing shown emits nothing.
+		const seen = hit ? `${hit.get_one?.("title")}|${hit.state}|${root?.get_one?.("title")}` : String(this._why);
+		if (was !== hit || seen !== this._seen){ this._seen = seen; this.emit("target", hit); }
+		return hit;
+	}
+
+	// A root that changes live (its Store read a line) may have gained or lost the target: look again, once per batch.
+	watch(root){
+		if (this._watched === root) return;
+		if (this._watched) this._watched.off?.("read", this._on_root);
+		this._watched = root;
+		root.on?.("read", this._on_root ??= () => this.settle(this._watched, this.url));
+	}
+
+	/** Why it is gone, in words, for the "gone" row. */
+	get why(){ return this._why ?? null; }
+
+	/** The title a reader sees: the root's title, then the target's, as "session › task". */
+	label(){
+		const t = this._target, root = this._root_of_target;
+		const name = x => x?.get_one?.("title") ?? x?.title ?? x?.id ?? "";
+		return root && root !== t && this.url ? `${name(root)} › ${name(t)}` : name(t);
+	}
+
+	// ---- statics: lookup, files, backlinks ----
+
+	/** The item at `path` under `root`; on a miss, the path's last part looked up as an id anywhere under it (Item.find). */
+	static lookup(root, path){
+		if (!root) return null;
+		if (!path) return root;
+		const hit = root.get(path);
+		if (hit instanceof Item) return hit;
+		const id = String(path).split(".").at(-1);
+		return root.find?.(id) ?? null;
+	}
+
+	static forward_of(item){
+		const to = item?.get_one?.("moved_to");
+		return to && typeof to === "object" ? to : null;
+	}
+
+	/** A folder url opens the record it keeps (session.jsonl, else task.jsonl, else page.jsonl); a file url is itself. */
+	static async file_of(url){
+		if (/\.jsonl$/.test(url)) return url;
+		const dir = String(url).replace(/\/?$/, "/");
+		const names = typeof document !== "undefined" ? (await import("../Router/listing.js")).names(dir) : null;
+		const order = ["session.jsonl", "task.jsonl", "page.jsonl"];
+		if (names) return dir + (order.find(n => names.includes(n)) ?? order[0]);
+		for (const n of order){
+			const res = await fetch(dir + n, { method: "HEAD" }).catch(() => null);
+			if (res?.ok && !res.headers.get("content-type")?.includes("html")) return dir + n;
+		}
+		return dir + order[0];
+	}
+
+	/** Every same-file Ref under `root`, by the path it names: computed by a walk, kept until any list changes (Item.generation),
+	    never saved. A Ref to another file is not here: across files a move leaves a forward instead. */
+	static backlinks(root){
+		const had = root._backlinks;
+		if (had && had.gen === Item.generation && had.changes === Ref.changes) return had.map;
+		const map = new Map();
+		root.walk(item => { if (item instanceof Ref && !item.url) (map.get(item.path ?? "") ?? map.set(item.path ?? "", []).get(item.path ?? "")).push(item); });
+		Object.defineProperty(root, "_backlinks", { value: { gen: Item.generation, changes: Ref.changes, map }, writable: true, configurable: true, enumerable: false });
+		return map;
+	}
+
+	/** Where is this shown: the Refs in its own file that point at it, by its path or, after a move, by its id. */
+	static shown(item){
+		const root = item.root(), path = Store.address(item, root), out = new Set(Ref.backlinks(root).get(path) ?? []);
+		for (const [p, refs] of Ref.backlinks(root)) if (p !== path && String(p).split(".").at(-1) === item.id) refs.forEach(r => out.add(r));
+		return [...out];
+	}
+
+	/** After `item` moved within its file: every Ref that named `old_path` (or found it by its id) takes the new path, one line each. */
+	static repath(item, old_path){
+		const root = item.root(), now = Store.address(item, root), refs = new Set(Ref.backlinks(root).get(old_path) ?? []);
+		for (const r of Ref.shown(item)) refs.add(r);
+		const moved = [...refs].filter(r => r.path !== now);
+		for (const r of moved) r.set({ path: now });
+		return moved;
+	}
+
+	/** A move to another file: the old place keeps `{moved_to: {url, path}}`, a forward old Refs follow. */
+	static forward(old_item, to){ old_item.set({ moved_to: { url: to.url, path: to.path ?? "" } }); return old_item; }
+}
+
+Item.register(Ref, "Ref");
+
+// A live move to another list (List.move) re-paths the same-file Refs that named the old path, one line each. Not on replay:
+// the file already holds those lines. Only while Ref is loaded: a page with no Refs pays nothing.
+Item.moving = {
+	before: item => item.root?.()?.store?.replaying || Store.muted ? undefined : Store.address(item, item.root()),
+	after: (item, old_path) => { if (old_path && Ref.backlinks(item.root()).size) Ref.repath(item, old_path); },
+};
+export default Ref;
diff --git a/public/framework/core/Item/Ref.test.mjs b/public/framework/core/Item/Ref.test.mjs
new file mode 100644
index 000000000..e4b6aba6f
--- /dev/null
+++ b/public/framework/core/Item/Ref.test.mjs
@@ -0,0 +1,142 @@
+// Ref: references that resolve through a real Store and real files. Plain node: `node public/framework/core/Item/Ref.test.mjs`
+// The files sit in a temp folder served over http, so Item.open fetches them exactly as a browser would (one load; the live
+// tail is the browser's, shown on the session page).
+//   1. another file: Item.open(url), one root per url, then get(path); a missing target is "gone", named
+//   2. an id fallback: the path misses, the id is found through the root's index (built on that miss, never saved)
+//   3. backlinks within one file: built from the replayed lines; "where is this shown"; a move re-paths each Ref, one line each
+//   4. a forward across files: {moved_to:{url, path}} at the old place; an old Ref follows it and takes the new address
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import Test from "../Test/Test.js";
+import Item from "./Item.js";
+import "../List/List.js";
+import Store from "./Store.js";
+import "../Task/Task.js";
+import "../Session/Session.js";
+import Ref from "./Ref.js";
+
+const t = new Test("core/Item/Ref");
+const DIR = fs.mkdtempSync(path.join(os.tmpdir(), "ref-test-"));
+const write = (file, lines) => { fs.mkdirSync(path.dirname(path.join(DIR, file)), { recursive: true }); fs.writeFileSync(path.join(DIR, file), lines.map(l => JSON.stringify(l)).join("\n") + "\n"); };
+const read = file => fs.readFileSync(path.join(DIR, file), "utf8").split("\n").filter(Boolean).map(l => JSON.parse(l));
+
+const server = http.createServer((req, res) => {
+	const file = path.join(DIR, decodeURIComponent(new URL(req.url, "http://x").pathname));
+	if (!file.startsWith(DIR) || !fs.existsSync(file) || fs.statSync(file).isDirectory()){ res.writeHead(404); return res.end(); }
+	res.writeHead(200, { "content-type": "application/x-ndjson" });
+	res.end(req.method === "HEAD" ? undefined : fs.readFileSync(file));
+});
+await new Promise(ok => server.listen(0, "127.0.0.1", ok));
+const BASE = `http://127.0.0.1:${server.address().port}`;
+
+// A document attached to a real file the way Store.test does it: a change appends its one line to the file.
+const attach = (host, file) => {
+	const store = new Store({ url: BASE + "/" + file });
+	store.append = line => fs.appendFileSync(path.join(DIR, file), JSON.stringify(line) + "\n");
+	store.attach(host);
+	return store;
+};
+
+const child = [
+	{ session: { id: "child-1", kind: "agent", at: "2026-10-28T20:00:00-05:00" } },
+	{ tasks: { add: { type: "Task", id: "t1", title: "Build the page" } } },
+	{ tasks: { add: { type: "Task", id: "t2", title: "Write the doc" } } },
+	{ tasks: { t2: { tasks: { add: { type: "Task", id: "t3", title: "Proofread" } } } } },
+];
+
+try {
+	// 1. another file, one root per url, gone
+	write("s/child-1/session.jsonl", child);
+	const r1 = new Ref({ url: "/s/child-1/", path: "tasks.t1" });
+	r1.url = BASE + "/s/child-1/";   // set after construction too: the field is the address, the line it writes is {set:{url}}
+	const hit = await r1.resolve();
+	t.eq(hit?.get_one("title"), "Build the page", "a Ref to another file resolves to the item at its path");
+	t.ok(hit?.constructor.name === "Task" && r1._root_of_target?.constructor.name === "Session", "the file opens as what its lines say: a Session record, its tasks Tasks");
+	t.eq(r1.label(), "child-1 › Build the page", "drawn in context: session › task");
+
+	const r2 = new Ref({ url: BASE + "/s/child-1/", path: "tasks.t2.tasks.t3" });
+	await r2.resolve();
+	t.ok(r2._root_of_target === r1._root_of_target, "one root per url: two Refs to one file share the same live object");
+	t.ok(await Item.open(BASE + "/s/child-1/session.jsonl") === r1._root_of_target, "and Item.open(url) answers that same root");
+	t.eq(r2.target?.get_one("title"), "Proofread", "a nested path walks one get() per level");
+
+	const gone = new Ref({ url: BASE + "/s/child-1/", path: "tasks.nope" });
+	t.eq(await gone.resolve(), null, "a missing target resolves to null");
+	t.ok(gone.gone && /tasks\.nope/.test(gone.why), `it is gone and says what it looked for (${gone.why})`);
+	const nofile = new Ref({ url: BASE + "/s/never-made/", path: "tasks.t1" });
+	t.eq(await nofile.resolve(), null, "a Ref to a folder with no record is gone too, not a throw");
+
+	// 2. an id fallback
+	const before = fs.readFileSync(path.join(DIR, "s/child-1/session.jsonl"), "utf8");
+	const stale = new Ref({ url: BASE + "/s/child-1/", path: "tasks.t1.tasks.t3" });   // t3 was under t2, never t1
+	t.eq((await stale.resolve())?.get_one("title"), "Proofread", "the path misses, the id (its last part) finds the item");
+	const root = stale._root_of_target;
+	t.ok(!Object.keys(root).includes("_deep") && !!Object.getOwnPropertyDescriptor(root, "_deep"), "the id index is built on the miss, kept off the item's keys");
+	t.eq(fs.readFileSync(path.join(DIR, "s/child-1/session.jsonl"), "utf8"), before, "and never saved: the file is unchanged");
+
+	// 3. backlinks within one file
+	const doc = Item.hydrate({ id: "doc", title: "Doc", tasks: [{ id: "ui", title: "UI", tasks: [{ id: "c3", title: "C3" }] }, { id: "done", title: "Done", tasks: [] }], chat: [] });
+	write("doc.jsonl", []);
+	attach(doc, "doc.jsonl");
+	doc.chat.add({ type: "Ref", id: "r1", path: "tasks.ui.tasks.c3" });
+	doc.chat.add({ type: "Ref", id: "r2", path: "tasks.ui.tasks.c3" });
+	doc.chat.add({ type: "Ref", id: "r3", path: "tasks.done" });
+	const c3 = doc.get("tasks.ui.tasks.c3");
+	t.eq(Ref.shown(c3).map(r => r.id), ["r1", "r2"], "where is C3 shown: the two Refs that point at it");
+	t.eq(Ref.backlinks(doc).get("tasks.done").map(r => r.id), ["r3"], "the backlinks map holds every path a Ref names");
+
+	const n = read("doc.jsonl").length;
+	doc.get("tasks.done.tasks").move("c3", { after: null, from: doc.get("tasks.ui.tasks") });   // the move alone: List.move calls Ref.repath
+	t.eq(["r1", "r2"].map(id => doc.chat.find(id).path), ["tasks.done.tasks.c3", "tasks.done.tasks.c3"], "a move re-paths the Refs that named the old path");
+	t.eq(Ref.repath(c3, "tasks.ui.tasks.c3"), [], "and calling repath again finds nothing left to do");
+	const added = read("doc.jsonl").slice(n + 1);   // after the move line itself
+	t.eq(added, [{ chat: { r1: { set: { path: "tasks.done.tasks.c3" } } } }, { chat: { r2: { set: { path: "tasks.done.tasks.c3" } } } }], "one line per Ref, naming its new path");
+
+	// Replayed from the file: the backlinks are rebuilt from the lines, and every Ref finds C3 at its new place.
+	const again = Item.hydrate({ id: "doc", title: "Doc", tasks: [{ id: "ui", title: "UI", tasks: [{ id: "c3", title: "C3" }] }, { id: "done", title: "Done", tasks: [] }], chat: [] });
+	const reader = new Store({ url: BASE + "/doc.jsonl" });
+	reader.attach(again);
+	reader.read(read("doc.jsonl"));
+	const c3b = again.get("tasks.done.tasks.c3");
+	t.ok(!!c3b, "the replayed file has C3 under Done");
+	t.eq(Ref.shown(c3b).map(r => r.id), ["r1", "r2"], "the backlinks built from the replay point at the moved C3");
+	t.ok((await again.chat.find("r1").resolve()) === c3b, "and a replayed Ref resolves straight to it");
+
+	// 4. a forward across files
+	write("s/old/session.jsonl", [
+		{ session: { id: "old", kind: "agent", at: "2026-10-28T19:00:00-05:00" } },
+		{ tasks: { add: { type: "Task", id: "w1", title: "Work, before it moved" } } },
+	]);
+	write("s/new/session.jsonl", [
+		{ session: { id: "new", kind: "agent", at: "2026-10-28T19:30:00-05:00" } },
+		{ tasks: { add: { type: "Task", id: "w1", title: "Work, in its new session" } } },
+	]);
+	// The mover leaves a forward at the old place (here as the line it writes; Ref.forward(item, to) is the call that makes it).
+	fs.appendFileSync(path.join(DIR, "s/old/session.jsonl"), JSON.stringify({ tasks: { w1: { moved_to: { url: BASE + "/s/new/", path: "tasks.w1" } } } }) + "\n");
+	const holder = Item.hydrate({ id: "holder", title: "Holder", chat: [] });
+	write("holder.jsonl", []);
+	attach(holder, "holder.jsonl");
+	const old_ref = holder.chat.add({ type: "Ref", id: "o1", url: BASE + "/s/old/", path: "tasks.w1" });
+	const followed = await old_ref.resolve();
+	t.eq(followed?.get_one("title"), "Work, in its new session", "an old Ref follows the forward to the new file");
+	t.eq([old_ref.url, old_ref.path], [BASE + "/s/new/", "tasks.w1"], "and takes the new address");
+	t.eq(read("holder.jsonl").slice(1), [{ chat: { o1: { set: { url: BASE + "/s/new/" } } } }], "written as one line (what changed: the url; the path is the same), so the next load goes straight there");
+
+	const loop = Item.hydrate({ id: "loop", chat: [] });
+	write("s/a/session.jsonl", [{ session: { id: "a" } }, { tasks: { add: { type: "Task", id: "x" } } }, { tasks: { x: { moved_to: { url: BASE + "/s/b/", path: "tasks.x" } } } }]);
+	write("s/b/session.jsonl", [{ session: { id: "b" } }, { tasks: { add: { type: "Task", id: "x" } } }, { tasks: { x: { moved_to: { url: BASE + "/s/a/", path: "tasks.x" } } } }]);
+	const looped = loop.chat.add({ type: "Ref", id: "l1", url: BASE + "/s/a/", path: "tasks.x" });
+	t.eq(await looped.resolve(), null, "two forwards pointing at each other end as gone, not a hang");
+
+	// The writer half: Ref.forward leaves the forward on a live item.
+	const left = Item.hydrate({ id: "left", title: "Left" });
+	Ref.forward(left, { url: "/s/new/", path: "tasks.w1" });
+	t.eq(left.get_one("moved_to"), { url: "/s/new/", path: "tasks.w1" }, "Ref.forward sets {moved_to:{url, path}} at the old place");
+} finally {
+	server.close();
+	fs.rmSync(DIR, { recursive: true, force: true });
+}
+
+t.done();
diff --git a/public/framework/core/Item/RefView.css b/public/framework/core/Item/RefView.css
new file mode 100644
index 000000000..7c55dc15d
--- /dev/null
+++ b/public/framework/core/Item/RefView.css
@@ -0,0 +1,25 @@
+@layer base, theme, site, util;
+
+@layer site {
+	/* One row: state icon, where (the other file's root), ›, what (the target). Narrow: where on top, small; what below, full width. */
+	.ref-view { display: grid; grid-template-columns: auto minmax(0, max-content) auto minmax(0, 1fr); align-items: center; gap: .5em; min-width: 0; }
+	.ref-view-state { flex: none; }

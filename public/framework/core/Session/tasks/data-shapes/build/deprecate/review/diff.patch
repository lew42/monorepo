diff --git a/public/framework/core/Item/watch/watch.css b/public/framework/core/Item/watch/watch.css
new file mode 100644
index 000000000..d7888e2fb
--- /dev/null
+++ b/public/framework/core/Item/watch/watch.css
@@ -0,0 +1,30 @@
+@layer base, theme, site, util;
+
+/* The watch demo (Watch.js): one column on a phone, two from 70em, three from 100em. */
+@layer site {
+	.core-item-watch { display: grid; gap: var(--gap); grid-template-columns: 1fr; align-items: start; }
+	/* Middle widths: steps | objects, the lines under both. Wide: all three side by side. */
+	@media (min-width: 70em) {
+		.core-item-watch { grid-template-columns: minmax(18em, 1fr) minmax(22em, 1.4fr); }
+		.core-item-watch-lines { grid-column: 1 / -1; }
+	}
+	@media (min-width: 100em) {
+		.core-item-watch { grid-template-columns: minmax(18em, 1fr) minmax(22em, 1.3fr) minmax(20em, 1.2fr); }
+		.core-item-watch-lines { grid-column: auto; }
+	}
+	.core-item-watch > * { min-width: 0; }
+	/* Narrow: only the step that just ran (the one the note explains), so the objects stay near the top. */
+	@media (max-width: 69.99em) {
+		.core-item-watch-list > li:not(.is-focus) { display: none; }
+	}
+
+	.core-item-watch-note { min-height: 3em; margin: 0; }
+	.core-item-watch-list { margin: 0; padding-inline-start: 1.6em; display: flex; flex-direction: column; gap: .3em; }
+	.core-item-watch-list > li { color: var(--subtle); }
+	.core-item-watch-list > li.is-done { color: inherit; }
+	.core-item-watch-list > li.is-next { color: inherit; font-weight: 600; }
+	.core-item-watch-list code { white-space: normal; overflow-wrap: anywhere; }
+
+	.core-item-watch-lines .log-line { font-family: var(--mono, monospace); font-size: .85em; overflow-wrap: anywhere; }
+	.core-item-watch-same { font-weight: 600; }
+}

+// Item's core test, the same steps its class page draws (Item.steps.js). Run: node public/framework/core/Item/Item.steps.test.mjs
+import Test from "../Test/Test.js";
+import "../List/List.js";
+import steps, { run_steps } from "./Item.steps.js";
+

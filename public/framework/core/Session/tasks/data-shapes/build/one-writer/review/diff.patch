+	const agent = Promise.all(Array.from({ length: 20 }, (_, i) => run_item({ path: URL, delta: { tasks: { add: { title: `agent task ${i}` } } } }, { caller: "agent-t" })));
+	const [posted] = await Promise.all([tab, agent]);

diff --git a/public/framework/core/Page/parts/PageFile.js b/public/framework/core/Page/parts/PageFile.js
new file mode 100644
index 000000000..7114f12b2
--- /dev/null
+++ b/public/framework/core/Page/parts/PageFile.js
@@ -0,0 +1,13 @@
+import Item from "../../Item/Item.js";
+import View from "../../View/View.js";
+
+/* {"type":"part-file","file":"./readme.md"} — a markdown file in the page's folder, rendered here.
+   One implementation with the page-level `place` line: Jsonl.draw_md (Jsonl.js). */
+export default class PageFile extends Item {}
+PageFile.View = class PageFileView extends View {
+	render(){
+		const page = this.item.parent;   // a part's parent is the page that holds it (root() would walk on to the site root)
+		return page.draw_md(new URL(this.item.get("file"), location.origin + page.log_folder()).href);
+	}
+};
+Item.register(PageFile, "part-file");
diff --git a/public/framework/core/Page/parts/PageView.js b/public/framework/core/Page/parts/PageView.js

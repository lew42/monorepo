index c650f1f13..df77570ab 100644
--- a/public/framework/core/Page/Listing.js
+++ b/public/framework/core/Page/Listing.js
@@ -1,3 +1,5 @@
+import { names } from "../Router/listing.js";
+
 // What listing() answers: files, dirs, pages (Map kid → js/jsonl), page (is this log a page?), log (the source file). (doc/decisions.md)
 export default class PageListing {
 
@@ -31,4 +33,50 @@ export default class PageListing {
 
 	// Is `name` a folder here, page or not?
 	folder(name){ return this.dirs.includes(name) || this.pages.has(name); }
+
+	// A folder's own file list: a loaded page's lines, else files.jsonl, else page.jsonl, else null. Memoised per folder. (doc/decisions.md)
+	static listing(P, url, fresh){
+		url = String(url).replace(/\/?$/, "/");
+		if (P.UNLOGGED.test(url)) return Promise.resolve(null);
+
+		const own = P.page_listing(url);
+		if (own) return Promise.resolve(own);
+
+		const memo = P.listings ??= new Map();
+		if (fresh || !memo.has(url)) memo.set(url, P.fetch_listing(url)
+			.then(listing => { (P.loaded_listings ??= new Map()).set(url, listing); return listing; }));
+		return memo.get(url);
+	}
+
+	// The two files, in the order the parent's listing suggests; the first one there wins.
+	static async fetch_listing(P, url){
+		const [, parent, name] = url.match(/^(.*\/)([^/]+)\/$/) ?? [];
+		const jsonl_first = parent && P.loaded_listing(parent)?.pages.get(name) === "jsonl";
+		let order = jsonl_first ? ["page.jsonl", "files.jsonl"] : ["files.jsonl", "page.jsonl"];
+
+		// On the dev server the folder's names say which log exists, so a folder with neither asks for nothing (no 404s). Static site: null, probe as before.
+		const listed = names(url);
+		if (Array.isArray(listed)) order = order.filter(file => listed.includes(file));
+
+		for (const file of order){
+			const reader = await new P.Reader({ url: url + file }).load();
+			if (reader.loaded) return P.Listing.from(reader.entries, file === "page.jsonl" ? undefined : false, file);
+		}
+		return null;
+	}
+
+	// A jsonl page already loaded at `url` (jsonl() registers it): its lines, as a listing.
+	static page_listing(P, url){
+		const page = P.log_pages?.get(url);
+		if (!page) return null;
+		return P.Listing.from([...page.listed?.values() ?? []].map(file => ({ file })), true, "page.jsonl");
+	}
+
+	// The listing, only if it is already here — a loaded jsonl page, or a `listing()`
+	// call that has come back; never fetches.
+	// undefined = not asked yet, null = asked, no file list.
+	static loaded_listing(P, url){
+		url = String(url).replace(/\/?$/, "/");
+		return P.page_listing(url) ?? P.loaded_listings?.get(url);
+	}
 }
diff --git a/public/framework/core/Page/Load.js b/public/framework/core/Page/Load.js
new file mode 100644
index 000000000..d00bcf454
--- /dev/null
+++ b/public/framework/core/Page/Load.js
@@ -0,0 +1,75 @@
+import { is } from "../View/View.js";
+
+// The loading statics of Page: each takes the class (P) first; Page keeps one-line forwarders. (doc/architecture.md)
+export default class PageLoad {
+
+	// Last resort: a `.md` beside me IS a page. ⚠ The SPA fallback answers a miss with index.html at 200: content-type is the 404. (doc/watch-out.md)
+	static async file(P, url){
+		const res = await fetch(url).catch(() => null);
+		if (!res?.ok || res.headers.get("content-type")?.includes("html")) return null;
+
+		const text = await res.text();
+		const { default: md } = await import("../../ext/markdown/md.js");
+		const href = new URL(url, location.origin).href;
+
+		md.cache[href] ??= Promise.resolve(text);
+
+		return {
+			title: text.match(/^#\s+(.+?)\s*$/m)?.[1],
+			content(){ return md.file({ url: href }, href, { h1: false }); },
+		};
+	}
+
+	// A module that throws is NOT a module that isn't there. ⚠ `levels` bounds its subtree (nothing = its own `depth`). (doc/watch-out.md)
+	static async load(P, url, levels){
+		try {
+			const page = (await import(url + "page.js")).default ?? null;
+			return page instanceof P ? page.load_all_children(levels) : page;
+		}
+		catch (error){
+			if (!P.missing(error))
+				console.error(`Page.load("${url}page.js") — the file EXISTS but failed to load:`, error);
+			return null;
+		}
+	}
+
+	// ⚠ The SPA fallback answers a miss with index.html at 200: content-type is the 404. `opts` goes to fetch. (doc/decisions.md)
+	static async read_json(P, url, opts){
+		const res = await fetch(url, opts).catch(() => null);
+		if (!res?.ok || res.headers.get("content-type")?.includes("html")) return null;
+		return res.json().catch(() => null);
+	}
+
+	static async from(P, source, adopt){
+		const url  = is.str(source) ? source.replace(/\/?$/, "/") : null;
+		const data = url ? await P.read_json(url + "page.json") : source;
+		if (!data) return null;
+
+		const page = new P({ url, ...P.props(data, data.mode ?? {}) }, adopt);
+
+		for (const name of data.children ?? [])
+			page.add(name, (url && await P.from(url + name + "/")) ?? { title: name });
+
+		return page;
+	}
+
+	static props(P, data, mode){
+		return {
+			title: data.title, icon: data.icon, description: data.description,
+			navigation: mode.navigation, arrangement: mode.arrangement,
+			surface: mode.surface, background: mode.background,
+			type_size: mode.type,
+			width: mode.room ?? mode.width,
+			content: mode.content,
+		};
+	}
+
+	static missing(P, error){
+		return /Failed to fetch dynamically imported module|error loading dynamically imported module|MIME type|Expected a JavaScript/i
+			.test(error?.message ?? "");
+	}
+
+	static slug(P, title){
+		return String(title).toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+	}
+}

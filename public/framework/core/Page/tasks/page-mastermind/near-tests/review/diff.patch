+test("tests: passes on the base, fails on the branch -> refused, nothing lands; the base result is cached by sha", () => {
+	const { main, wt } = scratchTests("worktree/t1", { baseX: GOOD, baseTest: CHECKS_ONE, branchX: BAD });

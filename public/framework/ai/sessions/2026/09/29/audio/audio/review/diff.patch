+				frame(360, 500, () => {
+					p.c("muted", "sheet width · 30 messages — capped, then scrolls");
+					const panel = new ChatPanel({ placeholder: "say something" }).style("--chatbox-panel-max", "70vh");
+					seed(30).forEach(e => panel.say(e));
+				});
+			});

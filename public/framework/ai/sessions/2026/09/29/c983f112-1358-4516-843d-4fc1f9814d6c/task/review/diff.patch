diff --git a/public/layouts/explorer/explorer.css b/public/layouts/explorer/explorer.css
new file mode 100644
index 00000000..ca8782c4
--- /dev/null
+++ b/public/layouts/explorer/explorer.css
@@ -0,0 +1,209 @@
+@layer site {
+
+	/* THE PAGE SHELL — round 2: the page starts at the top of the screen. `render()`
+	   in page.js skips core's default `<h1>` + "Folder" link, so this IS the whole
+	   page: a header row (the breadcrumb), then the three regions filling the rest
+	   of `100dvh`. `page-fs-link` (the "Folder" link) is core's own default, drawn
+	   by `render()` before `content()` ever runs — the reason this page overrides
+	   `render()` whole rather than trying to hide one line of someone else's markup. */
+	.std-explorer-page {
+		display: flex;
+		flex-direction: column;
+		height: 100dvh;
+		overflow: hidden;
+		padding-inline: var(--pad, 1em);
+	}
+
+	/* THE HEADER — one line: the breadcrumb, then a small (i) whose native title=
+	   tooltip carries the explanation that used to be a whole paragraph. */
+	.std-explorer-head {
+		flex: 0 0 auto;
+		padding-block: 0.6em;
+		border-block-end: 1px solid var(--line);
+	}
+
+	.std-explorer-crumbs {
+		display: flex;
+		align-items: center;
+		gap: 0.2em;
+		flex-wrap: wrap;
+	}
+
+	.std-explorer-crumb {
+		display: inline-flex;
+		align-items: center;
+		gap: 0.2em;
+		text-decoration: none;
+		color: inherit;
+	}
+
+	.std-explorer-crumb:hover { color: var(--accent, currentColor); }
+
+	.std-explorer-info { margin-inline-start: auto; color: var(--subtle); cursor: help; }
+
+	/* THE THREE-REGION ROW — fills whatever height the header left. Round 2,
+	   deliverable 6: the rails GROW a little on a wide screen (the `clamp`'s middle
+	   term is a `vw`) but cap well short of the centre's own share, which is the
+	   rest of the row (`minmax(0, 1fr)`) — the same "a share, floored and capped"
+	   shape every `cols` track in the layout standard already uses. */
+	.std-explorer-body {
+		flex: 1 1 auto;
+		min-height: 0;
+		display: grid;
+		grid-template-columns: clamp(14em, 16vw, 20em) minmax(0, 1fr) clamp(14em, 16vw, 20em);
+		gap: var(--gap);
+		padding-block: 0.8em;
+		overflow: hidden;
+	}
+
+	/* EACH REGION SCROLLS ITSELF — deliverable 1: "each rail scrolling on its own",
+	   so a long wall of cards never pushes the other two regions off screen. The
+	   centre is ALSO a flex column now (round 3): its picture is the one flexible
+	   item (`flex: 1 1 auto` below), so it grows to fill whatever height the title
+	   and the properties strip leave, rather than sitting at a fixed aspect. */
+	.std-explorer-rail {
+		min-width: 0;
+		height: 100%;
+		overflow-y: auto;
+		padding-inline-end: 0.4em;
+	}
+
+	.std-explorer-centre {
+		min-width: 0;
+		height: 100%;
+		overflow-y: auto;
+		padding-inline-end: 0.4em;
+		display: flex;
+		flex-direction: column;
+	}
+
+	.std-explorer-rail h3 { margin-block: 0 0.4em; }
+
+	@media (max-width: 40rem) {
+		/* A PHONE READS ONE COLUMN — round 3: the centre comes FIRST (the actual
+		   answer to "what does this look like"), then its children, then the
+		   sibling list — `order`, the DOM itself is unchanged. The PAGE scrolls,
+		   rather than three independent scroll boxes each fighting a sliver of a
+		   700px-tall screen for room. */
+		.std-explorer-page { height: auto; overflow: visible; }
+
+		.std-explorer-body {
+			display: flex;
+			flex-direction: column;
+			height: auto;
+			overflow: visible;
+		}
+
+		.std-explorer-body > *:nth-child(1) { order: 3; }   /* left rail — siblings */
+		.std-explorer-body > *:nth-child(2) { order: 1; }   /* centre */
+		.std-explorer-body > *:nth-child(3) { order: 2; }   /* right rail — children */
+
+		.std-explorer-rail,
+		.std-explorer-centre { height: auto; overflow: visible; margin-block-end: 1.2em; }
+
+		.std-explorer-pic-big { flex: 0 0 auto; aspect-ratio: 16 / 9; }
+	}
+
+	.std-explorer-cards {
+		display: grid;
+		grid-template-columns: 1fr;
+		gap: 0.5em;
+	}
+
+	/* A CARD — the whole thing is the link (`.std-explorer-card` IS the `<a>`), so a
+	   drawing or an iframe inside it must never take the click; explorer.css is the
+	   one place that turns both off, rather than repeating `pointer-events: none` at
+	   every call site. Round 2, deliverable 4: shorter, so ~6 fit in one screen —
+	   the caption is ONE line (`text-overflow: ellipsis`), never a second row. */
+	.std-explorer-card {
+		display: block;
+		border: 1px solid var(--line);
+		border-radius: 0.35em;
+		overflow: hidden;
+		text-decoration: none;
+		color: inherit;
+		background: var(--surface);
+	}
+
+	.std-explorer-card:hover { border-color: var(--accent, currentColor); }
+	.std-explorer-card.is-active { border-color: var(--accent, currentColor); border-width: 2px; }
+
+	.std-explorer-card .std-frame,
+	.std-explorer-card .std-explorer-draw iframe { pointer-events: none; }
+
+	.std-explorer-card-title {
+		display: block;
+		padding: 0.35em 0.6em;
+		font-weight: 600;
+		font-size: 0.9em;
+		white-space: nowrap;
+		overflow: hidden;
+		text-overflow: ellipsis;
+	}
+
+	/* A pure category with nothing at all to draw (no children either) — the one
+	   fallback `effective()` in page.js cannot resolve. Round 2 removed this as the
+	   NORMAL category picture (a category now shows its first child's own drawing),
+	   so it is rare — a plain tile still reads as "a picture belongs here". */
+	.std-explorer-pic-cat {
+		display: flex;
+		align-items: center;
+		justify-content: center;
+		aspect-ratio: 16 / 9;
+		background: var(--tint, var(--pad-bg, #0000000d));
+		color: var(--subtle);
+	}
+
+	/* THE IFRAME FRAME — the same "draw it real size, then shrink with a container
+	   query zoom" trick Layout.js's own `.std-frame`/`.std-draw` already uses (its own
+	   header comment has the measurements), so a wireframe card and a real-page card
+	   land at the same height with nothing measured in JS. */
+	.std-explorer-frame {
+		container-type: inline-size;
+		aspect-ratio: var(--w) / var(--h);
+		overflow: hidden;
+		background: var(--surface);
+	}
+
+	.std-explorer-draw {
+		width: calc(var(--w) * 1px);
+		height: calc(var(--h) * 1px);
+		zoom: calc(100cqw / (var(--w) * 1px));
+	}
+
+	.std-explorer-draw iframe { width: 100%; height: 100%; border: 0; display: block; }
+
+	/* THE CENTRE — the selected item, real size (well, real page, shrunk to the
+	   column it is given). Its iframe DOES take clicks — it is not inside a link. */
+	.std-explorer-centre-title { margin-block: 0 0.5em; }
+
+	/* ROUND 3, DELIVERABLE 1 — the one flexible item in the centre's own flex column
+	   (`.std-explorer-centre`, above): it takes whatever height the title and the
+	   properties strip below it leave, and `fit_frame()` in page.js reads that real
+	   box back into the frame's own `--w`/`--h`, so the drawing (or iframe) fills it
+	   exactly rather than sitting at a fixed 16∶9 slice of it. */
+	.std-explorer-pic-big {
+		flex: 1 1 auto;
+		min-height: 240px;
+		border: 1px solid var(--line);
+		border-radius: 0.4em;
+		overflow: hidden;
+	}
+
+	.std-explorer-pic-big .std-explorer-draw iframe { pointer-events: auto; }
+
+	.std-explorer-empty { padding: 2em; text-align: center; }
+
+	/* DELIVERABLE 7's FALLBACK — a small strip under the centre's own picture, not
+	   the ☰ drawer (see page.js's own comment and the final report for why). Lives
+	   inside `.std-explorer-centre` now, so it scrolls with it. */
+	.std-explorer-props {
+		margin-block-start: 1em;
+		padding: 0.8em 1em;
+		border: 1px solid var(--line);
+		border-radius: 0.4em;
+		background: var(--surface);
+	}
+
+	.std-explorer-props p { margin: 0.2em 0; }
+}

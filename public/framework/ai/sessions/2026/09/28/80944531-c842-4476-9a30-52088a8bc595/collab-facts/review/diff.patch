++{"fact":{"at":"2026-09-28T15:28:00-05:00","id":"a-trailing-dash-in-css-scopes-txt-e-g-ui","text":"A trailing dash in css-scopes.txt (e.g., ui-) reserves that namespace. Never create .ui-<thing> without owning ui- in the scopes file.","certainty":"settled"}}

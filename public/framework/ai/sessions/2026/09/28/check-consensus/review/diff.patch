index 00000000..c1886ef9
--- /dev/null
+++ b/Server/doc/check.md
@@ -0,0 +1,78 @@
+# check() and consensus() — a cheap second opinion, by default
+
+Design: [Step C — sanity checks](/framework/ai/2026/09/28/agent-work-on-every-page-sanity-checks-c/design.md) (④ check, ⑤ consensus).
+
+## What they are
+
+Two small node modules that ask a couple of **fresh** agents — ones that never saw the
+reasoning behind a claim — whether it holds up.
+
+- **`check(claim, context)`** (`Server/check.mjs`) — for a single decision, answer or landing
+  outcome. Spawns 2 cheap agents (Haiku and Sonnet today — different model families, so a
+  mistake one is prone to isn't shared by both) and asks each: could this be wrong, what's the
+  alternative, agree or doubt? Target cost: **under $0.01**.
+- **`consensus(question, options)`** (`Server/consensus.mjs`) — for when the checkers disagree,
+  or the truth just isn't clear. 5 agents at 3 price levels (2x Haiku-tier, 2x Sonnet-tier,
+  1x Opus-tier today) each vote for one option. Target cost: **under $0.05**.
+
+Both reuse the spawn pattern `Server/review.mjs`'s fresh-eyes review already proved: a brand
+new Servex agent, never resumed or forked, over the loopback MCP
+(`spawn_agent` → `wait_for_agent` → `stop_agent`). Neither ever throws — a checker or voter
+that fails to run becomes one `doubt`/`(no vote)` row, not a crash.
+
+## How it's used
+
+```js
+import { check, chip } from "../Server/check.mjs";
+const result = await check("The button should say Save, not Submit.", {
+	ownerWords: ["public/framework/ai/2026/09/28/.../owner-words.md"],
+	files: ["public/app.js"],
+	cardDir: "public/framework/ai/2026/09/28/some-card"   // appends {"check":…} to its task.jsonl
+});
+result.chip   // "✓✓" both agree, "✓?" they split or either doubts
+```
+
+```js
+import { consensus, appendConsensus } from "../Server/consensus.mjs";
+const result = await consensus("Which layout word fits best?", ["rail", "wall", "grid"]);
+appendConsensus(cardDir, question, options, result);   // appends {"consensus":…}
+```
+
+Or from the command line, while building or debugging:
+
+```
+node Server/check.mjs <cardDir> "<claim>" [--owner-words <file>] [--files <file,file>]
+node Server/consensus.mjs <cardDir> "<question>" "<option1>" "<option2>" ...
+```
+
+Both print their JSON result, plus the chip or tally. A Servex agent calls the same work as
+MCP tools — `check` and `consensus`, wired in `Servex/agents/check-tools.js`.
+
+## When it runs by itself
+
+After a manager or task mastermind writes a `decision` line, and on a landing outcome — never
+on the fast assistant's quick replies. One line about this lives in the sub-mastermind skill.
+
+## Watch out
+
+- Each checker/voter sees **only** the claim (or question), the owner's words and the files
+  named — never the conversation that produced the claim. That's the whole point: a fresh
+  read, not an echo.
+- The model rosters (`CHECKERS` in check.mjs, `VOTERS` in consensus.mjs) are Claude's own tiers
+  today. OpenRouter replaces them with a priced config table once harness step 2 lands — the
+  array is the one place that changes.
+- **The measured cost is over both targets today.** A real `check()` run (2 turns, `allowed_tools`
+  restricted to `["Read"]`) landed near **$0.18**, not the $0.01 target; a real `consensus()` run
+  (5 turns, `allowed_tools: []`) landed near **$0.47**, not the $0.05 target. Restricting the
+  toolset barely moved the number — this repo's own CLAUDE.md and skill-listing preamble is paid
+  on **every** spawn regardless of what tools it can use, and that fixed cost (roughly $0.09 per
+  turn here) dwarfs a 5-line answer. Fixing it means changing what a Servex spawn loads by
+  default — outside this module. Until then, call `check`/`consensus` sparingly, not on every
+  small decision.
+- `consensus()`'s own exported signature is `(question, options)`, with no `cardDir` — the
+  append happens separately, in `appendConsensus(cardDir, question, options, result)`, called by
+  both the CLI and the Servex `consensus` tool. `check()` differs: it takes `cardDir` inside its
+  `context` and appends itself.
+- The `Vote` shape is `{member, pick, caveat}` (the design's own shape, not a plain `{model,
+  vote, why}`) — `pick` is the voter's favourite option, `caveat` is the one improvement it
+  would want if a different option won.
diff --git a/Servex/agents/check-tools.js b/Servex/agents/check-tools.js
new file mode 100644
index 00000000..1d29f43e
--- /dev/null
+++ b/Servex/agents/check-tools.js
@@ -0,0 +1,53 @@
+import { check } from "../../Server/check.mjs";
+import { consensus, appendConsensus } from "../../Server/consensus.mjs";
+
+/* The two check/consensus tools: a cheap sanity check by default, and a 5-model vote when the
+ * truth is unclear. Same shape as `ops_tools(host)` in ops.js — the handlers here need no
+ * `agents`, but the argument is kept so both are wired the same way:
+ *
+ *   for (const tool of check_tools(servex.agents)) servex.mcp.tool(tool);
+ *
+ * Design: /framework/ai/2026/09/28/agent-work-on-every-page-sanity-checks-c/design.md (④ and ⑤). */
+
+const tool = (name, description, properties, required, handler) => {
+	const inputSchema = { type: "object", required, properties };
+	return { name, description, inputSchema, schema: inputSchema, handler };
+};
+
+export function check_tools(agents){ return [
+
+	tool("check",
+		"Spawn 2 fresh checkers (Haiku and Sonnet today, different model families) to sanity-check one"
+		+ " claim — a decision, an answer, a landing outcome. Each checker sees ONLY the claim, the"
+		+ " owner's words and the files it names, never your reasoning, and says whether it agrees or"
+		+ " doubts, in 5 lines at most. Appends a `{\"check\":…}` line to the card's task.jsonl and"
+		+ " returns the verdicts, the total cost and the chip (\"✓✓\" both agree, \"✓?\" otherwise).",
+		{
+			cardDir: { type: "string", description: "The card's directory (e.g. public/framework/ai/2026/09/28/<slug>). The result is appended to its task.jsonl." },
+			claim: { type: "string", description: "The one sentence being checked." },
+			ownerWords: { type: "array", items: { type: "string" }, description: "File paths to the owner's own words, so a checker can weigh the claim against what was actually asked." },
+			files: { type: "array", items: { type: "string" }, description: "File paths the claim is about." }
+		},
+		["cardDir", "claim"],
+		async ({ cardDir, claim, ownerWords, files }) =>

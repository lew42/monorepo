+++ b/Server/check.mjs
@@ -0,0 +1,117 @@
+/* `node Server/check.mjs <cardDir> <claim> [--owner-words <file>[,<file>]] [--files <file,file>]`
+ * A cheap sanity check by default: 2 fresh Servex agents, from different model families where
+ * possible, read ONLY the claim, the owner's own words and the files it names — never the
+ * caller's reasoning or the conversation that produced the claim — and say whether they agree
+ * or doubt it, and what the alternative might be. Today the two families are Claude's own
+ * Haiku and Sonnet; OpenRouter adds more families once harness step 2 lands (see `CHECKERS`).
+ *
+ * Spawn pattern copied from `Server/review.mjs`'s `mcp()` (fresh eyes: `spawn_agent` ->
+ * `wait_for_agent` -> `stop_agent` over the loopback MCP at http://127.0.0.1:8090/mcp) — not
+ * imported, since review.mjs is a script, not a library. Every child process this file might
+ * spawn sets `windowsHide: true`; today it spawns none directly, only over MCP `fetch`.
+ *
+ * Never throws: a Servex problem for one checker becomes `{"verdict":"doubt", "why":
+ * "checker failed to run: <msg>"}` for that checker, not a crash of the whole check.
+ *
+ * Design: /framework/ai/2026/09/28/agent-work-on-every-page-sanity-checks-c/design.md (④). */
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const MCP = "http://127.0.0.1:8090/mcp";
+// The repo THIS copy of check.mjs lives in — a worktree carries its own copy of Server/, so this
+// is never assumed to be wherever Servex's own process happens to be running.
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+
+// Today's two families. OpenRouter adds more families once harness step 2 lands.
+const CHECKERS = [
+	{ model: "claude-haiku-4-5-20251001" },
+	{ model: "claude-sonnet-5" }
+];
+
+const now = () => { const d = new Date(), o = -d.getTimezoneOffset(), p = n => String(Math.floor(Math.abs(n))).padStart(2, "0"); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}${o < 0 ? "-" : "+"}${p(o / 60)}:${p(o % 60)}`; };
+
+function appendJSON(file, obj) {
+	let lead = ""; try { const b = fs.readFileSync(file); if (b.length && b.at(-1) !== 10) lead = "\n"; } catch {}
+	fs.appendFileSync(file, lead + JSON.stringify(obj) + "\n");
+}
+
+async function mcp(name, args, ms = 30000) {
+	const r = await fetch(MCP, { method: "POST", headers: { "content-type": "application/json", accept: "application/json, text/event-stream" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name, arguments: args } }), signal: AbortSignal.timeout(ms) });
+	const j = await r.json();
+	const text = j.result?.content?.[0]?.text ?? j.error?.message ?? "";
+	try { return JSON.parse(text); } catch { return { raw: text }; }
+}
+
+function buildPrompt(claim, ownerWords, files) {
+	const read = [...ownerWords, ...files];
+	return `You are a fresh checker: you have never seen the reasoning or conversation behind this claim, only the files below. Repo root: ${ROOT.replaceAll("\\", "/")}.\n\n`
+		+ (read.length ? `Read: ${read.join(", ")}.\n\n` : "")
+		+ `Claim being checked: ${claim}\n\n`
+		+ `Could this be wrong? What is a real alternative? Then decide.\n\n`
+		+ `Answer in 5 lines at most. The first line must be exactly "verdict: agree" or "verdict: doubt" — nothing else on that line. The rest is your reasoning, in plain sentences.`;
+}
+
+// A checker's raw reply -> {model, verdict, why}. The first line decides; everything after is "why".
+function parseVerdict(model, text) {
+	const rows = String(text ?? "").split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+	const first = rows[0] ?? "";
+	const verdict = /^verdict:\s*agree\b/i.test(first) ? "agree" : "doubt";
+	const rest = rows.slice(1).join(" ").trim();
+	const why = rest || (/^verdict:\s*(agree|doubt)\b/i.test(first) ? "" : "no parseable verdict line — treated as doubt");
+	return { model, verdict, why };
+}
+
+async function askChecker(model, claim, ownerWords, files) {
+	const prompt = buildPrompt(claim, ownerWords, files);
+	try {
+		// allowed_tools: ["Read"] only — a job that is always "read these named files, then answer
+		// in 5 lines" never needs Bash, Edit, Agent or any MCP server, and omitting allowed_tools
+		// hands the checker the CLI's whole default toolset for nothing. ⚠ Measured: this repo's
+		// own CLAUDE.md + skill-listing preamble is paid on every spawn regardless, so a real
+		// two-checker run still landed near $0.18, well over the $0.01 target — see check.md's
+		// "Watch out" and this task's own log for the number and the open question about it.
+		const spawned = await mcp("spawn_agent", { role: "checker", name: `check-${model.replace(/[^a-z0-9]+/gi, "-")}`, prompt, model, effort: "low", permission_mode: "bypassPermissions", cwd: ROOT, allowed_tools: ["Read"] });
+		if (!spawned.id) throw new Error(spawned.raw || spawned.why || "spawn_agent did not return an id");
+		const waited = await mcp("wait_for_agent", { id: spawned.id, timeout_s: 180 }, 190000);
+		await mcp("stop_agent", { id: spawned.id }, 20000);
+		return { ...parseVerdict(model, waited.words), cost: waited.cost ?? 0 };
+	} catch (e) {
+		return { model, verdict: "doubt", why: `checker failed to run: ${String(e?.message || e).slice(0, 200)}`, cost: 0 };
+	}
+}
+
+/* `"✓✓"` when both checkers agree, `"✓?"` when they split or either doubts — what a card shows. */
+export function chip(verdicts) {
+	return verdicts.length && verdicts.every(v => v.verdict === "agree") ? "✓✓" : "✓?";
+}
+
+/* `claim`: the one sentence being checked. `context`: `{ownerWords: [file paths], files: [file
+ * paths the claim is about], cardDir: the card's directory}`. Appends one `{"check":…}` line to
+ * `<cardDir>/task.jsonl` when `cardDir` is given, and returns `{verdicts, cost, chip}`. */
+export async function check(claim, context = {}) {
+	const { ownerWords = [], files = [], cardDir } = context;
+	const results = await Promise.all(CHECKERS.map(c => askChecker(c.model, claim, ownerWords, files)));
+	const verdicts = results.map(({ model, verdict, why }) => ({ model, verdict, why }));
+	const cost = results.reduce((sum, r) => sum + (r.cost || 0), 0);
+	if (cardDir) appendJSON(path.join(cardDir, "task.jsonl"), { check: { at: now(), claim, verdicts, cost } });
+	return { verdicts, cost, chip: chip(verdicts) };
+}
+
+async function main() {
+	const argv = process.argv.slice(2);
+	const flag = name => { const i = argv.indexOf(name); if (i < 0) return undefined; const [, v] = argv.splice(i, 2); return v; };
+	const ownerWordsArg = flag("--owner-words"), filesArg = flag("--files");
+	const [cardDirArg, claim] = argv;
+	if (!cardDirArg || !claim) { console.error('usage: node Server/check.mjs <cardDir> <claim> [--owner-words <file>[,<file>]] [--files <file,file>]'); process.exit(1); }
+	const result = await check(claim, {
+		cardDir: path.resolve(cardDirArg),
+		ownerWords: ownerWordsArg ? ownerWordsArg.split(",").filter(Boolean) : [],
+		files: filesArg ? filesArg.split(",").filter(Boolean) : []
+	});
+	console.log(JSON.stringify(result, null, 2));
+	console.log(result.chip);
+}
+
+const isMain = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+if (isMain) main().catch(e => { console.error(String(e?.stack || e)); process.exitCode = 1; });
diff --git a/Server/consensus.mjs b/Server/consensus.mjs
new file mode 100644
index 00000000..75f2f799
--- /dev/null
+++ b/Server/consensus.mjs
@@ -0,0 +1,127 @@
+/* `node Server/consensus.mjs <cardDir> "<question>" "<option1>" "<option2>" ...`
+ * When a check's checkers disagree, or the truth is just unclear: 5 models at 3 price levels
+ * vote on an open question, and the tally shows on the card. Today the roster is Claude's own
+ * tiers — 2x Haiku-tier, 2x Sonnet-tier, 1x Opus-tier — kept in one small `VOTERS` array so
+ * swapping to OpenRouter (its own models, chosen from one config table with prices) once harness
+ * step 2 lands is a one-array edit, not a rewrite.
+ *
+ * Spawn pattern copied from `Server/review.mjs`'s `mcp()`, same as `Server/check.mjs` — not
+ * imported, since review.mjs is a script, not a library.
+ *
+ * Never throws: a Servex problem for one voter becomes a `{"pick": "(no vote)", "caveat": "voter
+ * failed to run: <msg>"}` row for that voter, not a crash of the whole consensus.
+ *
+ * The `Vote` shape (`member`, `pick`, `caveat`) is the design's own — a favourite option plus the
+ * one improvement that voter would add to the winner, not a free-form "why".
+ *
+ * Design: /framework/ai/2026/09/28/agent-work-on-every-page-sanity-checks-c/design.md (⑤, and the
+ * "Added" section's `Vote` row). */
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const MCP = "http://127.0.0.1:8090/mcp";
+// The repo THIS copy of consensus.mjs lives in — same reasoning as check.mjs's ROOT.
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+
+// Today's 5-member roster at 3 price levels. `member` is the Vote's own id (the design's `Member`
+// object has an id distinct from its model). OpenRouter replaces this with a priced config table
+// once harness step 2 lands — swap the array, nothing else in this file changes.
+export const VOTERS = [
+	{ member: "haiku-1", model: "claude-haiku-4-5-20251001", tier: "cheap" },
+	{ member: "haiku-2", model: "claude-haiku-4-5-20251001", tier: "cheap" },
+	{ member: "sonnet-1", model: "claude-sonnet-5", tier: "mid" },
+	{ member: "sonnet-2", model: "claude-sonnet-5", tier: "mid" },
+	{ member: "opus-1", model: "claude-opus-5-5", tier: "premium" }
+];
+
+const now = () => { const d = new Date(), o = -d.getTimezoneOffset(), p = n => String(Math.floor(Math.abs(n))).padStart(2, "0"); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}${o < 0 ? "-" : "+"}${p(o / 60)}:${p(o % 60)}`; };
+
+function appendJSON(file, obj) {
+	let lead = ""; try { const b = fs.readFileSync(file); if (b.length && b.at(-1) !== 10) lead = "\n"; } catch {}
+	fs.appendFileSync(file, lead + JSON.stringify(obj) + "\n");
+}
+
+async function mcp(name, args, ms = 30000) {
+	const r = await fetch(MCP, { method: "POST", headers: { "content-type": "application/json", accept: "application/json, text/event-stream" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name, arguments: args } }), signal: AbortSignal.timeout(ms) });
+	const j = await r.json();
+	const text = j.result?.content?.[0]?.text ?? j.error?.message ?? "";
+	try { return JSON.parse(text); } catch { return { raw: text }; }
+}
+
+function buildPrompt(question, options) {
+	return `Question: ${question}\n\nOptions:\n${options.map((o, i) => `${i + 1}. ${o}`).join("\n")}\n\n`
+		+ `Pick exactly one favourite option. Answer in 2 lines: the first line exactly "pick: <option>"`
+		+ ` (copy the option text exactly, nothing else on that line), the second line "caveat: <text>" —`
+		+ ` the one improvement you'd want added if a DIFFERENT option won instead of yours.`;
+}
+
+// A voter's raw reply -> {member, pick, caveat}. `pick` is matched back to one of `options`
+// (case-insensitive, exact first, then a loose contains); an unmatched pick is kept as said so
+// nothing is silently dropped, but never tallied.
+function parseVote(member, text, options) {
+	const rows = String(text ?? "").split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+	const m = /^pick:\s*(.+)$/i.exec(rows[0] ?? "");
+	const said = (m ? m[1] : "").trim();
+	const pick = options.find(o => o.toLowerCase() === said.toLowerCase())
+		?? options.find(o => said && said.toLowerCase().includes(o.toLowerCase()))
+		?? (said || "(no vote)");
+	const caveatLine = rows.slice(1).join(" ").trim();
+	const caveat = caveatLine.replace(/^caveat:\s*/i, "") || (m ? "" : "no parseable pick line");
+	return { member, pick, caveat };
+}
+
+async function askVoter(member, model, question, options) {
+	const prompt = buildPrompt(question, options);
+	try {
+		// allowed_tools: [] — a voter sees the whole question and options in its prompt, reads no
+		// file, so the default full toolset (Bash, Edit, Agent, every MCP server…) would be pure
+		// overhead here. ⚠ Measured: it did NOT bring the cost down much — a real 5-voter run still
+		// lands near $0.47, over the $0.05 target, because this repo's own CLAUDE.md + skill-listing
+		// preamble is paid on every spawn regardless of allowed_tools. See check.md's "Watch out".
+		const spawned = await mcp("spawn_agent", { role: "voter", name: `vote-${member}`, prompt, model, effort: "low", permission_mode: "bypassPermissions", cwd: ROOT, allowed_tools: [] });
+		if (!spawned.id) throw new Error(spawned.raw || spawned.why || "spawn_agent did not return an id");
+		const waited = await mcp("wait_for_agent", { id: spawned.id, timeout_s: 180 }, 190000);
+		await mcp("stop_agent", { id: spawned.id }, 20000);
+		return { ...parseVote(member, waited.words, options), cost: waited.cost ?? 0 };
+	} catch (e) {
+		return { member, pick: "(no vote)", caveat: `voter failed to run: ${String(e?.message || e).slice(0, 200)}`, cost: 0 };
+	}
+}
+
+function tally(votes, options) {
+	const t = Object.fromEntries(options.map(o => [o, 0]));
+	for (const v of votes) if (t[v.pick] !== undefined) t[v.pick]++;
+	return t;
+}
+
+/* `question`: the open question. `options`: the list of choices (strings). Returns
+ * `{votes, tally, cost}` — no card write here, since this function's own shape carries no
+ * `cardDir` (see `appendConsensus` below for that, used by the CLI and the Servex tool). */
+export async function consensus(question, options) {
+	const results = await Promise.all(VOTERS.map(v => askVoter(v.member, v.model, question, options)));
+	const votes = results.map(({ member, pick, caveat }) => ({ member, pick, caveat }));
+	const cost = results.reduce((sum, r) => sum + (r.cost || 0), 0);
+	return { votes, tally: tally(votes, options), cost };
+}
+
+/* Appends `{"consensus":{at, question, options, votes, tally, cost}}` to `<cardDir>/task.jsonl`
+ * — same append style as `check()`. Kept separate from `consensus()` because `consensus()`'s own
+ * signature (spec'd as `(question, options)`) carries no `cardDir`; both the CLI below and the
+ * Servex `consensus` tool call this after `consensus()` resolves. */
+export function appendConsensus(cardDir, question, options, result) {
+	appendJSON(path.join(cardDir, "task.jsonl"), { consensus: { at: now(), question, options, votes: result.votes, tally: result.tally, cost: result.cost } });
+}
+
+async function main() {
+	const [cardDirArg, question, ...options] = process.argv.slice(2);
+	if (!cardDirArg || !question || !options.length) { console.error('usage: node Server/consensus.mjs <cardDir> "<question>" "<option1>" "<option2>" ...'); process.exit(1); }
+	const cardDir = path.resolve(cardDirArg);
+	const result = await consensus(question, options);
+	appendConsensus(cardDir, question, options, result);
+	console.log(JSON.stringify(result, null, 2));
+	console.log(JSON.stringify(result.tally));
+}
+
+const isMain = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+if (isMain) main().catch(e => { console.error(String(e?.stack || e)); process.exitCode = 1; });

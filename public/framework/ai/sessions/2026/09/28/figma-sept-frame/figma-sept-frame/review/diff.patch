+/* Card 5 — 2-Col: Sidebar + Content. A scaled recreation, not a reflowed one —
+   see the note at the top of view.js for why. Every number below is an `em`,
+   converted from the Figma's own pixels at its 856px canvas (16px = 1em there),
+   so `.figma-panel`'s own font-size (set from the container's width) carries
+   every size in this file down or up together. */
+@layer site {
+
+	.figma-scale { container-type: inline-size; }
+
+	.figma-panel {
+		font-size: clamp(7px, calc(100cqi / 53.5), 16px);
+		border-radius: 0.5em;
+		padding: 2.25em 2em;   /* 36px / 32px at the Figma's own width */
+	}
+
+	.figma-widget {
+		display: grid;
+		grid-template-columns: 33% 1fr;   /* the Figma's 280:576 sidebar/content split */
+		border-radius: 0.5em;
+		overflow: hidden;
+		border: 1px solid var(--line);
+		font-size: 1em;
+	}
+
+	.figma-sidebar {
+		display: flex;
+		flex-direction: column;
+		background: var(--prim);

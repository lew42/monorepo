+++ b/public/framework/ai/2026/09/28/figma-sept-2026/6-ui-controls/view.js
@@ -0,0 +1,100 @@
+import { View, div, span, label, input, img } from "/app.js";
+
+// Recreation of the Figma section "UI Controls" — four little galleries: toggles,
+// chips, three separately-boxed "Progress & Sliders" groups (metadata.xml really
+// has three, each with its own heading — plain, then darken-2, then a lighter
+// fill), and counter badges.
+//
+// SCALES, does not reflow (mastermind correction, 2026-09-28, same as card 5):
+// `.figma-scale` is a size container and `.figma-panel`'s font-size is set from
+// its own width (100cqi / 53.5 = 16px at the Figma's real 856px), and every
+// padding, gap, radius and font-size below it is `em` — none of the site's own
+// type scale or --gap/--pad tokens, which are viewport- not container-relative.
+View.stylesheet(import.meta, "view.css");
+
+const TOGGLES = [
+	["Dark mode", true],
+	["Notifications", false],
+	["Auto-save", true],
+];
+
+const CHIPS = [
+	["Design", true], ["Tokens", false], ["Variables", true],
+	["Themes", false], ["Mobile", false], ["Adaptive", true],
+];
+
+const BARS = [["Upload", 72], ["Processing", 45]];
+
+const BADGES = [["Inbox", 12], ["Updates", 3], ["Tasks", 28]];
+
+// One toggle: a real checkbox (so it actually flips on a click) hidden under a
+// styled track. `label` already puts a click on the whole row onto the input.
+const toggle = (text, checked) => label.c("figma-toggle", () => {
+	const box = input().attr("type", "checkbox").ac("figma-toggle-input");
+	if (checked) box.attr("checked", "");
+	span.c("figma-toggle-track");
+	span(text);
+});
+
+// One progress row: a label + its percent on one line, then a thin track with a
+// fill sized by the percent.
+const bar = (text, pct) => div.c("figma-bar", () => {
+	div.c("figma-bar-row", () => {
+		span(text);
+		span(pct + "%");
+	});
+	div.c("figma-bar-track", () => div.c("figma-bar-fill").style("width", pct + "%"));
+});
+
+// The two BOXED "Progress & Sliders" groups (one darker, one lighter) — each
+// gets its own sentence-case heading, unlike the section's own small uppercase
+// label above the first, plain group.
+const progress_group = extra => div.c("figma-progress-group " + extra, () => {
+	div.c("figma-progress-title", "Progress & Sliders");
+	BARS.forEach(([text, pct]) => bar(text, pct));
+});
+
+export default class Default extends View {
+
+	render(){
+		div.c("figma-scale", () => {
+			div.c("figma-panel darken-1", () => {
+
+				div.c("figma-title", "UI Controls");
+
+				div.c("figma-section", () => {
+					div.c("figma-group-title", "Toggles");
+					div.c("figma-toggles", () => TOGGLES.forEach(([text, on]) => toggle(text, on)));
+				});
+
+				div.c("figma-section", () => {
+					div.c("figma-group-title", "Tags & Chips");
+					div.c("figma-chips", () => CHIPS.forEach(([text, accent]) =>
+						span.c("figma-chip" + (accent ? " accent" : ""), text)));
+				});
+
+				div.c("figma-section figma-progress-section", () => {
+					div.c("figma-group-title", "Progress & Sliders");
+					BARS.forEach(([text, pct]) => bar(text, pct));
+					progress_group("dark");
+					progress_group("light");
+				});
+
+				div.c("figma-section", () => {
+					div.c("figma-group-title", "Badges & Counters");
+					div.c("figma-badges", () => BADGES.forEach(([text, count]) =>
+						div.c("figma-badge", () => {
+							span(text);
+							span.c("figma-count", String(count));
+						})));
+				});
+			});
+		});
+
+		div.c("figma-compare", () => {
+			div.c("figma-compare-label", "Figma");
+			img().attr("src", new URL("figma.png", import.meta.url).href)
+				.attr("alt", "Figma section 6").style("maxWidth", "100%");
+		});
+	}
+}
diff --git a/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/ai.css b/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/ai.css

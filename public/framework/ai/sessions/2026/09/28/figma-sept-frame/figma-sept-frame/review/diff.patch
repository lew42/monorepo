+/* Figma "Typography" section — the one rounded darken panel every section
+   sits in, tight 36px rhythm (the Figma spec's own gap, not the page's
+   fluid --flow), and a dark-ink/accent-text chip instead of the site's
+   orange pill badge. Scoped to this card's root so nothing here leaks. */
+@layer site {
+	.figma-typography .figma-panel {
+		border-radius: var(--radius);
+		padding: 2.25em 2em;   /* 36px / 32px at the root size */
+	}
+
+	/* The Figma frame's own gap (36px) read cramped at the site's own type
+	   scale, which runs smaller — ~0.6x (20px) reads the same, and the
+	   links row keeps its own slightly bigger gap above it (24px), same
+	   as the Figma. Flat, not `--flow`: that scales with font-size and the
+	   viewport, and measured 2-3x too tall here. */
+	.figma-typography .figma-panel > * + * { margin-top: 20px; }
+	.figma-typography .figma-panel > :first-child { margin-top: 0; }
+	.figma-typography .figma-panel > .figma-links { margin-top: 24px; }
+	.figma-typography .figma-panel h1,
+	.figma-typography .figma-panel h2,
+	.figma-typography .figma-panel h3,
+	.figma-typography .figma-panel h4,
+	.figma-typography .figma-panel p { margin: 0; }
+
+	/* A dark ink box, small radius, accent uppercase text — not `.ui-pill`'s
+	   fully-rounded orange fill. */
+	.figma-typography .figma-chip {
+		display: inline-block;
+		background: var(--bg);
+		color: var(--prim);
+		font-size: 0.8em;
+		font-weight: 700;
+		letter-spacing: 0.05em;
+		text-transform: uppercase;
+		border-radius: 0.375em;
+		padding: 0.4em 0.75em;
+	}
+
+	/* `flex-wrap` so a narrow card wraps to a SECOND ROW, never inside one
+	   link's own text — `white-space: nowrap` is what stops "Learn more"
+	   breaking into "Learn" / "more" when the row itself has no room left. */
+	.figma-typography .figma-links {
+		flex-wrap: wrap;
+		gap: 16px;
+	}
+	.figma-typography .figma-links .figma-link {
+		color: var(--ink);
+		font-weight: 600;
+		white-space: nowrap;
+		text-decoration-line: underline;
+		text-decoration-color: var(--prim);
+		text-decoration-thickness: 0.2em;
+		text-underline-offset: 0.2em;
+	}
+
+	.figma-typography .figma-compare {
+		margin-top: var(--flow);
+		padding-top: var(--gap);
+	}
+	.figma-typography .figma-compare img { border-radius: var(--radius); }
+}

index 00000000..3c720661
--- /dev/null
+++ b/public/framework/ai/2026/09/28/figma-sept-2026/4-2-col-pricing/view.css
@@ -0,0 +1,95 @@
+/* Figma's "2-Col: Pricing" section (metadata.xml, frame 17:1051) has NO panel
+ * behind the two plan cards — just the cards themselves, side by side, on
+ * the page's own background. Every measurement below comes straight off
+ * metadata.xml at the Figma frame's own 856px width (padding 32, card gap
+ * 24, row gap 16 — all multiples of the 16px body size), turned into `em`
+ * against `.figma-pricing-scale`'s own font-size instead of pixels, so the
+ * SAME numbers hold true at any width: `container-type: inline-size` on the
+ * root (`.figma-pricing`, which `classify()` already stamps on this view's
+ * own element) makes `cqi` mean "percent of THIS card's width", and
+ * `font-size: clamp(7px, calc(100cqi / 53.5), 16px)` is 16px exactly when
+ * the card is 856px wide (856 / 53.5 = 16) and shrinks below that — so a
+ * narrow AI 2 column gets the Figma proportions at a smaller size instead
+ * of the Figma pixels wrapping.
+ *
+ * ⚠ Every child uses a flex `gap`, not individual margins — Figma's five
+ * internal gaps (label→price, price→"per month", →divider, →checklist,
+ * →button) are ALL 16px, i.e. all exactly 1em, so one `gap: 1em` on the
+ * plan's own flex column reproduces every one of them with no per-element
+ * number to keep in sync. */
+@layer site {
+
+	.figma-pricing { container-type: inline-size; }
+
+	.figma-pricing-scale {
+		font-size: clamp(7px, calc(100cqi / 53.5), 16px);
+	}
+
+	.figma-pricing-grid {
+		display: grid;
+		grid-template-columns: 1fr 1fr;
+		gap: 1.5em;   /* 24px at 16px */
+	}
+
+	.figma-plan {
+		display: flex;
+		flex-direction: column;
+		gap: 1em;   /* 16px — every internal Figma gap, at once */
+		padding: 2em;   /* 32px */
+		border-radius: var(--radius);
+		background: var(--surface);
+		color: var(--ink);
+		border: 1px solid var(--line);
+	}
+	.figma-plan.figma-plan-dark {
+		background: var(--ink);
+		color: var(--surface);
+		border-color: var(--ink);
+	}
+
+	.figma-plan-label {
+		font-size: 0.875em;   /* 14px */
+		font-weight: 700;
+		letter-spacing: 0.08em;
+		text-transform: uppercase;
+		color: var(--prim);
+	}
+
+	.figma-plan-price {
+		font-size: 3em;   /* 48px */
+		font-weight: 900;
+		line-height: 1;
+	}
+
+	.figma-plan-sub { font-size: 1em; opacity: 0.7; }
+
+	.figma-plan hr {
+		border: none;
+		border-top: 1px solid color-mix(in oklab, currentColor 20%, transparent);
+		width: 100%;
+	}
+
+	/* [check][text], two real grid columns, so a line long enough to wrap
+	   ("Unlimited projects" at the narrowest width) wraps under its OWN
+	   text instead of under the checkmark. */
+	.figma-plan-features {
+		display: grid;
+		grid-template-columns: auto 1fr;
+		align-items: start;
+		column-gap: 0.625em;   /* 10px */
+		row-gap: 1em;   /* 16px, same unit as everything else */
+		font-size: 1em;
+	}
+	.figma-plan-check { color: var(--prim); }
+
+	.figma-plan button.prim {
+		display: block;
+		width: 100%;
+		font-size: 0.875em;   /* 14px */
+		text-transform: uppercase;
+		font-weight: 700;
+		letter-spacing: 0.04em;
+		padding: 0.9em 1em;
+		white-space: nowrap;
+	}
+}
diff --git a/public/framework/ai/2026/09/28/figma-sept-2026/4-2-col-pricing/view.js b/public/framework/ai/2026/09/28/figma-sept-2026/4-2-col-pricing/view.js
new file mode 100644
index 00000000..b769aebc
--- /dev/null
+++ b/public/framework/ai/2026/09/28/figma-sept-2026/4-2-col-pricing/view.js
@@ -0,0 +1,56 @@
+import { View, div, span, hr, button, img, icon } from "/app.js";
+
+View.stylesheet(import.meta, "view.css");
+
+/* Figma "2-Col: Pricing" section (metadata.xml, frame 17:1051): two plan
+ * cards, Starter (light) and Pro (dark, the "highlighted" plan), each an
+ * eyebrow label, a big price, "per month", a divider, a checklist and a
+ * full-width CTA — no panel behind them, straight on the page.
+ *
+ * Every size in view.css is `em` against `.figma-pricing-scale`'s own
+ * `font-size: clamp(...)`, which reads `cqi` off `.figma-pricing`'s
+ * `container-type: inline-size` — the Figma layout (two cards, one line
+ * per feature, one line on the button) at ANY width, not just 1920, because
+ * the numbers are all relative to the card's own size instead of pixels.
+ * `classify()` (core/View/View.js) already stamps this instance's own
+ * element `.figma-pricing` from the class name, which is what makes it the
+ * container query's root with no extra wrapper needed. */
+const PLANS = [
+	{ name: "Starter", price: "$9", features: ["5 projects", "10GB storage", "Email support"], dark: false },
+	{ name: "Pro", price: "$29", features: ["Unlimited projects", "100GB storage", "Priority support", "Custom domains", "API access"], dark: true },
+];
+
+export default class FigmaPricingView extends View {
+
+	render(){
+		div.c("figma-pricing-scale", () => {
+			div.c("figma-pricing-grid", () => PLANS.forEach(plan => this.plan(plan)));
+		});
+
+		div.c("flex v gap", () => {
+			div.c("h4 muted", "Figma");
+			img().attr("src", new URL("figma.png", import.meta.url).href).style({ maxWidth: "100%", borderRadius: "var(--radius)" });
+		}).style({ "--gap": "calc(var(--gap) * 0.3)", marginTop: "1em" });
+	}
+
+	plan(plan){
+		div.c("figma-plan" + (plan.dark ? " figma-plan-dark" : ""), () => {
+			div.c("figma-plan-label", plan.name);
+			div.c("figma-plan-price", plan.price);
+			span.c("figma-plan-sub", "per month");
+			hr();
+			div.c("figma-plan-features", () => plan.features.forEach(text => {
+				icon("check").ac("figma-plan-check");
+				span(text);
+			}));
+			button.c("prim", "Choose Plan").click(() => this.choose(plan));
+		});
+	}
+
+	// Nothing persists — a status line under the card it was clicked on is the
+	// whole "it works" proof the brief asks for.
+	choose(plan){
+		if (this.$chosen) this.$chosen.remove();
+		this.$chosen = div.c("h4 muted", `${plan.name} chosen — nothing saved.`).append_to(this.el);
+	}
+}

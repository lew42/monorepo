diff --git a/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.css b/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.css
new file mode 100644
index 00000000..5b6a679c
--- /dev/null
+++ b/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.css
@@ -0,0 +1,262 @@
+/* Figma "Task management" section (nodes 78:13556, 78:13559, 78:13653): the
+ * plain intro, then TWO separate rounded panels — "Task cards and progress"
+ * and "Timeline preview" — matching how the Figma frame itself draws two
+ * distinct grey bands rather than one.
+ *
+ * SCALE, DON'T REFLOW. The Figma frame is 856px wide; this card's own column
+ * is ~400px. Rather than stack every row into one tall column at full size,
+ * `.figma-scale` is a query container and `.figma-root`'s font-size is
+ * `clamp(7px, 100cqi / 53.5, 16px)` — 16px exactly when the container is
+ * 856px wide (856 / 16 = 53.5), shrinking below that. Every size after this
+ * point is `em`, off that one number, so the two-up cards, the three-up
+ * progress row and the timeline grid keep the Figma's proportions at any
+ * width instead of the site's own `--gap`/`--pad`/flow rhythm (sized for a
+ * full page, not a 400px card) blowing the layout out to one long column.
+ */
+@layer site {
+
+	.figma-scale { container-type: inline-size; }
+
+	.figma-root {
+		font-size: clamp(7px, calc(100cqi / 53.5), 16px);
+		display: flex;
+		flex-direction: column;
+		gap: 1.25em;
+	}
+
+	.figma-intro { text-align: center; display: flex; flex-direction: column; gap: 0.5em; }
+	.figma-intro h2 { margin: 0; font-size: 2em; }
+	.figma-intro p { margin: 0; font-size: 0.9em; }
+
+	.figma-panel {
+		padding: 1.5em 1.25em;
+		border-radius: 0.5em;
+		display: flex;
+		flex-direction: column;
+		gap: 1em;
+	}
+
+	.figma-group { display: flex; flex-direction: column; gap: 0.75em; }
+	.figma-label { font-size: 0.75em; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); }
+	.figma-label.muted { color: color-mix(in srgb, currentColor 75%, transparent); }
+	.figma-caption { font-size: 0.75em; margin: 0; }
+	.figma-desc { margin: 0; font-size: 0.9em; }
+
+	/* The eyebrow chip — "a dark ink box with accent text", not a coloured
+	   pill: background and text both come from tokens the theme already
+	   guarantees read against each other. */
+	.figma-chip {
+		display: inline-block;
+		align-self: flex-start;
+		padding: 0.35em 0.7em;
+		border-radius: 0.3em;
+		background: var(--ink);
+		color: var(--prim);
+		font-weight: 700;
+		font-size: 0.85em;
+		letter-spacing: 0.08em;
+		text-transform: uppercase;
+	}
+
+	.figma-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5em; }
+	.figma-row-tight { display: flex; align-items: center; gap: 0.4em; font-size: 0.9em; }
+
+	/* Two fixed-width columns in the Figma (330 / 450) become an auto-fit
+	   grid: two up once the panel is wide enough for both, one column below
+	   that — proportion, not a breakpoint. */
+	.figma-cards, .figma-progress-row {
+		display: grid;
+		grid-template-columns: repeat(auto-fit, minmax(9em, 1fr));
+		gap: 0.9em;
+	}
+	.figma-card-col { display: flex; flex-direction: column; gap: 0.4em; }
+	.figma-card-col-wide { grid-column: span 1; }
+
+	/* No font-size shrink on this box or any container below it — the one
+	   `.figma-root` clamp already carries the whole-panel scale, and
+	   stacking a second, third and fourth local shrink on top of it (one
+	   round of this drove avatars and icons down to a couple of px, reading
+	   as broken tiny glyphs) is the bug a mastermind review caught. Text
+	   hierarchy comes from each element's own em class instead. */
+	.figma-card-box {
+		background: var(--surface);
+		color: var(--ink);
+		border: 1px solid var(--line);
+		border-radius: 0.4em;
+		padding: 0.9em;
+		display: flex;
+		flex-direction: column;
+		gap: 0.6em;
+	}
+	.figma-card-title { font-weight: 700; }
+
+	.figma-badge {
+		display: inline-block;
+		padding: 0.2em 0.6em;
+		border-radius: 999px;
+		font-size: 0.75em;
+		font-weight: 700;
+		letter-spacing: 0.03em;
+		text-transform: uppercase;
+	}
+	/* Two small named hues beyond the one accent: the Figma's own "today"
+	   (accent) and "feature" (a light violet chip) badges read apart on
+	   sight, which is the job this one pair of colours is doing — local to
+	   this one card, not a new sitewide token (same reasoning as the
+	   timeline's agent-identity colours below). */
+	.figma-badge.accent { background: var(--prim); color: var(--surface); }
+	.figma-badge.feature { background: #ede9fe; color: #7c3aed; }
+
+	.figma-sub-tasks { display: flex; flex-direction: column; gap: 0.4em; }
+
+	/* Plain circles, not the icon font — a checkbox this small (this whole
+	   card is drawn at a fraction of full size) made "check_circle" and
+	   "radio_button_unchecked" render as unrecognisable square specks. */
+	.figma-marker {
+		width: 1em;
+		height: 1em;
+		border-radius: 999px;
+		border: 2px solid var(--line);
+		flex: 0 0 auto;
+		display: inline-flex;
+		align-items: center;
+		justify-content: center;
+	}
+	.figma-marker.done {
+		background: #2fa86a;
+		border-color: #2fa86a;
+	}
+	.figma-marker.done::after {
+		content: "✓";
+		color: #fff;
+		font-size: 0.6em;
+		line-height: 1;
+	}
+	.figma-done-label { color: color-mix(in srgb, currentColor 65%, transparent); text-decoration: line-through; }
+
+	.figma-path { display: flex; align-items: center; gap: 0.35em; font-size: 0.8em; }
+	.figma-path .icon { font-size: 1em; }
+	.figma-avatars { display: flex; }
+	/* Same size as the timeline's own avatars (`--avatar: 1.6em`, no local
+	   font-size). The earlier `font-size: 0.6em` here computed the avatar's
+	   OWN em box against its OWN now-smaller font, so 1.6em came out to a
+	   7px dot instead of 1.6em of the ambient text — the double-shrink bug
+	   a mastermind review caught a second time. */
+	.figma-avatars .ui-avatar { --avatar: 1.6em; border: 2px solid var(--surface); }
+	.figma-avatars .ui-avatar:not(:first-child) { margin-inline-start: -0.5em; }
+
+	/* Agent-identity colours: fixed hues so people/agents read apart at a
+	   glance, the same job the source file's own coloured dots do. The
+	   design system has one accent (`--prim`); these are local to this one
+	   card, not a new sitewide token. */
+	.figma-avatar-purple { background: #8b5cf6; color: #fff; }
+	.figma-avatar-green { background: #2fa86a; color: #fff; }
+	.figma-avatar-orange { background: #e08a3c; color: #fff; }
+	.figma-avatar-blue { background: #4a90e2; color: #fff; }
+
+	/* Migration bar: a plain two-div track/fill instead of the native
+	   `<progress>` — a light grey track with an accent fill, guaranteed
+	   rather than left to each browser's own UA styling. */
+	.figma-track { width: 100%; height: 0.5em; border-radius: 999px; background: var(--wash); overflow: hidden; }
+	.figma-track-fill { height: 100%; background: var(--prim); border-radius: 999px; }
+
+	/* Five-step rollout: discrete segments, not one bar — a `<progress>` can
+	   only show "how far", not "which step", so this is plain divs. */
+	.figma-segments { display: flex; gap: 0.25em; }
+	.figma-segment { flex: 1; height: 0.5em; border-radius: 999px; background: var(--wash); }
+	.figma-segment.on-green { background: #2fa86a; }
+	.figma-segment.on-accent { background: var(--prim); }
+
+	/* Milestones: a dot-and-connector row, the same shape as the timeline
+	   component's own rail, drawn horizontally instead of down a column. */
+	.figma-milestones { display: flex; align-items: center; gap: 0; }
+	.figma-milestone {
+		width: 1em;
+		height: 1em;
+		border-radius: 999px;
+		background: var(--surface);
+		border: 2px solid var(--line);
+		flex: 0 0 auto;
+		display: flex;
+		align-items: center;
+		justify-content: center;
+	}
+	.figma-milestone.on { background: var(--prim); border-color: var(--prim); }
+	.figma-milestone.on::after { content: "✓"; color: var(--surface); font-size: 0.6em; line-height: 1; }
+	.figma-connector { flex: 1 1 auto; height: 2px; background: var(--line); }
+	.figma-connector.on { background: var(--prim); }
+
+	/* Timeline preview: the same light `darken-1` panel as the task cards —
+	   the grid itself sits one shade lighter again, in an inset "surface"
+	   box, so it reads apart from the panel around it. */
+	.figma-timeline-inner {
+		background: var(--surface);
+		border-radius: 0.4em;
+		padding: 0.75em;
+	}
+
+	/* A day-grid: quarter-hour rows in a left gutter set the rhythm, a
+	   relatively positioned track to the right places each task card by
+	   its own time (top/height) and Figma x/width (left/width) — the
+	   frame's own proportions, not its pixels. The thin hour lines are ONE
+	   background on the whole grid (not a border per row in just the
+	   gutter column), so they run the full width, under the gutter AND the
+	   track, the way the Figma draws them. */
+	.figma-timeline {
+		display: grid;
+		grid-template-columns: 3em 1fr;
+		gap: 0.5em;
+		background: repeating-linear-gradient(
+			to bottom,
+			var(--line) 0, var(--line) 1px,
+			transparent 1px, transparent 2.6em
+		);
+	}
+	.figma-timeline-grid { display: flex; flex-direction: column; }
+	.figma-timeline-row { height: 2.6em; padding-top: 0.15em; }
+	.figma-time-label { font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 0.75em; }
+
+	.figma-timeline-track { position: relative; }
+	.figma-timeline-card {
+		position: absolute;
+		min-height: 3em;
+		padding: 0.5em 0.6em 0.5em 0.7em;
+		border-radius: 0.3em;
+		background: var(--surface);
+		color: var(--ink);
+		border-inline-start: 3px solid var(--line);
+		box-shadow: 0 1px 4px color-mix(in srgb, black 15%, transparent);
+		display: flex;
+		flex-direction: column;
+		gap: 0.2em;
+		overflow: hidden;
+	}
+	.figma-time-range { font-size: 0.7em; font-weight: 600; }
+	.figma-timeline-avatar {
+		position: absolute;
+		top: 0.4em;
+		inset-inline-end: 0.4em;
+		--avatar: 1.6em;
+	}
+
+	.figma-timeline-card.orange { border-inline-start-color: #e08a3c; }
+	.figma-timeline-card.purple { border-inline-start-color: #8b5cf6; }
+	.figma-timeline-card.green { border-inline-start-color: #2fa86a; }
+	.figma-time-range.orange { color: #c06a1f; }
+	.figma-time-range.purple { color: #7c3aed; }
+	.figma-time-range.green { color: #218a53; }
+
+	.figma-now-line { position: absolute; inset-inline: 0; height: 2px; background: var(--prim); }
+	.figma-now-line::before {
+		content: "";
+		position: absolute;
+		inset-inline-start: -3px;
+		top: -3px;
+		width: 8px;
+		height: 8px;
+		border-radius: 999px;
+		background: var(--prim);
+	}
+
+	.figma-timeline-note { text-align: left; font-size: 0.8em; margin: 0.5em 0 0; }
+}
diff --git a/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.js b/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.js
new file mode 100644
index 00000000..5b17d301
--- /dev/null
+++ b/public/framework/ai/2026/09/28/figma-sept-2026/7-task-management-ai-patterns/view.js
@@ -0,0 +1,224 @@
+import { View, div, span, p, h2, icon } from "/app.js";
+// AI 2 never imports the ui/ tier, so `.ui-avatar` has no rules there unless
+// this file loads them itself (mastermind finding, 2026-09-28) — that
+// missing CSS, not a font/sizing bug, is why the avatars rendered unstyled.
+import "/framework/ui/avatar/avatar.js";
+
+View.stylesheet(import.meta, "view.css");
+
+// The first part of the Figma "Task Management & AI Patterns" section, drawn as
+// live site markup instead of a screenshot: the plain intro, then TWO separate
+// rounded panels — "Task cards and progress" and "Timeline preview" — matching
+// how the Figma frame itself draws them as two distinct grey bands.
+//
+// The card column is only ~400px, a third of the Figma frame's own 856px, so
+// this keeps the Figma's LAYOUT (two-up cards, a three-up progress row, a real
+// time grid) by SCALING instead of re-flowing: a container query sets one
+// font-size for the whole thing (16px at 856px container width, shrinking
+// below that), and every spacing inside is `em` off that one number — never
+// the site's own `--gap`/`--pad`/flow tokens, which are sized for a full
+// page, not a 400px card.
+//
+// Two sibling views ("Details and priority" and "AI feedback patterns") draw
+// the rest of this same card, each its own panel; a separate figma.js (placed
+// last) shows the Figma png for comparison, so the picture is not duplicated
+// three times.
+export default class Default extends View {
+
+	render(){
+		div.c("figma-scale", () => {
+			div.c("figma-root", () => {
+
+				// Section introduction (node 78:13556) — no panel, plain.
+				div.c("figma-intro", () => {
+					h2("Task management");
+					p.c("muted", "Reusable patterns for planning, tracking, prioritizing, and collaborating with agents.");
+				});
+
+				// Panel A: task cards and progress (node 78:13559)
+				div.c("figma-panel darken-1", () => {
+					span.c("figma-chip", "TASK CARDS");
+
+					div.c("figma-cards", () => {
+						this.simple_card();
+						this.complex_card();
+					});
+
+					div.c("figma-group", () => {
+						div.c("figma-label muted", "PROGRESS TREATMENTS");
+						div.c("figma-progress-row", () => {
+							this.step_progress();
+							this.linear_progress();
+							this.milestone_progress();
+						});
+					});
+				});
+
+				// Panel B: timeline preview (node 78:13653) — same light panel.
+				this.timeline_preview();
+			});
+		});
+	}
+
+	simple_card(){
+		div.c("figma-card-col", () => {
+			div.c("figma-label muted", "SIMPLE · DESCRIPTION ONLY");
+			div.c("figma-card-box", () => {
+				div.c("figma-row", () => {
+					span.c("figma-badge accent", "TODAY");
+					icon("more_horiz").ac("muted");
+				});
+				p.c("figma-desc", "Update release notes with the final accessibility fixes.");
+				div.c("figma-row", () => {
+					span.c("figma-path muted", () => {
+						icon("account_tree");
+						span("tasks/release-notes#a18f");
+					});
+					div.c("figma-avatars", () => {
+						span.c("ui-avatar figma-avatar-purple", "AK");
+						span.c("ui-avatar figma-avatar-green", "AI");
+					});
+				});
+			});
+		});
+	}
+
+	complex_card(){
+		const subtasks = [
+			["Map keyboard shortcuts", true],
+			["Build command search", true],
+			["Add recent actions", false],
+			["Run accessibility pass", false],
+		];
+
+		div.c("figma-card-col figma-card-col-wide", () => {
+			div.c("figma-label muted", "COMPLEX · SUB-TASKS");
+			div.c("figma-card-box", () => {
+				div.c("figma-row", () => {
+					div.c("figma-row-tight", () => {
+						span.c("figma-badge feature", "FEATURE");
+						span.c("figma-card-title", "Ship command palette");
+					});
+					span.c("figma-label muted", "2/4");
+				});
+				p.c("figma-desc", "Unify navigation, search, and common actions behind one keyboard-first surface.");
+				div.c("figma-sub-tasks", () => {
+					subtasks.forEach(([label, done]) => div.c("figma-row-tight", () => {
+						span.c(done ? "figma-marker done" : "figma-marker");
+						span.c(done ? "figma-done-label" : "", label);
+					}));
+				});
+				div.c("figma-row", () => {
+					span.c("figma-path muted", () => {
+						icon("account_tree");
+						span("feature/command-menu#c04b");
+					});
+					div.c("figma-avatars", () => {
+						span.c("ui-avatar figma-avatar-orange", "MC");
+						span.c("ui-avatar figma-avatar-green", "AI");
+						span.c("ui-avatar figma-avatar-blue", "JD");
+					});
+				});
+			});
+		});
+	}
+
+	step_progress(){
+		div.c("figma-card-box", () => {
+			div.c("figma-row", () => {
+				span.c("figma-card-title", "Five-step rollout");
+				span.c("figma-label muted", "STEP 3");
+			});
+			div.c("figma-segments", () => {
+				["green", "green", "accent", "", ""].forEach(tone => div.c(tone ? `figma-segment on-${tone}` : "figma-segment"));
+			});
+			p.c("figma-caption muted", "Review in progress");
+		});
+	}
+
+	linear_progress(){
+		div.c("figma-card-box", () => {
+			div.c("figma-row", () => {
+				span.c("figma-card-title", "Migration");
+				span.c("figma-label muted", "68%");
+			});
+			div.c("figma-track", () => { div.c("figma-track-fill").style("width", "68%"); });
+			p.c("figma-caption muted", "17 of 25 modules");
+		});
+	}
+
+	milestone_progress(){
+		const steps = [true, true, true, false];
+
+		div.c("figma-card-box", () => {
+			span.c("figma-card-title", "Milestones");
+			div.c("figma-milestones", () => {
+				steps.forEach((done, i) => {
+					span.c(done ? "figma-milestone on" : "figma-milestone");
+					if (i < steps.length - 1) div.c(done ? "figma-connector on" : "figma-connector");
+				});
+			});
+			p.c("figma-caption muted", "QA is the final gate");
+		});
+	}
+
+	// A day's worth of quarter-hour rows (09:00–11:00, the Figma's own range) with
+	// three scheduled-task cards placed by time (top/height) AND by column
+	// (left/width, from the Figma's own x/width in its 792px-wide track) —
+	// the frame's own proportions, not its pixels. `tone` is an
+	// agent-identity colour, not a token: the design system has one accent,
+	// so these fixed hues just tell concurrent agents apart, the same job
+	// the source file's own dot colours do.
+	timeline_preview(){
+		const START = 9 * 60, END = 11 * 60;
+		const top = minutes => ((minutes - START) / (END - START)) * 100;
+		const clock = minutes => `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;
+
+		const tasks = [
+			{ start: 9 * 60 + 10, end: 9 * 60 + 40, title: "Triage launch blockers", path: "ops/launch#91d2", who: "MC", tone: "orange", left: 12, width: 29 },
+			{ start: 9 * 60 + 30, end: 10 * 60 + 15, title: "Review command palette", path: "feature/cmd-menu#c04b", who: "AI", tone: "purple", left: 43, width: 31 },
+			{ start: 10 * 60 + 20, end: 10 * 60 + 50, title: "Publish release notes", path: "tasks/notes#a18f", who: "AK", tone: "green", left: 22, width: 32 },
+		];
+
+		div.c("figma-panel darken-1", () => {
+			div.c("figma-row", () => {
+				span.c("figma-chip", "TIMELINE PREVIEW");
+				span.c("figma-path muted", () => {
+					icon("calendar_today");
+					span("Tuesday · 24 Sep");
+				});
+			});
+
+			div.c("figma-timeline-inner", () => {
+				div.c("figma-timeline", () => {
+					div.c("figma-timeline-grid", () => {
+						for (let m = START; m <= END; m += 15) div.c("figma-timeline-row", () => {
+							span.c("figma-label figma-time-label muted", clock(m));
+						});
+					});
+
+					div.c("figma-timeline-track", () => {
+						tasks.forEach(task => div.c(`figma-timeline-card ${task.tone}`, () => {
+							span.c(`figma-time-range ${task.tone}`, `${clock(task.start)}–${clock(task.end)}`);
+							span.c("figma-card-title", task.title);
+							div.c("figma-path muted", () => {
+								icon("account_tree");
+								span(task.path);
+							});
+							span.c(`ui-avatar figma-avatar-${task.tone === "orange" ? "orange" : task.tone === "purple" ? "purple" : "green"} figma-timeline-avatar`, task.who);
+						}).style({
+							top: top(task.start) + "%",
+							height: (top(task.end) - top(task.start)) + "%",
+							insetInlineStart: task.left + "%",
+							width: task.width + "%",
+						}));
+
+						div.c("figma-now-line").style("top", top(10 * 60 + 7) + "%");
+					});
+				});
+			});
+
+			p.c("figma-timeline-note muted", "Fifteen-minute increments reveal sequencing, overlap, and handoff windows at a glance.");
+		});
+	}
+}

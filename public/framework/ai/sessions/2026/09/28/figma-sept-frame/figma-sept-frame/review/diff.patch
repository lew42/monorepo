+/* Figma's "Form Elements" section is one rounded panel: darken-1 for the fill
+   (the .darken-1 utility class carries that), this file for its own padding
+   and the spacing/control sizes Figma draws tighter than the site's default
+   flow rhythm. Kept to what .darken-1/.card/h4 do not already give. */
+@layer site {
+
+	.figma-form-elements {
+		border-radius: var(--radius);
+		padding: 36px 32px;
+	}
+
+	.figma-form-elements .figma-chip { margin-bottom: 24px; }
+
+	.figma-form-elements .figma-field + .figma-field { margin-top: 36px; }
+	.figma-form-elements .figma-field-label { margin-bottom: 12px; }
+
+	.figma-form-elements input,
+	.figma-form-elements textarea {
+		display: block;
+		width: 100%;
+		background: var(--surface);
+		border: 1px solid var(--line);
+		border-radius: var(--radius);
+		padding: 16px 26px;
+		font-size: 16px;
+	}
+
+	.figma-form-elements .figma-actions {
+		display: flex;
+		gap: 12px;
+		margin-top: 36px;
+	}
+
+	/* The site skin stopped giving buttons a shouty voice on 2026-09-06
+	   (lew42.css's own note) — Figma's SUBMIT/CANCEL still want one here. */
+	.figma-form-elements .figma-actions button {
+		text-transform: uppercase;
+		font-weight: 700;
+		letter-spacing: 0.05em;
+		font-size: 0.75em;
+		padding: 0.9em 1.6em;
+	}
+
+	.figma-form-elements .figma-status { margin-top: 12px; }
+}
diff --git a/public/framework/ai/2026/09/28/figma-sept-2026/3-form-elements/view.js b/public/framework/ai/2026/09/28/figma-sept-2026/3-form-elements/view.js
new file mode 100644
index 00000000..f35f887a
--- /dev/null
+++ b/public/framework/ai/2026/09/28/figma-sept-2026/3-form-elements/view.js
@@ -0,0 +1,62 @@
+import { View, div, h4, input, textarea, button, img } from "/app.js";
+
+View.stylesheet(import.meta, "view.css");
+
+/* Figma "Form Elements" section (metadata.xml, frame 43:12819): one rounded
+ * darken panel holding an eyebrow label, three stacked fields — a text input,
+ * an email input, a message textarea — and a two-button row (Submit /
+ * Cancel). Every control is the site's own <input>/<textarea>/<button>;
+ * view.css only adds the panel's own padding and the tight label/field
+ * spacing and small uppercase buttons Figma draws, which framework.css's
+ * general-purpose rhythm does not give for free. "Submit" and "Cancel" work
+ * locally — a status line and a real reset — but nothing persists.
+ *
+ * `classify()` (core/View/View.js) already stamps this instance's own
+ * element with `.figma-form-elements` from the class name — view.css hangs
+ * off that directly, so render() only adds `darken-2` for the panel fill
+ * (measured against the Figma png: its panel is ~14% black on white, which
+ * `darken-2`'s 16% is closer to than `darken-1`'s 8%). */
+export default class FigmaFormElementsView extends View {
+
+	render(){
+		this.ac("darken-2");
+
+		h4("Form Elements").ac("figma-chip").style("color", "var(--prim)");
+
+		this.name_input = this.field("Full Name", () => input().attr("type", "text").attr("value", "Jane Cooper"));
+		this.email_input = this.field("Email", () => input().attr("type", "email").attr("placeholder", "you@example.com"));
+		this.message_input = this.field("Message", () => textarea().attr("placeholder", "Tell us about your project...").attr("rows", "3"));
+
+		div.c("figma-actions", () => {
+			button.c("prim", "Submit").click(() => this.submit());
+			button("Cancel").click(() => this.reset());
+		});
+
+		this.$status = div.c("h4 muted figma-status", "");
+
+		div.c("flex v gap", () => {
+			div.c("h4 muted", "Figma");
+			img().attr("src", new URL("figma.png", import.meta.url).href).style({ maxWidth: "100%", borderRadius: "var(--radius)" });
+		}).style({ "--gap": "calc(var(--gap) * 0.3)", marginTop: "24px" });
+	}
+
+	// One label above one control — the shape ui/field's own template uses,
+	// just without the wrapping <label> (three separate fields, not one).
+	field(text, build){
+		var made;
+		div.c("figma-field", () => { h4.c("figma-field-label muted", text); made = build(); });
+		return made;
+	}
+
+	submit(){
+		const name = this.name_input.el.value.trim() || "(no name)";
+		this.$status.text(`Submitted — ${name}. This demo does not save anything.`);
+	}
+
+	reset(){
+		this.name_input.el.value = "Jane Cooper";
+		this.email_input.el.value = "";
+		this.message_input.el.value = "";
+		this.$status.text("");
+	}
+}

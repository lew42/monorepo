+import { View, div, span, h1, h2, h3, h4, p, a, img } from "/app.js";
+
+View.stylesheet(import.meta, "view.css");
+
+// The "Typography" section of the Figma "Sept 2026" frame, drawn as live site
+// markup — same headings, same body copy, same three links — inside the one
+// rounded darken panel every section sits in. The Figma png sits BELOW the
+// panel, outside it, for comparison.
+export default class Default extends View {
+
+	render(){
+		div.c("figma-typography", () => {
+			div.c("figma-panel darken-1", () => {
+				span.c("figma-chip", "TYPOGRAPHY");
+
+				h1("Heading One");
+				h2("Heading Two");
+				h3("Heading Three");
+				h4("Heading four");
+
+				p("Body text uses the scheme text color, adapting across Light, Dark, Prime, and PrimeInvert without any manual overrides.");
+
+				div.c("figma-links flex", () => {
+					a.c("figma-link", "Learn more").href("#");
+					a.c("figma-link", "Documentation").href("#");
+					a.c("figma-link", "Get started").href("#");
+				});
+			});
+
+			div.c("figma-compare", () => {
+				span.c("h4 muted", "Figma");
+				img().attr("src", new URL("figma.png", import.meta.url).href).attr("alt", "Figma: Typography section");
+			});
+		});
+	}
+}

+
+	.figma-dash-title { font-size: 1.35em; font-weight: 600; margin-bottom: 0.4em; }
+
+	.figma-nav { display: flex; flex-direction: column; gap: 0.2em; }
+
+	.figma-nav-item { padding: 0.6em 0.7em; border-radius: 0.4em; }
+	.figma-nav-item.active { background: var(--lighten-2); font-weight: 600; }
+
+	.figma-user {
+		display: flex;
+		align-items: center;
+		gap: 0.6em;
+		margin-top: auto;
+		padding: 0.6em;
+		border-radius: 0.5em;
+		background: var(--darken-2);
+	}
+
+	.figma-user-avatar {
+		width: 2em; height: 2em;
+		border-radius: 50%;
+		background: var(--ink);
+		flex-shrink: 0;
+	}
+
+	.figma-user-info { display: flex; flex-direction: column; gap: 0.1em; }

+	.figma-content {
+		display: flex;
+		flex-direction: column;
+		gap: 1em;
+		background: var(--surface);
+		color: var(--ink);
+		padding: 1.5em;
+	}
+
+	.figma-content-title { font-size: 1.9em; font-weight: 700; }
+
+	.figma-stats { display: flex; gap: 0.7em; }
+
+	.figma-tile {
+		flex: 1;
+		display: flex;
+		flex-direction: column;
+		gap: 0.3em;
+		background: var(--wash);
+		border-radius: 0.4em;
+		padding: 0.9em;
+	}
+
+	.figma-tile-label {
+		font-size: 0.65em;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.05em;
+		color: var(--subtle);
+	}
+
+	.figma-tile-value { font-size: 1.4em; font-weight: 600; }
+
+	.figma-activity {
+		display: flex;
+		flex-direction: column;
+		gap: 0.6em;
+		background: var(--wash);
+		border-radius: 0.4em;
+		padding: 1em;
+	}
+
+	.figma-activity-title {
+		font-size: 0.65em;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.05em;
+		color: var(--subtle);

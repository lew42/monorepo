new file mode 100644
index 000000000..97b81e990
--- /dev/null
+++ b/Servex/ErrorLine.js
@@ -0,0 +1,40 @@
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import SpawnLog from "./SpawnLog.js";
+
+/* A CAUGHT ERROR GETS A LINE: `{"error":"<message>","where":"Servex/x.js:12", ...}` in the session log of the agent it happened for,
+ * so `git grep '"error":'` finds it beside the work (contract: public/framework/ai/indexing-past-work.md, sections 5 and 6).
+ * Written where a tool call is caught (agents/tools.js server(), MCP.js call()); with no agent it goes to the Servex `errors` log.
+ * Writing never throws: a broken log line must not turn one error into two. */
+export default class ErrorLine {
+	static ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+	static CUT = 500;
+
+	/* The first stack frame inside the repo (not node_modules, not node:internal), as "repo/relative/file.js:line"; null when there is none. */
+	static where(e, root = this.ROOT){
+		for (const raw of String(e?.stack ?? "").split("\n").slice(1)){
+			const m = raw.match(/\(?((?:file:\/\/\/)?[A-Za-z]:[\\/][^():]*|\/[^():]*):(\d+):\d+\)?\s*$/);
+			if (!m) continue;
+			const file = m[1].startsWith("file:") ? fileURLToPath(m[1]) : m[1];
+			const rel = path.relative(root, file);
+			if (!rel || rel.startsWith("..") || path.isAbsolute(rel) || /node_modules/.test(rel)) continue;
+			return `${rel.split(path.sep).join("/")}:${m[2]}`;
+		}
+		return null;
+	}
+
+	/* The line itself: error first (the contract's fixed first key), then where, then whatever the caller adds (tool, agent). */
+	static of(e, extra = {}){
+		return { error: String(e?.message ?? e).slice(0, this.CUT), where: this.where(e), ...extra };
+	}
+
+	/* Write it: into the agent's session log when `who` has a task dir, else the `errors` log. */
+	static note(agents, who, e, extra = {}){
+		try {
+			const line = this.of(e, { ...extra, ...(who ? { agent: who } : {}) });
+			const dir = who ? SpawnLog.dir_for(agents, who) : null;
+			if (dir) return SpawnLog.note(dir, line);
+			if (SpawnLog.sink) return void SpawnLog.sink.append("errors", line).catch(() => {});
+		} catch { /* never throws */ }
+	}
+}
diff --git a/Servex/ErrorLine.test.mjs b/Servex/ErrorLine.test.mjs
new file mode 100644
index 000000000..004b84a55
--- /dev/null
+++ b/Servex/ErrorLine.test.mjs
@@ -0,0 +1,39 @@
+// ErrorLine core test: where() finds the first repo frame, of() puts "error" first, note() lands one line in the agent's session log.
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import ErrorLine from "./ErrorLine.js";
+import SpawnLog from "./SpawnLog.js";
+
+const root = ErrorLine.ROOT;
+const e = new Error("boom");
+e.stack = [
+	"Error: boom",
+	`    at inner (${path.join(root, "node_modules", "x", "i.js")}:3:1)`,
+	"    at node:internal/process/task_queues:95:5",
+	`    at handler (file:///${path.join(root, "Servex", "agents", "tools.js").split(path.sep).join("/")}:612:9)`,
+].join("\n");
+assert.equal(ErrorLine.where(e), "Servex/agents/tools.js:612", "skips node_modules and node:internal, keeps the repo frame");
+assert.equal(ErrorLine.where({ stack: "Error: x\n    at node:internal/a:1:1" }), null, "no repo frame: null");
+
+const line = ErrorLine.of(e, { tool: "item" });
+assert.deepEqual(Object.keys(line), ["error", "where", "tool"], "error is the fixed first key");
+assert.equal(line.error, "boom");
+assert.equal(ErrorLine.of("plain string").error, "plain string", "a thrown string still makes a line");
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), "errorline-"));
+fs.writeFileSync(path.join(dir, "session.jsonl"), JSON.stringify({ title: "t", by: "test", ts: new Date().toISOString() }) + "\n");
+const agents = { live: new Map([["minion-x", { task: { dir } }]]) };
+ErrorLine.note(agents, "minion-x", e, { tool: "item" });
+await SpawnLog.flush();
+const last = JSON.parse(fs.readFileSync(path.join(dir, "session.jsonl"), "utf8").trim().split("\n").at(-1));
+assert.equal(last.error, "boom");
+assert.equal(last.where, "Servex/agents/tools.js:612");
+assert.equal(last.agent, "minion-x");
+assert.equal(last.tool, "item");
+assert.equal(last.by, "servex");
+
+assert.doesNotThrow(() => ErrorLine.note(null, null, e), "no agent and no sink: never throws");
+fs.rmSync(dir, { recursive: true, force: true });
+console.log("ErrorLine.test: ok");

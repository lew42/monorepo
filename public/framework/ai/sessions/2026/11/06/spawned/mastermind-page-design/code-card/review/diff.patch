diff --git a/public/live/LiveCode.js b/public/live/LiveCode.js
new file mode 100644
index 0000000000..526c083dda
--- /dev/null
+++ b/public/live/LiveCode.js
@@ -0,0 +1,30 @@
+import Item from "/framework/core/Item/Item.js";
+import View, { div, h4 } from "/framework/core/View/View.js";
+import { code } from "/framework/ext/highlight/highlight.js";
+
+/* {"type":"live-code","lang":"js","code":"const x = 1;","title":"Optional","caption":"one line under it"} — a code block
+ * card: a title, the code highlighted (ext/highlight), a caption. `lang` is one of js, json, css, html, sh (default js);
+ * an unregistered language degrades to escaped plain text (ext/highlight's own rule). A long line scrolls inside the
+ * block; the card itself never grows wider than the page. */
+export default class LiveCode extends Item {
+	static example = { id: "snippet", lang: "js", code: "const sum = (a, b) => a + b;", title: "Add", caption: "Two numbers in, one out." };   // what the item tool's help shows
+}
+
+LiveCode.View = class LiveCodeView extends View {
+	render(){
+		const item = this.item;
+		return div.c("live-code-card", () => {
+			h4.c("live-card-title").bind(item, "title", function(t){ this.tc("is-empty", !t).text(t ?? ""); });
+			const $wrap = div.c("live-code-wrap");
+			const draw = () => {
+				const lang = item.get("lang") ?? "js";
+				const fn = code[lang] ?? code.js;
+				$wrap.empty(() => fn(String(item.get("code") ?? "")));
+			};
+			["lang", "code"].forEach(key => item.on("change", k => { if (k === key) draw(); }));
+			draw();
+			div.c("live-code-caption").bind(item, "caption", function(t){ this.tc("is-empty", !t).empty(() => { if (t) this.md(String(t), { safe: true }); }); });
+		});
+	}
+};
+Item.register(LiveCode, "live-code");
diff --git a/public/live/LiveCode.test.mjs b/public/live/LiveCode.test.mjs
new file mode 100644
index 0000000000..44c3705452
--- /dev/null
+++ b/public/live/LiveCode.test.mjs
@@ -0,0 +1,30 @@
+/* LiveCode: a live-code line replays with its fields intact. `node public/live/LiveCode.test.mjs` */
+import assert from "node:assert";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { run_item } from "../../Servex/agents/page_tools.js";
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const NAME = ".test-" + process.pid, DIR = path.join(HERE, NAME), URL = `/live/${NAME}/`;
+let n = 0;
+const ok = (c, m) => { assert.ok(c, m); n++; };
+const go = async delta => { const r = await run_item({ path: URL, delta }, { caller: "LiveCode.test" }); assert.ok(r.ok, JSON.stringify(delta) + " refused: " + r.why); return r; };
+const read = async p => (await run_item({ path: URL, read: p }, { caller: "LiveCode.test" })).value;
+
+fs.mkdirSync(DIR, { recursive: true });
+fs.writeFileSync(path.join(DIR, "page.jsonl"), JSON.stringify({ class: "/live/LivePage.js", title: "Test" }) + "\n");
+try {
+	await go({ content: { add: { type: "live-code", id: "s1", lang: "js", code: "const x = 1;", title: "X", caption: "a snippet" } } });
+	const s1 = await read("content.s1");
+	ok(s1.type === "live-code", "a live-code line replays as live-code");
+	ok(s1.data.lang === "js" && s1.data.code === "const x = 1;", "lang and code survive replay");
+	ok(s1.data.title === "X" && s1.data.caption === "a snippet", "title and caption survive replay");
+
+	await go({ content: { add: { type: "live-code", id: "s2", code: "{}" } } });
+	const s2 = await read("content.s2");
+	ok(s2.data.lang === undefined, "lang defaults to js only in the View, not forced onto the stored data");
+	console.log(`LiveCode.test: ${n} passed`);
+} finally {
+	fs.rmSync(DIR, { recursive: true, force: true });
+}

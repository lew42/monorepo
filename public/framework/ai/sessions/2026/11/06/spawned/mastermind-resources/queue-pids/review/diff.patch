diff --git a/Servex/SpawnLog.js b/Servex/SpawnLog.js
new file mode 100644
index 000000000..e874d34db
--- /dev/null
+++ b/Servex/SpawnLog.js
@@ -0,0 +1,98 @@
+import fs from "node:fs";
+import path from "node:path";
+import { AsyncLocalStorage } from "node:async_hooks";
+import { place, stamp } from "./home.js";
+
+/* WHO STARTED THIS PID: every child_process spawn Servex makes gets a `{"pid":N,...}` line, and an exit line when it ends.
+ * Crumbs.js calls `SpawnLog.watch()` after each async child_process function. Attribution is an AsyncLocalStorage store
+ * ({agent, session, why, dir, parent_dir}) entered by `SpawnLog.within()` where an agent tool runs (agents/tools.js) and
+ * around the agent's own claude.exe (Agents.spawn_claude). With an agent the line goes to its session log (and its parent's,
+ * for claude.exe); with none, to the Servex log `spawns`. Doc: Servex/doc/processes.md, "Who started this pid". */
+export default class SpawnLog {
+	static store = new AsyncLocalStorage();
+	static sink = null;      // Servex's single-writer Log, set in Servex.admission(); without it the `spawns` file is appended directly
+	static CUT = 300;
+	static QUIET = [/Get-CimInstance Win32_Process/, /^netstat\b/, /\bworktree list\b/, /rev-parse --verify --quiet/];   // no-agent polls (~9 of the ~12 spawns a minute): not worth a line
+	static chain = null;
+	static deps = null;
+
+	static within(ctx, fn){ return this.store.run(ctx, fn); }
+
+	/* A dir given as a function resolves late; relative dirs resolve against Servex's cwd, as open_task does. */
+	static dir_of(dir){
+		try { const d = typeof dir === "function" ? dir() : dir; return d ? path.resolve(d) : null; } catch { return null; }
+	}
+
+	/* The session log of a task dir: its session.jsonl if there is one, else task.jsonl; null when the dir has neither. */
+	static file_of(dir){
+		const d = this.dir_of(dir);
+		return d && this.deps?.SessionRecord.log_file(d) || null;
+	}
+
+	/* The parent agent's task dir: its live task, its registry row, the heartbeat's owner map. */
+	static dir_for(agents, id){
+		try { return agents.live?.get(id)?.task?.dir ?? agents.reg?.().read()[id]?.task_dir ?? agents.task_dir_of?.(id) ?? null; } catch { return null; }
+	}
+
+	/* Run `job(deps)` after LogLine and SessionRecord have loaded (lazily, so a Worker or a bare import costs nothing), in order, never throwing. */
+	static later(job){
+		try {
+			this.deps ??= null;
+			this.chain ??= import("../Server/LogLine.mjs").then(async l => { this.deps = { LogLine: l.default, SessionRecord: (await import("../Server/SessionRecord.mjs")).default }; });
+			return this.chain = this.chain.then(() => job(this.deps)).catch(() => {});
+		} catch { return null; }
+	}
+
+	static flush(){ return this.chain ?? Promise.resolve(); }
+
+	/* One line, whole, into a task dir's session log through the one appender. Used by the spawn gate (Servex.hold/drain) and by watch(). */
+	static note(dir, obj){
+		return this.later(({ LogLine }) => {
+			const file = this.file_of(dir);
+			if (file) LogLine.raw(file, { ...obj, by: "servex", ts: stamp() });
+		});
+	}
+
+	/* The machine's load as the queued line records it; the process monitor has no page-file reading yet, so page_file_mb is null until it grows one. */
+	static load(servex){
+		const p = servex?.procmon, pct = p?.commit_mb && p?.commit_limit_mb ? 100 * p.commit_mb / p.commit_limit_mb : null;
+		return { commit_pct: pct == null ? null : Math.round(pct * 10) / 10, page_file_mb: p?.page_file_mb ?? null };
+	}
+
+	/* Called by Crumbs after spawn/exec/execFile/fork. `result` is the ChildProcess, or (promisified exec/execFile) a promise carrying `.child`.
+	 * Sync variants never get here: they have no live pid to report. */
+	static watch(name, args, result){
+		try {
+			const child = result?.child ?? result, pid = child?.pid;
+			if (typeof pid !== "number" || typeof child.once !== "function") return;
+			const cmd = [args[0], ...(Array.isArray(args[1]) ? args[1] : typeof args[1] === "string" ? [args[1]] : [])].join(" ").replace(/\s+/g, " ");
+			const ctx = this.store.getStore() ?? null;
+			if (!ctx?.agent && this.QUIET.some(q => q.test(cmd))) return;
+			const where = this.targets(ctx);
+			const line = { pid, agent: ctx?.agent ?? null, session: ctx?.session ?? null, cmd: cmd.slice(0, this.CUT), why: ctx?.why ?? `${name}:${path.basename(String(args[0]))}`, at: stamp() };
+			this.put(where, line);
+			child.once("exit", (code, signal) => this.put(where, { pid_exit: pid, code, signal: signal ?? null, at: stamp() }));
+		} catch { /* a log line must never reach the caller */ }
+	}
+
+	/* Where this context's lines go: the agent's own dir (and, for claude.exe, its parent's), or the `spawns` log. */
+	static targets(ctx){
+		if (!ctx?.agent) return null;
+		const dirs = [ctx.dir, ctx.parent_dir].map(d => this.dir_of(d)).filter(Boolean);
+		return dirs.length ? dirs : null;
+	}
+
+	static put(where, line){
+		if (!where) return this.spawns(line);
+		return this.later(({ LogLine }) => {
+			for (const d of new Set(where)){ const file = this.file_of(d); if (file) LogLine.raw(file, { ...line, by: "servex" }); }
+		});
+	}
+
+	static spawns(line){
+		try {
+			if (this.sink) return void this.sink.append("spawns", line).catch(() => {});
+			fs.appendFileSync(place("logs", "spawns.jsonl"), JSON.stringify(line) + "\n");
+		} catch { /* never throws */ }
+	}
+}
diff --git a/Servex/SpawnLog.test.mjs b/Servex/SpawnLog.test.mjs
new file mode 100644
index 000000000..c9ca98b4b
--- /dev/null
+++ b/Servex/SpawnLog.test.mjs
@@ -0,0 +1,68 @@
+/* node Servex/SpawnLog.test.mjs — a real child process is logged with its pid under the calling agent (start + exit), in the parent's log too for claude.exe, and with no agent in the `spawns` log. */
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawn, execFile } from "node:child_process";
+import { promisify } from "node:util";
+
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "spawnlog-test-"));
+process.env.SERVEX_HOME = path.join(tmp, "home");   // before home.js loads
+await import("./Crumbs.js");                         // installs the child_process wrappers
+const { default: SpawnLog } = await import("./SpawnLog.js");
+const exec_file = promisify(execFile);   // after Crumbs, so it wraps the patched execFile
+
+const task = path.join(tmp, "agent-task"), parent = path.join(tmp, "parent-task");
+for (const d of [task, parent]){ fs.mkdirSync(d); fs.writeFileSync(path.join(d, "session.jsonl"), JSON.stringify({ session: { id: "x", at: 1 } }) + "\n"); }
+const read = f => fs.existsSync(f) ? fs.readFileSync(f, "utf8").split("\n").filter(Boolean).map(l => JSON.parse(l)) : [];
+const run = child => new Promise(done => child.on("exit", () => done()));
+const pids = lines => lines.filter(l => "pid" in l), exits = lines => lines.filter(l => "pid_exit" in l);
+
+// 1. inside an agent's context: a start line and an exit line, pid first, in that agent's log
+const child = SpawnLog.within({ agent: "minion-t", session: "uuid-1", why: "shell", dir: task }, () => spawn("node", ["-e", "1"], { windowsHide: true }));
+await run(child); await SpawnLog.flush();
+let lines = read(path.join(task, "session.jsonl")).slice(1);
+assert.equal(pids(lines).length, 1, "one start line");
+assert.equal(Object.keys(pids(lines)[0])[0], "pid", "pid is the first key");
+assert.equal(pids(lines)[0].pid, child.pid);
+assert.equal(pids(lines)[0].agent, "minion-t"); assert.equal(pids(lines)[0].session, "uuid-1"); assert.equal(pids(lines)[0].why, "shell");
+assert.match(pids(lines)[0].cmd, /^node -e 1/);
+assert.equal(exits(lines).length, 1, "one exit line");
+assert.equal(exits(lines)[0].pid_exit, child.pid); assert.equal(exits(lines)[0].code, 0);
+assert.equal(pids(lines).concat(exits(lines)).length, lines.length, "nothing else landed");
+assert.ok(fs.readFileSync(path.join(task, "session.jsonl"), "utf8").includes(`"pid":${child.pid},`), 'the text is exactly "pid":N');
+assert.ok(fs.readFileSync(path.join(task, "session.jsonl"), "utf8").includes(`"pid_exit":${child.pid},`), 'the exit text is "pid_exit":N');
+console.log("PASS  agent context: start and exit lines in the agent's session log");
+
+// 2. claude.exe: also in the parent's log
+const claude = SpawnLog.within({ agent: "minion-t", why: "claude.exe", dir: () => task, parent_dir: () => parent }, () => spawn("node", ["-e", "1"], { windowsHide: true }));
+await run(claude); await SpawnLog.flush();
+assert.equal(pids(read(path.join(parent, "session.jsonl"))).length, 1, "the parent's log has the claude.exe start line");
+assert.equal(exits(read(path.join(parent, "session.jsonl"))).length, 1, "and its exit line");
+assert.equal(pids(read(path.join(task, "session.jsonl"))).length, 2, "the agent's own log has both children");
+console.log("PASS  claude.exe lines land in the agent's log and its parent's");
+
+// 3. promisified execFile (what Servex's own git/PowerShell calls use) is hooked too, and still resolves {stdout}
+const out = await SpawnLog.within({ agent: "minion-t", why: "execfile", dir: task }, () => exec_file(process.execPath, ["-p", "40+2"], { windowsHide: true }));
+assert.equal(out.stdout.trim(), "42"); await SpawnLog.flush();
+assert.equal(pids(read(path.join(task, "session.jsonl"))).length, 3, "promisified execFile logged");
+console.log("PASS  promisify(execFile) logged and still resolves {stdout}");
+
+// 4. no agent: the `spawns` log; a quiet poll is skipped
+const spawns = path.join(tmp, "home", "logs", "spawns.jsonl");
+const bare = spawn("node", ["-e", "1"], { windowsHide: true }); await run(bare); await SpawnLog.flush();
+const quiet = spawn("node", ["-e", "//Get-CimInstance Win32_Process"], { windowsHide: true }); await run(quiet); await SpawnLog.flush();
+lines = read(spawns);
+assert.equal(pids(lines).length, 1, "the unattributed spawn is in the spawns log, the quiet poll is not");
+assert.equal(pids(lines)[0].pid, bare.pid); assert.equal(pids(lines)[0].agent, null);
+assert.equal(exits(lines)[0].pid_exit, bare.pid);
+console.log("PASS  no agent: spawns log; quiet polls skipped");
+
+// 5. a context with no resolvable task dir falls back to the spawns log and never throws
+const lost = SpawnLog.within({ agent: "ghost", why: "x", dir: () => { throw new Error("boom"); } }, () => spawn("node", ["-e", "1"], { windowsHide: true }));
+await run(lost); await SpawnLog.flush();
+assert.ok(pids(read(spawns)).some(l => l.pid === lost.pid), "no dir: the spawns log");
+console.log("PASS  an agent with no task dir lands in spawns");
+
+fs.rmSync(tmp, { recursive: true, force: true });
+process.exit(0);

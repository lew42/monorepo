+	.live-card:has(> .live-card-go) { padding-bottom: calc(var(--pad-card) + .5rem); }
 	.live-card-chevron { position: absolute; right: .75rem; bottom: .6rem; font-size: 1.1rem; line-height: 1; opacity: .45; pointer-events: none; }
 	.live-card :is(a:not(.live-card-go), button, input, select, label, pre, .live-code-wrap, table) { position: relative; z-index: 1; }   /* tapped, or swiped sideways, on their own */
 	/* A code block inside a card (LivePage.Preview's own members): page padding, card padding and the chevron would

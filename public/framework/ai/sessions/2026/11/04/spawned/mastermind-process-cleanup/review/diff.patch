+	return new Promise((resolve, reject) => {
+		const child = spawn(process.execPath, [path.join(HERE, "closeout.fixture.mjs"), mode, id], { cwd, env: { ...process.env, ...extra }, stdio: ["ignore", "pipe", "inherit"], windowsHide: true });

-		border: 1px solid var(--line);
-		border-radius: 0.3em;
-		background: var(--surface);
-		color: inherit;
-		font: inherit;
-		font-size: 0.9em;
-		cursor: pointer;
-	}
-
-	.ai2-need-opt:hover {
-		border-color: var(--prime);
-		color: var(--prime);
-	}

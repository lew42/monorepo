-	/* WRAPPED, not one tight row — a fixed-width control column (22em) left the field only
-	   ~8em beside the "Answer" button, showing just "Your" of "Your answer…" (mastermind's
-	   judged fix, 2026-09-29). The field takes the control's full width on its own line;
-	   "Answer" sits under it. */
-	.ai2-need-reply {
-		display: flex;
-		flex-wrap: wrap;
-		gap: 0.4em;
-	}
-
-	.ai2-need-field {
-		flex: 1 1 100%;
-		min-width: 10em;
-		height: 2.2em;
-		padding: 0.3em 0.5em;
-		border: 1px solid var(--line);
-		border-radius: 0.3em;
-		background: var(--surface);
-		color: inherit;
-		font: inherit;
-		font-size: 0.9em;
-		resize: none;
-		overflow: hidden;
-	}
-
-	.ai2-need-send {
-		flex: none;
-	}
-
-	/* ⚠ `:not([hidden])`, not a bare `display: block` — a plain `.ai2-need-err { display:
-	   block }` beats the browser's own `[hidden] { display: none }` (equal specificity,
-	   author beats UA regardless of layers), so every error line showed at rest — exactly
-	   the "`display: none` cannot hide a utility class" trap this module's own readme warns
-	   about, just with an attribute instead of a class. */
-	.ai2-need-err {
-		margin-block-start: 0.3em;
-		color: var(--error);
-		font-size: 0.8em;
-	}
-	.ai2-need-err:not([hidden]) { display: block; }
-
-	.ai2-needs-empty {
-		display: block;
-		padding-block: var(--gap-50);
-	}
-
-	/* Too narrow for the control beside the text (a phone, or the rail's own width if this
-	   tab is ever embedded narrower): the control takes the row's full width on its own line. */
-	@media (width < 34em) {
-		.ai2-need-control { flex-basis: 100%; max-width: none; }
-	}
-}

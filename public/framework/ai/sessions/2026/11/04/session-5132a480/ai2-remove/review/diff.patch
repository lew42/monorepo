-/* ── the Needs you tab (ai2-needs-row, 2026-09-29) ─────────────────────────
-   ONE BIG PLAIN LINE PER ITEM (brief D). Before this block existed, `.ai2-need*` had NO
-   rules of its own, so every row fell back to a bare `<a>` and `<div>`: default link-blue
-   underline, the icon on its own line, the title running straight into the meta text — the
-   mastermind's own judged miss. The row is icon, then a title/question/meta column that
-   grows, then the control (buttons or a reply box) at the right WHEN IT FITS — `flex-wrap`
-   drops the control to its own line once the row is too narrow for both. */
-@layer theme {
-	.ai2-needs-list { max-width: 56em; }
-
-	/* Padding is tighter than the module's usual `--gap-50` rows (mastermind's judged fix,
-	   2026-09-29: "aim for 8-10 items above the fold at 1920") — this list is read top to
-	   bottom in one sitting, not browsed like the rail, so a shorter row that still reads
-	   clearly beats spacing tuned for a different kind of list. */
-	.ai2-need {
-		display: flex;
-		flex-wrap: wrap;
-		align-items: flex-start;
-		gap: var(--gap-35);
-		padding-block: 0.6em;
-		border-block-end: 1px solid var(--line);
-	}
-
-	.ai2-need:first-child { padding-block-start: 0; }
-
-	/* The whole icon + title + question + meta column is ONE link to the card — plain, not
-	   the site's default blue-underline prose link (this is not `p`/`li` text, so nothing
-	   restyles it without this rule). */
-	.ai2-need-head {
-		display: flex;
-		align-items: flex-start;
-		gap: var(--gap-25);
-		flex: 1 1 24em;
-		min-width: 0;
-		color: inherit;
-		text-decoration: none;
-	}
-
-	.ai2-need-head:hover .ai2-need-title { text-decoration: underline; }
-
-	.ai2-need-head > .icon {
-		flex: none;
-		margin-block-start: 0.15em;
-		opacity: 0.7;
-	}
-
-	.ai2-need-body { flex: 1; min-width: 0; }
-
-	/* THE IMPORTANCE BADGE (asks-ledger/view, 2026-09-30) — `importance()`'s own number, shown
-	   on every row (brief D). `.inbox-score` (ux/Inbox) is the same look for the rail's own
-	   rows. Muted grey normally; only a
-	   score of 70+ (the "blocking" bands and up) turns it the error colour, so red means
-	   something on this page instead of decorating every row. */
-	.ai2-need-score {
-		flex: none;
-		display: inline-block;
-		min-width: 1.6em;
-		padding: 0.05em 0.4em;
-		border-radius: 1em;
-		background: var(--fill-a08);
-		font-size: 0.75em;
-		font-weight: 700;
-		text-align: center;
-	}
-
-	.ai2-need-score-hot {
-		background: var(--error);
-		color: white;
-	}
-
-	/* THE HEADLINE — the card's own SHORT title, big and plain (brief D: "a short title...
-	   not raw dictation"). A visible "Blocker" flag sits beside it only for that one kind;
-	   every kind still says its word once more, quietly, in the meta line below. */
-	.ai2-need-title {
-		font-weight: 600;
-		font-size: 1.1em;
-		line-height: 1.3;
-		overflow-wrap: anywhere;
-	}
-
-	.ai2-need-blocker-flag {
-		flex: none;
-		padding: 0.05em 0.5em;
-		border-radius: 1em;
-		background: var(--error);
-		color: white;
-		font-size: 0.75em;
-		font-weight: 700;
-		text-transform: uppercase;
-	}
-
-	/* THE FULL ASK, AS ONE QUIET LINE under the title — CSS-ellipsised (never `short_title()`'s
-	   word-cut), so a long dictated question never wraps to three or four lines and pushes the
-	   next item off the fold; the whole sentence survives in `title=` (a hover) and, unabridged,
-	   as the row's own link text one click into the card. */
-	.ai2-need-question {
-		display: block;
-		margin-block-start: 0.2em;
-		overflow: hidden;
-		white-space: nowrap;
-		text-overflow: ellipsis;
-	}
-
-	.ai2-need-meta {
-		display: block;
-		margin-block-start: 0.25em;
-		font-size: 0.8em;
-	}
-
-	/* THE CONTROL — buttons or a one-line reply box, at the right of the same row when the
-	   row is wide enough for both (`flex-wrap` on `.ai2-need` above drops it to its own full
-	   line otherwise, e.g. a narrow phone width). */
-	.ai2-need-control {
-		flex: 1 1 18em;
-		min-width: 14em;
-		max-width: 22em;
-	}
-
-	.ai2-need-options {
-		display: flex;
-		flex-wrap: wrap;
-		gap: 0.4em;

+/* /join/stats/: plain tables, readable from 390 to 1920 wide. Not join.css's one-column video frame: this page scrolls. */
+:root { color-scheme: dark; }
+* { box-sizing: border-box; }
+html, body { margin: 0; background: #0b0b0d; color: #fff; font: 15px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
+body { padding: 16px max(16px, env(safe-area-inset-right)) 32px max(16px, env(safe-area-inset-left)); }
+
+.stats { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
+h1 { font-size: 20px; margin: 0 0 6px; }
+h2 { font-size: 16px; margin: 20px 0 2px; opacity: 0.9; }
+.note { opacity: 0.85; }
+.note.bad { color: #ff8a80; }
+.note a { color: #fff; }
+
+.wrap { width: 100%; overflow-x: auto; display: block; border-collapse: collapse; font-size: 14px; }
+table.wrap { display: table; }
+.wrap thead { position: sticky; top: 0; }
+.wrap th, .wrap td { padding: 6px 10px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.12); white-space: nowrap; }
+.wrap th { opacity: 0.7; font-weight: 600; }
+.wrap td.group { font-weight: 600; opacity: 0.9; }
+.wrap td.num { text-align: right; font-variant-numeric: tabular-nums; }
+
+@media (min-width: 900px) {
+	.stats { gap: 14px; }
+	h1 { font-size: 24px; }
+}

new file mode 100644
index 0000000000..3c8a4bd56a
--- /dev/null
+++ b/public/join/Funnel.js
@@ -0,0 +1,60 @@
+/**
+ * Funnel: one event per step of /join/, sent to POST /api/join/event (worker/join.js). No personal data — only a
+ * random visitor id this device keeps in localStorage, and the utm_* values the ad link carried, kept in
+ * sessionStorage so they survive a reload or the trip through Google. In mock mode it logs to the console and
+ * sends nothing, so nobody needs a real Worker to see the calls it would make.
+ *
+ *   const funnel = new Funnel(backend, env);   // env = the page's InAppBrowser; reads/creates the visitor id
+ *   funnel.send("tap_allow");                   // never awaited, never throws: see() fires and forgets
+ *   Funnel.reset();                              // ?debug=1's Reset everything also drops the visitor id
+ */
+export class Funnel {
+
+	static VKEY = "join-visitor";
+	static UKEY = "join-utm";
+
+	constructor(backend, env, params = new URLSearchParams(location.search)){
+		this.backend = backend;
+		this.env = env;
+		this.utm = this.read_utm(params);
+	}
+
+	read_utm(params){
+		if (params.has("utm_source") || params.has("utm_campaign") || params.has("utm_content")){
+			const utm = { src: params.get("utm_source") || "", camp: params.get("utm_campaign") || "", content: params.get("utm_content") || "" };
+			sessionStorage.setItem(Funnel.UKEY, JSON.stringify(utm));
+			return utm;
+		}
+		try { return JSON.parse(sessionStorage.getItem(Funnel.UKEY) || "null") || { src: "", camp: "", content: "" }; }
+		catch { return { src: "", camp: "", content: "" }; }
+	}
+
+	get visitor(){
+		let v = localStorage.getItem(Funnel.VKEY);
+		if (!/^[0-9a-f]{16}$/.test(v || "")){
+			v = [...crypto.getRandomValues(new Uint8Array(8))].map(b => b.toString(16).padStart(2, "0")).join("");
+			localStorage.setItem(Funnel.VKEY, v);
+		}
+		return v;
+	}
+
+	get os(){ return this.env?.ios ? "ios" : this.env?.android ? "android" : "desktop"; }
+	get inapp(){ return this.env?.app || ""; }
+
+	send(event){
+		if (this.backend?.mock) return void console.log("[funnel]", event, { os: this.os, inapp: this.inapp, ...this.utm });
+		const body = JSON.stringify({ v: this.visitor, e: event, inapp: this.inapp, os: this.os, src: this.utm.src, camp: this.utm.camp, content: this.utm.content });
+		try {
+			const blob = new Blob([body], { type: "application/json" });
+			if (!navigator.sendBeacon?.("/api/join/event", blob))
+				fetch("/api/join/event", { method: "POST", headers: { "content-type": "application/json" }, body, keepalive: true }).catch(() => {});
+		} catch {}
+	}
+
+	static reset(){
+		localStorage.removeItem(Funnel.VKEY);
+		sessionStorage.removeItem(Funnel.UKEY);
+	}
+}
+
+export default Funnel;
diff --git a/public/join/Funnel.test.mjs b/public/join/Funnel.test.mjs
new file mode 100644
index 0000000000..96e4a42e86
--- /dev/null
+++ b/public/join/Funnel.test.mjs
@@ -0,0 +1,46 @@
+// node, no DOM: stubs localStorage/sessionStorage and navigator/crypto the way they exist in a browser.
+import { test } from "../framework/core/Test/Test.js";
+import { Funnel } from "./Funnel.js";
+
+function store(){
+	const m = new Map();
+	return { getItem: k => (m.has(k) ? m.get(k) : null), setItem: (k, v) => m.set(k, String(v)), removeItem: k => m.delete(k) };
+}
+
+test("Funnel keeps a stable 16-hex visitor id, reads utm_* from the URL, and logs instead of sending in mock mode", t => {
+	globalThis.localStorage = store();
+	globalThis.sessionStorage = store();
+	globalThis.crypto.getRandomValues = a => { for (let i = 0; i < a.length; i++) a[i] = i; return a; };
+	Object.defineProperty(globalThis, "navigator", { value: { sendBeacon: () => true }, configurable: true });
+
+	const sent = [];
+	const log = console.log; console.log = (...a) => sent.push(a);
+
+	const f1 = new Funnel({ mock: true }, { ios: true, app: "" }, new URLSearchParams("utm_source=youtube&utm_campaign=t1"));
+	t.eq(f1.os, "ios", "os read from the InAppBrowser-shaped env");
+	t.eq(f1.utm.src, "youtube", "utm_source read from the URL");
+	const v1 = f1.visitor;
+	t.ok(/^[0-9a-f]{16}$/.test(v1), "visitor id is 16 hex chars");
+	t.eq(f1.visitor, v1, "the same id comes back on a second read");
+
+	f1.send("tap_allow");
+	t.eq(sent.length, 1, "mock mode logs instead of calling the API");
+	t.eq(sent[0][1], "tap_allow", "the logged event name is the one sent");
+
+	// a second instance with no utm_* in the URL still finds the ones sessionStorage kept
+	const f2 = new Funnel({ mock: true }, {}, new URLSearchParams(""));
+	t.eq(f2.utm.camp, "t1", "utm_campaign survived in sessionStorage across a reload");
+	t.eq(f2.visitor, v1, "the visitor id survives across instances (it is in localStorage)");
+
+	let beaconed = null;
+	navigator.sendBeacon = (url, blob) => { beaconed = url; return true; };
+	const f3 = new Funnel({ mock: false }, {}, new URLSearchParams(""));
+	f3.send("view");
+	t.eq(beaconed, "/api/join/event", "a real backend sends a beacon to the event route");
+
+	Funnel.reset();
+	t.eq(localStorage.getItem(Funnel.VKEY), null, "reset drops the visitor id");
+	t.eq(sessionStorage.getItem(Funnel.UKEY), null, "reset drops the remembered utm_*");
+
+	console.log = log;
+});

 ## Files
 
-`index.html`, `main.js` (boots it), `Join.js` (the page class), `join.css`, `copy.js` (**all** words and the video, poster and captions paths: edit text here), `Backend.js` (the Worker's `/api` calls; `Backend.detect()` picks real or mock), `MockBackend.js` (+ `MockBackend.test.mjs`), `JoinState.js` (+ `JoinState.test.mjs`: the button-state rule and the shared-link cleaner; `Join.js` needs a DOM, so its flow is covered by `shoot.mjs` instead), `sw.js` (service worker, scope `/join/`, shows the push payload, caches nothing), `manifest.webmanifest`, `media/` (the video, poster and `captions.vtt`), `shoot.mjs` (the check below). Built on `ux/Auth`: [GoogleButton](/framework/ux/Auth/readme.md) and `InAppBrowser`. The API: [worker/readme.md](/worker/readme.md), "Sign-in, sessions and push".
+`index.html`, `main.js` (boots it), `Join.js` (the page class), `join.css`, `copy.js` (**all** words and the video, poster and captions paths: edit text here), `Backend.js` (the Worker's `/api` calls; `Backend.detect()` picks real or mock), `MockBackend.js` (+ `MockBackend.test.mjs`), `JoinState.js` (+ `JoinState.test.mjs`: the button-state rule and the shared-link cleaner; `Join.js` needs a DOM, so its flow is covered by `shoot.mjs` instead), `Funnel.js` (+ `Funnel.test.mjs`: the ad funnel, below), `sw.js` (service worker, scope `/join/`, shows the push payload, caches nothing), `manifest.webmanifest`, `media/` (the video, poster and `captions.vtt`), `shoot.mjs` (the check below). Built on `ux/Auth`: [GoogleButton](/framework/ux/Auth/readme.md) and `InAppBrowser`. The API: [worker/readme.md](/worker/readme.md), "Sign-in, sessions and push".
+
+## The ad funnel: `Funnel.js` and `/join/stats/`
+
+`Join.js` fires one `Funnel` event at every step (view, the Google tap, signed in, the Allow tap, subscribed, a test push, the in-app card, copy/share link, "Not working?", signed out, deleted…), each a `POST /api/join/event` with no personal data — only a random visitor id this device keeps in `localStorage`, and the `utm_source`/`utm_campaign`/`utm_content` the first ad link carried (kept in `sessionStorage` for the visit). `?debug=1`'s Reset everything drops the visitor id too (it shares the `join-` prefix the reset already sweeps). In mock mode it logs to the console and sends nothing.
+
+[`/join/stats/`](stats/) (`Stats.js`) is a second standalone page, admin-only: the funnel in step order (today UTC, 7 days, all time), then split by ad and by in-app vs not, then the two totals (signed-up users, active push subscriptions). Not an admin: one line with a link to sign in. The route and table: [worker/readme.md](/worker/readme.md), "Sign-in, sessions and push".
 
 ## Re-run the flow
 
diff --git a/public/join/stats/Stats.js b/public/join/stats/Stats.js
new file mode 100644
index 0000000000..a8d3963aa0
--- /dev/null
+++ b/public/join/stats/Stats.js
@@ -0,0 +1,87 @@
+const el = (tag, cls = "", ...kids) => {
+	const e = document.createElement(tag);
+	if (cls) e.className = cls;
+	for (const k of kids) if (k != null && k !== false) e.append(k);
+	return e;
+};
+
+/**
+ * Stats: /join/stats/ — the admin-only numbers for the /join/ ad funnel (worker/join.js's GET /api/join/stats).
+ * Plain tables, no charts: the funnel in step order (today, 7 days, all time), then one table per split
+ * (utm_source, in-app vs not), then the two totals. Not an admin: one line, with a link to sign in. Any other
+ * failure: the real error, in words.
+ *
+ *   new Stats(document.getElementById("stats")).load();
+ */
+export class Stats {
+
+	constructor(root){
+		this.root = root;
+	}
+
+	async load(){
+		this.root.replaceChildren(el("p", "note", "Loading…"));
+		try {
+			const res = await fetch("/api/join/stats");
+			if (res.status === 401 || res.status === 403) return this.denied();
+			const data = await res.json().catch(() => ({}));
+			if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
+			this.draw(data);
+		} catch (err){
+			this.root.replaceChildren(el("p", "note bad", "That didn't work: " + err.message));
+		}
+	}
+
+	denied(){
+		this.root.replaceChildren(el("p", "note",
+			"Admins only. Sign in at ", Object.assign(el("a"), { href: "/join/", textContent: "/join/" }), " with the admin account."));
+	}
+
+	draw(data){
+		const { events, funnel, by_source, by_inapp, signed_up_users, active_push_subs } = data;
+		this.root.replaceChildren(
+			el("h1", "", "Funnel: /join/"),
+			this.funnel_table(events, funnel),
+			el("h2", "", "By ad (utm_source)"),
+			this.split_table(events, by_source, "source"),
+			el("h2", "", "In-app browser vs not"),
+			this.split_table(events, by_inapp, "in_app", v => v ? "in-app" : "not in-app"),
+			el("h2", "", "Totals"),
+			this.totals_table(signed_up_users, active_push_subs));
+	}
+
+	head(first){
+		return el("thead", "", el("tr", "", el("th", "", first), el("th", "", "Step"), el("th", "", "Today (UTC)"), el("th", "", "7 days"), el("th", "", "All time")));
+	}
+
+	funnel_table(events, funnel){
+		return el("table", "wrap",
+			this.head(""),
+			el("tbody", "", ...events.map(e => el("tr", "",
+				el("td", ""), el("td", "", e),
+				el("td", "", String(funnel.today[e] || 0)), el("td", "", String(funnel.week[e] || 0)), el("td", "", String(funnel.all[e] || 0))))));
+	}
+
+	// Groups every window's rows by the split key (utm_source, or in_app), then one row per event that split saw.
+	split_table(events, windows, key, label = v => v){
+		const groups = new Map();
+		for (const win of ["today", "week", "all"])
+			for (const row of windows[win] || [])
+				(groups.get(row[key]) ?? groups.set(row[key], { today: {}, week: {}, all: {} }).get(row[key]))[win][row.event] = row.n;
+
+		const rows = [...groups.entries()].flatMap(([name, g]) =>
+			events.filter(e => g.today[e] || g.week[e] || g.all[e]).map((e, i) => el("tr", "",
+				el("td", "group", i === 0 ? label(name) : ""), el("td", "", e),
+				el("td", "", String(g.today[e] || 0)), el("td", "", String(g.week[e] || 0)), el("td", "", String(g.all[e] || 0)))));
+		return el("table", "wrap", this.head(key === "source" ? "Source" : ""), el("tbody", "", ...(rows.length ? rows : [el("tr", "", el("td", "", "—"), el("td", ""), el("td", ""), el("td", ""), el("td", ""))])));
+	}
+
+	totals_table(signed_up_users, active_push_subs){
+		return el("table", "wrap", el("tbody", "",
+			el("tr", "", el("td", "", "Signed-up users (Google)"), el("td", "num", String(signed_up_users.google))),
+			el("tr", "", el("td", "", "Signed-up users (Google + test)"), el("td", "num", String(signed_up_users.with_test))),
+			el("tr", "", el("td", "", "Active push subscriptions"), el("td", "num", String(active_push_subs)))));
+	}
+}
+
+export default Stats;

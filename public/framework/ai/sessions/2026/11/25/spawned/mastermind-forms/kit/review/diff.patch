diff --git a/public/framework/ux/Form/Form.js b/public/framework/ux/Form/Form.js
new file mode 100644
index 0000000000..8679d0231e
--- /dev/null
+++ b/public/framework/ux/Form/Form.js
@@ -0,0 +1,173 @@
+import View, { div, h3, p, span, button, progress } from "../../core/View/View.js";
+import { Property } from "../../core/Property/Property.js";
+import Question from "./Question.js";
+
+/**
+ * Form: a list of Questions that reads and writes one plain object.
+ *   const form = Form.from({ title: "Check-in", questions: [{ id: "intro", type: "T09", label: "How was the intro?" }] });
+ *   form.values()                      // { intro: null }   (-3..3, 0, "skip" or null for a Scale7)
+ *   form.load({ intro: 2 })            // sets answers by id; unknown ids are ignored
+ *   form.on("change", values => …)     // any answer changed
+ *   form.on("submit", values => …)     // Submit pressed and no required question is empty
+ * `layout`: "list" (default) shows every question in a column; "stepper" shows one at a time with Back, Next and a
+ * progress bar; "quiz" is a stepper whose questions may carry a `correct` value, ending in a score. Doc: readme.md.
+ */
+export default class Form extends View {
+
+	static layouts = ["list", "stepper", "quiz"];
+
+	// json: { title?, questions: [{ id, type, label, hint?, required?, options?, config? }] } or just the array.
+	static from(json, opts = {}){
+		const list = Array.isArray(json) ? json : json.questions;
+		return new Form({ title: Array.isArray(json) ? undefined : json.title, ...opts, questions: list });
+	}
+
+	get changes(){ return this._changes ??= new Property(0); }
+	get sent(){ return this._sent ??= new Property(null); }
+
+	on(event, cb){
+		if (event === "change") this.changes.on("change", () => cb.call(this, this.values(), this));
+		else if (event === "submit") this.sent.on("change", v => cb.call(this, v, this));
+		else return super.on(event, cb);
+		return this;
+	}
+
+	classify(){
+		super.classify();
+		this.ac("fm-form");
+	}
+
+	get stepping(){ return this.layout === "stepper" || this.layout === "quiz"; }
+	get quiz(){ return this.layout === "quiz"; }
+
+	initialize(){
+		this.items = [];
+		this.index = 0;
+		this.finished = false;
+		super.initialize();
+	}
+
+	render(){
+		if (this.title) h3.c("fm-title", this.title);
+		div.c("fm-questions", box => {
+			(this.questions ?? []).forEach(q => {
+				const item = q instanceof Question ? box.append(q) && q : new Question(q);
+				item.answer.on("change", () => this.changes.set(this.changes.get() + 1));
+				this.items.push(item);
+			});
+		});
+		if (this.stepping) this.nav(); else this.actions();
+		if (this.quiz) this.score_box = div.c("fm-score fm-off");
+		if (this.stepping) this.show();
+	}
+
+	actions(){
+		div.c("fm-actions", () => {
+			this.status = p.c("fm-status", "");
+			button.c("prim", this.submit_text ?? "Submit").attr("type", "button").click(() => this.submit());
+		});
+	}
+
+	// stepper and quiz: the progress line, the bar, Back and Next (Next is Submit on the last question)
+	nav(){
+		this.nav_box = div.c("fm-nav", () => {
+			this.count = span.c("fm-count", "");
+			this.bar = progress.c("fm-bar-progress").attr("max", this.items.length);
+			div.c("fm-actions", () => {
+				this.back_btn = button("Back").attr("type", "button").click(() => this.go(this.index - 1));
+				this.next_btn = button.c("prim", "").attr("type", "button").click(() => this.advance());
+				this.status = p.c("fm-status", "");
+			});
+		});
+	}
+
+	// Show question i and hide the rest; every Question stays alive, so no answer is lost on the way.
+	go(i){
+		this.index = Math.max(0, Math.min(this.items.length - 1, i));
+		return this.show();
+	}
+
+	show(){
+		this.items.forEach((q, i) => { if (this.finished || i === this.index) q.rc("fm-off"); else q.ac("fm-off"); });
+		const last = this.index === this.items.length - 1;
+		this.count.text(`Question ${this.index + 1} of ${this.items.length}`);
+		this.bar.attr("value", this.index + 1);
+		this.back_btn.el.disabled = this.index === 0;
+		this.next_btn.text(last ? (this.quiz ? "Finish" : this.submit_text ?? "Submit") : "Next");
+		return this;
+	}
+
+	// Next: stay on a required question that is still empty, else move on; on the last one, submit.
+	advance(){
+		const q = this.items[this.index];
+		if (q.missing()){
+			q.flag(true);
+			this.status.text("Please answer this one.");
+			return false;
+		}
+		this.status.text("");
+		if (this.index < this.items.length - 1){ this.go(this.index + 1); return true; }
+		return this.submit();
+	}
+
+	// { right, total, results: { id: true|false } } over the questions that have a `correct`.
+	score(){
+		const graded = this.items.filter(q => q.graded());
+		return { right: graded.filter(q => q.right()).length, total: graded.length, results: Object.fromEntries(graded.map(q => [q.id, q.right()])) };
+	}
+
+	// The quiz ends: every question is shown again, graded, under the score.
+	reveal(){
+		const { right, total } = this.score();
+		this.finished = true;
+		this.nav_box.ac("fm-off");
+		this.items.forEach(q => q.grade(true));
+		this.score_box.empty(() => {
+			p.c("fm-score-line", `You got ${right} of ${total} right.`);
+			button.c("prim", "Try again").attr("type", "button").click(() => this.reset());
+		}).rc("fm-off");
+		return this.show();
+	}
+
+	// Clear every answer and go back to the first question.
+	reset(){
+		this.finished = false;
+		this.items.forEach(q => { q.answer.reset(); q.flag(false); q.grade(false); });
+		this.nav_box?.rc("fm-off");
+		this.score_box?.ac("fm-off");
+		this.status?.text("");
+		return this.stepping ? this.go(0) : this;
+	}
+
+	question(id){ return this.items.find(q => q.id === id); }
+
+	values(){
+		return Object.fromEntries(this.items.map(q => [q.id, q.value]));
+	}
+
+	load(values = {}){
+		for (const [id, v] of Object.entries(values)){
+			const q = this.question(id);
+			if (q) q.value = v;
+		}
+		return this;
+	}
+
+	// The ids of the required questions still empty.
+	missing(){
+		return this.items.filter(q => q.missing()).map(q => q.id);
+	}
+
+	submit(){
+		const missing = this.missing();
+		this.items.forEach(q => q.flag(missing.includes(q.id)));
+		if (missing.length){
+			this.status.text(`Please answer: ${missing.length} required.`);
+			if (this.stepping) this.go(this.items.findIndex(q => missing.includes(q.id)));
+			return false;
+		}
+		if (this.quiz) this.reveal(); else this.status.text("Thanks, sent.");
+		this.sent.set({ ...this.values() });
+		return true;
+	}
+}
diff --git a/public/framework/ux/Form/Form.test.mjs b/public/framework/ux/Form/Form.test.mjs
new file mode 100644
index 0000000000..325f7ffa69
--- /dev/null
+++ b/public/framework/ux/Form/Form.test.mjs
@@ -0,0 +1,57 @@
+// Form core: build from JSON, values(), load(), required, change and submit. Node: node public/framework/ux/Form/Form.test.mjs
+import { install, choose, type } from "./fake-dom.mjs";
+install();
+const { test } = await import("../../core/Test/Test.js");
+const { default: Form } = await import("./Form.js");
+const { default: Answers } = await import("./Answers.js");
+
+const json = {
+	title: "Check-in",
+	questions: [
+		{ id: "intro", type: "T09", label: "How was the intro?", required: true },
+		{ id: "how", type: "chooseone", label: "How?", options: [["a", "A"], ["b", "B"]] },
+		{ id: "word", type: "ShortText", label: "One word" },
+	],
+};
+
+test("Answers.find reads a type id or a class name", t => {
+	t.eq(Answers.find("T09").name, "Scale7", "by id");
+	t.eq(Answers.find("scale7").name, "Scale7", "by lower-case name");
+	t.eq(Answers.find("number").name, "NumberAnswer", "the Answer suffix is optional");
+	t.eq(Answers.list.length, 20, "twenty types");
+});
+
+test("Form.from builds the questions; values() starts all null, in question order", t => {
+	const form = Form.from(json);
+	t.eq(Object.keys(form.values()), ["intro", "how", "word"], "one key per question id");
+	t.eq(Object.values(form.values()), [null, null, null], "nothing answered");
+});
+
+test("load() sets answers by id and ignores unknown ids; values() reads them back", t => {
+	const form = Form.from(json);
+	form.load({ intro: -2, how: "b", word: "calm", nope: 1 });
+	t.eq(form.values(), { intro: -2, how: "b", word: "calm" }, "round trip");
+});
+
+test("a user's click lands in values() and fires change", t => {
+	const form = Form.from(json);
+	const seen = [];
+	form.on("change", v => seen.push(v.how));
+	const radios = form.question("how").el.find(e => e.tag === "input");
+	choose(radios[1]);
+	t.eq(form.values().how, "b", "the click is in values()");
+	t.eq(seen, ["b"], "change fired with the new values");
+});
+
+test("submit refuses while a required question is empty, then sends the values", t => {
+	const form = Form.from(json);
+	const sent = [];
+	form.on("submit", v => sent.push(v));
+	t.eq(form.missing(), ["intro"], "only the required one is missing");
+	t.ok(!form.submit(), "refused");
+	t.ok(form.question("intro").el.classList.contains("fm-missing"), "the question is flagged");
+	form.load({ intro: 0 });
+	t.eq(form.missing(), [], "0 is an answer, not empty");
+	t.ok(form.submit(), "accepted");
+	t.eq(sent[0].intro, 0, "submit carried the values");
+});
diff --git a/public/framework/ux/Form/JsonPanel.js b/public/framework/ux/Form/JsonPanel.js
new file mode 100644
index 0000000000..a23d328c89
--- /dev/null
+++ b/public/framework/ux/Form/JsonPanel.js
@@ -0,0 +1,50 @@
+import View, { div, h3, p, button, textarea } from "../../core/View/View.js";
+
+View.stylesheet(import.meta, "Form.css");
+
+/**
+ * JsonPanel: a form's values as JSON, live, and a place to paste JSON back in.
+ *   new JsonPanel({ form })     // the box follows form.values(); Load puts the pasted object into the form
+ * Doc: readme.md.
+ */
+export default class JsonPanel extends View {
+
+	classify(){
+		super.classify();
+		this.ac("fm-json-panel");
+	}
+
+	render(){
+		h3(this.title ?? "form.values()");
+		this.box = textarea.c("fm-field fm-code", "").attr("spellcheck", "false").attr("aria-label", "The form's values as JSON");
+		button.c("prim", "Load").attr("type", "button").click(() => this.load());
+		this.status = p.c("fm-status", "");
+		this.form.on("change", () => this.show());
+		this.show();
+	}
+
+	show(){
+		this.box.el.value = JSON.stringify(this.form.values(), null, 2);
+		this.box.rc("fm-bad");
+		return this;
+	}
+
+	// Parse the box, put the object into the form, say what happened.
+	load(){
+		let data;
+		try { data = JSON.parse(this.box.el.value); }
+		catch (e){ return this.fail("Not valid JSON: " + e.message); }
+		if (!data || typeof data !== "object" || Array.isArray(data)) return this.fail('Expected an object like { "intro": 2 }.');
+		const ignored = Object.keys(data).filter(id => !this.form.question(id));
+		this.form.load(data);
+		this.show();
+		this.status.rc("fm-bad").text(ignored.length ? `Loaded. Ignored unknown ids: ${ignored.join(", ")}.` : "Loaded.");
+		return true;
+	}
+
+	fail(message){
+		this.box.ac("fm-bad");
+		this.status.ac("fm-bad").text(message);
+		return false;
+	}
+}
diff --git a/public/framework/ux/Form/Layouts.test.mjs b/public/framework/ux/Form/Layouts.test.mjs
new file mode 100644
index 0000000000..e7b1a2a869
--- /dev/null
+++ b/public/framework/ux/Form/Layouts.test.mjs
@@ -0,0 +1,90 @@
+// Stepper, quiz and JsonPanel. Node: node public/framework/ux/Form/Layouts.test.mjs
+import { install, choose, type } from "./fake-dom.mjs";
+install();
+const { test } = await import("../../core/Test/Test.js");
+const { default: Form } = await import("./Form.js");
+const { default: JsonPanel } = await import("./JsonPanel.js");
+
+const questions = () => [
+	{ id: "a", type: "T09", label: "A", required: true },
+	{ id: "b", type: "chooseone", label: "B", options: [["x", "X"], ["y", "Y"]], correct: "y" },
+	{ id: "c", type: "choosemany", label: "C", options: [["1", "1"], ["2", "2"], ["3", "3"]], correct: ["3", "1"] },
+];
+const shown = form => form.items.filter(q => !q.el.classList.contains("fm-off")).map(q => q.id);
+
+test("a stepper shows one question and Next stops on an empty required one", t => {
+	const form = new Form({ layout: "stepper", questions: questions() });
+	t.eq(shown(form), ["a"], "only the first is shown");
+	t.eq(form.next_btn.el.textContent, "Next", "Next, not Submit");
+	t.ok(form.back_btn.el.disabled, "Back is off on the first");
+	t.ok(!form.advance(), "refused while a is empty");
+	t.eq(form.index, 0, "still on the first");
+	form.load({ a: 0 });
+	t.ok(form.advance(), "0 is an answer, so it moves on");
+	t.eq(shown(form), ["b"], "the second is shown");
+	t.ok(!form.back_btn.el.disabled, "Back is on");
+	form.go(0);
+	t.eq(form.values().a, 0, "going back keeps the answer");
+});
+
+test("the last stepper step is Submit; it sends the values and the form says thanks", t => {
+	const form = new Form({ layout: "stepper", questions: questions() });
+	const sent = [];
+	form.on("submit", v => sent.push(v));
+	form.load({ a: 1 });
+	form.go(2);
+	t.eq(form.next_btn.el.textContent, "Submit", "last step");
+	t.ok(form.advance(), "submitted");
+	t.eq(sent[0].a, 1, "values were sent");
+	t.eq(form.count.el.textContent, "Question 3 of 3", "progress line");
+});
+
+test("submit from a stepper jumps to the first missing required question", t => {
+	const form = new Form({ layout: "stepper", questions: questions() });
+	form.go(2);
+	t.ok(!form.submit(), "refused");
+	t.eq(form.index, 0, "back on the empty required one");
+});
+
+test("a quiz grades only the questions with a correct value, and scores them", t => {
+	const form = new Form({ layout: "quiz", questions: [...questions(), { id: "d", type: "shorttext", label: "D" }] });
+	form.load({ a: 0, b: "y", c: ["1", "3"] });
+	t.eq(form.score(), { right: 2, total: 2, results: { b: true, c: true } }, "d has no correct: not counted; checkbox order never matters");
+	form.load({ c: ["1"] });
+	t.eq(form.score().results.c, false, "a partial list is wrong");
+});
+
+test("finishing a quiz shows every question graded and a score; Try again clears it", t => {
+	const form = new Form({ layout: "quiz", questions: questions() });
+	form.load({ a: 0, b: "x", c: ["1", "3"] });
+	form.go(2);
+	t.eq(form.next_btn.el.textContent, "Finish", "the last step says Finish");
+	t.ok(form.advance(), "finished");
+	t.eq(shown(form), ["a", "b", "c"], "all shown again");
+	t.ok(form.question("b").el.classList.contains("fm-wrong"), "b is red");
+	t.ok(form.question("c").el.classList.contains("fm-right"), "c is green");
+	t.ok(form.question("b").key.el.textContent.includes("Correct answer: Y"), "the right answer is named by its label");
+	t.ok(form.score_box.el.textContent.includes("You got 1 of 2 right."), "the score line");
+	form.reset();
+	t.eq(Object.values(form.values()), [null, null, []], "answers cleared");
+	t.ok(!form.question("b").el.classList.contains("fm-wrong"), "grades gone");
+	t.eq(shown(form), ["a"], "back on the first question");
+});
+
+test("JsonPanel mirrors values() live and loads pasted JSON", t => {
+	const form = Form.from({ questions: questions() });
+	const panel = new JsonPanel({ form });
+	t.eq(JSON.parse(panel.box.el.value), { a: null, b: null, c: [] }, "starts as the values");
+	form.load({ a: 2 });
+	t.eq(JSON.parse(panel.box.el.value).a, 2, "follows a change");
+	type(panel.box.el, '{ "a": -1, "b": "x", "nope": 1 }');
+	t.ok(panel.load(), "good JSON loads");
+	t.eq(form.values().a, -1, "the form took it");
+	t.ok(panel.status.el.textContent.includes("nope"), "an unknown id is named");
+	type(panel.box.el, "{ not json");
+	t.ok(!panel.load(), "bad JSON is refused");
+	t.ok(panel.status.el.textContent.startsWith("Not valid JSON"), "with a message");
+	t.eq(form.values().a, -1, "and nothing changed");
+	type(panel.box.el, "[1]");
+	t.ok(!panel.load(), "an array is refused");
+});
diff --git a/public/framework/ux/Form/Question.js b/public/framework/ux/Form/Question.js
new file mode 100644
index 0000000000..0b90f58c73
--- /dev/null
+++ b/public/framework/ux/Form/Question.js
@@ -0,0 +1,62 @@
+import View, { span, p, legend } from "../../core/View/View.js";
+import Answers from "./Answers.js";
+
+/**
+ * Question: a label, an optional hint, and one Answer.
+ *   new Question({ id: "intro", type: "T09", label: "How was the intro?", hint: "Be honest", required: true })
+ *   new Question({ id: "how", type: "chooseone", label: "How?", options: [["a", "A"], ["b", "B"]] })
+ *   q.value            // the answer's value, read and write
+ *   q.missing()        // true when it is required and still empty
+ * `correct` (any value the answer can hold) makes it gradable: q.right(), and the quiz layout's score.
+ * `type` is a type id ("T09") or an answer class name ("Scale7"). `options`, and any extra key in
+ * `config` ({ markers: "faces" }), go to the Answer. A ready `answer` instance can be passed instead.
+ */
+export default class Question extends View {
+
+	classify(){
+		super.classify();
+		this.ac("fm-question");
+	}
+
+	prerender(){
+		this.tag = "fieldset";
+		super.prerender();
+	}
+
+	get value(){ return this.answer.value; }
+	set value(v){ this.answer.value = v; }
+
+	missing(){ return !!this.required && this.answer.empty(); }
+
+	graded(){ return this.correct !== undefined; }
+	right(){ return this.graded() && this.answer.matches(this.correct); }
+
+	// Show the grade: a green or red outline and the correct answer. grade(false) takes it away.
+	grade(on = true){
+		this.rc("fm-right"); this.rc("fm-wrong");
+		this.key?.ac("fm-off");
+		if (!on || !this.graded()) return this;
+		this.ac(this.right() ? "fm-right" : "fm-wrong");
+		this.key.text(this.right() ? "Correct" : "Correct answer: " + this.answer.say(this.correct)).rc("fm-off");
+		return this;
+	}
+
+	// Mark or unmark "answer this one" (the form does it on submit).
+	flag(on){
+		if (on) this.ac("fm-missing"); else this.rc("fm-missing");
+		return this;
+	}
+
+	render(){
+		legend.c("fm-label", () => {
+			span(this.label ?? this.id ?? "");
+			if (this.required) span.c("fm-req", "*").attr("title", "required");
+		});
+		if (this.hint) p.c("fm-hint", this.hint);
+		this.answer ??= Answers.make(this.type, { ...this.config, options: this.options });
+		this.answer.parent = this;
+		if (!this.answer.el.parentNode) this.append(this.answer);
+		this.answer.on("change", () => this.flag(false));
+		this.key = p.c("fm-key fm-off", "");
+	}
+}
diff --git a/public/framework/ux/Form/Scale7.test.mjs b/public/framework/ux/Form/Scale7.test.mjs

diff --git a/public/framework/ux/Form/Answer.js b/public/framework/ux/Form/Answer.js
new file mode 100644
index 0000000000..4349bb877e
--- /dev/null
+++ b/public/framework/ux/Form/Answer.js
@@ -0,0 +1,188 @@
+import View, { div, span, label, input, option } from "../../core/View/View.js";
+import { Property } from "../../core/Property/Property.js";
+
+View.stylesheet(import.meta, "Form.css");
+
+/**
+ * Answer: one native control that holds one typed value. The 20 answer types extend it.
+ *
+ *   const a = new Scale7({ value: -1 });
+ *   a.value                                  // -1
+ *   a.value = 2;                             // the control follows
+ *   a.on("change", (value, answer) => …);    // by the user or by code
+ *   a.empty()                                // true when nothing is answered yet
+ *
+ * A subclass sets `static type / title / shape / native / use / example`, builds its control in
+ * render(), and paints this.value into it in sync(). A touch ends in `this.value = …`, so a click,
+ * a load() and code all take the same road.
+ * ⚠ Options arrive through assign() (`new ChooseOne({ options })`), never class fields: a field
+ * would initialise AFTER render() already ran. Defaults live in statics and getters. doc: readme.md
+ */
+export default class Answer extends View {
+
+	static type = "T00";
+	static title = "Answer";
+	static shape = "any";
+	static native = "";
+	static use = "";
+	static initial = null;                  // the value before anyone answers
+	static example = { label: "A question" };   // what the demo page asks, plus any options
+	static seq = 0;
+
+	get prop(){
+		if (!this._prop){
+			const start = this.constructor.initial;
+			this._prop = new Property(Array.isArray(start) ? [...start] : start);
+		}
+		return this._prop;
+	}
+
+	get value(){ return this.prop.get(); }
+	set value(v){ this.prop.set(this.coerce(v)); }
+
+	coerce(v){ return v === undefined || v === "" ? null : v; }
+
+	empty(){
+		const v = this.value;
+		return v === null || (Array.isArray(v) && !v.some(x => x !== null && x !== undefined));
+	}
+
+	classify(){
+		super.classify();
+		this.ac("fm-answer");
+	}
+
+	initialize(){
+		this.group ??= "fm" + ++Answer.seq;
+		super.initialize();
+		this.prop.on("change", () => this.sync());
+		this.sync();
+	}
+
+	on(event, cb){
+		if (event !== "change") return super.on(event, cb);
+		this.prop.on("change", v => cb.call(this, v, this));
+		return this;
+	}
+
+	// Paint this.value into the control: a radio or checkbox group, or one native field.
+	sync(){
+		const v = this.value;
+		if (this.inputs){
+			this.inputs.forEach((inp, i) => {
+				const val = this.pairs[i][0];
+				inp.el.checked = this.many ? Array.isArray(v) && v.some(x => this.same(x, val)) : this.same(v, val);
+			});
+		}
+		if (this.field){
+			const text = v === null || v === undefined ? "" : String(v);
+			if (this.field.el.value !== text) this.field.el.value = text;
+		}
+	}
+
+	same(a, b){ return a !== null && a !== undefined && String(a) === String(b); }
+
+	// Back to the unanswered start (a quiz's "try again").
+	reset(){
+		const start = this.constructor.initial;
+		this.value = Array.isArray(start) ? [...start] : start;
+	}
+
+	// Is `correct` the value? Lists compare in order, except a checkbox group, where order never matters.
+	matches(correct){
+		const v = this.value;
+		if (!Array.isArray(correct)) return this.same(v, correct);
+		if (!Array.isArray(v) || v.length !== correct.length) return false;
+		const a = v.map(String), b = correct.map(String);
+		if (this.many){ a.sort(); b.sort(); }
+		return a.every((x, i) => x === b[i]);
+	}
+
+	// A value as the reader saw it: the option's label when it has one ("+2", "Music"), else the value.
+	say(v){
+		if (Array.isArray(v)) return v.map(x => this.say(x)).join(", ");
+		const hit = (this.pairs ?? this.choices).find(p => this.same(p[0], v));
+		return String(hit ? hit[1] : v);
+	}
+
+	// [[value, label], …] from this.options, else the class's static options. Values keep their type.
+	get choices(){
+		const list = this.options ?? this.constructor.options ?? [];
+		return list.map(o => Array.isArray(o) ? o : o && typeof o === "object" ? [o.value, o.label ?? o.value] : [o, o]);
+	}
+
+	// A radio group: one label per choice. `cls` is its look (fm-list, fm-seg, fm-chips …).
+	one_of(pairs, cls = "fm-list"){
+		this.many = false;
+		return this.group_of("radio", pairs, cls);
+	}
+
+	// A checkbox group: the value is the ticked values, in option order.
+	many_of(pairs, cls = "fm-list"){
+		this.many = true;
+		return this.group_of("checkbox", pairs, cls);
+	}
+
+	group_of(kind, pairs, cls){
+		this.pairs = pairs;
+		this.inputs = [];
+		return div.c("fm-group " + cls, () => {
+			pairs.forEach(([val, text], i) => {
+				label.c("fm-opt", () => {
+					const inp = input().attr("type", kind).attr("name", this.group).attr("value", String(val));
+					inp.on("change", () => this.touched(i));
+					this.inputs.push(inp);
+					this.face(val, text, i);
+				});
+			});
+		}).attr("role", kind === "radio" ? "radiogroup" : "group");
+	}
+
+	// What one choice looks like inside its label; a subclass overrides it (stars, faces, bars).
+	face(val, text){ return span.c("fm-text", text); }
+
+	touched(i){
+		if (!this.many){
+			if (this.inputs[i].el.checked) this.value = this.pairs[i][0];
+			return;
+		}
+		this.value = this.pairs.filter((_, k) => this.inputs[k].el.checked).map(p => p[0]);
+	}
+
+	// One native field (input or textarea) whose text is the value; coerce() types it.
+	field_of(view){
+		view.ac("fm-field");
+		const commit = () => { this.value = view.el.value; };
+		view.on("input", commit);
+		view.on("change", commit);
+		this.field = view;
+		return view;
+	}
+
+	// A native range with its readout. sync_range() paints it; null means "not touched yet".
+	range_of({ min, max, step = 1, ticks = false, fmt = v => String(v) }){
+		const id = this.group + "-range";
+		this.fmt = fmt;
+		this.readout = new View({ tag: "output" }).ac("fm-readout").attr("for", id).text("–");
+		this.range = input().ac("fm-range fm-untouched").attr("type", "range").attr("id", id)
+			.attr("min", min).attr("max", max).attr("step", step);
+		this.range.el.value = (min + max) / 2;   // the browser clamps its own default to a late-set max (3, not 0)
+		if (ticks){
+			this.range.attr("list", id + "-ticks");
+			new View({ tag: "datalist" }).attr("id", id + "-ticks").append(() => {
+				for (let v = min; v <= max; v += 1) option().attr("value", v);
+			});
+		}
+		const commit = () => { this.value = Number(this.range.el.value); };
+		["input", "change", "pointerup"].forEach(e => this.range.on(e, commit));
+		return this.range;
+	}
+
+	sync_range(){
+		if (!this.range) return;
+		const v = this.value, number = typeof v === "number";
+		if (number && Number(this.range.el.value) !== v) this.range.el.value = v;
+		if (number) this.range.rc("fm-untouched"); else this.range.ac("fm-untouched");
+		this.readout.text(number ? this.fmt(v) : v === "skip" ? "skipped" : "–");
+	}
+}
diff --git a/public/framework/ux/Form/Answer.test.mjs b/public/framework/ux/Form/Answer.test.mjs
new file mode 100644
index 0000000000..ef8f372349
--- /dev/null
+++ b/public/framework/ux/Form/Answer.test.mjs
@@ -0,0 +1,56 @@
+// Answer core: value, change, empty, and the radio group road. Node: node public/framework/ux/Form/Answer.test.mjs
+import { install, choose, type } from "./fake-dom.mjs";
+install();
+const { test } = await import("../../core/Test/Test.js");
+const { default: Answer } = await import("./Answer.js");
+const { default: ChooseOne } = await import("./answers/ChooseOne.js");
+const { default: ChooseMany } = await import("./answers/ChooseMany.js");
+const { default: ShortText } = await import("./answers/ShortText.js");
+
+const radios = a => a.el.find(e => e.tag === "input");
+
+test("an Answer starts empty, holds a value, and says change once per change", t => {
+	const a = new Answer();
+	const seen = [];
+	a.on("change", v => seen.push(v));
+	t.ok(a.empty(), "nothing answered yet");
+	a.value = "x";
+	a.value = "x";
+	a.value = "y";
+	t.eq(seen, ["x", "y"], "the same value twice is one change");
+	t.ok(!a.empty(), "now answered");
+	a.value = "";
+	t.eq(a.value, null, "an empty string is not an answer: it is null");
+});
+
+test("ChooseOne: a click stores the option's value, code can set it, the radio follows", t => {
+	const a = new ChooseOne({ options: [["a", "Alpha"], ["b", "Beta"]] });
+	const [ra, rb] = radios(a);
+	choose(rb);
+	t.eq(a.value, "b", "click stores b");
+	a.value = "a";
+	t.ok(ra.checked && !rb.checked, "the radios follow a value set from code");
+	t.eq(new ChooseOne({ options: ["x", "y"], value: "y" }).value, "y", "a value can arrive in the constructor");
+});
+
+test("ChooseMany: the value is the ticked values in option order", t => {
+	const a = new ChooseMany({ options: [["m", "Music"], ["c", "Code"], ["t", "Talks"]] });
+	t.eq(a.value, [], "starts as an empty list, not null");
+	t.ok(a.empty(), "an empty list is empty");
+	const [m, c, tk] = radios(a);
+	choose(tk); choose(m);
+	t.eq(a.value, ["m", "t"], "option order, not click order");
+	choose(tk, false);
+	t.eq(a.value, ["m"], "unticking removes it");
+});
+
+test("ShortText: typing stores the string, empty is null", t => {
+	const a = new ShortText();
+	const [field] = radios(a);
+	type(field, "calm");
+	t.eq(a.value, "calm", "typed text is the value");
+	type(field, "");
+	t.eq(a.value, null, "cleared text is null, so required can see it");
+	a.value = "back";
+	t.eq(field.value, "back", "the field follows code");
+});
diff --git a/public/framework/ux/Form/AnswerCard.js b/public/framework/ux/Form/AnswerCard.js
new file mode 100644
index 0000000000..e47fdfa52b
--- /dev/null
+++ b/public/framework/ux/Form/AnswerCard.js
@@ -0,0 +1,36 @@
+import View, { div, span, p, pre } from "../../core/View/View.js";
+import Question from "./Question.js";
+import "./Answer.js";
+
+/**
+ * AnswerCard: one answer type on the docs page: its id and name, a live question, the value it stores
+ * (as JSON, updating as you answer), and the native element behind it.
+ *   new AnswerCard({ answer: Scale7 })      // the class, not an instance
+ */
+export default class AnswerCard extends View {
+
+	classify(){
+		super.classify();
+		this.ac("fm-card");
+	}
+
+	render(){
+		const A = this.answer;
+		const ex = A.example ?? {};
+		div.c("fm-card-head", () => {
+			span.c("fm-card-id", A.type);
+			span.c("fm-card-name", A.title);
+		});
+		const q = new Question({ type: A.type, label: ex.label, hint: ex.hint, options: ex.options, config: ex.config });
+		const json = pre.c("fm-json", "");
+		const show = () => json.text(JSON.stringify(q.value));
+		q.answer.on("change", show);
+		show();
+		p.c("fm-card-meta", () => {
+			span(`stores ${A.shape}`);
+			span(` · native ${A.native}`);
+			if (A.use) span(` · ${A.use}`);
+		});
+		this.question = q;
+	}
+}
diff --git a/public/framework/ux/Form/Answers.js b/public/framework/ux/Form/Answers.js
new file mode 100644
index 0000000000..ef434d2533
--- /dev/null
+++ b/public/framework/ux/Form/Answers.js
@@ -0,0 +1,47 @@
+import YesNo from "./answers/YesNo.js";
+import Toggle from "./answers/Toggle.js";
+import ChooseOne from "./answers/ChooseOne.js";
+import Dropdown from "./answers/Dropdown.js";
+import ChooseMany from "./answers/ChooseMany.js";
+import Chips from "./answers/Chips.js";
+import Frequency from "./answers/Frequency.js";
+import Agreement from "./answers/Agreement.js";
+import Scale7 from "./answers/Scale7.js";
+import Slider7 from "./answers/Slider7.js";
+import Slider100 from "./answers/Slider100.js";
+import Likelihood from "./answers/Likelihood.js";
+import Stars from "./answers/Stars.js";
+import NumberAnswer from "./answers/NumberAnswer.js";
+import DateAnswer from "./answers/DateAnswer.js";
+import TimeAnswer from "./answers/TimeAnswer.js";
+import ShortText from "./answers/ShortText.js";
+import LongText from "./answers/LongText.js";
+import RankTop3 from "./answers/RankTop3.js";
+import Emoji from "./answers/Emoji.js";
+
+/**
+ * The 20 answer classes in type order (T01 … T20), and how a question's `type` finds one.
+ *   Answers.find("T09") · find("scale7") · find("Scale7") · find("number")   // the class
+ *   Answers.make("stars", { value: 4 })                                       // an instance
+ * A key matches the type id or the class name, case and punctuation ignored, "Answer" suffix optional.
+ */
+export default class Answers {
+
+	static list = [YesNo, Toggle, ChooseOne, Dropdown, ChooseMany, Chips, Frequency, Agreement, Scale7, Slider7,
+		Slider100, Likelihood, Stars, NumberAnswer, DateAnswer, TimeAnswer, ShortText, LongText, RankTop3, Emoji];
+
+	static norm(key){
+		return String(key).toLowerCase().replace(/[^a-z0-9]/g, "").replace(/answer$/, "");
+	}
+
+	static find(key){
+		const k = Answers.norm(key);
+		return Answers.list.find(A => Answers.norm(A.type) === k || Answers.norm(A.name) === k);
+	}
+
+	static make(key, opts = {}){
+		const A = Answers.find(key);
+		if (!A) throw new Error(`Form: no answer type "${key}"`);
+		return new A(opts);
+	}
+}
diff --git a/public/framework/ux/Form/Form.css b/public/framework/ux/Form/Form.css
new file mode 100644
index 0000000000..bdc7de65a6
--- /dev/null
+++ b/public/framework/ux/Form/Form.css
@@ -0,0 +1,152 @@
+/* ux/Form: every rule is in @layer site and reads the framework's own tokens (--prime, --line, --fill-*, --subtle, --ok, --error).
+   Bare button / select / input / textarea already wear the control grammar; this file only adds the shapes it has no word for.
+   Inputs are 16px or more (iOS zooms below that) and every tap target is 44px or more. Doc: readme.md. */
+@layer site {
+
+	/* The framework has no token for the ink on --prime: button.prim and .bg-prime both write the literal. One name here, same value. */
+	.fm-form, .fm-answer { --fm-on-prime: #1a1a1a; }
+	.fm-form { display: flex; flex-direction: column; gap: 1.5rem; }
+	.fm-title { margin: 0; }
+	.fm-questions { display: flex; flex-direction: column; gap: 1.5rem; }
+	.fm-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
+	.fm-actions button { min-height: 48px; padding-inline: 2rem; font-size: max(16px, 1em); }
+	.fm-status { margin: 0; color: var(--subtle); }
+
+	/* Question: a fieldset, so a radio group is announced with its label */
+	.fm-question { border: 0; margin: 0; padding: 0; min-width: 0; }
+	.fm-question.fm-missing { outline: 2px solid var(--error); outline-offset: 0.5rem; border-radius: var(--radius); }
+	.fm-label { padding: 0; margin-bottom: 0.5rem; font-weight: 700; font-size: max(16px, 1em); line-height: 1.4; }
+	.fm-req { color: var(--error); margin-inline-start: 0.25em; }
+	.fm-hint { margin: -0.25rem 0 0.5rem; font-size: 0.875rem; color: var(--subtle); }
+
+	.fm-answer { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
+	.fm-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+
+	/* native text fields */
+	.fm-answer .fm-field { width: 100%; min-height: 48px; font-size: max(16px, 1em); }
+	.fm-answer textarea.fm-field { min-height: 7rem; resize: vertical; }
+
+	/* radio and checkbox groups: the real input is the first child of its label */
+	.fm-group { display: flex; gap: 0.5rem; }
+	.fm-opt { position: relative; display: flex; align-items: center; justify-content: center; min-height: 44px; cursor: pointer; box-sizing: border-box; }
+	.fm-opt > input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+	.fm-opt:has(input:focus-visible) { outline: 2px solid var(--prime); outline-offset: 2px; }
+
+	/* list: a visible native radio or checkbox in a bordered row */
+	.fm-list { flex-direction: column; }
+	.fm-list .fm-opt { justify-content: flex-start; gap: 0.75rem; min-height: 52px; padding: 0.5rem 0.875rem; font-size: max(16px, 1em);
+		border: 1px solid var(--fill-a32); border-radius: var(--radius); background-color: var(--fill-a04); }
+	.fm-list .fm-opt > input { position: static; flex: none; width: 22px; height: 22px; opacity: 1; accent-color: var(--prime); }
+	.fm-list .fm-opt:has(input:checked) { border-color: var(--prime); background-color: color-mix(in srgb, var(--prime) 14%, transparent); }
+
+	/* seg: equal buttons in one row; selected = solid --prime */
+	.fm-seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.25rem; }
+	.fm-seg .fm-opt { min-height: 48px; padding: 0.25rem 0.125rem; text-align: center; font-weight: 600; font-size: max(16px, 1em); line-height: 1.2;
+		border: 1px solid var(--fill-a32); border-radius: var(--radius); background-color: var(--fill-a08); }
+	.fm-seg .fm-opt:hover { border-color: var(--prime); }
+	.fm-seg .fm-opt:has(input:checked) { background-color: var(--prime); border-color: var(--prime); color: var(--fm-on-prime); }
+	.fm-words .fm-opt { font-size: 0.75rem; padding-inline: 0; overflow-wrap: normal; hyphens: none; }
+	.fm-wrap { grid-auto-flow: row; grid-template-columns: repeat(6, 1fr); }
+
+	/* chips */
+	.fm-chips { flex-wrap: wrap; }
+	.fm-chips .fm-opt { min-height: 44px; padding: 0 1rem; font-size: max(16px, 1em); border: 1px solid var(--fill-a32); border-radius: 999px; background-color: var(--fill-a08); }
+	.fm-chips .fm-opt:has(input:checked) { background-color: var(--prime); border-color: var(--prime); color: var(--fm-on-prime); font-weight: 600; }
+
+	/* Scale7: seven buttons, then one line of end words under -3, 0 and +3 */
+	.fm-scale { grid-template-columns: repeat(7, 1fr); grid-auto-flow: row; }
+	.fm-scale .fm-opt { padding: 0; }
+	.fm-ends { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0 0.25rem; font-size: 0.75rem; line-height: 1.3; color: var(--subtle); }
+	.fm-ends .fm-lo { grid-column: 1 / 3; text-align: start; }
+	.fm-ends .fm-mid { grid-column: 3 / 6; text-align: center; }
+	.fm-ends .fm-hi { grid-column: 6 / 8; text-align: end; }
+	.fm-ends.fm-two { grid-template-columns: 1fr 1fr; }
+	.fm-ends.fm-two .fm-lo { grid-column: 1; }
+	.fm-ends.fm-two .fm-hi { grid-column: 2; }
+	.fm-skip { align-self: flex-start; min-height: 44px; font-size: 0.875rem; }
+	.fm-skip.on { border-color: var(--prime); background-color: color-mix(in srgb, var(--prime) 14%, transparent); }
+
+	/* the four marker sets */
+	.fm-num { font-variant-numeric: tabular-nums; }
+	.fm-face { font-size: 1.625rem; line-height: 1; }
+	.fm-icon { font-size: calc(0.875rem + var(--k, 0) * 0.3rem); line-height: 1; }
+	.fm-flip { display: inline-block; transform: scaleY(-1); }
+	.fm-bar { display: block; width: 0.625rem; height: var(--h, 3px); border-radius: 2px; background: var(--subtle); }
+	.fm-bar.fm-bad { background: var(--error); }
+	.fm-bar.fm-good { background: var(--ok); }
+	.fm-bars .fm-opt:has(input:checked) { background-color: color-mix(in srgb, var(--prime) 14%, transparent); }
+
+	/* sliders: native range, a big readout above */
+	.fm-readout { font-size: 2rem; font-weight: 800; line-height: 1.1; text-align: center; font-variant-numeric: tabular-nums; }
+	.fm-range { width: 100%; min-height: 44px; margin: 0; accent-color: var(--prime); cursor: pointer; }
+	.fm-range.fm-untouched { opacity: 0.55; }
+
+	/* stars: the lit run is the checked star and every star before it */
+	.fm-stars { gap: 0.125rem; }
+	.fm-stars .fm-opt { min-width: 44px; }
+	.fm-star { font-size: 2rem; line-height: 1; color: var(--fill-a32); }
+	.fm-stars .fm-opt:has(input:checked) .fm-star,
+	.fm-stars .fm-opt:has(~ .fm-opt input:checked) .fm-star { color: var(--prime); }
+
+	/* emoji: selected gets a ring, not a solid fill, so the emoji stays visible */
+	.fm-emoji { font-size: 1.75rem; line-height: 1; }
+	.fm-emojis .fm-opt:has(input:checked) { background-color: color-mix(in srgb, var(--prime) 14%, transparent); border-color: var(--prime); color: inherit; }
+
+	/* switch */
+	.fm-switch { position: relative; display: flex; align-items: center; gap: 0.75rem; min-height: 44px; cursor: pointer; }
+	.fm-switch > input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+	.fm-track { position: relative; flex: none; width: 52px; height: 32px; border-radius: 999px; background: var(--fill-a32); transition: background 0.15s; }
+	.fm-track::after { content: ""; position: absolute; top: 2px; left: 2px; width: 28px; height: 28px; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow); transition: transform 0.15s; }

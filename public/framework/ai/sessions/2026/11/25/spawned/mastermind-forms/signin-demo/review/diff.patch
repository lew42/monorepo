diff --git a/public/join/readme.md b/public/join/readme.md
new file mode 100644
index 0000000000..9d497fb622
--- /dev/null
+++ b/public/join/readme.md
@@ -0,0 +1,33 @@
+# /join/ — a video asks you to sign in and allow one notification a week
+
+A standalone page (not a framework `page.js`, so no sidebar): a full-height 9:16 video that never stops, the host's words as a caption, and ONE button at the bottom that changes. On a desktop the same column sits centred on a dark backdrop. Open it at [/join/](/join/); `?debug=1` adds a state strip with a "Reset everything" button.
+
+## The button's states (derived on every load, so a reload lands on the right one)
+
+| State | Shown when | Button |
+|---|---|---|
+| `google` | no user | Continue with Google (`ux/Auth/GoogleButton`), plus "Not working?" |
+| `inapp` | no user, inside Instagram/Facebook/… | the "open in your browser" card (Android `intent://`, iOS steps, Copy link, Share) instead of Google |
+| `allow` | user, no push subscription or permission | Allow one notification a week; on iPhone not added to the Home Screen it opens the add-to-home-screen sheet |
+| `done` | user, subscribed, permission granted | "You're in. See you next week." + Send me a test notification now |
+
+The gear is the avatar (top right, once signed in): Sign out, Turn off notifications, Delete account (confirm first).
+
+## Modes (`?debug=1` shows which)
+
+- **google**: the Worker's `/api` answers `/api/config`; Google's own button signs in.
+- **test**: `?test=<key>` adds a "Test sign-in" button that calls `POST /api/auth/test {key}` (staging only); everything after it is the real path. The key is never stored in a file.
+- **No Google client id** (a Worker whose `GOOGLE_CLIENT_ID` is empty, production today): the Google button's fake sign-in shows "Sign-in isn't set up here yet." instead of signing in; the "Not working?" link stays under the button, and in test mode so does Test sign-in.
+- **mock**: no `/api` (the dev server), or `?mock`. Fake sign-in, fake subscribe, a local `showNotification`, and a yellow MOCK badge. State lives in `localStorage["join-mock"]`.
+
+## Files
+
+`index.html`, `main.js` (boots it), `Join.js` (the page class), `join.css`, `copy.js` (**all** words and the video, poster and captions paths: edit text here), `Backend.js` (the Worker's `/api` calls; `Backend.detect()` picks real or mock), `MockBackend.js` (+ `MockBackend.test.mjs`), `JoinState.js` (+ `JoinState.test.mjs`: the button-state rule and the shared-link cleaner; `Join.js` needs a DOM, so its flow is covered by `shoot.mjs` instead), `sw.js` (service worker, scope `/join/`, shows the push payload, caches nothing), `manifest.webmanifest`, `media/` (the video, poster and `captions.vtt`), `shoot.mjs` (the check below). Built on `ux/Auth`: [GoogleButton](/framework/ux/Auth/readme.md) and `InAppBrowser`. The API: [worker/readme.md](/worker/readme.md), "Sign-in, sessions and push".
+
+## Re-run the flow
+
+`node public/join/shoot.mjs [base-url] [out-dir]` walks the whole first-visit path (sign in, allow, reload, test push, notifications off, sign out, delete), prints each check and any console error, and shoots every state at 400 and 1920 wide. Needs Playwright installed globally and Chromium (`channel: "chromium"`; the headless shell denies notifications). The shots go to the out-dir you pass; the shots folder in the task is gitignored, so they are not committed.
+
+## Not proven here
+
+Real Google sign-in needs the page's origin in the Google client's Authorized JavaScript origins. Added to the Home Screen, the iPhone app has its own cookies, so the person signs in again there (the sheet says so). Real push on iOS needs a physical iPhone with the page on the Home Screen. Headless Chromium has no H.264, so the shots show the poster, not the playing video.
diff --git a/public/join/shoot.mjs b/public/join/shoot.mjs
new file mode 100644
index 0000000000..8153b0bccb
--- /dev/null
+++ b/public/join/shoot.mjs
@@ -0,0 +1,80 @@
+// Walks /join/ headless and shoots every state at 400 and 1920 wide.
+//   node public/join/shoot.mjs [base-url] [out-dir]      e.g. node public/join/shoot.mjs https://staging.lew42.com/ shots
+// Needs Playwright installed globally. Also runs the whole mock flow and prints console errors and any failed check.
+import { pathToFileURL } from "node:url";
+import { execSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+
+const { chromium } = await import(pathToFileURL(join(execSync("npm root -g").toString().trim(), "playwright", "index.mjs")).href);
+const base = (process.argv[2] || "http://127.0.0.1:57506/").replace(/\/$/, "");
+const out = process.argv[3] || "public/framework/ai/sessions/2026/11/25/spawned/mastermind-forms/signin-demo/join/shots";
+mkdirSync(out, { recursive: true });
+
+const UA = {
+	ios: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148 Safari/604.1",
+	insta: "Mozilla/5.0 (Linux; Android 13; Pixel 7 Build/TQ3A.230901.001; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120.0.0.0 Mobile Safari/537.36 Instagram 320.0.0.34.109 Android (33/13; 420dpi; 1080x2400; Google; Pixel 7; panther; tensor; en_US; 123456789)",
+};
+const SIZES = { 400: { width: 400, height: 800 }, 1920: { width: 1920, height: 1080 } };
+const SEED = { user: { id: 1, name: "Demo Person", handle: "demo", email: "demo@example.com", avatar_url: "" } };
+
+const browser = await chromium.launch({ channel: "chromium" });
+const errors = [], fails = [];
+const check = (name, ok) => { if (!ok) fails.push(name); console.log(ok ? "ok  " : "FAIL", name); };
+
+async function open({ w, ua, db, grant, query = "" }){
+	const ctx = await browser.newContext({ viewport: SIZES[w], userAgent: ua, hasTouch: !!ua, permissions: grant ? ["notifications"] : [], serviceWorkers: "allow" });
+	if (db) await ctx.addInitScript(d => { if (!localStorage.getItem("join-seeded")){ localStorage.setItem("join-mock", d); localStorage.setItem("join-seeded", "1"); } }, JSON.stringify(db));
+	const page = await ctx.newPage();
+	page.on("console", m => m.type() === "error" && errors.push(`${m.text()} (${page.url()})`));
+	page.on("pageerror", e => errors.push(String(e)));
+	await page.goto(`${base}/join/${query}`, { waitUntil: "networkidle" });
+	await page.waitForTimeout(500);
+	return { ctx, page };
+}
+const shot = async (page, name, w) => { await page.screenshot({ path: `${out}/${name}-${w}.png` }); };
+
+const states = {
+	"1-google": { open: {} },
+	"2-allow": { open: { db: SEED } },
+	"3-ios-sheet": { open: { db: SEED, ua: UA.ios }, then: p => p.click(".main") },
+	"4-done": { open: { db: { ...SEED, push: true }, grant: true } },
+	"5-settings": { open: { db: { ...SEED, push: true }, grant: true }, then: p => p.click(".avatar") },
+	"6-inapp": { open: { ua: UA.insta } },
+	"7-debug": { open: { db: SEED, query: "?debug=1" } },
+};
+for (const w of [400, 1920]) for (const [name, s] of Object.entries(states)){
+	const { ctx, page } = await open({ w, ...s.open });
+	if (s.then){ await s.then(page); await page.waitForTimeout(300); }
+	await shot(page, name, w);
+	await ctx.close();
+}
+
+// The whole flow, as a first-time visitor on the mock path: count the taps.
+{
+	const { ctx, page } = await open({ w: 400, grant: true });
+	const state = () => page.evaluate(() => document.querySelector(".frame").dataset.state);
+	let taps = 0;
+	check("starts on google", await state() === "google");
+	await page.click(".ux-auth-google-btn"); taps++; await page.waitForTimeout(300);
+	check("tap 1 signs in -> allow", await state() === "allow");
+	await page.click(".main"); taps++; await page.waitForTimeout(600);
+	check("tap 2 allows -> done", await state() === "done");
+	await page.reload({ waitUntil: "networkidle" }); await page.waitForTimeout(400);
+	check("reload stays done", await state() === "done");
+	await page.click(".main"); await page.waitForTimeout(500);
+	check("test notification reports sent", /Sent/.test(await page.textContent(".note")));
+	await page.click(".avatar"); await page.click(".sheet .wide:nth-of-type(2)"); await page.waitForTimeout(400);
+	check("turn off notifications -> allow", await state() === "allow");
+	await page.click(".avatar"); await page.click(".sheet .wide:nth-of-type(1)"); await page.waitForTimeout(400);
+	check("sign out -> google", await state() === "google");
+	await page.click(".ux-auth-google-btn"); await page.waitForTimeout(300);
+	await page.click(".avatar"); await page.click(".sheet .wide.danger"); await page.click(".confirm .danger"); await page.waitForTimeout(400);
+	check("delete account -> google, mock db cleared", await state() === "google" && !(await page.evaluate(() => localStorage.getItem("join-mock"))));
+	console.log("taps for a first-time visitor (after landing):", taps);
+	await ctx.close();
+}
+
+await browser.close();
+console.log(errors.length ? "CONSOLE ERRORS:\n" + errors.join("\n") : "no console errors");
+if (fails.length || errors.length) process.exitCode = 1;
diff --git a/public/join/sw.js b/public/join/sw.js
new file mode 100644
index 0000000000..ccd8c5b164
--- /dev/null
+++ b/public/join/sw.js
@@ -0,0 +1,23 @@
+// Service worker (scope /join/): shows a push payload { title, body, url } and opens url on tap. It caches nothing, so /api/ is never cached.
+self.addEventListener("install", () => self.skipWaiting());
+self.addEventListener("activate", e => e.waitUntil(self.clients.claim()));
+
+self.addEventListener("push", e => {
+	let data = {};
+	try { data = e.data ? e.data.json() : {}; } catch { data = { body: e.data?.text() }; }
+	e.waitUntil(self.registration.showNotification(data.title || "lew42", {
+		body: data.body || "",
+		icon: "/app/icons/icon-192.png",
+		badge: "/app/icons/icon-192.png",
+		data: { url: data.url || "/join/" },
+	}));
+});
+
+self.addEventListener("notificationclick", e => {
+	e.notification.close();
+	const url = new URL(e.notification.data?.url || "/join/", self.location.origin).href;
+	e.waitUntil(clients.matchAll({ type: "window", includeUncontrolled: true }).then(list => {
+		const open = list.find(c => c.url.startsWith(self.location.origin + "/join/"));
+		return open ? open.focus().then(c => c.navigate?.(url) ?? c) : clients.openWindow(url);
+	}));
+});

+@layer base, theme, site, util;
+
+@layer site {
+	.wl { display: grid; gap: .4em; font-size: .85em; inline-size: clamp(20rem, 100vw - 24rem, 160rem); max-inline-size: none; }   /* the page measure is too narrow for a seven-column table */
+	.wl-head { display: flex; flex-wrap: wrap; gap: .3em .8em; align-items: baseline; }
+	.wl-stat { opacity: .7; }
+	.wl-run { font: inherit; padding: .05em .5em; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 1em; background: none; color: inherit; cursor: pointer; }
+	.wl-run.is-on { background: color-mix(in srgb, seagreen 25%, transparent); }
+	.wl-rows { max-block-size: 70vh; overflow: auto; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: .4em; }
+	.wl-row { display: grid; grid-template-columns: 2.5em 8em 5.5em 10.5em 15em minmax(24em, 1fr); min-inline-size: 66em; gap: .5em; padding: .15em .4em; align-items: baseline; cursor: pointer; border-block-end: 1px solid color-mix(in srgb, currentColor 8%, transparent); }
+	.wl-headrow { z-index: 1; position: sticky; inset-block-start: 0; background: Canvas; font-weight: 600; cursor: default; }
+	.wl-seq, .wl-clock, .wl-gap, .wl-origin { font-variant-numeric: tabular-nums; opacity: .75; }
+	.wl-gap { display: block; opacity: .5; }
+	.wl-chip { display: inline-block; white-space: nowrap; padding: 0 .5em; border-radius: 1em; background: color-mix(in srgb, gray 25%, transparent); margin-inline-end: .3em; }
+	.wl-row.k-interim, .wl-row.k-guess { opacity: .65; }
+	.wl-row.k-final .wl-chip, .wl-row.k-commit .wl-chip { background: color-mix(in srgb, seagreen 35%, transparent); }
+	.wl-row.k-deliver .wl-chip, .wl-row.k-go .wl-chip, .wl-row.k-chunk .wl-chip { background: color-mix(in srgb, royalblue 30%, transparent); }
+	.wl-row.k-stale .wl-chip, .wl-row.k-commit-dropped .wl-chip { background: color-mix(in srgb, goldenrod 40%, transparent); }
+	.wl-chip.wl-amend { background: color-mix(in srgb, orange 45%, transparent); }
+	.wl-chip.wl-dupchip { background: color-mix(in srgb, crimson 45%, transparent); }
+	.wl-row.is-dup { background: color-mix(in srgb, crimson 12%, transparent); }
+	.wl-row.c-amend { background: color-mix(in srgb, orange 12%, transparent); }
+	.wl-w.wl-add { background: color-mix(in srgb, seagreen 30%, transparent); }
+	.wl-w.wl-del { background: color-mix(in srgb, crimson 25%, transparent); text-decoration: line-through; }
+	.wl-note { opacity: .5; }
+	.wl-detail { padding: .3em .6em; background: color-mix(in srgb, currentColor 5%, transparent); }
+	.wl-json { white-space: pre-wrap; word-break: break-word; font-family: monospace; max-block-size: 20em; overflow: auto; }
+	.wl-legend { opacity: .65; }
+	@media (max-width: 48rem) {
+		.wl-headrow { display: none; }
+		.wl-row { grid-template-columns: 2.5em 7.5em 4.5em 1fr; min-inline-size: 0; }
+		.wl-origin, .wl-text { grid-column: 2 / -1; }
+	}
+	.wl-empty { padding: .8em; }
+}
diff --git a/public/framework/audio/Whisper/WhisperLog.js b/public/framework/audio/Whisper/WhisperLog.js
new file mode 100644
index 000000000..7c1c0e7e3
--- /dev/null
+++ b/public/framework/audio/Whisper/WhisperLog.js
@@ -0,0 +1,192 @@
+import { View, div, span, button } from "../../core/View/View.js";
+import JSONL from "../../ext/JSONL/JSONL.js";
+import FsFile from "../../ext/filesystem/FsFile.js";
+import Rows from "./WhisperLogRows.js";
+
+View.stylesheet(import.meta, "WhisperLog.css");
+
+/**
+ * class WhisperLog — the one log of everything between the microphone and the page, one line per event,
+ * every line numbered in the order it happened.
+ *
+ *   WhisperLog.event("composer", "deliver", { msg: "What is it?", req: 4 });   // anyone can add a line
+ *   WhisperLog.attach(mic, system);                                            // wires the downstream events (below)
+ *   new WhisperLog();                                                          // the view: a table that tails the file
+ *
+ * A line: `{ seq, run, t, at, src, kind, msg, ...whatever else }`. `seq` counts up per page load (`run` names it, so
+ * two tabs never mix); `src` is where it came from, `kind` what happened:
+ *
+ *   server   interim | final   whisper-server's own reply to one request: `msg` is its text, `server` its WHOLE
+ *                              answer (segments, word probabilities, no_speech_prob), `req`, `segment`, `ms`
+ *   dictate  guess | commit | stale   what `ux/Dictate` did with a reply (a reply dropped as out of date is "stale")
+ *   composer commit-in | commit-dropped | enqueue | post | send-check | deliver    the box and the send queue (`ext/Chat/Mic.js`)
+ *   refine   sending | go | chunk | done | sentences    `RefineSystem`: the send to the cleaner, the chunk, the sentence list
+ *
+ * Stored in `/framework/ai/whisper/<date>.jsonl`, the day file `WhisperSession` already wrote (one store, one writer,
+ * tailed by `JSONL.live()`); old lines have no `seq` and the table skips them. Nothing records unless a page wires
+ * it: `WhisperSession.record` (the server lines) and `attach()` (the rest). Reading rules: `WhisperLogRows.js`.
+ * Doc: `audio/Whisper/readme.md`.
+ */
+export default class WhisperLog extends View {
+	static icon = "receipt_long";
+	static dir = "/framework/ai/whisper/";
+	static path(){ return `${WhisperLog.dir}${new Date().toISOString().slice(0, 10)}.jsonl`; }
+
+	static run = Date.now().toString(36) + Math.random().toString(36).slice(2, 5);
+	static seq = 0;
+	static where = globalThis.location?.pathname ?? "";
+
+	/** An ISO time as local time (the file keeps UTC): `19:08:55.880`, or with `date` false `10-16 19:08:50`. */
+	static local(at, ms = false){
+		const d = new Date(at);
+		if (isNaN(d)) return "";
+		const p = (n, w = 2) => String(n).padStart(w, "0"), clock = `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
+		return ms ? `${clock}.${p(d.getMilliseconds(), 3)}` : `${p(d.getMonth() + 1)}-${p(d.getDate())} ${clock}`;
+	}
+
+	/** Add one line. Returns its `seq` at once; the write is not awaited and never throws. */
+	static event(src, kind, fields = {}){
+		const seq = ++WhisperLog.seq;
+		const t = globalThis.performance ? +(performance.timeOrigin + performance.now()).toFixed(2) : Date.now();
+		const line = { seq, run: WhisperLog.run, t, at: new Date().toISOString(), src, kind, ...fields };
+		if (seq === 1) line.page = WhisperLog.where;
+		try { FsFile.append(WhisperLog.path(), line).catch(() => {}); } catch {}
+		return seq;
+	}
+
+	/** One whisper-server reply, in the shape `Dictate.on_whisper` and `WhisperSession.record` use. */
+	static record({ kind, text, body, ...rest }){
+		return WhisperLog.event("server", kind, { msg: text ?? "", server: body, ...rest });
+	}
+
+	/** Wire the downstream half: `mic` is a `ComposerMic`/`Dictate`, `system` a `RefineSystem` (either may be omitted).
+	 *  Only wraps methods on these two instances; each wrapper logs, then calls the original and returns its result. */
+	static attach(mic, system){
+		const E = WhisperLog.event;
+		const wrap = (obj, name, before, after) => {
+			const orig = obj[name];
+			if (typeof orig !== "function" || orig.wl) return;
+			const fn = function(...args){
+				try { before?.(args); } catch {}
+				const out = orig.apply(this, args);
+				try { after?.(args, out); } catch {}
+				return out;
+			};
+			fn.wl = true;
+			obj[name] = fn;
+		};
+		if (mic){
+			mic.on_trace = (kind, f) => E("dictate", kind, f);
+			mic.response_format = "verbose_json";   // the log wants everything the server says; ~70 ms slower per reply, so only a mic that is logged
+			const guess = mic.on_guess;
+			mic.on_guess = text => { E("dictate", "guess", { msg: text }); return guess?.call(mic, text); };
+			let pushed = 0;
+			wrap(mic, "commit", ([text, reason]) => { pushed = 0; E("composer", "commit-in", { msg: String(text ?? ""), reason }); },
+				([text]) => { if (!pushed) E("composer", "commit-dropped", { msg: String(text ?? ""), why: "stripped as already sent, or an annotation" }); });
+			wrap(mic, "push_to_target", ([text, reason, chunk]) => { pushed++; E("dictate", "commit", { msg: String(text ?? ""), reason, chunk }); });
+			wrap(mic, "enqueue", ([items]) => (items ?? []).forEach(it => E("composer", "enqueue", { msg: typeof it === "string" ? it : it.text, raw: it?.raw ?? undefined })));
+			wrap(mic, "post_held", ([item]) => E("composer", "post", { msg: typeof item === "string" ? item : item?.text, raw: item?.raw ?? undefined }));
+			wrap(mic, "same_as_last_send", null, (a, dup) => E("composer", "send-check", { msg: String(a[0] ?? ""), dup }));
+			const deliver = mic.deliver;
+			if (typeof deliver === "function") mic.deliver = (entry, ...r) => { E("composer", "deliver", { msg: entry?.text, raw: entry?.raw, via: entry?.via }); return deliver.call(mic, entry, ...r); };
+		}
+		if (system){
+			wrap(system, "sending_start", ([text]) => E("refine", "sending", { msg: String(text ?? "") }));
+			wrap(system, "go", ([text]) => E("refine", "go", { msg: String(text ?? "").trim() }),
+				([text], p) => {
+					E("refine", "chunk", { msg: String(text ?? "").trim(), n: system.chunks.length });
+					Promise.resolve(p).then(() => { const c = system.chunks.at(-1); if (c) E("refine", "done", { msg: c.raw, status: c.status, ms: c.ms, error: c.error || undefined }); }).catch(() => {});
+				});
+			let before = "";
+			wrap(system, "compose", null, () => {
+				const sentences = (system.prompt?.clean ?? []).map(s => s.text), key = sentences.join("\u0001");
+				if (key === before || !sentences.length) return;
+				before = key;
+				const repeats = sentences.filter((s, i) => i && Rows.norm(s) && Rows.norm(s) === Rows.norm(sentences[i - 1])).length;
+				E("refine", "sentences", { msg: sentences.at(-1), n: sentences.length, all: sentences, repeats: repeats || undefined });
+			});
+		}
+		return WhisperLog;
+	}
+
+	// ---- the view ----
+
+	render(){
+		this.ac("wl");
+		this.only_problems = false;
+		this.$head = div.c("wl-head");
+		div.c("wl-legend", "req = the request number sent to whisper-server · seg = which segment · conf = the average word confidence (1 is sure) · nospeech = the chance the audio was not speech · click a row for everything it recorded.");
+		this.$rows = div.c("wl-rows");
+		this.log = new JSONL({ url: WhisperLog.path() });
+		this.log.live(() => this.draw()).then(() => this.draw());   // live() calls back for later lines only; the first replay resolves the promise
+		this.draw();
+	}
+
+	lines(){ return (this.log?.logs ?? []).filter(l => l && l.seq != null); }
+
+	draw(){
+		const all = this.lines(), runs = Rows.runs(all);
+		this.run ??= runs.at(-1);
+		if (this.run && !runs.includes(this.run)) this.run = runs.at(-1);
+		let rows = Rows.annotate(all.filter(l => l.run === this.run));
+		const sum = Rows.summary(rows);
+		if (this.only_problems) rows = rows.filter(r => r.change === "amend" || r.dup_of != null);
+		this.$head.empty(() => {
+			h4.c("wl-title", "Whisper log: every event, in order");
+			span.c("wl-stat", `${sum.rows} events · ${sum.amends} amended · ${sum.dups} duplicates`);
+			runs.forEach(r => button.c(`wl-run${r === this.run ? " is-on" : ""}`, this.run_label(r, all)).click(() => { this.run = r; this.draw(); }));
+			button.c(`wl-run${this.only_problems ? " is-on" : ""}`, "problems only").click(() => { this.only_problems = !this.only_problems; this.draw(); });
+		});
+		const stick = this.$rows.el.scrollTop + this.$rows.el.clientHeight >= this.$rows.el.scrollHeight - 40;
+		this.$rows.empty(() => {
+			if (!rows.length) return div.c("wl-empty muted", "Nothing yet. Speak into a page that wires the log (the Refine page does).");
+			div.c("wl-row wl-headrow", () => { ["#", "time", "src", "kind", "origin", "text (changed words vs the previous line)"].forEach(t => span.c("wl-h", t)); });
+			let prev_t = null;
+			rows.forEach(r => {
+				const gap = prev_t == null ? "" : `+${Math.round(r.t - prev_t)} ms`;
+				prev_t = r.t;
+				const box = div.c(`wl-row is-${r.src} k-${r.kind} c-${r.change}${r.dup_of != null ? " is-dup" : ""}`, () => {
+					span.c("wl-seq", String(r.seq));
+					span.c("wl-at", () => { span.c("wl-clock", WhisperLog.local(r.at, true)); span.c("wl-gap", gap); });
+					span.c("wl-src", r.src);
+					span.c("wl-kind", () => {
+						span.c("wl-chip", r.kind);
+						if (r.change === "amend") span.c("wl-chip wl-amend", "amended");
+						if (r.dup_of != null) span.c("wl-chip wl-dupchip", `same as #${r.dup_of}`);
+					});
+					span.c("wl-origin", this.origin(r));
+					span.c("wl-text", () => {
+						if (r.diff && r.change !== "same") r.diff.forEach(d => span.c(`wl-w wl-${d.op}`, d.w + " "));
+						else span.c("wl-w", r.msg ?? "");
+						if (r.change === "same" && r.prev_seq != null) span.c("wl-note", ` (unchanged from #${r.prev_seq})`);
+					});
+				});
+				const detail = div.c("wl-detail", () => { div.c("wl-json", JSON.stringify(this.detail(r), null, 1)); });
+				detail.el.hidden = true;
+				box.el.addEventListener("click", () => { detail.el.hidden = !detail.el.hidden; });
+			});
+		});
+		if (stick) this.$rows.el.scrollTop = this.$rows.el.scrollHeight;
+	}
+
+	/** A run button reads as its start time and size, so a run is findable without knowing its id. */
+	run_label(run, all){
+		const mine = all.filter(l => l.run === run);
+		return `${WhisperLog.local(mine[0]?.at)} · ${mine.length}`;
+	}
+
+	/** The ids that say where a line came from, so a duplicate shows two different origins. */
+	origin(r){
+		const bits = [];
+		if (r.req != null) bits.push(`req ${r.req}`);
+		if (r.segment != null) bits.push(`seg ${r.segment}`);
+		if (r.chunk) bits.push(`chunk ${String(r.chunk).slice(0, 6)}`);
+		if (r.n != null) bits.push(`n ${r.n}`);
+		if (r.ms != null) bits.push(`${r.ms} ms`);
+		const s = r.server?.segments;
+		if (s?.length) bits.push(`conf ${(s.reduce((a, x) => a + Math.exp(x.avg_logprob ?? 0), 0) / s.length).toFixed(2)}`, `nospeech ${Math.max(...s.map(x => x.no_speech_prob ?? 0)).toExponential(0)}`);
+		return bits.join(" · ");
+	}
+
+	detail(r){ const { diff, ...rest } = r; return rest; }
+}
diff --git a/public/framework/audio/Whisper/WhisperLogRows.js b/public/framework/audio/Whisper/WhisperLogRows.js
new file mode 100644
index 000000000..3170db014
--- /dev/null
+++ b/public/framework/audio/Whisper/WhisperLogRows.js
@@ -0,0 +1,84 @@
+/**
+ * class WhisperLogRows — the pure half of the Whisper log: how to read a list of log lines. No DOM, so
+ * `node --test` runs it. `WhisperLog.View` draws what `annotate()` returns.
+ *
+ *   const rows = WhisperLogRows.annotate(lines);   // sorted; each row gains .change .diff .dup_of
+ *
+ * `change` says what a row did to the previous row of its lane (same segment of Whisper replies, or the same
+ * stage downstream): "new", "same", "grow" (only words added at the end), "amend" (an earlier word changed).
+ * `dup_of` is the `seq` of an earlier row at the same stage with the same words: the duplicate to look for.
+ * Doc: `audio/Whisper/readme.md`.
+ */
+export default class WhisperLogRows {
+
+	/** Stages where the same words appearing twice means a duplicate. A grey interim guess repeating is normal, so it is not here. */
+	static DUP_STAGES = new Set(["server:final", "dictate:commit", "composer:enqueue", "composer:post", "composer:deliver", "refine:go", "refine:chunk", "chat:bubble"]);
+
+	static norm(t){ return String(t ?? "").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim(); }
+	static words(t){ return String(t ?? "").trim().split(/\s+/).filter(Boolean); }
+	static stage(row){ return `${row.src}:${row.kind}`; }
+
+	/** The lane a row is compared inside: Whisper replies of one segment, else the same stage. */
+	static lane(row){ return row.src === "server" && row.segment != null ? `server:${row.segment}` : WhisperLogRows.stage(row); }
+
+	/** Word diff of `b` against `a` (LCS, case and trailing punctuation ignored): [{w, op: "same"|"add"|"del"}]. */
+	static diff(a, b){
+		const A = WhisperLogRows.words(a), B = WhisperLogRows.words(b), n = (w) => w.toLowerCase().replace(/[.,!?;:]+$/, "");
+		const L = Array.from({ length: A.length + 1 }, () => new Array(B.length + 1).fill(0));
+		for (let i = A.length - 1; i >= 0; i--) for (let j = B.length - 1; j >= 0; j--)
+			L[i][j] = n(A[i]) === n(B[j]) ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
+		const out = [];
+		let i = 0, j = 0;
+		while (i < A.length && j < B.length){
+			if (n(A[i]) === n(B[j])){ out.push({ w: B[j], op: "same" }); i++; j++; }
+			else if (L[i + 1][j] >= L[i][j + 1]) out.push({ w: A[i++], op: "del" });
+			else out.push({ w: B[j++], op: "add" });
+		}
+		while (i < A.length) out.push({ w: A[i++], op: "del" });
+		while (j < B.length) out.push({ w: B[j++], op: "add" });
+		return out;
+	}
+
+	/** "new" | "same" | "grow" | "amend": what `text` did to the `before` text of its lane. */
+	static change(before, text){
+		if (before == null) return "new";
+		const d = WhisperLogRows.diff(before, text);
+		if (d.every(x => x.op === "same")) return "same";
+		const shared = d.filter(x => x.op === "same").length, shorter = Math.min(WhisperLogRows.words(before).length, WhisperLogRows.words(text).length);
+		if (shared < shorter / 2) return "new";   // a different sentence in the same lane, not a rewrite of the last one
+		const del = d.some(x => x.op === "del");
+		if (!del) return "grow";
+		// the last word of a guess is still forming: a lone changed last word is a tweak, not an amend of earlier words
+		const cut = d.findLastIndex(x => x.op === "same");
+		const tail_only = !d.slice(0, cut + 1).some(x => x.op !== "same");
+		return tail_only && d.filter(x => x.op === "del").length <= 1 ? "grow" : "amend";
+	}
+
+	/** Sort by time then seq, and mark every row: change, diff against its lane's previous row, dup_of. */
+	static annotate(lines){
+		const rows = [...lines].filter(l => l && l.seq != null).sort((a, b) => (a.t ?? 0) - (b.t ?? 0) || a.seq - b.seq);
+		const last = new Map(), seen = new Map();
+		return rows.map(r => {
+			const row = { ...r }, text = r.msg ?? "", lane = WhisperLogRows.lane(r);
+			const prev = last.get(lane);
+			row.change = text ? WhisperLogRows.change(prev?.msg, text) : "none";
+			row.diff = text && prev?.msg ? WhisperLogRows.diff(prev.msg, text) : null;
+			row.prev_seq = prev?.seq ?? null;
+			if (text) last.set(lane, r);
+			const stage = WhisperLogRows.stage(r), key = `${r.run}|${stage}|${WhisperLogRows.norm(text)}`;
+			if (text && WhisperLogRows.DUP_STAGES.has(stage) && WhisperLogRows.norm(text).length > 1){
+				if (seen.has(key)) row.dup_of = seen.get(key); else seen.set(key, r.seq);
+			}
+			return row;
+		});
+	}
+
+	static runs(lines){ return [...new Set(lines.filter(l => l?.run).map(l => l.run))]; }
+
+	/** One line of facts: how many replies, how many amended, how many duplicates, per stage. */
+	static summary(rows){
+		const by = {};
+		for (const r of rows){ const s = WhisperLogRows.stage(r); by[s] = (by[s] ?? 0) + 1; }
+		return { rows: rows.length, amends: rows.filter(r => r.change === "amend").length, dups: rows.filter(r => r.dup_of != null).length, by };
+	}
+}
diff --git a/public/framework/audio/Whisper/WhisperLogRows.test.mjs b/public/framework/audio/Whisper/WhisperLogRows.test.mjs
new file mode 100644
index 000000000..285035e35
--- /dev/null
+++ b/public/framework/audio/Whisper/WhisperLogRows.test.mjs
@@ -0,0 +1,51 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import Rows from "./WhisperLogRows.js";
+
+const line = (seq, src, kind, msg, extra = {}) => ({ seq, t: seq * 10, run: "r1", src, kind, msg, ...extra });
+
+test("diff marks added and removed words", () => {
+	const d = Rows.diff("and so my fellow", "and so, my fellow Americans");
+	assert.deepEqual(d.filter(x => x.op !== "same").map(x => x.w), ["Americans"]);
+});
+
+test("change: new, same, grow, amend", () => {
+	assert.equal(Rows.change(null, "hello there"), "new");
+	assert.equal(Rows.change("hello there", "Hello there."), "same");
+	assert.equal(Rows.change("hello there", "hello there my friend"), "grow");
+	assert.equal(Rows.change("what is the county doing", "what is the country doing today"), "amend");
+	assert.equal(Rows.change("It has two sentences.", "And so, my fellow Americans"), "new");   // another sentence, not a rewrite
+});
+
+test("annotate: an interim amended inside one segment is flagged against the previous reply of that segment", () => {
+	const rows = Rows.annotate([
+		line(1, "server", "interim", "so there is interim", { segment: 0 }),
+		line(2, "server", "interim", "so there's interim and final", { segment: 0 }),
+		line(3, "server", "final", "So there's interim and final.", { segment: 0 }),
+	]);
+	assert.equal(rows[0].change, "new");
+	assert.equal(rows[1].change, "amend");
+	assert.equal(rows[2].change, "same");
+	assert.equal(rows[2].prev_seq, 2);
+});
+
+test("annotate: the same words at the same downstream stage twice is a duplicate with its origin", () => {
+	const rows = Rows.annotate([
+		line(1, "composer", "deliver", "What is minion-kaq?", { req: 4 }),
+		line(2, "composer", "deliver", "what is minion kaq", { req: 5 }),
+		line(3, "composer", "enqueue", "What is minion-kaq?"),
+	]);
+	assert.equal(rows[0].dup_of, undefined);
+	assert.equal(rows[1].dup_of, 1);
+	assert.equal(rows[2].dup_of, undefined);   // a different stage is the normal path, not a duplicate
+});
+
+test("annotate: repeated interim guesses are never duplicates", () => {
+	const rows = Rows.annotate([line(1, "server", "interim", "okay", { segment: 0 }), line(2, "server", "interim", "okay", { segment: 1 })]);
+	assert.equal(rows.filter(r => r.dup_of != null).length, 0);
+});
+
+test("summary counts", () => {
+	const rows = Rows.annotate([line(1, "server", "final", "yes sir"), line(2, "server", "final", "yes sir")]);
+	assert.deepEqual(Rows.summary(rows).dups, 1);
+});

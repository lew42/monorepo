@@ -0,0 +1,23 @@
+// node Servex/agents/context-alert.test.mjs — a child's context crossing 50% and 75% puts one line in its session log, and the parent's follow forwards it.
+import assert from "node:assert"; import fs from "node:fs"; import os from "node:os"; import path from "node:path";
+process.env.SERVEX_HOME = fs.mkdtempSync(path.join(os.tmpdir(), "servex-alert-"));
+const { Agents } = await import("./Agents.js");
+const Follow = (await import("../Follow.js")).default;
+const dir = "public/framework/ai/sessions/_context-alert-test/c1", log = path.join(dir, "session.jsonl");
+fs.mkdirSync(dir, { recursive: true }); fs.writeFileSync(log, "{\"assign\":{\"agent\":\"c1\"}}\n");
+const events = [];
+const mk = over => Object.assign(Object.create(Agents.Agent.prototype), { id: "c1", parent: "p", context: 0, task: { dir }, host: { window_tokens: 1000000 }, emit: e => events.push(e) }, over);
+const lines = () => fs.readFileSync(log, "utf8").trim().split("\n").slice(1);
+try {
+	const a = mk();
+	a.context = 499000; a.context_alert(); assert.equal(lines().length, 0, "under 50%: silent");
+	a.context = 520000; a.context_alert(); a.context = 530000; a.context_alert(); assert.equal(lines().length, 1, "50% once");
+	assert.match(lines()[0], /context 52% \(520,000 of 1,000,000 tokens\): c1/);
+	a.context = 760000; a.context_alert(); assert.equal(lines().length, 2, "75% once");
+	assert.deepEqual(events.map(e => e.pct), [50, 75]);
+	assert.equal(Follow.worth_waking(lines()).length, 2, "the parent's follow forwards both");
+	a.context = 100000; a.context_alert(); a.context = 510000; a.context_alert(); assert.equal(lines().length, 3, "a compaction re-arms 50%");
+	mk({ parent: null, context: 900000 }).context_alert(); mk({ one_shot: true, context: 900000 }).context_alert();
+	assert.equal(lines().length, 3, "no parent / one-shot fork: no line");
+	console.log("context-alert: ok");
+} finally { fs.rmSync("public/framework/ai/sessions/_context-alert-test", { recursive: true, force: true }); }
diff --git a/public/framework/ai/doc/context.md b/public/framework/ai/doc/context.md
index b47c208d1..8709b196d 100644
--- a/public/framework/ai/doc/context.md
+++ b/public/framework/ai/doc/context.md
@@ -22,6 +22,10 @@ Yes. Servex records `context` on every agent: the tokens the last turn had in it
 
 Servex compacts for you in three places, all described in [compaction.md](compaction.md): before an agent sleeps (over 100k), when an idle agent is nudged and chooses to (a mastermind at 150k), and at a safety ceiling (400k tokens or 500 MB). The Claude CLI has its own auto-compact near the full window, which Servex never turns off. A compaction is a turn that replaces the conversation with a summary of about 10 to 20k tokens.
 
+## Context alerts to the parent
+
+The nudge above talks to the agent itself. A child with a parent also tells the parent: the first time its context passes 50% of the window, and again at 75%, `context_alert()` (Agents.js) appends one `alert: context 52% (520,000 of 1,000,000 tokens): <id>. Wind down: …` line to the child's own session log. The parent already tails that log (a `alert:` line is one Follow forwards), so the parent decides: wind the child down, send it the compact nudge, or give the next phase to a fresh agent. A compaction that drops the context below 50% re-arms both levels. No parent, or a one-shot fork: no line.
+
 ## Context dependency: a fresh agent knows only what was written down
 
 Whatever the last agent had read is gone when it is replaced: a new session, a renewed mastermind, a minion that ends, a compaction. The only things that carry over are the system prompt and CLAUDE.md, the files in the repo, and the logs. So:

diff --git a/public/framework/ai/sessions/readme.md b/public/framework/ai/sessions/readme.md
index 6bce96dc1..90a5ae7ed 100644
--- a/public/framework/ai/sessions/readme.md
+++ b/public/framework/ai/sessions/readme.md
@@ -32,9 +32,10 @@ A session folder is one of three kinds:
 |---|---|
 | `cache.jsonl`, `index.json`, day/month/year `index.json` | `ai/AISession/AISessionIndex.mjs`: a file watch on the transcripts re-reads only the new bytes. Started inside the dev server by `AISession/AISessionTailer.mjs` (main checkout only). |
 | a **record-only** session (no transcript here: a cloud voice call) | the same writer: `AISessionIndex.record_snap()` builds its snapshot (id = folder name, `kind` from `session.jsonl` line 1, times and `cost` lines from the record) at start-up and when `session.jsonl` grows. Shown as the `cloud voice` kind. Needs a dev-server restart to start. |
-| a Servex agent's folder and line 1 (`session.jsonl`, at any depth) | `open_task()` in `Servex/agents/Agents.js`, called from `Agents.spawn()` *before* the agent's first turn (the `spawn_agent` tool) |
+| a Servex agent's folder and line 1 (`session.jsonl`, at any depth) | `open_task()` in `Servex/agents/Agents.js` (the folder from `TaskDirs`, an alias of `DatedFiles.sessions`: [Server/doc/dated-files.md](/Server/doc/dated-files.md)), called from `Agents.spawn()` *before* the agent's first turn (the `spawn_agent` tool) |
 | any later line | `node .claude/hooks/append.mjs <file> <lines.json>`: validates against `.claude/hooks/jsonl-schema.mjs`, turns `"NOW"` into the clock, and picks `session.jsonl` vs `task.jsonl` through `SessionRecord.start_file()` |
-| a cloud voice call's folder and lines | `Servex/ext/remote/RemoteMCP.js` `voice_session()` / `record()` / `after()` ([voice system](/Servex/ext/remote/doc/cloud-voice-agent.md)) |
+| a cloud voice call's folder and lines | `Servex/ext/remote/RemoteMCP.js` `voice_session()` (its path from `DatedFiles.sessions.path`) / `record()` / `after()` ([voice system](/Servex/ext/remote/doc/cloud-voice-agent.md)) |
+| the day-index row of any folder, however it was made | `DatedFiles.sessions.watch()` / `sync(dir)` (`Server/DatedFiles.mjs`): a folder appears or its record grows, one `session` row on its start day; the SessionStart hook's folder comes from `DatedFiles.sessions.session_dir` |
 | tags, notes, alerts, closed | `AISession.log()`; digests by `AISessionDigest.mjs` |
 
 ## How data is read
diff --git a/public/framework/core/Item/Dated.js b/public/framework/core/Item/Dated.js
index dfb528fb9..80c4ecb15 100644
--- a/public/framework/core/Item/Dated.js
+++ b/public/framework/core/Item/Dated.js
@@ -7,6 +7,8 @@ export default class Dated {
 	/** The registry: one entry per collection. `root` has a `{module}` slot; `index` is the folder holding the YYYY/MM/DD/index.jsonl day streams. */
 	static collections = {
 		projects: { kind: "project", file: "project.jsonl", root: "public/framework/{module}/projects", index: "public/framework/ai/sessions" },
+		// sessions: the store itself. A folder is a session or a task (task.jsonl in a folder not yet moved); the index is the same day file.
+		sessions: { kind: "session", file: "session.jsonl", root: "public/framework/ai/sessions", index: "public/framework/ai/sessions" },
 	};
 
 	constructor(name = "projects", spec = Dated.collections[name]){
@@ -21,6 +23,9 @@ export default class Dated {
 		return `${root}/${Day.path(day)}/${slug}`;
 	}
 
+	/** The folder of one day: <root>/YYYY/MM/DD (where that day's items, and its day.jsonl, live). */
+	day_path(day, module){ return this.path(day, "", module).replace(/\/$/, ""); }
+
 	/** The day's stream: <index>/YYYY/MM/DD/index.jsonl. */
 	index_path(day){ return `${this.index}/${Day.path(day)}/index.jsonl`; }
 
diff --git a/public/framework/core/Item/Dated.test.mjs b/public/framework/core/Item/Dated.test.mjs
index 1f3570b61..74df926bf 100644
--- a/public/framework/core/Item/Dated.test.mjs
+++ b/public/framework/core/Item/Dated.test.mjs
@@ -61,5 +61,24 @@ t((await f.check()).stale.length === 1, "check names a row whose folder is gone"
 const back = await f.undo();
 t(back.undone === done.run && fs.existsSync(path.join(root, sess)), "undo puts it back");
 
+// the sessions collection: paths, make, sync, watch, check
+const S = DatedFiles.sessions, UID = "11111111-2222-3333-4444-555555555555";
+t(S.path("2026-10-20", "x") === "public/framework/ai/sessions/2026/10/20/x" && S.day_path("2026-10-20") === "public/framework/ai/sessions/2026/10/20", "sessions folder rule");
+const sdir = S.make(S.home({ slug: "my-task", session_id: UID, day: "2026-10-20" }));
+t(sdir.endsWith(path.join("2026", "10", "20", "session-11111111", "my-task")) && fs.existsSync(sdir), "make puts a task inside its session folder");
+let refused = false; fs.writeFileSync(path.join(sdir, "task.jsonl"), "{}\n"); try { S.make(sdir); } catch { refused = true; }
+t(refused, "make refuses a folder that holds a task");
+const w = S.watch({ debounce: 50 }), nd = path.join(S.day_dir("2026-10-20"), "watched");
+fs.mkdirSync(nd, { recursive: true });
+fs.writeFileSync(path.join(nd, "session.jsonl"), JSON.stringify({ assign: { session_id: "watched", title: "W", at: "2026-10-20T12:00:00" } }) + "\n");
+await new Promise(r => setTimeout(r, 500));
+const rows = () => DatedFiles.lines(path.join(root, "public/framework/ai/sessions/2026/10/20/index.jsonl")).map(l => l.session).filter(r => r?.id === "watched");
+t(rows().length === 1 && rows()[0].state === "open", "watch writes the row when a folder appears");
+fs.appendFileSync(path.join(nd, "session.jsonl"), JSON.stringify({ finish: { at: "2026-10-20T13:00:00" } }) + "\n");
+await new Promise(r => setTimeout(r, 500)); w.close();
+t(rows().length === 2 && rows()[1].state === "done", "watch writes a row when the record grows");
+t(S.sync(nd) === null, "sync writes nothing when nothing changed");
+const sc = await S.check(); t(sc.ok && sc.stale.length === 0, "sessions check ok: " + JSON.stringify(sc));
+
 fs.rmSync(root, { recursive: true, force: true });
 console.log(`Dated.test.mjs: ${n} checks passed`);

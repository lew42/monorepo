@@ -0,0 +1,20 @@
+/* The session page's Overview list (SessionFeed). Prefix sfeed-. Rows come from SessionTaskRow and TaskView.row; only the list frame is here. */
+@layer site {
+	.sfeed { width: 100%; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; gap: .75rem; max-width: 70rem; }
+	.sfeed-head { margin: 0; font-size: 1.05rem; }
+	.sfeed-list { padding: .25rem 0; min-width: 0; max-width: 100%; box-sizing: border-box; overflow-wrap: anywhere; }
+	.sfeed-item { min-width: 0; }
+	.sfeed-item { border-top: 1px solid var(--mob-line); padding: .25rem .75rem; }
+	.sfeed-list > .sfeed-item:first-child { border-top: 0; }
+	.sfeed-item.is-dropped { opacity: .5; }
+	.sfeed-row { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; }
+	.sfeed-sum { display: flex; align-items: flex-start; gap: .75em; cursor: pointer; list-style: none; }
+	.sfeed-sum::-webkit-details-marker { display: none; }
+	.sfeed-sum::before { content: "▸"; padding-top: .9em; color: color-mix(in srgb, var(--ink) 50%, transparent); }
+	details[open] > .sfeed-sum::before { content: "▾"; }
+	.sfeed-prog { flex: 0 0 auto; padding-top: .9em; }
+	.sfeed-title { padding: .6em 0; }
+	.sfeed-kids { margin-left: 1.25rem; border-left: 1px solid var(--mob-line); }
+	.sfeed-agent { display: flex; gap: .75em; align-items: baseline; padding: 0 0 .5em 2.5rem; }
+	.sfeed-link { font-size: .8rem; }
+}

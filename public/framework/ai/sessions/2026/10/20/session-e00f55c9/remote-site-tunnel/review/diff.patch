new file mode 100644
index 000000000..004819862
--- /dev/null
+++ b/Server/SiteGateway.mjs
@@ -0,0 +1,167 @@
+import fs from "fs";
+import path from "path";
+import http from "http";
+import net from "net";
+import crypto from "crypto";
+import os from "os";
+import { fileURLToPath } from "url";
+
+/* The site from anywhere: https://monorepo.lew42.com → this gateway (127.0.0.1:8192, via the named
+ * Cloudflare tunnel) → the dev server, dialled at this PC's own LAN address (10.x:3104), never loopback.
+ * The browser sees ONE origin: pages, the live-reload WebSocket, `/whisper/*` and `/servex/*` (Servex's API,
+ * through the dev server's own ServexProxy) all ride it.
+ *
+ * Why the LAN address: the dev server then sees a LAN PEER, exactly like the owner's phone on Wi-Fi, so its own
+ * guards still stand: loopback-only routes (/mcp, /screenshot, /devsource.json, /ai-logs, /recordings) refuse it,
+ * and the socket gets push traffic only (no rpc:cmd, no rpc:write; Socket.js). On top of that, four checks here:
+ *   1. The key. `?key=<remote.token>` once sets an HttpOnly cookie (an HMAC of the token, never the token);
+ *      no cookie, no entry. Cloudflare Access replaces this once it is enabled (doc below).
+ *   2. Origin. A write (any method but GET/HEAD) and every WebSocket must come from our own origin.
+ *   3. DENY: the loopback-only dev routes (/mcp, /ai-logs, /screenshot, /recordings, /devsource.json,
+ *      /Servex/, /Server/, /ask/turn, /push/send) never pass.
+ *   4. /servex/* passes only the page routes in SERVEX (no /mcp, no merge, no project start/stop).
+ * Every request is also marked `x-lew42-remote` (Socket.js drops such a socket to the LAN tier even from loopback).
+ *
+ *     node Server/SiteGateway.mjs       run it alone (Tunnel.mjs `up` also starts it in named mode)
+ *
+ * Doc: Servex/ext/remote/doc/tunnel.md ("The site from anywhere") */
+export default class SiteGateway {
+    static DIR = path.join(process.env.LOCALAPPDATA ?? "", "lew42", "servex");
+    static PORT = 8192;
+    static PUBLIC = "https://monorepo.lew42.com";
+    static COOKIE = "lew42_site";
+    static DENY = /^\/(mcp|ai-logs|screenshot|recordings|devsource\.json|servex|server|ask|push\/send)(\/|$)/i;
+    static SERVEX = /^\/servex\/(api\/item|api\/page-ai|api\/page-session\/(new|resume)|api\/session\/[\w-]+(\/stream)?|api\/refine(\/live)?|api\/tidy|api\/voice(\/card|\/stream)?|api\/whisper(\/stream)?|api\/hitl|api\/local-chat|log\/prompts)$/;
+    static SERVEX_GET = /^\/servex\/(api\/agents|api\/page-agents|api\/page-sessions|api\/sessions|api\/stream|api\/ready-to-merge|waiting)$/;
+
+    constructor({ port = SiteGateway.PORT, target = SiteGateway.target(), key } = {}){
+        this.port = port;
+        this.target = target;   // { host, port, name }: name is the Host header the dev server sees
+        this.key = key ?? fs.readFileSync(path.join(SiteGateway.DIR, "remote.token"), "utf8").trim();
+        this.cookie = crypto.createHmac("sha256", this.key).update("site-cookie").digest("hex");
+    }
+
+    // the dev server at this PC's private LAN address (lan() and safe_host() accept it; loopback() does not)
+    static target(){
+        const ip = Object.values(os.networkInterfaces()).flat()
+            .find(a => a?.family === "IPv4" && !a.internal && /^(10.|192.168.|172.(1[6-9]|2d|3[01]).)/.test(a.address))?.address;
+        if (!ip) throw new Error("no private LAN address on this PC");
+        let port = 3104; try { port = JSON.parse(fs.readFileSync(path.join(SiteGateway.DIR, "ports.json"), "utf8")).monorepo ?? port; } catch {}
+        return { host: ip, port, name: `${ip}:${port}` };
+    }
+
+    // ── the four checks ────────────────────────────────────────────────────
+    has_cookie(req){
+        const m = new RegExp(`(?:^|;\\s*)${SiteGateway.COOKIE}=([0-9a-f]{64})`).exec(req.headers.cookie ?? "");
+        return !!m && crypto.timingSafeEqual(Buffer.from(m[1]), Buffer.from(this.cookie));
+    }
+    key_ok(given){
+        const a = Buffer.from(String(given ?? "")), b = Buffer.from(this.key);
+        return a.length === b.length && crypto.timingSafeEqual(a, b);
+    }
+    // the decoded path, or null when it tries to climb or smuggle (.., backslash, NUL, bad escapes)
+    clean(p){
+        let d; try { d = decodeURIComponent(p); } catch { return null; }
+        if (/\\|\0|(^|\/)\.\.(\/|$)/.test(d) || /%2f|%5c/i.test(p)) return null;
+        return d.replace(/\/{2,}/g, "/");
+    }
+    // why this request is refused, or null to let it through (auth is checked before this)
+    refuse(method, p, origin, upgrade = false){
+        if ((upgrade || !/^(GET|HEAD)$/.test(method)) && origin !== SiteGateway.PUBLIC) return "origin";
+        if (p.startsWith("/servex/")){
+            if (SiteGateway.SERVEX.test(p)) return null;
+            if (SiteGateway.SERVEX_GET.test(p) && /^(GET|HEAD)$/.test(method)) return null;
+            return "servex route not on the list";
+        }
+        if (SiteGateway.DENY.test(p)) return "loopback-only route";
+        return null;
+    }
+
+    // the headers the dev server sees: our Host, the remote marker, a local Origin, no gateway cookie
+    headers(req){
+        const h = { ...req.headers };
+        for (const k of ["host", "x-forwarded-host", "x-lew42-remote", "cf-connecting-ip", "cf-ipcountry", "cf-ray", "cf-visitor", "cdn-loop", "cf-warp-tag-id"]) delete h[k];
+        h.host = this.target.name;
+        h["x-lew42-remote"] = "1";
+        h["x-forwarded-proto"] = "https";
+        if (h.origin) h.origin = "http://" + this.target.name;
+        if (h.referer) h.referer = h.referer.replace(SiteGateway.PUBLIC, "http://" + this.target.name);
+        const rest = (h.cookie ?? "").split(/;\s*/).filter(c => c && !c.startsWith(SiteGateway.COOKIE + "="));
+        if (rest.length) h.cookie = rest.join("; "); else delete h.cookie;
+        return h;
+    }
+
+    // ── http ───────────────────────────────────────────────────────────────
+    request(req, res){
+        const url = new URL(req.url, SiteGateway.PUBLIC);
+        const p = this.clean(url.pathname);
+        if (p === null) return res.writeHead(400).end();
+        if (url.searchParams.has("key")){
+            if (!this.key_ok(url.searchParams.get("key"))) return this.locked(res);
+            url.searchParams.delete("key");
+            return res.writeHead(302, {
+                "set-cookie": `${SiteGateway.COOKIE}=${this.cookie}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax`,
+                location: url.pathname + url.search, "cache-control": "no-store" }).end();
+        }
+        if (!this.has_cookie(req)) return this.locked(res);
+        const why = this.refuse(req.method, p, req.headers.origin);
+        if (why) return res.writeHead(403, { "content-type": "text/plain" }).end("refused: " + why);
+        const up = http.request({ host: this.target.host, port: this.target.port, method: req.method, path: req.url, headers: this.headers(req) }, r => {
+            const h = { ...r.headers };
+            if (h.location) h.location = String(h.location).replace("http://" + this.target.name, SiteGateway.PUBLIC);
+            res.writeHead(r.statusCode, h);
+            r.pipe(res);
+            r.on("error", () => res.destroy());
+        });
+        up.on("error", e => { if (process.env.GW_DEBUG) console.error(e); if (!res.headersSent) res.writeHead(502, { "content-type": "text/plain" }); res.end("site unreachable"); });
+        res.on("close", () => { if (!res.writableFinished) up.destroy(); });   // the browser left mid-reply (an SSE tab closed): stop the upstream
+        req.pipe(up);
+    }
+
+    locked(res){
+        res.writeHead(401, { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" })
+            .end(`<!doctype html><meta name="viewport" content="width=device-width"><title>Locked</title>
+<body style="font:18px system-ui;padding:2em;background:#111;color:#ccc">
+<h1>Locked</h1><p>Open the site with its key link once (it is in <code>%LOCALAPPDATA%\\lew42\\servex\\site.url</code> on the PC); this browser then stays signed in for 30 days.</p></body>`);
+    }
+
+    // ── websocket ──────────────────────────────────────────────────────────
+    upgrade(req, socket, head){
+        const deny = code => { socket.end(`HTTP/1.1 ${code}\r\nConnection: close\r\nContent-Length: 0\r\n\r\n`); };
+        socket.on("error", () => socket.destroy());
+        const url = new URL(req.url, SiteGateway.PUBLIC);
+        const p = this.clean(url.pathname);
+        if (p === null) return deny("400 Bad Request");
+        if (!this.has_cookie(req)) return deny("401 Unauthorized");
+        if (this.refuse(req.method, p, req.headers.origin, true)) return deny("403 Forbidden");
+        const up = net.connect(this.target.port, this.target.host, () => {
+            const h = this.headers(req);
+            up.write(`${req.method} ${req.url} HTTP/1.1\r\n` + Object.entries(h).map(([k, v]) => `${k}: ${v}`).join("\r\n") + "\r\n\r\n");
+            if (head?.length) up.write(head);
+            up.pipe(socket); socket.pipe(up);
+        });
+        up.on("error", () => socket.destroy());
+        socket.on("close", () => up.destroy());
+    }
+
+    server(){
+        const s = http.createServer((req, res) => this.request(req, res));
+        s.on("upgrade", (req, socket, head) => this.upgrade(req, socket, head));
+        return s;
+    }
+
+    // listens on loopback only; resolves with the server, or null when the port is already taken
+    listen(){
+        const s = this.server();
+        return new Promise(resolve => {
+            s.once("error", e => { console.error("site gateway: " + e.message); resolve(null); });
+            s.listen(this.port, "127.0.0.1", () => {
+                fs.writeFileSync(path.join(SiteGateway.DIR, "site.url"), `${SiteGateway.PUBLIC}/?key=${this.key}`);
+                console.log(`site gateway on 127.0.0.1:${this.port} for ${SiteGateway.PUBLIC} (key link in site.url)`);
+                resolve(s);
+            });
+        });
+    }
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) await new SiteGateway().listen() ?? process.exit(1);
diff --git a/Server/SiteGateway.test.mjs b/Server/SiteGateway.test.mjs
new file mode 100644
index 000000000..8abe5947b
--- /dev/null
+++ b/Server/SiteGateway.test.mjs
@@ -0,0 +1,91 @@
+// node Server/SiteGateway.test.mjs: the gateway's four checks and its WebSocket relay, against a fake dev server (no network, no cloudflared)
+import assert from "node:assert";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import net from "node:net";
+import SiteGateway from "./SiteGateway.mjs";
+
+SiteGateway.DIR = fs.mkdtempSync(path.join(os.tmpdir(), "site-gw-test-"));
+const seen = [], NL = "\r\n";
+const dev = http.createServer((req, res) => { seen.push({ url: req.url, headers: req.headers }); res.writeHead(req.url === "/go" ? 302 : 200, req.url === "/go" ? { location: "http://10.0.0.1:3104/there" } : {}).end("ok " + req.url); });
+// a byte-level upgrade: answer 101, report the headers it saw, then echo every byte (no ws dependency)
+const socks = [];
+dev.on("upgrade", (req, sock) => {
+    socks.push(sock);
+    sock.write(["HTTP/1.1 101 Switching Protocols", "Upgrade: websocket", "Connection: Upgrade", "", ""].join(NL)
+        + JSON.stringify({ origin: req.headers.origin, remote: req.headers["x-lew42-remote"], cookie: req.headers.cookie ?? null }) + "\n");
+    sock.on("data", b => sock.write("echo " + b));
+});
+dev.on("clientError", e => process.env.GW_DEBUG && console.error("dev clientError", e.code, e.rawPacket?.toString()));
+await new Promise(r => dev.listen(0, "127.0.0.1", r));
+
+const KEY = "k".repeat(64);
+const gw = new SiteGateway({ port: 0, key: KEY, target: { host: "127.0.0.1", port: dev.address().port, name: "10.0.0.1:3104" } });
+const s = gw.server(); await new Promise(r => s.listen(0, "127.0.0.1", r));
+const base = `http://127.0.0.1:${s.address().port}`;
+const ORIGIN = SiteGateway.PUBLIC;
+const go = (p, o = {}) => fetch(base + p, { redirect: "manual", ...o });
+
+// 1. the key
+assert.strictEqual((await go("/")).status, 401, "no cookie: locked");
+assert.strictEqual((await go("/?key=wrong")).status, 401, "a wrong key: locked");
+const r = await go("/framework/?key=" + KEY + "&x=1");
+assert.strictEqual(r.status, 302, "the key sets the cookie and redirects");
+assert.strictEqual(r.headers.get("location"), "/framework/?x=1", "the key leaves the url");
+const set = r.headers.get("set-cookie");
+assert.match(set, /HttpOnly; Secure; SameSite=Lax/);
+assert.ok(!set.includes(KEY), "the cookie is not the key");
+const cookie = set.split(";")[0];
+const ok = (p, o = {}) => go(p, { ...o, headers: { cookie: cookie + "; other=1", ...(o.headers ?? {}) } });
+
+const page = await ok("/framework/");
+assert.strictEqual(page.status, 200, "a page passes");
+const h = seen.at(-1).headers;
+assert.strictEqual(h.host, "10.0.0.1:3104", "the dev server sees its LAN host");
+assert.strictEqual(h["x-lew42-remote"], "1", "marked remote");
+assert.strictEqual(h.cookie, "other=1", "the gateway cookie never reaches the dev server");
+assert.strictEqual((await ok("/go")).headers.get("location"), ORIGIN + "/there", "redirects point back at the public host");
+
+// 2. origin
+assert.strictEqual((await ok("/servex/api/item", { method: "POST", body: "{}" })).status, 403, "a write without our Origin is refused");
+assert.strictEqual((await ok("/servex/api/item", { method: "POST", body: "{}", headers: { origin: "https://evil.example" } })).status, 403);
+assert.strictEqual((await ok("/servex/api/item", { method: "POST", body: "{}", headers: { origin: ORIGIN } })).status, 200, "a page edit passes");
+assert.strictEqual(seen.at(-1).headers.origin, "http://10.0.0.1:3104", "Origin is rewritten to the LAN one");
+
+// 3 + 4. routes
+for (const p of ["/mcp", "/MCP", "/mcp/remote/x", "/screenshot?path=/", "/devsource.json", "/Servex/agents/x.js", "/Server/Tunnel.mjs", "/ai-logs/x", "/recordings/", "/ask/turn",
+    "/servex/mcp", "/servex/api/projects", "/servex/api/merge", "/servex/api/agents/x/message", "/Servex/api/item", "/a%2fb", "/servex%2fmcp"])
+    assert.ok([400, 403].includes((await ok(p, { method: "POST", headers: { origin: ORIGIN } })).status), "refused: " + p);
+assert.strictEqual(gw.clean("/%2e%2e/x"), null, "an encoded climb is refused (fetch itself normalizes it away)");
+assert.strictEqual(gw.clean("/a/%5c/b"), null);
+assert.strictEqual((await ok("/servex/api/agents")).status, 200, "a read-only Servex route passes on GET");
+assert.strictEqual((await ok("/servex/api/agents", { method: "POST", headers: { origin: ORIGIN } })).status, 403, "...but not as a write");
+for (const p of ["/servex/api/session/say", "/servex/api/session/abc-1/stream", "/servex/api/voice/stream", "/servex/log/prompts", "/whisper/inference"])
+    assert.strictEqual((await ok(p, { method: "POST", headers: { origin: ORIGIN } })).status, 200, "passes: " + p);
+
+// the socket
+const open = headers => new Promise(res => {
+    const c = net.connect(s.address().port, "127.0.0.1", () => c.write(["GET / HTTP/1.1", "Host: x", "Upgrade: websocket", "Connection: Upgrade",
+        ...Object.entries(headers).map(([k, v]) => k + ": " + v), "", ""].join(NL)));
+    let buf = "";
+    c.on("data", b => {
+        buf += b;
+        const st = Number(/^HTTP\/1\.1 (\d+)/.exec(buf)?.[1]);
+        if (st !== 101){ c.destroy(); return res({ status: st }); }
+        const m = /\r\n\r\n(.*)\n/.exec(buf);
+        if (m){ c.removeAllListeners("data"); res({ status: st, c, m: m[1] }); }
+    });
+});
+assert.strictEqual((await open({ origin: ORIGIN })).status, 401, "socket: no cookie, no socket");
+assert.strictEqual((await open({ cookie })).status, 403, "socket: no Origin, no socket");
+assert.strictEqual((await open({ cookie, origin: "https://evil.example" })).status, 403, "socket: a foreign Origin, no socket");
+const { c, m } = await open({ cookie, origin: ORIGIN });
+assert.deepStrictEqual(JSON.parse(m), { origin: "http://10.0.0.1:3104", remote: "1", cookie: null }, "socket: relayed, LAN origin, marked, no cookie");
+c.write("hi"); assert.strictEqual(await new Promise(r => c.once("data", x => r(String(x)))), "echo hi", "socket: both directions");
+c.destroy();
+
+socks.forEach(x => x.destroy()); s.closeAllConnections(); dev.closeAllConnections(); s.close(); dev.close();
+fs.rmSync(SiteGateway.DIR, { recursive: true, force: true });
+console.log("SiteGateway.test ok");

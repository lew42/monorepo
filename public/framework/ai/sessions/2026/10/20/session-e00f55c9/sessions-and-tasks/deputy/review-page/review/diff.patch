+/* FilterPill: a Dropdown worn as a small rounded pill. TimeFilter's hidden rows. Doc: readme.md, "Filter pills". */
+@layer site {
+	.dropdown.filter-pill { inline-size: auto; flex: none; }
+	.dropdown.filter-pill > .dropdown-trigger:is(button, .btn) { inline-size: auto; border-radius: 2em; padding-block: 0.15em; padding-inline: 0.8em 0.5em; font-size: 0.9em; font-weight: 600; }
+	.filter-pill-out { display: none !important; }
+}
diff --git a/public/framework/ux/Filter/FilterPill.js b/public/framework/ux/Filter/FilterPill.js
new file mode 100644
index 000000000..b94e281a2
--- /dev/null
+++ b/public/framework/ux/Filter/FilterPill.js
@@ -0,0 +1,47 @@
+import { View, icon } from "../../core/View/View.js";
+import { Dropdown } from "../../ext/Dropdown/dropdown.js";
+
+View.stylesheet(import.meta, "FilterPill.css");
+
+/**
+ * class FilterPill extends Dropdown — one filter as a small rounded pill: "Today ▾".
+ * Its choice lives in the url (`?<param>=<value>`, left out when it is the default), so a reload
+ * or a shared link lands on the same view. A page adds one in one line:
+ *
+ *   FilterPill.add({ param: "kind", options: [{ value: "all", label: "All" }, …], changed: v => redraw() });
+ *
+ * Subclass to give it meaning (`TimeFilter`). Doc: readme.md, "Filter pills".
+ */
+export default class FilterPill extends Dropdown {
+
+	// Built and drawn under whatever is capturing; returns the instance, not the view, so the caller can ask it things.
+	static add(...args){ const f = new this(...args); f.draw(); return f; }
+
+	constructor(...args){
+		super(...args);
+		this.fallback ??= this.value ?? this.options[0]?.value;
+		const asked = new URLSearchParams(location.search).get(this.param);
+		this.value = this.options.some(o => o.value === asked) ? asked : this.fallback;
+	}
+
+	draw(){ return super.draw().ac("filter-pill").attr("title", this.title ?? ""); }
+
+	// Dropdown calls pick(value) once per choice: remember it, write it to the url, redraw the face, tell the caller.
+	pick(value){
+		this.value = value;
+		this.write();
+		this.$trigger.empty(() => { this.face(this.chosen()); icon("expand_more"); });
+		this.$list.el.querySelectorAll(".dropdown-option").forEach((b, i) => b.classList.toggle("on", this.options[i]?.value === value));
+		this.changed?.(value, this);
+	}
+
+	write(){
+		const q = new URLSearchParams(location.search);
+		this.value === this.fallback ? q.delete(this.param) : q.set(this.param, this.value);
+		history.replaceState(history.state, "", location.pathname + (q.size ? "?" + q : "") + location.hash);
+	}
+}
+
+FilterPill.prototype.param = "filter";
+
+export { FilterPill };
diff --git a/public/framework/ux/Filter/TimeFilter.js b/public/framework/ux/Filter/TimeFilter.js
new file mode 100644
index 000000000..345346894
--- /dev/null
+++ b/public/framework/ux/Filter/TimeFilter.js
@@ -0,0 +1,76 @@
+import FilterPill from "./FilterPill.js";
+
+/**
+ * class TimeFilter extends FilterPill — the "Today ▾" pill: Today, Week, Month, Year (Year is everything, for now).
+ * It filters by hiding: every element under `root` that carries `data-at` (ms or an ISO time) outside the window is
+ * hidden, and new ones are checked as they arrive. An element matching `follows` (a chat's "12 tool calls" line)
+ * has no time of its own and goes with the element before it. One line on a page:
+ *
+ *   TimeFilter.add({ root: $box, changed: () => … });   // ?when=week in the url
+ */
+export default class TimeFilter extends FilterPill {
+	static DAY = 864e5;
+
+	/** The window's first moment, in ms: local midnight for Today, 7 and 30 days back, 0 for Year (all). */
+	since(now = Date.now()){
+		if (this.value === "today"){ const d = new Date(now); d.setHours(0, 0, 0, 0); return d.getTime(); }
+		if (this.value === "week") return now - 7 * TimeFilter.DAY;
+		if (this.value === "month") return now - 30 * TimeFilter.DAY;
+		return 0;
+	}
+
+	/** Is a time (ms, an ISO string, or nothing) inside the window? No time at all is always kept. */
+	keeps(t){
+		const ms = typeof t === "number" ? t : Number(t) || Date.parse(t ?? "");
+		return !Number.isFinite(ms) || !ms || ms >= this.since();
+	}
+
+	/** row => boolean over one field, for a caller that filters data instead of elements. */
+	predicate(field = "at"){ return row => this.keeps(row?.[field]); }
+
+	draw(){
+		const view = super.draw();
+		if (this.root) this.watch(this.root);
+		return view;
+	}
+
+	pick(value){ super.pick(value); this.apply(); }
+
+	/** Hide what falls outside the window under every watched root; returns { shown, hidden }. */
+	apply(){
+		const n = { shown: 0, hidden: 0 };
+		for (const root of this.roots ?? []){
+			let prev = false;
+			for (const el of root.querySelectorAll("[data-at], " + this.follows)){
+				const out = el.matches("[data-at]") ? !this.keeps(el.dataset.at) : prev;
+				el.classList.toggle("filter-pill-out", out);
+				if (el.matches("[data-at]")){ prev = out; n[out ? "hidden" : "shown"]++; }
+			}
+		}
+		this.counted = n;
+		this.after?.(n, this);
+		return n;
+	}
+
+	/** Filter `root` (an element or a View) now and whenever something is added under it. */
+	watch(root){
+		const el = root.el ?? root;
+		(this.roots ??= []).push(el);
+		let queued = false;
+		new MutationObserver(() => { if (!queued){ queued = true; queueMicrotask(() => { queued = false; this.apply(); }); } }).observe(el, { childList: true, subtree: true });
+		this.apply();
+		return this;
+	}
+}
+
+TimeFilter.prototype.param = "when";
+TimeFilter.prototype.title = "Show only what happened in this window";
+TimeFilter.prototype.follows = ".chatbox-update";
+TimeFilter.prototype.options = [
+	{ value: "today", label: "Today" },
+	{ value: "week", label: "Week" },
+	{ value: "month", label: "Month" },
+	{ value: "year", label: "Year" },
+];
+
+export { TimeFilter };

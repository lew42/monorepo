diff --git a/public/framework/ai/AISession/Approvals.js b/public/framework/ai/AISession/Approvals.js
new file mode 100644
index 000000000..935f05d53
--- /dev/null
+++ b/public/framework/ai/AISession/Approvals.js
@@ -0,0 +1,43 @@
+import JSONL from "/framework/ext/JSONL/JSONL.js";
+import FsFile from "/framework/ext/filesystem/FsFile.js";
+import Day from "/framework/core/Session/Day.js";
+
+/** Approvals — which of one day's sessions the owner approved. Approving writes two lines through FsFile.append (the one file API):
+ *  `{"approve":{"at","by":"owner"}}` in the session's own record (`<day>/<folder>/session.jsonl`, the fact), and one pointer line in
+ *  that day's log (`<day>/day.jsonl`, `{"log":{…,"approve":{"session","record","by"}}}`), which is what this class streams: one file
+ *  per day instead of probing every session's record (most have none, and each miss is a 404). Doc: readme.md, "Review". */
+export default class Approvals extends JSONL {
+	static ROOT = new URL("../sessions/", import.meta.url).pathname;
+	static day_url(day){ return `${Approvals.ROOT}${Day.path(day)}/day.jsonl`; }
+	/** The session's own record. `dir` is the folder the store found its snapshot under; `day` may be written with dashes. */
+	static record(s){ return `${Approvals.ROOT}${(s.day ?? s.dir ?? "").replaceAll("-", "/")}/${s.folder ?? s.id}/session.jsonl`; }
+
+	got = new Map();   // session id -> { at, by } of its approval
+	listeners = new Set();
+
+	static of_day(day){ return new Approvals({ url: Approvals.day_url(day), day }).live(); }
+
+	on(fn){ this.listeners.add(fn); return () => this.listeners.delete(fn); }
+	of(id){ return this.got.get(id) ?? null; }
+
+	read(entries){
+		for (const e of entries){ const a = e?.log?.approve; if (a?.session) this.got.set(a.session, { at: e.log.at, by: a.by ?? "owner" }); }
+		this.listeners.forEach(fn => fn(this));
+		return this;
+	}
+	reset(){ this.got = new Map(); return super.reset(); }
+	live(){ super.live(() => {}); return this; }
+
+	/** Approve sessions (snapshots): shown at once, then written; put back if a write is refused. Returns true when every line was written. */
+	async approve(snaps){
+		const at = new Date().toISOString(), was = new Map(snaps.map(s => [s.id, this.got.get(s.id)]));
+		snaps.forEach(s => this.got.set(s.id, { at, by: "owner" }));
+		this.listeners.forEach(fn => fn(this));
+		const own = await Promise.all(snaps.map(s => FsFile.append(Approvals.record(s), { approve: { at, by: "owner" } }).catch(() => false)));
+		const kept = snaps.filter((s, i) => own[i]);
+		const day = kept.length ? await FsFile.append(this.url, kept.map(s => ({ log: { at, task: s.id, msg: "approved by the owner: " + (s.title ?? s.agent ?? s.id), approve: { session: s.id, record: Approvals.record(s), by: "owner" } } }))).catch(() => false) : true;
+		snaps.forEach((s, i) => { if (!own[i] || !day) was.get(s.id) ? this.got.set(s.id, was.get(s.id)) : this.got.delete(s.id); });
+		if (own.includes(false) || !day) this.listeners.forEach(fn => fn(this));
+		return !own.includes(false) && !!day;
+	}
+}
diff --git a/public/framework/ai/AISession/Review.js b/public/framework/ai/AISession/Review.js
new file mode 100644
index 000000000..20a1d2454
--- /dev/null
+++ b/public/framework/ai/AISession/Review.js
@@ -0,0 +1,40 @@
+/** Review — the owner's review of one day: each session's state and the day's three totals (approved, waiting, leaking).
+ *  Plain code over a SessionTree and the Approvals; computed on every paint, never stored. The rule and its numbers: readme.md, "Review". */
+export default class Review {
+	static FINISHED_MS = 60 * 60000;   // no activity for an hour: finished
+	static LEAK_USD = 0.5;             // costs more than this (rolled up through its children)
+	static LEAK_AGE_MS = 24 * 3600000; // and finished more than a day ago, unapproved: a leak
+
+	static STATES = {
+		approved: { label: "approved", hint: "The owner approved it, or a session above it" },
+		live:     { label: "working",  hint: "Active in the last hour" },
+		waiting:  { label: "waiting",  hint: "Finished, waiting for the owner's approval" },
+		leak:     { label: "leak",     hint: `Finished over a day ago, cost over $${Review.LEAK_USD.toFixed(2)}, never approved` },
+	};
+
+	constructor(tree, approvals, now = Date.now()){
+		this.tree = tree; this.approvals = approvals; this.now = now;
+		tree.roots.forEach(r => this.walk(r, null));
+	}
+
+	/** Sets on every node: `approved` (the approve line, its own or inherited), `by_parent`, `finished`, `state`. */
+	walk(n, up){
+		const own = this.approvals.of(n.s.id);
+		n.approved = own ?? up?.approved ?? null;
+		n.by_parent = !own && !!n.approved;
+		n.finished = n.s.state !== "active" && this.now - n.last >= Review.FINISHED_MS;
+		n.state = n.approved ? "approved" : !n.finished ? "live" : this.leaks(n) ? "leak" : "waiting";
+		n.kids.forEach(k => this.walk(k, n));
+	}
+	leaks(n){ return n.rolled > Review.LEAK_USD && this.now - n.last >= Review.LEAK_AGE_MS; }
+
+	/** Every session's own cost, put in the bucket of its own state: { approved, waiting, leak } dollars and counts. They add up to the day. */
+	totals(){
+		const t = { approved: { usd: 0, n: 0 }, waiting: { usd: 0, n: 0 }, leak: { usd: 0, n: 0 } };
+		this.tree.nodes.forEach(n => { const b = t[n.state === "live" ? "waiting" : n.state]; b.usd += n.own; b.n++; });
+		return t;
+	}
+
+	/** Roots "Approve all" would approve: finished and not approved. */
+	ready(){ return this.tree.roots.filter(r => r.finished && !r.approved); }
+}
diff --git a/public/framework/ai/AISession/SessionWork.css b/public/framework/ai/AISession/SessionWork.css

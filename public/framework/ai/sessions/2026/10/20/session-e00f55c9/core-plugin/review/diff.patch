diff --git a/public/framework/core/Plugin/Plugin.js b/public/framework/core/Plugin/Plugin.js
new file mode 100644
index 000000000..eec6ff026
--- /dev/null
+++ b/public/framework/core/Plugin/Plugin.js
@@ -0,0 +1,151 @@
+// core/Plugin: a class that is pluggable, and the class every plugin may extend. Readme: ./readme.md, design: ./doc/design-notes.md
+//   Host.use(A, B)    every new Host instance reaches A.attach(inst) and B.attach(inst)
+//   Host.unuse(A)     the hook comes off; live instances are told A.detach(inst)
+//   Host.plugins      a lazy List of rows (PluginEntry): name, enabled, config; switching a row on or off uses / unuses
+import { Events } from "../Events/Events.js";
+import { List } from "../List/List.js";
+import PluginEntry from "./PluginEntry.js";
+
+const own_events = Symbol.for("core.Plugin.events");
+
+export class Plugin extends Events(Object) {
+
+	// Same order the server's Events had: assign the args, announce "new", then instantiate().
+	constructor(...args){
+		super();
+		this.assign(...args);
+		this.constructor.emit("new", this);
+		this.instantiate();
+	}
+
+	assign(...args){ return Object.assign(this, ...args); }
+	instantiate(){ this.initialize(); }
+	initialize(){}
+	bubbles(){ return false; }   // a plugin host is not a tree; an Item's events still bubble
+
+	// ── class-level events. "new" walks the class chain: parents' listeners first, then each subclass's own.
+	static get events(){
+		if (!Object.hasOwn(this, own_events)) Object.defineProperty(this, own_events, { value: {}, writable: true });
+		return this[own_events];
+	}
+	static on(event, fn){ (this.events[event] ??= []).push(fn); return this; }
+	static off(event, fn){
+		const list = this.events[event];
+		if (list) this.events[event] = list.filter(l => l !== fn && l.fn !== fn);
+		return this;
+	}
+	static once(event, fn){
+		const wrapper = (...args) => { this.off(event, wrapper); return fn.apply(this, args); };
+		wrapper.fn = fn;
+		return this.on(event, wrapper);
+	}
+	static clear(event){ if (this.events[event]) this.events[event] = []; return this; }
+	static emit(event, ...args){
+		const chain = [];
+		for (let c = this; c && c !== Function.prototype; c = Object.getPrototypeOf(c)){
+			const own = Object.hasOwn(c, own_events) && c[own_events][event];
+			if (own?.length) chain.push(own);
+		}
+		for (let i = chain.length - 1; i >= 0; i--) chain[i].slice().forEach(fn => fn.apply(this, args));
+		return this;
+	}
+
+	// ── a class that is PLUGGABLE
+	static hosts = [];   // every class that has used or listed a plugin, for a page that shows them live
+	static store = new Map();   // saved on/config per row, key plugin.<Host>.<Plugin>; a page swaps in localStorage
+
+	static get records(){
+		if (!Object.hasOwn(this, "_records")) Object.defineProperty(this, "_records", { value: new Map(), writable: true });
+		return this._records;
+	}
+
+	static use(...plugins){
+		for (const p of plugins) {
+			const fresh = !this.records.has(p), rec = this.record(p);
+			if (!fresh || rec.wanted) this.enable(rec);   // a saved or default "off" wins over the first use()
+		}
+		return this;
+	}
+
+	static unuse(...plugins){
+		for (const p of plugins) { const rec = this.records.get(p); if (rec) this.disable(rec); }
+		return this;
+	}
+
+	// Know P, but leave it off: the list shows a switched-off row.
+	static available(...plugins){
+		for (const p of plugins) this.record(p, false);
+		return this;
+	}
+
+	// The one record per plugin on this class: the exact hook that was installed, so off can find it.
+	static record(p, wanted_on){
+		let rec = this.records.get(p);
+		if (rec) return rec;
+		const name = p.name || "plugin", key = `plugin.${this.name}.${name}`;
+		const saved = Plugin.store.get(key), defaults = p.defaults ?? {};
+		const { on: default_on = true, ...config_defaults } = defaults;
+		rec = { plugin: p, name, key, on: false, fn: null, live: new Set(), n: 0,
+			wanted: wanted_on ?? saved?.on ?? default_on, config: { ...config_defaults, ...saved?.config } };
+		this.records.set(p, rec);
+		if (!Plugin.hosts.includes(this)) Plugin.hosts.push(this);
+		if (this._list) this.add_row(rec);
+		return rec;
+	}
+
+	static enable(rec){
+		rec.wanted = true;
+		if (rec.on) return;
+		const p = rec.plugin, tracks = typeof p.detach === "function" && p.detach !== Plugin.detach;
+		const run = typeof p.attach === "function" ? inst => p.attach(inst)
+			: typeof p.setup === "function" ? inst => p.setup(inst)
+			: typeof p === "function" && !p.prototype ? p : null;
+		if (!run) { console.warn(`Plugin ${rec.name} must be a function or have attach(instance) or setup(instance)`); return; }
+		rec.fn = function(inst){
+			if (tracks) {
+				rec.live.add(new WeakRef(inst));
+				if (++rec.n % 256 === 0) for (const ref of rec.live) if (!ref.deref()) rec.live.delete(ref);
+			}
+			return run.call(this, inst);
+		};
+		this.on("new", rec.fn);
+		rec.on = true;
+		rec.row?.sync(true);
+	}
+
+	static disable(rec){
+		rec.wanted = false;
+		if (!rec.on) return;
+		this.off("new", rec.fn);
+		rec.on = false;
+		for (const ref of rec.live) { const inst = ref.deref(); if (inst) rec.plugin.detach?.(inst); }
+		rec.live.clear();
+		rec.row?.sync(false);
+	}
+
+	// Lazy: nothing exists until it is read. After that, use/unuse/available keep it in step.
+	static get plugins(){
+		if (!Object.hasOwn(this, "_list")) {
+			Object.defineProperty(this, "_list", { value: new List(), writable: true });
+			for (const rec of this.records.values()) this.add_row(rec);
+		}
+		return this._list;
+	}
+
+	static add_row(rec){
+		if (rec.row) return rec.row;
+		const row = new PluginEntry({ id: rec.name, name: rec.name, enabled: rec.on, config: rec.config });
+		Object.defineProperties(row, { host: { value: this }, record: { value: rec }, plugin: { value: rec.plugin } });
+		rec.row = row;
+		this._list.add(row);
+		return row;
+	}
+
+	// ── a class that IS a plugin. attach(instance): "this plugin attaches itself to that instance". setup is the old name.
+	static attach(instance){ return this.setup?.(instance); }
+	static detach(instance){}
+	static defaults = { on: true };
+	static fields = [];   // [{key, label, kind: "toggle|slider|number|text", min, max, step, section}] drives a panel
+}
+
+export default Plugin;
diff --git a/public/framework/core/Plugin/Plugin.test.mjs b/public/framework/core/Plugin/Plugin.test.mjs
new file mode 100644
index 000000000..dbe1d38c0
--- /dev/null
+++ b/public/framework/core/Plugin/Plugin.test.mjs
@@ -0,0 +1,157 @@
+// core/Plugin: A.use(B, C), unuse, A.plugins (lazy List), toggle, config, sub-plugins, the server shim.
+// Run: node public/framework/core/Plugin/Plugin.test.mjs   (written before Plugin.js: it fails until the class exists)
+import { test } from "../Test/Test.js";
+import { Plugin } from "./Plugin.js";
+import ServerEvents from "../../../../Server/Events.js";
+
+Plugin.store = new Map();   // saved config goes here, not to a browser
+
+// a pluggable class A, and plugins that record what they were given
+const calls = [];
+class Host extends Plugin {}
+class Spy { static attach(inst){ calls.push(["attach", this.name, inst.tag]); } static detach(inst){ calls.push(["detach", this.name, inst.tag]); } }
+class Other { static attach(inst){ calls.push(["attach", this.name, inst.tag]); } }
+class Old { static setup(inst){ calls.push(["setup", this.name, inst.tag]); } }   // the old word keeps working
+
+test("use(B, C) installs each, returns the class, and a new instance reaches each plugin with its args already assigned", t => {
+	calls.length = 0;
+	t.ok(Host.use(Spy, Other) === Host, "use returns the class so it chains");
+	new Host({ tag: "one" });
+	t.eq(calls, [["attach", "Spy", "one"], ["attach", "Other", "one"]], "attach ran per plugin, in order, after assign");
+});
+
+test("setup is still accepted as the old name for attach, and a plain function is a plugin", t => {
+	calls.length = 0;
+	class H2 extends Plugin {}
+	let fn_got; H2.use(Old, inst => { fn_got = inst.tag; });
+	new H2({ tag: "x" });
+	t.eq(calls, [["setup", "Old", "x"]], "a plugin with only setup is attached through setup");
+	t.eq(fn_got, "x", "a plain function is called with the new instance");
+});
+
+test("using the same plugin twice is a no-op", t => {
+	calls.length = 0;
+	class H3 extends Plugin {}
+	H3.use(Other); H3.use(Other);
+	new H3({ tag: "d" });
+	t.eq(calls.length, 1, "attached once");
+});
+
+test("unuse removes the hook; live instances are told detach, new ones are not attached", t => {
+	calls.length = 0;
+	class H4 extends Plugin {}
+	H4.use(Spy);
+	const live = new H4({ tag: "live" });
+	H4.unuse(Spy);
+	t.eq(calls, [["attach", "Spy", "live"], ["detach", "Spy", "live"]], "the live instance was detached");
+	new H4({ tag: "later" });
+	t.eq(calls.length, 2, "a later instance gets nothing");
+	t.ok(live, "kept so the instance is not collected before unuse");
+});
+
+test("a subclass instance reaches its parents' plugins first, and its own use does not leak up", t => {
+	calls.length = 0;
+	class P1 extends Plugin {}
+	class P2 extends P1 {}
+	P1.use(Other); P2.use(Spy);
+	new P2({ tag: "kid" });
+	t.eq(calls, [["attach", "Other", "kid"], ["attach", "Spy", "kid"]], "parent plugin, then subclass plugin");
+	calls.length = 0;
+	new P1({ tag: "mum" });
+	t.eq(calls, [["attach", "Other", "mum"]], "the parent never runs the subclass's plugin");
+});
+
+test("instance events: once fires once, clear drops listeners, on/off chain", t => {
+	const e = new Host({ tag: "e" });
+	let n = 0;
+	t.ok(e.on("x", () => n++) === e, "on returns this");
+	e.once("y", () => n += 10);
+	e.emit("y"); e.emit("y"); e.emit("x");
+	t.eq(n, 11, "once ran once; on ran");
+	e.clear("x"); e.emit("x");
+	t.eq(n, 11, "clear removed the listener");
+});
+
+test("A.plugins is lazy: nothing is built until it is read, then one entry per plugin, in step with use/unuse", t => {
+	class H5 extends Plugin {}
+	H5.use(Spy);
+	t.ok(!Object.hasOwn(H5, "_list"), "reading nothing built nothing");
+	const list = H5.plugins;
+	t.eq(list.length, 1, "one entry");
+	t.eq(list.find("Spy").get("enabled"), true, "the entry is on");
+	H5.use(Other);
+	t.eq(list.length, 2, "a plugin used after the list exists appears in it");
+	H5.unuse(Other);
+	t.eq(list.find("Other").get("enabled"), false, "unuse switches the row off");
+});
+
+test("available() lists a plugin switched off and installs nothing", t => {
+	calls.length = 0;
+	class H6 extends Plugin {}
+	H6.available(Spy);
+	t.eq(H6.plugins.find("Spy").get("enabled"), false, "shown off");
+	new H6({ tag: "a" });
+	t.eq(calls.length, 0, "not attached while off");
+	H6.plugins.find("Spy").set({ enabled: true });
+	new H6({ tag: "b" });
+	t.eq(calls, [["attach", "Spy", "b"]], "switching on installs it");
+});
+
+test("toggling a row (what the item tool sends) moves the hook with it", t => {
+	calls.length = 0;
+	class H7 extends Plugin {}
+	H7.use(Spy);
+	H7.plugins.set({ Spy: { enabled: false } });
+	new H7({ tag: "off" });
+	t.eq(calls.length, 0, "off: the hook is gone");
+	H7.plugins.set({ Spy: { enabled: true } });
+	new H7({ tag: "on" });
+	t.eq(calls, [["attach", "Spy", "on"]], "on: the hook is back");
+});
+
+test("config: defaults, a changed value is saved under plugin.<Class>.<name>, and a reinstall reads it back", t => {
+	class Dim { static defaults = { on: true, opacity: 0.6 }; static fields = [{ key: "opacity", kind: "slider", min: 0, max: 1, step: 0.1 }]; static attach(){} }
+	class H8 extends Plugin {}
+	H8.use(Dim);
+	const row = H8.plugins.find("Dim");
+	t.eq(row.get("config"), { opacity: 0.6 }, "defaults fill the config");
+	row.set({ config: { opacity: 0.3 } });
+	t.eq(Plugin.store.get("plugin.H8.Dim"), { on: true, config: { opacity: 0.3 } }, "saved");
+	H8.unuse(Dim); H8.use(Dim);
+	t.eq(H8.plugins.find("Dim").get("config"), { opacity: 0.3 }, "read back after a reinstall");
+	t.eq(row.fields[0].key, "opacity", "the row exposes the plugin's fields for a panel");
+});
+
+test("a sub-plugin follows its parent: parent off means the sub-plugin never runs and its row reads inactive", t => {
+	calls.length = 0;
+	class Sub { static attach(inst){ calls.push(["attach", "Sub", inst.tag]); } }
+	class Parent extends Plugin { static attach(host){ new this(host); } }   // a plugin that is also pluggable
+	Parent.use(Sub);
+	class H9 extends Plugin {}
+	H9.use(Parent);
+	const row = H9.plugins.find("Parent"), sub = row.plugins.find("Sub");
+	new H9({ tag: "p1" });
+	t.eq(calls, [["attach", "Sub", "p1"]], "on: the sub-plugin runs for the parent's instance");
+	row.set({ enabled: false });
+	t.eq(sub.active, false, "the sub row reads inactive while the parent is off");
+	calls.length = 0;
+	new H9({ tag: "p2" });
+	t.eq(calls.length, 0, "off: the sub-plugin does not run");
+	row.set({ enabled: true });
+	t.eq(sub.active, true, "back on: active again");
+});
+
+test("the page can list the live plugin-using classes", t => {
+	class H10 extends Plugin {}
+	H10.use(Spy);
+	t.ok(Plugin.hosts.includes(H10), "Plugin.hosts holds every class that used or listed a plugin");
+});
+
+test("the server shim: Server/Events.js is a Plugin that keeps assign, then new, then initialize", t => {
+	const order = [];
+	class Sock extends ServerEvents { initialize(){ order.push("initialize:" + this.ws); } }
+	Sock.use(inst => order.push("new:" + inst.ws));
+	new Sock({ ws: 7 });
+	t.eq(order, ["new:7", "initialize:7"], "assign, new event, initialize");
+	t.ok(new Sock({}) instanceof Plugin, "it is a Plugin");
+});
diff --git a/public/framework/core/Plugin/PluginEntry.js b/public/framework/core/Plugin/PluginEntry.js
new file mode 100644
index 000000000..468cd78c6
--- /dev/null
+++ b/public/framework/core/Plugin/PluginEntry.js
@@ -0,0 +1,50 @@
+// One row of Host.plugins: the plugin's name, whether it is on, and its saved config. It is an Item, so the item tool
+// (or any {enabled: false} delta) drives it: set_enabled installs or removes the hook, set_config saves.
+import { Item } from "../Item/Item.js";
+
+export class PluginEntry extends Item {
+	static fields = ["name", "enabled", "config"];   // not "on": Item.set reads a bare key naming a method (Events.on) as a call
+
+	get fields(){ return this.plugin?.fields ?? []; }
+
+	// A row is active when it is on and the row above it (the plugin it is a sub-plugin of) is active.
+	get active(){ return !!this.get_one("enabled") && this.up?.active !== false; }
+
+	// A sub-plugin is a plugin of the plugin: its rows are the plugin's own Host.plugins list.
+	get plugins(){
+		const list = this.plugin?.plugins;
+		if (list) for (const row of list) row.up = this;
+		return list;
+	}
+
+	// Called by Host.enable / Host.disable, so the row follows a use() or unuse() made in code.
+	sync(on){
+		if (this.get_one("enabled") === on) return;
+		this.put("enabled", on);
+		this.emit_safely("change", "enabled", on);
+	}
+
+	set_enabled(value){
+		const rec = this.record;
+		if (!rec) return this.put("enabled", !!value);
+		value ? this.host.enable(rec) : this.host.disable(rec);
+		this.put("enabled", rec.on);
+		this.save_row();
+	}
+
+	set_config(value){
+		const rec = this.record, config = { ...this.get_one("config"), ...value };
+		this.put("config", config);
+		if (rec) rec.config = config;
+		this.save_row();
+	}
+
+	// Only a change made through the row is saved; a use() in code is the program's own wish, not a saved preference.
+	save_row(){
+		const rec = this.record;
+		if (rec) this.host.store.set(rec.key, { on: rec.on, config: rec.config });
+	}
+}
+Item.register(PluginEntry, "PluginEntry");
+
+export default PluginEntry;

+++ b/public/framework/ai/AISession/SessionTimeline.js
@@ -0,0 +1,132 @@
+import View, { div, span, small, a, p, button, details, summary, label, input, icon } from "/framework/core/View/View.js";
+import JSONL from "/framework/ext/JSONL/JSONL.js";
+import AICost from "../AITask/AICost.js";
+import SessionOutlineView from "./SessionOutlineView.js";
+import SessionPopover from "./SessionPopover.js";
+import SessionTimelineRows from "./SessionTimelineRows.js";
+
+View.stylesheet(import.meta, "SessionTimeline.css");
+
+/** The session page's Timeline tab: everything the session recorded, in time order, newest at the bottom. One compact row per event:
+ *  each line of session.jsonl is one row, each prompt of prompts.jsonl is one row (its raw words one click down), and each child session
+ *  that has landed adds one. `SessionTimelineRows.rows()` builds them with no DOM, so a node test can count them (SessionTimeline.test.mjs).
+ *  Fed by the page, never fetching the record itself: `record(lines)` is the tail SessionTasks already reads, `prompts(lines)` is the
+ *  prompt log's live tail (`SessionTimeline.Tail`), `children(list)` is the Overview's child sessions. Filters ▾ is the Sessions pages' own
+ *  popover (SessionPopover). Readme: ai/AISession/readme.md. */
+export default class SessionTimeline extends View {
+
+	/** The kinds, the hidden ones and the landed states live in SessionTimelineRows; the view uses them by these names. */
+	static KINDS = SessionTimelineRows.KINDS;
+	static HIDDEN = SessionTimelineRows.HIDDEN;
+	static rows = (...a) => SessionTimelineRows.rows(...a);
+	static landed_of = k => SessionTimelineRows.landed_of(k);
+
+	// ---- the view ------------------------------------------------------------------------------------------------------------
+
+	initialize(){
+		this.ac("stl");
+		this.lines = []; this.prompt_lines = []; this.kids = []; this.costs = new Map(); this.seen = new Set(); this.stick = true;
+		setTimeout(() => { this.seen.add("record").add("prompts"); this.later(); }, 4000);   // a missing file may never answer: after this, an empty list says so (a line arriving later still redraws)
+		this.on = new Set(SessionTimeline.KINDS.map(k => k[0]).filter(k => !SessionTimeline.HIDDEN.includes(k)));
+		this.counts = {};
+		this.empty(() => {
+			div.c("stl-head", () => {
+				this.$count = small.c("stl-count muted", "Reading this session's record…");
+				this.$filters = button.c("sessions-hbtn", "Filters ▾").attr("type", "button").attr("title", "Which kinds of event are listed");
+				SessionPopover.open(this.$filters, () => this.filter_menu(), "stl-pop");
+			});
+			this.$list = div.c("stl-list").on("scroll", () => { this.stick = this.at_bottom(); });
+		});
+	}
+
+	filter_menu(){
+		div.c("stl-menu", () => {
+			for (const [kind, text] of SessionTimeline.KINDS) label.c("stl-filter", () => {
+				const box = input().attr("type", "checkbox");
+				box.el.checked = this.on.has(kind);
+				box.on("change", () => { box.el.checked ? this.on.add(kind) : this.on.delete(kind); this.draw(); });
+				span(text);
+				this.counts[kind] = small.c("muted stl-n", "");
+			});
+		});
+	}
+
+	/** The record's lines so far (the page passes SessionTasks' own list, never a second fetch). */
+	record(lines){ this.lines = lines; this.settle("record"); this.later(); }
+	/** The prompt log's lines so far. */
+	prompts(lines){ this.prompt_lines = lines; this.settle("prompts"); this.later(); }
+	/** The Overview's child sessions: their names, state, model and cost for the rows, and which have landed. */
+	children(list){ this.kids = list; this.later(); }
+	/** A source has been looked at, even if it holds nothing: with all of them in and no rows, the empty sentence may show. */
+	settle(source){ this.seen.add(source); }
+
+	later(){ if (this.queued) return; this.queued = setTimeout(() => { this.queued = null; this.draw(); }, 30); }
+	at_bottom(){ const e = this.$list.el; return e.scrollHeight - e.scrollTop - e.clientHeight < 48; }
+	/** The tab was opened: its list is laid out now, so land on the newest row. */
+	shown(){ this.stick = true; this.$list.el.scrollTop = this.$list.el.scrollHeight; }
+
+	draw(){
+		const all = SessionTimeline.rows(this.lines, this.prompt_lines, SessionTimeline.landed_of(this.kids)), per = {};
+		all.forEach(r => per[r.kind] = (per[r.kind] ?? 0) + 1);
+		const rows = all.filter(r => this.on.has(r.kind)), stick = this.stick || this.at_bottom();
+		for (const [kind] of SessionTimeline.KINDS) if (this.counts[kind]) this.counts[kind].el.textContent = per[kind] ?? 0;
+		this.$count.el.textContent = !all.length ? (this.seen.size >= 2 ? "No events" : "Reading this session's record…") : rows.length === all.length ? `${all.length} event${all.length === 1 ? "" : "s"}` : `${rows.length} of ${all.length} events`;
+		this.el.dataset.total = all.length;
+		this.$list.empty(() => {
+			if (!all.length) return void (this.seen.size >= 2 && p.c("muted stl-none", "Nothing is recorded for this session yet: it has no prompts and no record lines."));
+			if (!rows.length) return void p.c("muted stl-none", "Every kind of event is switched off. Turn some on with Filters.");
+			let day = "";
+			for (const r of rows){
+				const d = new Date(r.at), key = d.toDateString();
+				if (key !== day){ day = key; div.c("stl-day", d.toLocaleDateString([], { weekday: "short", month: "short", day: "numeric" })); }
+				this.row(r, d);
+			}
+		});
+		this.el.dataset.rows = rows.length;
+		if (stick) this.$list.el.scrollTop = this.$list.el.scrollHeight;
+	}
+
+	kid(id){ return this.kids.find(c => c.id === id || c.name === id || c.key === id) ?? null; }
+
+	/** The meta of a child row: state, model and the cost line (AICost's, never summed here). */
+	kid_meta(c, id, $el){
+		const url = AICost.session_url(c?.id ?? id), snap = c?.snap, tab = SessionOutlineView.tab_of(snap);
+		const paint = () => { $el.el.textContent = [snap?.state, snap?.model && AICost.model_name(snap.model), AICost.cost_line({ cost: this.costs.get(url) ?? AICost.known_cost(url), own_usd: snap?.usd ?? null, tab }).text].filter(Boolean).join(" · "); };
+		paint();
+		if (c && !this.costs.has(url) && this.kids.length <= SessionOutlineView.ASK_ALL) AICost.summary(url).then(ans => { if (ans?.summary?.cost){ this.costs.set(url, ans.summary.cost); paint(); } });
+	}
+
+	icon_of(kind){
+		if (kind === "done") return SessionOutlineView.state_icon("complete");
+		return icon(SessionTimeline.KINDS.find(k => k[0] === kind)?.[2] ?? "more_horiz").ac("stl-icon");
+	}
+
+	row(r, d){
+		const body = () => {
+			small.c("stl-time muted", d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }));
+			this.icon_of(r.kind);
+			div.c("stl-main", () => {
+				div.c("stl-line", () => {
+					span.c("stl-text", r.children?.length ? r.text + ":" : r.text);
+					(r.children ?? []).forEach((id, i) => {
+						const c = this.kid(id);
+						a.c("stl-link", c?.snap?.title ?? c?.snap?.agent ?? c?.name ?? String(id).slice(0, 36)).href(AICost.session_url(c?.id ?? id));
+						if (i < r.children.length - 1) span(",");
+						if (r.children.length === 1 && c?.snap) this.kid_meta(c, id, small.c("stl-meta muted", ""));
+					});
+				});
+				if (r.more) small.c("stl-more muted", r.more);
+			});
+		};
+		if (r.raw) return details.c("stl-row stl-" + r.kind, () => { summary.c("stl-sum", body); p.c("stl-raw", r.raw); });
+		return div.c("stl-row stl-" + r.kind, body);
+	}
+}
+
+/** The prompt log's live tail: JSONL streams the file, and each batch of lines goes to `on_lines` (the whole history first, then appends). */
+SessionTimeline.Tail = class SessionTimelineTail extends JSONL {
+	lines = [];
+	read(entries){ this.lines.push(...entries); this.on_lines?.(this.lines); return this; }
+	reset(){ this.lines = []; this.on_lines?.(this.lines); return super.reset(); }   // a missing file answers with a reset: that is "looked, nothing there"
+	live(){ super.live(() => {}); return this; }
+};
diff --git a/public/framework/ai/AISession/SessionTimeline.test.mjs b/public/framework/ai/AISession/SessionTimeline.test.mjs
new file mode 100644
index 000000000..5a61b7f47
--- /dev/null
+++ b/public/framework/ai/AISession/SessionTimeline.test.mjs
@@ -0,0 +1,77 @@
+// node public/framework/ai/AISession/SessionTimeline.test.mjs — the Timeline's rows: one per record line, one per prompt, one per landed child,
+// counted here by hand, in time order, newest last. The page draws these same rows (data-total), so the two counts must agree.
+import assert from "node:assert/strict";
+import Rows from "./SessionTimelineRows.js";
+
+const at = m => `2026-10-20T20:${String(m).padStart(2, "0")}:00.000Z`;
+
+// session.jsonl: one of each line shape the real records hold (13 lines)
+const record = [
+	{ session: { kind: "voice" }, at: at(0) },
+	{ tasks: { add: [{ id: "t1", title: "Build the tab" }, { id: "t2", title: "Write the test" }] }, at: at(1) },
+	{ task: "/framework/ai/x/child-a/", as: "child-a", type: "Session", spawn: { role: "minion", model: "sonnet" }, at: at(2) },
+	{ sessions: ["child-b", "child-c"], at: at(3) },
+	{ log: "step one done", at: at(4) },
+	{ tag: "timeline", at: at(5) },
+	{ note: "a note", at: at(6) },
+	{ decision: { decision: "use a Tail", why: "no second fetch" }, at: at(7) },
+	{ review: { size: "full", verdict: "ok", findings: [{ n: 1 }, { n: 2 }] }, at: at(8) },
+	{ tasks: { t1: { complete: "built" }, t2: { complete: "tested" } }, at: at(9) },   // two tasks done in ONE line: one row
+	{ commit: { hash: "0123456789abcdef", what: "the tab" }, at: at(10) },
+	{ stop: { why: "waiting" }, at: at(11) },
+	{ log: "a line with no time of its own" },
+];
+// prompts.jsonl: 3 prompts (several stages each), one of them out of order in time
+const prompts = [
+	{ prompt: "p1", stage: "raw", text: "first words", at: at(1) },
+	{ prompt: "p1", stage: "refined", cards: [], subject: "First subject", at: at(1) },
+	{ prompt: "p2", stage: "raw", text: "second words", at: at(5) },
+	{ prompt: "p3", stage: "raw", text: "third words", at: at(0) },
+];
+const landed = [{ id: "child-a", name: "child-a", at: at(10) }];
+
+const rows = Rows.rows(record, prompts, landed);
+
+// the independent count: record lines + distinct prompt ids + landed children
+const expected = record.length + new Set(prompts.map(p => p.prompt)).size + landed.length;
+assert.equal(expected, 17);
+assert.equal(rows.length, expected, "rows drawn with every filter on = lines + prompts + landed");
+
+// time order, oldest first, ties by their original order; the untimed line takes the time of the line before it
+for (let i = 1; i < rows.length; i++) assert.ok(rows[i].at >= rows[i - 1].at, "row " + i + " is not before row " + (i - 1));
+const untimed = rows.find(r => r.text === "a line with no time of its own");
+assert.equal(untimed.at, Date.parse(at(11)));
+
+// the shapes
+const kinds = k => rows.filter(r => r.kind === k);
+assert.equal(kinds("prompt").length, 3);
+assert.equal(kinds("prompt").find(r => r.raw === "first words").text, "First subject");
+assert.equal(kinds("done").length, 1, "two tasks completed in one line are one row");
+assert.match(kinds("done")[0].text, /2 tasks done/);
+assert.equal(kinds("task").length, 1);
+assert.match(kinds("task")[0].text, /2 tasks added/);
+assert.equal(kinds("child").length, 2);
+assert.deepEqual(kinds("child").find(r => r.children.length === 2).children, ["child-b", "child-c"]);
+assert.equal(kinds("landed").length, 1);
+assert.equal(kinds("note").length, 1);
+assert.equal(kinds("decision").length, 1);
+assert.equal(kinds("review").length, 1);
+assert.match(kinds("review")[0].text, /2 findings/);
+assert.equal(kinds("commit").length, 1);
+assert.equal(kinds("session").length, 2, "session started + stopped");
+assert.equal(kinds("log").length, 2);
+assert.equal(kinds("tag").length, 1);
+
+// nothing recorded: no rows, no crash; prompts alone still make rows
+assert.equal(Rows.rows([], [], []).length, 0);
+assert.equal(Rows.rows([], prompts, []).length, 3);
+
+// the default filter hides log and tag lines
+assert.deepEqual(Rows.HIDDEN, ["log", "tag"]);
+assert.equal(rows.filter(r => !Rows.HIDDEN.includes(r.kind)).length, expected - 3);
+
+// landed_of: only children whose snapshot says landed
+const kids = [{ id: "a", name: "a", snap: { state: "complete", last_activity: at(3) } }, { id: "b", name: "b", snap: { state: "running" } }, { id: "c", name: "c", snap: null }, { id: "d", name: "d", snap: { closed: true, first_at: at(4) } }];
+assert.deepEqual(Rows.landed_of(kids).map(k => k.id), ["a", "d"]);
+
+console.log("SessionTimeline.test.mjs ok: " + rows.length + " rows = " + record.length + " lines + 3 prompts + " + landed.length + " landed");
diff --git a/public/framework/ai/AISession/SessionTimelineRows.js b/public/framework/ai/AISession/SessionTimelineRows.js
new file mode 100644
index 000000000..4c33a57c2
--- /dev/null
+++ b/public/framework/ai/AISession/SessionTimelineRows.js
@@ -0,0 +1,119 @@
+import PromptLog from "./PromptLog.js";
+
+/** The Timeline's rows, built with no DOM so a node test can count them (SessionTimeline.test.mjs). A record line is one row, a prompt of
+ *  prompts.jsonl is one row, a landed child session is one row; SessionTimeline draws them. Readme: ai/AISession/readme.md. */
+export default class SessionTimelineRows {
+
+	/** [kind, menu label, material icon]; `done` wears SessionOutlineView.state_icon, the Overview's green check. */
+	static KINDS = [
+		["prompt", "Prompts", "record_voice_over"], ["task", "Tasks added and changed", "add_task"], ["done", "Tasks done", "check_circle"],
+		["child", "Child sessions started", "play_circle"], ["landed", "Child sessions landed", "flag"], ["note", "Notes", "sticky_note_2"],
+		["decision", "Decisions", "gavel"], ["review", "Reviews", "rate_review"], ["commit", "Commits", "commit"],
+		["session", "Session start and stop", "power_settings_new"], ["log", "Log lines", "notes"], ["tag", "Tag lines", "sell"], ["other", "Other lines", "more_horiz"],
+	];
+	static HIDDEN = ["log", "tag"];   // off until the reader turns them on
+	static LANDED = ["landed", "complete", "done", "closed"];
+
+	// ---- rows: no DOM, so the test can call them ---------------------------------------------------------------------------------
+
+	static time_of(l){
+		const own = l.at ?? l.ts;
+		if (own) return Date.parse(own) || null;
+		for (const v of Object.values(l)) if (v && typeof v === "object" && !Array.isArray(v) && v.at) return Date.parse(v.at) || null;
+		return null;
+	}
+
+	static clip(s, n = 220){ s = String(s ?? "").replace(/\s+/g, " ").trim(); return s.length > n ? s.slice(0, n - 1) + "…" : s; }
+	static slug_of(path){ return String(path ?? "").split("/").filter(Boolean).pop() ?? ""; }
+
+	/** Every task title the record names (`tasks.add`), id to title: a later line says "done" with only the id. */
+	static titles(lines){
+		const out = new Map();
+		const walk = l => { if (!l || typeof l !== "object") return; for (const x of [].concat(l.tasks?.add ?? [])) if (x?.id && x.title) out.set(x.id, x.title); for (const v of Object.values(l)) if (v && typeof v === "object" && !Array.isArray(v) && v.tasks) walk(v); };
+		lines.forEach(walk);
+		return out;
+	}
+
+	/** One `tasks` line, which may add tasks, finish some and drop others at once, as one row. */
+	static task_row(t, titles){
+		const name = id => SessionTimelineRows.clip(titles.get(id) ?? id, 120), adds = [], done = [], dropped = [], other = [];
+		for (const [id, v] of Object.entries(t)){
+			if (id === "add"){ adds.push(...[].concat(v)); continue; }
+			if (v && typeof v === "object" && "complete" in v) done.push([id, v.complete]);
+			else if (v && typeof v === "object" && "stop" in v) dropped.push([id, v.stop]);
+			else other.push([id, v]);
+		}
+		const list = (names, noun) => names.length === 1 ? names[0] : `${names.length} ${noun}: ${names.slice(0, 2).join("; ")}${names.length > 2 ? ` and ${names.length - 2} more` : ""}`;
+		const also = [done.length && adds.length && `${adds.length} added`, dropped.length && (done.length || adds.length) && `${dropped.length} dropped`, other.length && (done.length || adds.length || dropped.length) && `${other.length} changed`].filter(Boolean).join(", ");
+		const tail = also ? ` (also ${also})` : "";
+		if (done.length){
+			const one = done.length === 1 ? done[0][1] : null, outcome = typeof one === "string" ? one : one?.outcome;
+			return { kind: "done", text: (done.length === 1 ? "Done: " : "") + list(done.map(d => name(d[0])), "tasks done") + tail, more: outcome ? SessionTimelineRows.clip(outcome, 300) : "" };
+		}
+		if (adds.length) return { kind: "task", text: (adds.length === 1 ? "Task added: " : "") + list(adds.map(x => SessionTimelineRows.clip(x.title ?? x.id ?? "untitled", 120)), "tasks added") + tail };
+		if (dropped.length) return { kind: "task", text: (dropped.length === 1 ? "Dropped: " : "") + list(dropped.map(d => name(d[0])), "tasks dropped") + tail, more: dropped.length === 1 && typeof dropped[0][1] === "string" ? SessionTimelineRows.clip(dropped[0][1], 300) : "" };
+		const first = other[0]?.[1], note = first && typeof first === "object" ? first.note ?? first.now ?? first.waiting_on : null;
+		return { kind: "task", text: "Task update: " + list(other.map(d => name(d[0])), "tasks"), more: other.length === 1 && note ? SessionTimelineRows.clip(typeof note === "string" ? note : JSON.stringify(note), 300) : "" };
+	}
+
+	/** One record line to one row `{ kind, at, text, more?, children? }`. `children` are the child sessions the row names (linked when drawn). */
+	static row(l, titles){
+		const at = SessionTimelineRows.time_of(l), clip = SessionTimelineRows.clip, str = v => typeof v === "string" ? v : v?.msg ?? v?.text ?? v?.title ?? v?.about ?? v?.id ?? "";
+		if (l.tasks && typeof l.tasks === "object") return { ...SessionTimelineRows.task_row(l.tasks, titles), at };
+		if (typeof l.task === "string"){
+			const id = l.as ?? SessionTimelineRows.slug_of(l.task);
+			if (l.type === "Session" || l.spawn) return { kind: "child", at, text: "Child session started", children: [id], more: [l.spawn?.role, l.spawn?.model].filter(Boolean).join(" · ") };
+			return { kind: "task", at, text: "Task linked: " + id, more: l.moved_from ? "moved here" : "" };
+		}
+		if (Array.isArray(l.sessions)){
+			const ids = l.sessions.map(s => typeof s === "string" ? s : s?.id).filter(Boolean);
+			return { kind: "child", at, text: ids.length > 1 ? `${ids.length} child sessions started` : "Child session started", children: ids };
+		}
+		if (l.decide) return { kind: "task", at, text: `Owner ${l.decide.is}: ${clip(titles.get(l.decide.task) ?? l.decide.task, 120)}`, more: l.decide.note ? clip(l.decide.note) : "" };
+		if (l.tag !== undefined) return { kind: "tag", at, text: "Tag: " + str(l.tag) };
+		if (l.log !== undefined) return { kind: "log", at, text: clip(str(l.log)) };
+		if (l.note !== undefined) return { kind: "note", at, text: clip(str(l.note)) };
+		if (l.decision !== undefined) return { kind: "decision", at, text: "Decision: " + clip(str(l.decision)), more: typeof l.decision === "object" ? clip(l.decision.decision ?? l.decision.chose ?? l.decision.why ?? "", 300) : "" };
+		if (l.review !== undefined){
+			const r = l.review, n = Array.isArray(r?.findings) ? r.findings.length : 0;
+			return { kind: "review", at, text: `Review${r?.size ? " (" + r.size + ")" : ""}: ${r?.verdict ?? "recorded"} · ${n} finding${n === 1 ? "" : "s"}` };
+		}
+		if (l.commit !== undefined) return { kind: "commit", at, text: `Commit ${String(l.commit?.hash ?? "").slice(0, 8)}: ${clip(l.commit?.what ?? "", 200)}` };
+		if (l.content !== undefined){ const x = l.content.add ?? l.content; return { kind: "note", at, text: `${x?.type ?? "Content"}: ${clip(x?.text ?? x?.title ?? "")}` }; }
+		if (l.stop !== undefined) return { kind: "session", at, text: "Session stopped" + (l.stop?.why ? ": " + clip(l.stop.why, 160) : "") };
+		if (l.start !== undefined) return { kind: "session", at, text: "Session resumed" };
+		if (l.landed_at !== undefined) return { kind: "session", at, text: "Landed" + (l.outcome ? ": " + clip(l.outcome, 200) : "") };
+		if (l.session && typeof l.session === "object") return { kind: "session", at, text: "Session started" + (l.session.kind ? " (" + l.session.kind + ")" : "") };
+		if (l.assign !== undefined || l.agent !== undefined) return { kind: "session", at, text: "Agent assigned" + (l.assign?.role ? ": " + l.assign.role : "") };
+		if (typeof l.msg === "string") return { kind: SessionTimelineRows.KINDS.some(k => k[0] === l.type) ? l.type : "log", at, text: clip(l.msg) };
+		const inner = Object.values(l).find(v => v && typeof v === "object" && !Array.isArray(v) && (v.tasks || typeof v.task === "string"));
+		if (inner) return { ...SessionTimelineRows.row(inner, titles), at: at ?? SessionTimelineRows.time_of(inner) };
+		const key = Object.keys(l).find(k => !["by", "ts", "at"].includes(k)) ?? "line";
+		return { kind: "other", at, text: key + ": " + clip(typeof l[key] === "string" ? l[key] : JSON.stringify(l[key]), 160) };
+	}
+
+	/** Every row, oldest first: one per record line, one per prompt in the log (`PromptLog.fold` of its lines), one per landed child
+	 *  (`landed`: `[{ id, name, at }]`). A line with no time of its own takes the time of the line before it; the sort is stable. */
+	static rows(lines = [], prompt_lines = [], landed = []){
+		const titles = SessionTimelineRows.titles(lines), out = [];
+		let last = null;
+		lines.forEach((l, n) => {
+			const r = SessionTimelineRows.row(l, titles);
+			if (r.at == null) r.at = last; else last = r.at;
+			out.push({ ...r, n });
+		});
+		const first = out.find(r => r.at != null)?.at ?? 0;
+		out.forEach(r => { r.at ??= first; });
+		for (const pr of Object.values(PromptLog.fold(prompt_lines))){
+			const raw = pr.raw ?? pr.clean.join(" ");
+			out.push({ kind: "prompt", at: Date.parse(pr.at) || first, text: SessionTimelineRows.clip(pr.subject || raw || "(empty prompt)", 160), raw: raw ?? "", n: out.length });
+		}
+		for (const c of landed) out.push({ kind: "landed", at: Date.parse(c.at) || first, text: "Child session landed", children: [c.id ?? c.name], n: out.length });
+		return out.sort((x, y) => x.at - y.at || x.n - y.n);
+	}
+
+	/** The child sessions that have landed, from the Overview's child list (SessionOutline.children().list). */
+	static landed_of(kids){
+		return kids.filter(c => c.snap && (c.snap.closed || SessionTimelineRows.LANDED.includes(c.snap.state))).map(c => ({ id: c.id ?? c.key, name: c.name, at: c.snap.last_activity ?? c.snap.first_at }));
+	}
+}

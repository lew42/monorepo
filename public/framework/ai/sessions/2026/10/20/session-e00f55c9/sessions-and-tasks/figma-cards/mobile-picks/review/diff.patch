diff --git a/public/framework/ai/sessions/v/mobile/MobileAll.js b/public/framework/ai/sessions/v/mobile/MobileAll.js
new file mode 100644
index 000000000..f4800c1bc
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileAll.js
@@ -0,0 +1,76 @@
+import { div, button, small, strong, details, summary, icon } from "/framework/core/View/View.js";
+import MobileHome from "./MobileHome.js";
+import MobileData from "./MobileData.js";
+import MobileRow from "./MobileRow.js";
+
+/* Page 2, every recent session nested by parent: a spawned session sits inside the session that spawned it, collapsed under
+   a count ("+6 minions"). The parent of each session is session-tree.json's (MobileData.parent); a child whose parent is
+   not in the list stays at the top, so nothing disappears. */
+export default class MobileAll extends MobileHome {
+
+	static DAYS = 1;   // today, as the Day tab
+	static PAGE = 40;   // top-level rows drawn at once; "show more" adds the next page
+	mode = "all";
+
+	constructor(...args){ super({ title: "Nested" }, ...args); }
+
+	/** How many days back: `?days=30` in the url, else DAYS. */
+	get days(){ return Math.min(60, +new URLSearchParams(location.search).get("days") || this.constructor.DAYS); }
+	/** `?end=2026-10-08` looks back from that day instead of today (the parent data of the last two weeks is stale: see the readme). */
+	get end(){ const e = new URLSearchParams(location.search).get("end"); return e ? new Date(e + "T12:00:00") : new Date(); }
+	head_info(){
+		if (!location.search) return super.head_info();   // the same date header as the Day tab
+		return { title: this.end.toDateString() === new Date().toDateString() ? this.days === 1 ? "Today" : `Last ${this.days} days` : `${this.days} d to ${new URLSearchParams(location.search).get("end")}` }; }
+
+	async rows(){
+		const snaps = await MobileData.days(this.days, this.end);
+		return Promise.all(snaps.map(async snap => { const tasks = await MobileData.tasks(snap).catch(() => null), line = await MobileData.outcome(snap, tasks); return { snap, tasks, line, group: MobileData.group(snap, tasks, line) }; }));
+	}
+
+	async load(out){
+		const [rows, tree] = [await this.rows(), await MobileData.tree()];
+		const by_id = new Map(rows.map(r => [r.snap.id, r]));
+		const kids = new Map();
+		for (const r of rows){
+			const up = MobileData.parent(r.snap, tree);
+			if (up && up !== r.snap.id && by_id.has(up)) (kids.get(up) ?? kids.set(up, []).get(up)).push(r);
+		}
+		const newest = (a, b) => String(b.snap.last_activity).localeCompare(String(a.snap.last_activity));
+		const top = rows.filter(r => { const up = MobileData.parent(r.snap, tree); return !(up && up !== r.snap.id && by_id.has(up)); }).sort(newest);
+		out.empty(() => {
+			this.header(rows);
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("account_tree").ac("mob-group-icon"); strong("Sessions"); small.c("mob-count", String(top.length)); });
+				if (!kids.size) div.c("mob-empty", "No parent links recorded for this day");
+				this.page_of(top, kids, tree, this.constructor.PAGE);
+			});
+		});
+	}
+
+	/** The first `n` of `top`, then a button for the next page (a month is thousands of rows). */
+	page_of(top, kids, tree, n){
+		top.slice(n - this.constructor.PAGE, n).forEach(r => this.nest(r, kids, tree));
+		if (top.length <= n) return;
+		const more = button.c("mob-more", `Show ${Math.min(this.constructor.PAGE, top.length - n)} more of ${top.length - n}`).click(() => { more.el.remove(); this.page_of(top, kids, tree, n + this.constructor.PAGE); });
+	}
+
+	/** A session row; its children, if any, are folded under "+N minions" (one indent, a 2 px rail) and drawn when first opened: a parent can hold hundreds. */
+	nest(r, kids, tree){
+		new MobileRow({ ...r, tree });
+		const mine = (kids.get(r.snap.id) ?? []).sort((a, b) => String(b.snap.last_activity).localeCompare(String(a.snap.last_activity)));
+		if (!mine.length) return;
+		let $kids, built = false;
+		const box = details.c("mob-nest", () => {
+			summary.c("mob-nest-sum", this.count_words(mine, tree));
+			$kids = div.c("mob-nest-kids");
+		});
+		box.on("toggle", () => { if (box.el.open && !built){ built = true; $kids.append(() => mine.forEach(k => this.nest(k, kids, tree))); } });
+	}
+
+	/** "+6 minions", "+1 mastermind, 3 minions": the direct children counted by kind. */
+	count_words(mine, tree){
+		const n = {};
+		mine.forEach(k => { const kind = MobileData.kind(k.snap, tree); n[kind] = (n[kind] ?? 0) + 1; });
+		return "+" + Object.entries(n).map(([k, c]) => `${c} ${k}${c > 1 && !k.endsWith("s") ? "s" : ""}`).join(", ");
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileData.js b/public/framework/ai/sessions/v/mobile/MobileData.js
new file mode 100644
index 000000000..52a3d5157
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileData.js
@@ -0,0 +1,103 @@
+import Day from "/framework/core/Session/Day.js";
+import SessionTree from "../../doc/variants/SessionTree.js";
+
+/* Everything the mobile variant reads, in one place (doc: readme.md here). Three files, all computed by node, nothing typed:
+   the day's sessions/YYYY/MM/DD/index.json (one snapshot per session), sessions/session-tree.json (parent and role per
+   session id) and ai/index.json (every task, read through SessionTree). */
+export default class MobileData {
+
+	static SESSIONS = "/framework/ai/sessions/";
+	static HOME = MobileData.SESSIONS + "v/mobile/";
+	static cache = new Map();
+
+	static json(url){
+		if (!this.cache.has(url)) this.cache.set(url, fetch(url).then(r => r.ok ? r.json() : null).catch(() => null));
+		return this.cache.get(url);
+	}
+
+	static async day(day){ return (await this.json(`${this.SESSIONS}${day}/index.json`))?.snapshots ?? []; }
+	static async tree(){ return (await this.json(this.SESSIONS + "session-tree.json")) ?? {}; }
+
+	/** The sessions of the last `days` days, newest day first, each once. A snapshot is stamped with the day file it came from (`_day`). */
+	static async days(days, from = new Date()){
+		const seen = new Map();
+		for (let i = 0; i < days; i++){
+			const day = Day.path(new Date(from.getFullYear(), from.getMonth(), from.getDate() - i));
+			for (const s of await this.day(day)) if (!seen.has(s.id)) seen.set(s.id, { ...s, _day: day });
+		}
+		return [...seen.values()];
+	}
+
+	/** One session by id: scans the last 14 day files once. */
+	static async find(id){
+		this.all ??= this.days(14);
+		return (await this.all).find(s => s.id === id) ?? null;
+	}
+
+	/** The session's folder day ("2026/10/20"): its `day` field, else the day file it was found in. */
+	static dir_day(snap){ return snap.day ? snap.day.replaceAll("-", "/") : snap._day; }
+	static dir_url(snap){ return `${this.SESSIONS}${this.dir_day(snap)}/${snap.folder}/`; }
+	static session_url(id){ return this.HOME + id + "/"; }
+	static task_url(id, rel){ return this.HOME + id + "/" + rel + "/"; }
+
+	/** The session's tasks as a tree (SessionTree.Node); null for a session with no folder or no task. */
+	static async tasks(snap){
+		if (!snap.folder) return null;
+		const t = await SessionTree.load(this.dir_day(snap), snap.folder);
+		return t.root.kids.length ? t : null;
+	}
+
+	// ---- what a session is -----------------------------------------------------------------------------
+
+	/** One of "VS Code tab", "voice", "mastermind", "minion"; any other agent keeps its role word (reviewer, assistant...). */
+	static kind(snap, tree){
+		const role = tree[snap.id]?.role, agent = snap.agent ?? tree[snap.id]?.agent ?? "";
+		if (snap.kind || /^v-/.test(snap.id) || role === "voice") return "voice";
+		if (role === "minion" || agent.startsWith("minion")) return "minion";
+		if (agent === "vscode-mastermind" || (!agent && !role && !snap.parent && !tree[snap.id])) return "VS Code tab";
+		if (/mastermind/.test(role ?? "") || agent.includes("mastermind")) return "mastermind";
+		return role ?? (agent.replace(/-.*/, "") || "session");
+	}
+
+	static parent(snap, tree){ return tree[snap.id]?.parent ?? snap.links?.parent ?? null; }
+
+	/** Sessions with no parent anywhere in the tree: the missing-link list for the report. */
+	static orphans(snaps, tree){
+		return snaps.filter(s => ["minion", "mastermind"].includes(this.kind(s, tree)) && !this.parent(s, tree));
+	}
+
+	/** The tasks the session itself did, from ai/index.json (`session` = its id): where a session without a task folder keeps its outcome. */
+	static async owned(snap){
+		const [index] = await SessionTree.files(this.dir_day(snap));
+		return index.tasks.filter(t => t.session === snap.id);
+	}
+
+	// ---- groups of the day --------------------------------------------------------------------------
+
+	/** Needs you / Running / Done / the rest. Needs you = an alert or a red flag on the session, or a task waiting on someone.
+	    Done = it has an outcome line (a landed task). The rest = idle with nothing landed. */
+	static group(snap, tasks, line){
+		if (snap.alerts > 0 || snap.flags > 0 || tasks?.root.all().some(n => n.state === "waiting")) return "needs";
+		if (snap.state === "active") return "running";
+		return line ? "done" : "rest";
+	}
+
+	/** The one line a finished session ends on: its latest landed task's, in its folder or owned by it. */
+	static async outcome(snap, tasks){
+		const own = (await this.owned(snap).catch(() => [])).filter(t => t.landed_at && t.line).map(t => ({ line: t.line, at: t.landed_at }));
+		const here = (tasks?.root.all() ?? []).filter(n => n.landed && n.line).map(n => ({ line: n.line, at: n.ended }));
+		return [...own, ...here].sort((a, b) => Date.parse(b.at) - Date.parse(a.at))[0]?.line ?? null;
+	}
+
+	static usd(n){ return "$" + (n ?? 0).toFixed(n >= 100 ? 0 : 2); }
+
+	static ago(iso){
+		const m = Math.round((Date.now() - Date.parse(iso ?? "")) / 6e4);
+		return isNaN(m) ? "" : m < 1 ? "just now" : m < 90 ? m + " min ago" : m < 2880 ? Math.round(m / 60) + " h ago" : Math.round(m / 1440) + " d ago";
+	}
+
+	// ---- task status: the owner's rules (mobile-cards.md) -----------------------------------------------------
+	// green done, amber running, red waiting or paused (blocked), grey open; a stopped task is dropped and not counted.
+
+	static states(nodes){ return nodes.map(n => n.state).filter(s => s !== "stopped"); }
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileHome.js b/public/framework/ai/sessions/v/mobile/MobileHome.js
new file mode 100644
index 000000000..de7e495f4
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileHome.js
@@ -0,0 +1,102 @@
+import { Page } from "/app.js";
+import { div, span, a, small, strong, details, summary, icon } from "/framework/core/View/View.js";
+import AISessionsPage from "../../../AISession/AISessionsPage.js";
+import Day from "/framework/core/Session/Day.js";
+import AISessionDetail from "../../../AISession/AISessionDetail.js";
+import MobileData from "./MobileData.js";
+import MobileRow from "./MobileRow.js";
+import MobilePath from "./MobilePath.js";
+
+/* Page 1, the day list: that day's sessions, grouped by what needs you. Extends the real sessions page (its route() and
+   child() are overridden to hand out the mobile pages); the ground, cards and rows are mobile.css. Doc: readme.md here. */
+export default class MobileHome extends AISessionsPage {
+
+	static GROUPS = [["needs", "Needs you", "error"], ["running", "Running", "play_circle"], ["done", "Done", "check_circle"], ["rest", "Everything else", "unfold_more"]];
+
+	constructor(...args){
+		super({ title: "Mobile sessions", icon: "smartphone", classes: "mob-page", description: "The sessions of one day, for a phone." }, ...args);
+	}
+
+	initialize(){}     // not the wide Panel2 columns of the real page
+	activated(){}      // the real page's live poll; this one reads the day file once
+	deactivated(){}
+
+	/** The day shown: the url's, else today. */
+	get shown_day(){ return this.day ?? Day.path(new Date()); }
+
+	/** `2026/10/22/` opens a day by path; `all/` (page 2) and a session id (page 3) are added as those pages land. */
+	route(name){
+		if (/^\d{4}$/.test(name)) return new MobilePath({ segs: [name], home: this });
+		if (name === "all") return new this.constructor.All();   // set in page.js: All extends this class, so it cannot be imported here
+		if (name.includes(".") || name === "doc" || name === "readme") return;
+		return new this.constructor.Session({ id: name });   // set in page.js, as All is
+	}
+
+	/** The real page preloads a session's rows in child(); the mobile pages read their own files, so go straight to Page. */
+	async child(name, levels){
+		if (name && !name.includes(".") && name !== "all" && !/^\d{4}$/.test(name)) await AISessionDetail.preload(MobileData.SESSIONS, name);   // the session page's loaders, before it is built
+		return Page.prototype.child.call(this, name, levels);
+	}
+
+	content(){
+		const out = div.c("mob-day");
+		this.load(out);
+	}
+
+	/** The sessions this page lists, each with its tasks and group. Page 2 lists the last week instead of one day. */
+	async rows(){
+		const snaps = await MobileData.day(this.shown_day);
+		return Promise.all(snaps.map(async s => { const snap = { ...s, _day: s._day ?? this.shown_day }, tasks = await MobileData.tasks(snap).catch(() => null), line = await MobileData.outcome(snap, tasks); return { snap, tasks, line, group: MobileData.group(snap, tasks, line) }; }));
+	}
+
+	async load(out){
+		const [rows, tree] = [await this.rows(), await MobileData.tree()];
+		rows.sort((a, b) => String(b.snap.last_activity).localeCompare(String(a.snap.last_activity)));
+		out.empty(() => {
+			this.header(rows);
+			for (const [key, label, glyph] of this.constructor.GROUPS){
+				const mine = rows.filter(r => r.group === key);
+				if (key === "rest") this.folded(label, mine, tree);
+				else if (mine.length) this.card(label, glyph, key, mine, tree);
+			}
+			if (!rows.length) div.c("mob-card", () => div.c("mob-empty", "No sessions were recorded on this day."));
+		});
+	}
+
+	/** The bar at the top: title, count and cost, the day arrows (day mode only) and the Day | Nested switch. */
+	header(rows){
+		const { title, step } = this.head_info();
+		const cost = MobileData.usd(rows.reduce((t, r) => t + (r.snap.usd ?? 0), 0));
+		div.c("mob-card mob-daybar", () => {
+			div.c("mob-card-head", () => {
+				step ? a.c("mob-step", icon("chevron_left")).href(step(-1)).attr("title", "the day before") : span.c("mob-step");
+				div.c("mob-head-main", () => { strong(title); small.c("mob-head-sub", `${rows.length} sessions · ${cost}`); });
+				step ? a.c("mob-step", icon("chevron_right")).href(step(1)).attr("title", "the day after") : span.c("mob-step");
+			});
+			div.c("mob-switch", () => {
+				this.mode === "all" ? a("Day").href(MobileData.HOME) : span.c("mob-switch-on", "Day");
+				this.mode === "all" ? span.c("mob-switch-on", "Nested") : a("Nested").href(MobileData.HOME + "all/");
+			});
+		});
+	}
+
+	head_info(){
+		const [y, m, d] = this.shown_day.split("/").map(Number);
+		return { title: new Date(y, m - 1, d).toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" }), step: n => MobileData.HOME + Day.path(new Date(y, m - 1, d + n)) + "/" };
+	}
+
+	card(label, glyph, key, rows, tree){
+		div.c("mob-card mob-group-" + key, () => {
+			div.c("mob-card-head", () => { icon(glyph).ac("mob-group-icon"); strong(label); small.c("mob-count", String(rows.length)); });
+			rows.forEach(r => new MobileRow({ ...r, tree }));
+		});
+	}
+
+	folded(label, rows, tree){
+		if (!rows.length) return;
+		details.c("mob-card mob-fold", () => {
+			summary.c("mob-card-head", () => { icon("unfold_more").ac("mob-group-icon"); strong(label); small.c("mob-count", String(rows.length)); });
+			rows.forEach(r => new MobileRow({ ...r, tree }));
+		});
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobilePath.js b/public/framework/ai/sessions/v/mobile/MobilePath.js

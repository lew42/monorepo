@@ -0,0 +1,14 @@
+import { Page } from "/app.js";
+import MobileHome from "./MobileHome.js";
+
+/* `2026/` and `2026/10/` are not pages, only the way to `2026/10/22/`: each step hands on to the next, the third is the day list. */
+export default class MobilePath extends Page {
+
+	constructor(...args){ super({ title: "", width: "fill" }, ...args); }
+
+	route(name){
+		if (!/^\d{1,2}$/.test(name)) return;
+		const segs = [...this.segs, name];
+		return segs.length === 3 ? new MobileHome({ day: segs.join("/") }) : new MobilePath({ segs, home: this.home });
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileRow.js b/public/framework/ai/sessions/v/mobile/MobileRow.js
new file mode 100644
index 000000000..3e1991bf9
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileRow.js
@@ -0,0 +1,31 @@
+import View, { div, span, a, small, strong, icon } from "/framework/core/View/View.js";
+import TaskView from "/framework/core/Task/TaskView.js";
+import MobileData from "./MobileData.js";
+
+View.stylesheet(import.meta, "mobile.css");
+
+/* One tappable session row: a status dot, the title, a line of facts, and (when the session has tasks) the one task bar.
+   `snap` is a day-index snapshot, `tasks` its SessionTree or null, `group` needs | running | done | rest.
+   `kids` (page 2) are the child rows drawn under it. */
+export default class MobileRow extends View {
+
+	static DOT = { needs: "is-blocked", running: "is-running", done: "is-done", rest: "is-open" };
+
+	initialize(){
+		const { snap, tasks, group, tree, line } = this;
+		this.ac("mob-row", "mob-" + group);
+		a.c("mob-row-link", () => {
+			span.c("mob-dot").ac(this.constructor.DOT[group]);
+			div.c("mob-row-body", () => {
+				strong.c("mob-row-title", snap.title || snap.id);
+				small.c("mob-row-sub", () => {
+					span.c("mob-kind", MobileData.kind(snap, tree));
+					span(" · " + MobileData.ago(snap.last_activity) + (snap.usd ? " · " + MobileData.usd(snap.tree_usd || snap.usd) : ""));
+				});
+				if (line && group === "done") small.c("mob-row-line", line);
+				if (tasks?.root.kids.length > 1) div.c("mob-row-bar", () => TaskView.draw_bar(MobileData.states(tasks.root.kids), 12));
+			});
+			icon("chevron_right").ac("mob-go");
+		}).href(MobileData.session_url(snap.id));
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileRun.js b/public/framework/ai/sessions/v/mobile/MobileRun.js
new file mode 100644
index 000000000..aac28c6f3
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileRun.js
@@ -0,0 +1,44 @@
+import View, { span, button, icon } from "/framework/core/View/View.js";
+import TaskPage from "/framework/core/Task/TaskPage.js";
+import { Task } from "/framework/core/Task/Task.js";
+import TaskView from "/framework/core/Task/TaskView.js";
+
+View.stylesheet(import.meta, "mobile.css");
+
+/* Is it running? One small indicator on a task row (a dot while it runs, a play triangle when it could start), the buttons
+   that fit its state, and a "next" mark when it will start by itself. The buttons are TaskView.VERBS where Task.can(state) allows; a press
+   appends the task's own verb line ({"pause":{}}) through task.act, so an agent following that log gets it; there is no second state machine.
+   `node` is a SessionTree.Node (rel, url, state); `next` says it is first in line under a running series parent. */
+export default class MobileRun extends View {
+
+	/** Computed, never stored: the first child of a running series parent that is not complete, when that child is idle (Task.js start_children). */
+	static is_next(node){
+		const up = node.parent;
+		if (!up || up.state !== "running" || node.state !== "idle") return false;
+		return up.kids.find(k => k.state !== "complete") === node;
+	}
+
+	initialize(){
+		this.ac("mob-run");
+		this.next ??= this.constructor.is_next(this.node);
+		this.draw();
+	}
+
+	draw(){
+		const { node } = this, state = node.state;
+		this.empty(() => {
+			icon(state === "running" ? "fiber_manual_record" : state === "complete" ? "check" : "play_arrow").ac("mob-run-dot", "is-" + state).attr("title", state);
+			if (this.next) span.c("mob-run-next", "next").attr("title", "starts by itself when the one before it is done");
+			for (const [verb, glyph, title] of TaskView.VERBS.filter(([verb]) => Task.can(state, verb)))
+				button.c("mob-run-btn").attr("title", title).attr("aria-label", title).append(icon(glyph)).click(e => { e.preventDefault(); e.stopPropagation(); this.press(verb); });
+		});
+	}
+
+	async press(verb){
+		const task = await new TaskPage({ url: this.node.url }).load_task();
+		task.act(verb, verb === "stop" ? "owner pressed stop" : undefined);   // saves the verb line, {"pause":{}} etc. (Item.act)
+		this.node.state = task.state;
+		this.draw();
+		this.on_change?.(this.node);
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileSession.js b/public/framework/ai/sessions/v/mobile/MobileSession.js
new file mode 100644
index 000000000..f22c00dec
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileSession.js
@@ -0,0 +1,91 @@
+import { Page } from "/app.js";
+import { div, span, a, small, strong, p, h1, icon } from "/framework/core/View/View.js";
+import AISessionDetail from "../../../AISession/AISessionDetail.js";
+import AISessionConversation from "../../../AISession/AISessionConversation.js";
+import AISessionFollow from "../../../AISession/AISessionFollow.js";
+import SessionTree from "../../doc/variants/SessionTree.js";
+import MobileData from "./MobileData.js";
+import MobileTaskRow from "./MobileTaskRow.js";
+import SwipeTabs from "./SwipeTabs.js";
+
+/* Page 3, one session, design B: open work first; the big title scrolls away and a compact bar slides in; tabs Overview,
+   Tasks and Chat swipe. Extends the real session page for its data loaders and its session menu (head_tools). */
+export default class MobileSession extends AISessionDetail {
+
+	static OPEN = 6;   // open tasks listed on Overview before "all in Tasks"
+
+	constructor({ id }){
+		super({ home: { url: MobileData.SESSIONS }, id });   // the loaders read home.url; the page's own url is set when it is added under v/mobile/
+	}
+
+	/** A task path under this session opens the task page (page 4). */
+	route(name){
+		if (name.includes(".")) return;
+		return new this.constructor.Task({ sid: this.id, segs: [name] });
+	}
+	child(name, levels){ return Page.prototype.child.call(this, name, levels); }
+
+	content(){
+		const root = div.c("mob-session");
+		const top = div.c("mob-title");
+		const bar = div.c("mob-bar-wrap", () => div.c("mob-bar", () => { a.c("mob-back", icon("arrow_back")).href(MobileData.HOME).attr("title", "all sessions"); this.$bar_title = strong.c("mob-bar-title", this.title); this.head_tools(); }));
+		this.tabs = new SwipeTabs({ tabs: [["overview", "Overview"], ["tasks", "Tasks"], ["chat", "Chat"]] });
+		new IntersectionObserver(([e]) => bar.el.classList.toggle("is-on", !e.isIntersecting)).observe(top.el);
+		this.fill(top);
+		this.chat(this.tabs.panes.chat);
+	}
+
+	async fill(top){
+		const snap = await MobileData.find(this.id), tree_ids = await MobileData.tree();
+		const { overview, tasks } = this.tabs.panes;
+		if (!snap){ top.empty(() => p.c("mob-empty", "This session is not in the last 14 days of day indexes.")); return; }
+		const tree = await MobileData.tasks(snap).catch(() => null), kind = MobileData.kind(snap, tree_ids), up = MobileData.parent(snap, tree_ids);
+		this.$bar_title?.el.replaceChildren(snap.title || snap.id);
+		top.empty(() => {
+			small.c("mob-kind", kind + (up ? " · spawned by " : ""));
+			if (up) a.c("mob-parent", up.slice(0, 8)).href(MobileData.session_url(up));
+			h1.c("mob-h1", snap.title || snap.id);
+			small.c("mob-head-sub", `${MobileData.ago(snap.last_activity)} · ${MobileData.usd(snap.tree_usd || snap.usd)} · ${snap.model ?? "no model"}`);
+		});
+		const nodes = tree?.root.all().slice(1) ?? [];
+		const open = nodes.filter(n => !["complete", "stopped"].includes(n.state) && !n.kids.some(k => !["complete", "stopped"].includes(k.state)));
+		overview.empty(() => {
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("pending_actions").ac("mob-group-icon"); strong("Open work"); small.c("mob-count", String(open.length)); });
+				open.slice(0, this.constructor.OPEN).forEach(n => new MobileTaskRow({ node: n, sid: this.id }));
+				if (!open.length) div.c("mob-empty", nodes.length ? "Nothing open: every task is done." : "No tasks recorded in this session.");
+				if (open.length > this.constructor.OPEN) a.c("mob-more", `${open.length - this.constructor.OPEN} more in Tasks`).on("click", () => this.tabs.go("tasks"));
+			});
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("info").ac("mob-group-icon"); strong("About"); });
+				div.c("mob-facts", () => (tree?.facts() ?? [["cost", MobileData.usd(snap.usd)]]).forEach(([k, v]) => div.c("mob-fact", () => { small.c("mob-fact-k", k); span(v); })));
+				if (tree) tree.bullets().slice(0, 6).forEach(t => div.c("mob-bullet", t));
+			});
+		});
+		tasks.empty(() => div.c("mob-card", () => {
+			div.c("mob-card-head", () => { icon("checklist").ac("mob-group-icon"); strong("Tasks"); small.c("mob-count", String(nodes.length)); });
+			if (!tree) div.c("mob-empty", "No tasks recorded in this session.");
+			else this.rows(tree.root.kids);
+		}));
+	}
+
+	/** Top-level tasks, each with its children one indent in and a 2 px rail; deeper levels open their own page. */
+	rows(list){
+		list.forEach(n => {
+			new MobileTaskRow({ node: n, sid: this.id });
+			if (n.kids.length) div.c("mob-nest-kids", () => n.kids.forEach(k => new MobileTaskRow({ node: k, sid: this.id })));
+		});
+	}
+
+	/** The conversation, as the real page shows it (AISessionConversation fed by AISessionFollow). */
+	chat(pane){
+		const conv = new AISessionConversation();
+		conv.session = this.id;
+		pane.append(conv.view);
+		if (!/^[0-9a-f]{8}-/.test(this.id)) return void pane.append(() => p.c("mob-empty", "No transcript for this kind of session."));
+		const f = new AISessionFollow(this.id);
+		f.on_lines = lines => conv.add(lines);
+		this.follow = f.start();
+		this.follow.then(() => { if (!conv.count) pane.append(() => p.c("mob-empty", AISessionDetail.NO_TRANSCRIPT)); });
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileTask.js b/public/framework/ai/sessions/v/mobile/MobileTask.js
new file mode 100644
index 000000000..c86297232
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileTask.js
@@ -0,0 +1,85 @@
+import { Page, md } from "/app.js";
+import { div, span, a, small, strong, p, h1, button, icon } from "/framework/core/View/View.js";
+import TaskView from "/framework/core/Task/TaskView.js";
+import TaskPage from "/framework/core/Task/TaskPage.js";
+import MobileData from "./MobileData.js";
+import MobileRun from "./MobileRun.js";
+import MobileTaskRow from "./MobileTaskRow.js";
+
+/* Page 4, one task: status and the bar on top, its content first, its subtasks as flat rows, then its open questions.
+   `sid` is the session id, `segs` the task's path under the session folder (deeper folders extend it through route()). */
+export default class MobileTask extends Page {
+
+	constructor({ sid, segs }){
+		super({ sid, segs, title: segs.at(-1), width: "fill", classes: "mob-page", url: MobileData.task_url(sid, segs.join("/")) });
+	}
+
+	route(name){
+		if (name.includes(".")) return;
+		return new this.constructor({ sid: this.sid, segs: [...this.segs, name] });
+	}
+	child(name, levels){ return Page.prototype.child.call(this, name, levels); }
+
+	content(){
+		const root = div.c("mob-session mob-task");
+		this.load(root);
+		return root;
+	}
+
+	async load(root){
+		const snap = await MobileData.find(this.sid), tree = snap && await MobileData.tasks(snap).catch(() => null);
+		const node = tree?.root.all().find(n => n.rel === this.segs.join("/"));
+		if (!node) return void root.empty(() => p.c("mob-empty", "This task is not in the session's task tree."));
+		this.retitle?.(node.title);
+		const task = await new TaskPage({ url: node.url }).load_task().catch(() => null);
+		const kids = MobileData.states(node.kids);
+		root.empty(() => {
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => {
+					a.c("mob-back", icon("arrow_back")).href(MobileData.session_url(this.sid)).attr("title", "back to the session");
+					strong.c("mob-bar-title", node.title);
+				});
+				div.c("mob-status", () => {
+					new MobileRun({ node });
+					strong.c("mob-state is-" + node.state, node.state);
+					small.c("mob-head-sub", node.kids.length ? `${kids.filter(s => s === "complete").length} of ${kids.length} done` : (node.landed ? "landed" : ""));
+				});
+				if (node.kids.length > 1) div.c("mob-row-bar", () => TaskView.draw_bar(kids, 12));
+			});
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("notes").ac("mob-group-icon"); strong("Content"); });
+				const body = div.c("mob-body", () => this.body(node, task));
+				const more = button.c("mob-more", "More").click(() => { const open = body.el.classList.toggle("is-open"); more.el.textContent = open ? "Less" : "More"; });
+				requestAnimationFrame(() => { if (![...body.el.children].some(l => l.scrollHeight > l.clientHeight + 1)) more.el.remove(); });
+			});
+			if (node.kids.length) div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("checklist").ac("mob-group-icon"); strong("Subtasks"); small.c("mob-count", String(node.kids.length)); });
+				node.kids.forEach(k => new MobileTaskRow({ node: k, sid: this.sid }));
+			});
+			const open = this.questions(task);
+			div.c("mob-card", () => {
+				div.c("mob-card-head", () => { icon("help").ac("mob-group-icon"); strong("Open questions"); small.c("mob-count", String(open.length)); });
+				if (!open.length) div.c("mob-empty", "No open questions.");
+				open.forEach(q => div.c("mob-question", q));
+			});
+		});
+	}
+
+	/** The one-line outcome, what was expected, then the task's content items. */
+	body(node, task){
+		const done = task?.get?.("outcome") ?? node.line;   // the whole outcome; the index line is cut
+		if (done) md(String(done)).ac("mob-line mob-md");   // an outcome is markdown (ai/AITask/AITask.js draws it the same way)
+		for (const line of [task?.expected].flat()) if (line) p.c("mob-line", () => { small.c("mob-fact-k", "expected "); span(String(line)); });
+		for (const item of task?._content ?? []){
+			const text = item.get?.("text") ?? item.get?.("title") ?? item.data?.text ?? item.data?.title;
+			if (text) p.c("mob-line", String(text));
+		}
+		if (!done && !task?.expected && !(task?._content?.length)) p.c("mob-empty", "No content recorded on this task.");
+	}
+
+	/** A task's waiting_on, plus any unanswered Question in its content. */
+	questions(task){
+		const items = [...(task?._content ?? [])].filter(i => (i.data?.type ?? i.get?.("type")) === "Question" && !(i.data?.answer ?? i.get?.("answer")));
+		return [task?.get?.("waiting_on"), ...items.map(i => i.data?.text ?? i.get?.("text"))].filter(Boolean).map(String);
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/MobileTaskRow.js b/public/framework/ai/sessions/v/mobile/MobileTaskRow.js
new file mode 100644
index 000000000..83d05ad04
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/MobileTaskRow.js
@@ -0,0 +1,27 @@
+import View, { div, span, a, small, strong, icon } from "/framework/core/View/View.js";
+import TaskView from "/framework/core/Task/TaskView.js";
+import MobileData from "./MobileData.js";
+import MobileRun from "./MobileRun.js";
+
+View.stylesheet(import.meta, "mobile.css");
+
+/* One task as a flat row: the run indicator and its buttons, the title (a link to the task page), its one-line outcome or state,
+   and the one bar when it has 2 or more children. `node` is a SessionTree.Node, `sid` the session id it belongs to. */
+export default class MobileTaskRow extends View {
+
+	initialize(){
+		const { node, sid } = this, kids = MobileData.states(node.kids);
+		this.ac("mob-task-row", "is-" + node.state);
+		this.empty(() => {
+		new MobileRun({ node });
+		a.c("mob-task-link", () => {
+			div.c("mob-row-body", () => {
+				strong.c("mob-row-title", node.title);
+				small.c("mob-row-sub", node.line && node.done ? node.line : node.state + (node.kids.length ? ` · ${kids.filter(s => s === "complete").length} of ${kids.length} done` : ""));
+				if (node.kids.length > 1) div.c("mob-row-bar", () => TaskView.draw_bar(kids, 12));
+			});
+			icon("chevron_right").ac("mob-go");
+		}).href(MobileData.task_url(sid, node.rel));
+		});
+	}
+}
diff --git a/public/framework/ai/sessions/v/mobile/SwipeTabs.js b/public/framework/ai/sessions/v/mobile/SwipeTabs.js
new file mode 100644
index 000000000..0170bdfc2
--- /dev/null
+++ b/public/framework/ai/sessions/v/mobile/SwipeTabs.js
@@ -0,0 +1,27 @@
+import View, { div, button } from "/framework/core/View/View.js";
+
+View.stylesheet(import.meta, "mobile.css");
+
+/* A tab row over a horizontal strip of panes: swipe the strip (CSS scroll-snap) or tap a tab; the row follows the scroll.
+   `tabs` = [[key, label], ...]; the pane for a key is `this.panes[key]`, an empty View the caller fills. No gesture library. */
+export default class SwipeTabs extends View {
+
+	initialize(){
+		this.ac("mob-tabs");
+		this.panes = {}; this.buttons = {};
+		div.c("mob-tabs-row", () => this.tabs.forEach(([key, label]) => this.buttons[key] = button.c("mob-tab", label).click(() => this.go(key))));
+		this.$strip = div.c("mob-tabs-strip", () => this.tabs.forEach(([key]) => this.panes[key] = div.c("mob-pane")));
+		this.$strip.on("scroll", () => this.sync());
+		this.sync();
+	}
+
+	index(){ const el = this.$strip.el; return el.clientWidth ? Math.round(el.scrollLeft / el.clientWidth) : 0; }
+
+	go(key){ const el = this.$strip.el; el.scrollTo({ left: this.tabs.findIndex(([k]) => k === key) * el.clientWidth, behavior: "smooth" }); }
+
+	/** Light the tab whose pane is showing. */
+	sync(){
+		const on = this.tabs[this.index()]?.[0];
+		for (const [key] of this.tabs) this.buttons[key].el.classList.toggle("is-on", key === on);
+	}
+}

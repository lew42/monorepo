index 000000000..9fb0e075a
--- /dev/null
+++ b/public/framework/core/Session/InFlight.test.mjs
@@ -0,0 +1,30 @@
+// InFlight.pick(session): in flight (newest first, capped), waiting on the owner, next, done. `node public/framework/core/Session/InFlight.test.mjs`
+import Test from "../Test/Test.js";
+import Session from "./Session.js";
+import InFlight from "./InFlight.js";
+
+const t = new Test("InFlight: pick() sorts a session's tasks into in flight, waiting, next and done");
+const at = m => `2026-11-02T10:${String(m).padStart(2, "0")}:00.000Z`;
+const lines = [{ session: { id: "s" } }];
+for (let i = 1; i <= 7; i++){
+	lines.push({ tasks: { add: { type: "Task", id: "r" + i, title: "Run " + i } }, ts: at(i) });
+	lines.push({ tasks: { ["r" + i]: { start: {} } }, ts: at(i) });
+}
+lines.push({ tasks: { r7: { set: { now: "writing the test" } } }, ts: at(8) });
+lines.push({ tasks: { add: { type: "Task", id: "w", title: "Rename" } }, ts: at(9) }, { tasks: { w: { wait: { on: "owner", what: "go on the rename" } } }, ts: at(9) });
+lines.push({ tasks: { add: { type: "Task", id: "wa", title: "Other" } }, ts: at(9) }, { tasks: { wa: { wait: { on: "mastermind-x", what: "x" } } }, ts: at(9) });
+lines.push({ tasks: { add: { type: "Task", id: "n1", title: "Later" } }, ts: at(10) });
+lines.push({ tasks: { add: { type: "Task", id: "d", title: "Done" } }, ts: at(11) }, { tasks: { d: { start: {} } }, ts: at(11) }, { tasks: { d: { complete: { outcome: "o", evidence: ["e"] } } }, ts: at(12) });
+lines.push({ tasks: { add: { type: "Task", id: "x", title: "Dropped" } }, ts: at(13) }, { tasks: { x: { stop: { why: "no" } } }, ts: at(13) });
+const s = Session.replay(lines), p = InFlight.pick(s);
+
+t.eq(p.inflight.length, 5, "at most 5 in flight");
+t.eq(p.more, 2, "the rest are counted (7 running, 5 shown)");
+t.eq(p.inflight[0].id, "r7", "most recently started first");
+t.eq(InFlight.now_of(p.inflight[0]), "writing the test", "a task's current line is its now");
+t.eq(p.waiting.map(w => w.task.id).join(), "w", "waiting on the owner only, not on another agent");
+t.eq(p.waiting[0].what, "go on the rename", "the one thing needed");
+t.ok(p.next.some(x => x.id === "n1"), "an idle task is next");
+t.eq(p.done, 1, "done is a count");
+t.ok(![...p.inflight, ...p.next].some(x => x.id === "x"), "a stopped task is nowhere");
+t.done();
diff --git a/public/framework/core/Session/InFlightView.js b/public/framework/core/Session/InFlightView.js
new file mode 100644
index 000000000..41e09c60b
--- /dev/null
+++ b/public/framework/core/Session/InFlightView.js
@@ -0,0 +1,51 @@
+// InFlightView.js — draws InFlight.pick for one session, or for several (the AI dashboard); live through SessionTasks (a JSONL tail).
+import View, { div, span, a, small, strong } from "../View/View.js";
+import SessionTasks from "./SessionTasks.js";
+import InFlight from "./InFlight.js";
+View.stylesheet(import.meta, "InFlight.css");
+
+export default class InFlightView extends View {
+	// { urls: [session.jsonl urls], all: true on the AI dashboard (a session with nothing in flight or waiting is left out) }
+	initialize(){
+		this.ac("in-flight");
+		this.sessions = new Map();
+		this.readers = (this.urls ?? [this.url]).filter(Boolean).map(url => new SessionTasks({ url, on_session: s => { this.sessions.set(url, s); this.redraw(); } }).live());
+		this.empty_text ??= "Nothing is in flight.";
+		this.redraw();
+	}
+
+	redraw(){
+		clearTimeout(this._t);
+		this._t = setTimeout(() => this.empty(() => this.paint()), 100);   // one repaint for a burst of lines
+	}
+
+	paint(){
+		const picks = [...this.sessions].map(([url, s]) => ({ url, s, ...InFlight.pick(s) }));
+		const shown = this.all ? picks.filter(p => p.inflight.length || p.waiting.length) : picks;
+		if (!shown.length || shown.every(p => !p.inflight.length && !p.waiting.length && !p.next.length)) return void div.c("if-empty", this.empty_text);
+		for (const p of shown){
+			div.c("if-session", () => {
+				if (this.all) a.c("if-session-name", p.s.get_one("title") ?? p.s.id ?? p.url).href(p.url.replace(/session\.jsonl$/, ""));
+				if (p.inflight.length) this.section("In flight", () => { p.inflight.forEach(t => this.row(t)); if (p.more) small.c("muted", `+ ${p.more} more running`); });
+				if (p.waiting.length) this.section("Waiting on you", () => p.waiting.forEach(w => this.row(w.task, w.what || "needs you", true)));
+				if (p.next.length && !this.all) this.section("Next", () => p.next.forEach(t => this.row(t)));
+				if (p.done && !this.all) small.c("muted if-done", `${p.done} done`);
+			});
+		}
+	}
+
+	section(title, fill){ div.c("if-section", () => { strong.c("if-h", title); fill(); }); }
+
+	row(t, line, bare){
+		const pct = Math.round(t.completion * 100), href = t.get_one("url") ?? t.get_one("path");
+		div.c("if-row" + (bare ? " if-bare" : ""), () => {
+			(href ? a.c("if-title", t.get_one("title") ?? t.id).href(href) : span.c("if-title", t.get_one("title") ?? t.id));
+			if (!bare){
+				span.c("if-bar", () => span.c("if-fill").style({ width: pct + "%" })).attr("title", pct + "%");
+				small.c("if-pct", pct + "%");
+			}
+			const now = line ?? InFlight.now_of(t);
+			if (now) div.c("if-now muted", now);
+		});
+	}
+}

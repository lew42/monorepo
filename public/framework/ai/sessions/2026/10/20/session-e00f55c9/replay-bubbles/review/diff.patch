+++ b/public/framework/audio/Recite/ReciteBubble.css
@@ -0,0 +1,33 @@
+@layer base, theme, site, util;
+
+@layer theme {
+	/* Recite.Bubble: the one small play/back control under an assistant reply, the same in V1, V2 and V3 */
+	.audio-recite-bubble-ctl {
+		display: flex;
+		justify-content: flex-end;
+		align-items: center;
+		gap: 0.25em;
+		margin-block-start: 0.2em;
+		font-size: 0.8em;
+		flex: none;
+		white-space: nowrap;
+		line-height: 1;
+	}
+	/* V2 and V3 draw a reply as a flex row (brain, text): wrap, so the control gets its own row under the text instead of a third column */
+	.audio-recite-bubble.chat-v3-reply { flex-wrap: wrap; }
+	.audio-recite-bubble.chat-v3-reply > .chat-v3-reply-text { flex: 1 1 0; }
+	.audio-recite-bubble > .audio-recite-bubble-ctl { flex-basis: 100%; }
+	.audio-recite-bubble-ctl button {
+		min-inline-size: 2.2em;
+		min-block-size: 2.2em;
+		padding: 0 0.5em;
+		border: 0;
+		border-radius: 1.1em;
+		background: transparent;
+		color: var(--subtle);
+		font: inherit;
+		cursor: pointer;
+	}
+	.audio-recite-bubble-ctl button:hover { background: var(--wash); color: var(--ink); }
+	.audio-recite-bubble-ctl .audio-recite-bubble-play.is-on { color: var(--prime); }
+}
diff --git a/public/framework/audio/Recite/ReciteBubble.js b/public/framework/audio/Recite/ReciteBubble.js
new file mode 100644
index 000000000..c9175ea29
--- /dev/null
+++ b/public/framework/audio/Recite/ReciteBubble.js
@@ -0,0 +1,97 @@
+import { View } from "../../core/View/View.js";
+import ReciteTap from "./ReciteTap.js";
+
+View.stylesheet(import.meta, "ReciteBubble.css");
+
+/**
+ * class ReciteBubble — `Recite.Bubble`: the one small control under an assistant reply, shared by Chat V1, V2 and V3 (each
+ * view calls `Recite.Bubble.mount(el, { text })` once for a reply bubble; this class is the only place the buttons exist).
+ * ▶/⏸ plays or pauses THAT bubble (from the word it last stopped at, or from the start), ↺10 steps back about 10 s in its
+ * text. A tap on the bubble's text does the same as ▶/⏸ (`Recite.Tap`). The audio is made again each time, never kept.
+ *
+ *   Recite.Bubble.mount(bubble_el, { text: () => "the reply's text" });
+ *
+ * It loads `Recite.js` only on the first tap (Recite imports this file, so a static import would be a cycle). `Recite.shared` calls
+ * `follow()` when it is made, and from then on each ▶/⏸ follows what Recite is reading.
+ */
+export default class ReciteBubble {
+
+	static HOST = ".audio-recite-bubble";
+	static texts = new WeakMap();   // host element -> () => the text Recite should read
+	static keys = new WeakMap();    // host element -> Recite.bubble_key(text), dropped at every mount (so a patched bubble is re-read) and set again at every tap
+
+	/** Add (or move to the end) the control on `host`; `text()` is read when a tap needs the words, so a patched bubble reads its latest text. */
+	static mount(host, { text }){
+		if (!host || typeof document === "undefined") return null;
+		this.texts.set(host, text);
+		this.keys.delete(host);
+		this.sig = null;
+		host.classList.add("audio-recite-bubble");
+		let ctl = host.querySelector(":scope > .audio-recite-bubble-ctl");
+		if (!ctl){
+			ctl = document.createElement("span");
+			ctl.className = "audio-recite-bubble-ctl";
+			const play = document.createElement("button"), back = document.createElement("button");
+			play.type = back.type = "button";
+			play.className = "audio-recite-bubble-play"; play.textContent = "▶"; play.title = play.ariaLabel = "Play this reply";
+			back.className = "audio-recite-bubble-back"; back.textContent = "↺10"; back.title = back.ariaLabel = "Back 10 seconds";
+			play.addEventListener("click", () => this.run(host, r => r.tap_bubble(this.text_of(host), host)));
+			back.addEventListener("click", () => this.run(host, r => r.back_bubble(this.text_of(host), host)));
+			ctl.append(play, back);
+		}
+		if (!host.recite_tap){
+			host.recite_tap = true;
+			// before Recite exists there is no Recite.Tap to hear a tap on the text: this one starts it, and marks the click so Recite.Tap, made a moment later, does not toggle it again
+			host.addEventListener("click", e => {
+				if (this.recite || !ReciteTap.root_of(e)) return;
+				e.recite_handled = true;
+				this.run(host, r => r.tap_bubble(this.text_of(host), host));
+			});
+		}
+		host.append(ctl);   // always last: a view that redraws its pieces appends them after the control
+		this.sync();   // Recite is loaded and started only by a tap (attach); if the page already has one, this shows what it is reading
+		return ctl;
+	}
+
+	static text_of(host){
+		const get = this.texts.get(host);
+		if (get) return String(get() ?? "");
+		const copy = host.cloneNode(true);
+		copy.querySelector(":scope > .audio-recite-bubble-ctl")?.remove();
+		return copy.textContent ?? "";
+	}
+
+	/** Runs `fn(recite)` once Recite has loaded (it already has by the time anyone taps). */
+	static run(host, fn){
+		this.attach().then(r => { this.keys.set(host, r.constructor.bubble_key(this.text_of(host))); fn(r); });
+	}
+
+	/** Loads Recite and gives back the page's one shared Recite (a page with no tap yet never starts one). */
+	static attach(){ return this.loading ??= import("./Recite.js").then(m => m.default.shared); }
+
+	/** Called by `Recite.shared` the moment the page's Recite exists, however it was started: keeps every ▶/⏸ in step with it. */
+	static follow(recite){
+		if (this.recite === recite) return;
+		this.recite = recite;
+		recite.on(() => this.sync());
+		this.sync();
+	}
+
+	/** ▶ or ⏸ on each bubble's button: ⏸ only on the one being read right now. */
+	static sync(){
+		const r = this.recite;
+		if (!r || typeof document === "undefined") return;
+		const now = r.bubble_state(), sig = `${now.key}|${now.playing}`;
+		if (sig === this.sig) return;   // Recite fires about 4 times a second while playing; nothing to redraw unless the playing bubble or its state changed
+		this.sig = sig;
+		for (const host of document.querySelectorAll(this.HOST)){
+			const play = host.querySelector(":scope > .audio-recite-bubble-ctl > .audio-recite-bubble-play");
+			if (!play) continue;
+			let key = this.keys.get(host);
+			if (key == null){ key = r.constructor.bubble_key(this.text_of(host)); this.keys.set(host, key); }
+			const on = now.key === key && now.playing;
+			const label = on ? "⏸" : "▶";
+			if (play.textContent !== label){ play.textContent = label; play.title = play.ariaLabel = on ? "Pause this reply" : "Play this reply"; play.classList.toggle("is-on", on); }
+		}
+	}
+}
diff --git a/public/framework/audio/Recite/ReciteBubble.test.mjs b/public/framework/audio/Recite/ReciteBubble.test.mjs
new file mode 100644
index 000000000..65f7afc7e
--- /dev/null
+++ b/public/framework/audio/Recite/ReciteBubble.test.mjs
@@ -0,0 +1,108 @@
+// node ReciteBubble.test.mjs [base-url] [shots-dir] — headless: every assistant reply bubble in Chat V1, V2 and V3 carries the one
+// Recite.Bubble control. A real click on a finished bubble asks recite-server to speak its FIRST sentence ("speak asked"), the
+// control turns to ⏸, and a second click pauses; the place it paused at is then remembered, and a later play starts from it.
+// recite-server is stubbed (POST /speak answers a 3 s silent WAV), so nothing needs Kokoro. Run with FENCE_SERVEX=1 so no request
+// reaches the live Servex (Server/ServexFence.mjs; core/Test/TestRunner.mjs sets it). Needs the global playwright and the dev server.
+import { browser as get_browser } from "../../../../Server/Browser.mjs";
+import { mkdirSync } from "node:fs";
+
+const base = process.argv[2] ?? process.env.SITE_URL ?? "http://monorepo.localhost", shots = process.argv[3];
+let pass = 0, fail = 0;
+const check = (name, ok, got) => { ok ? pass++ : fail++; console.log(`${ok ? "PASS" : "FAIL"} ${name}${ok ? "" : "  got: " + JSON.stringify(got)}`); };
+
+/** A 3 s, 8 kHz, 16-bit mono silent WAV: enough to pause inside. */
+function wav(seconds = 3){
+	const n = 8000 * seconds, b = Buffer.alloc(44 + n * 2);
+	b.write("RIFF", 0); b.writeUInt32LE(36 + n * 2, 4); b.write("WAVEfmt ", 8); b.writeUInt32LE(16, 16); b.writeUInt16LE(1, 20); b.writeUInt16LE(1, 22);
+	b.writeUInt32LE(8000, 24); b.writeUInt32LE(16000, 28); b.writeUInt16LE(2, 32); b.writeUInt16LE(16, 34); b.write("data", 36); b.writeUInt32LE(n * 2, 40);
+	return b;
+}
+
+const browser = await get_browser();
+const ctx = await browser.newContext({ viewport: { width: 400, height: 860 } });
+const errors = [];
+
+/** Polls (in the page) until the shared Recite is playing. */
+async function playing(page){
+	for (let i = 0; i < 60; i++){
+		if (await page.evaluate(async () => (await import("/framework/audio/Recite/Recite.js")).default.shared.state === "playing")) return true;
+		await page.waitForTimeout(250);
+	}
+	return false;
+}
+
+/** One view: open `url`, find its first reply bubble, and prove tap -> speak asked -> ⏸ -> pause -> place remembered. */
+async function view(name, url, bubble_sel, text_sel, prepare){
+	const page = await ctx.newPage(), asked = [];
+	page.on("pageerror", e => errors.push(`${name}: ${e}`));
+	await page.route("**/speak", async route => {
+		if (route.request().method() === "POST") asked.push(JSON.parse(route.request().postData() ?? "{}").text);
+		await route.fulfill({ status: 200, headers: { "content-type": "audio/wav", "x-recite-seconds": "3", "access-control-allow-origin": "*", "access-control-expose-headers": "x-recite-seconds" }, body: wav(3) });
+	});
+	await page.addInitScript(() => { try { localStorage.removeItem("lew42.recite.places"); localStorage.setItem("lew42.recite.auto", "false"); } catch {} });
+	await page.goto(url, { waitUntil: "domcontentloaded" });
+	await prepare?.(page);
+	await page.waitForSelector(bubble_sel + " > .audio-recite-bubble-ctl", { timeout: 15000 });
+	const bubble = page.locator(bubble_sel).first();
+	check(`${name}: the reply bubble has the ▶ and ↺10 control`, (await bubble.locator(":scope > .audio-recite-bubble-ctl button").allTextContents()).join(" ") === "▶ ↺10", await bubble.locator(":scope > .audio-recite-bubble-ctl").textContent());
+	check(`${name}: nothing was spoken before a tap`, asked.length === 0, asked);
+
+	// a real click on the text (user activation, so the browser lets the audio play)
+	await bubble.locator(text_sel).first().click({ position: { x: 150, y: 8 } });
+	await playing(page);
+	const first = await page.evaluate(async () => { const R = (await import("/framework/audio/Recite/Recite.js")).default.shared; return { state: R.state, first: R.chunks[0]?.text, text: R.chunks.map(c => c.text).join(" ").slice(0, 40) }; });
+	check(`${name}: a tap on the text asked to speak the bubble's first sentence`, asked.length >= 1 && asked[0] === first.first, { asked: asked[0], first });
+	check(`${name}: and it plays`, first.state === "playing", first.state);
+	const plain = n => n.replace(/[^\p{L}\p{N}]+/gu, " ").trim().toLowerCase();
+	check(`${name}: that first sentence is the start of what the bubble says`, plain(await bubble.locator(text_sel).first().innerText()).startsWith(plain(first.first).slice(0, 25)), first.first);
+	check(`${name}: the control shows ⏸ while it plays`, (await bubble.locator(".audio-recite-bubble-play").textContent()) === "⏸");
+
+	// ⏸ pauses it and the place is kept
+	await page.waitForTimeout(700);
+	await bubble.locator(".audio-recite-bubble-play").click();
+	const paused = await page.evaluate(async () => { const m = await import("/framework/audio/Recite/Recite.js"), R = m.default.shared; return { state: R.state, place: m.default.place_of(R.chunks[R.at]?.key), t: R.audio.currentTime }; });
+	check(`${name}: ⏸ pauses it`, paused.state === "paused", paused.state);
+	check(`${name}: the place it stopped at is remembered (sentence 0, a little way in)`, paused.place && paused.place.i === 0 && paused.place.t > 0.2, paused);
+	check(`${name}: the control is back to ▶`, (await bubble.locator(".audio-recite-bubble-play").textContent()) === "▶");
+	const stored = await page.evaluate(() => JSON.parse(localStorage.getItem("lew42.recite.places") ?? "{}"));
+	check(`${name}: and kept in the browser's storage for a reload`, Object.keys(stored).length === 1, stored);
+
+	// stop everything, then play again: the bubble starts from where it stopped, not from 0
+	await page.evaluate(async () => { (await import("/framework/audio/Recite/Recite.js")).default.shared.stop(); });
+	asked.length = 0;
+	await bubble.locator(".audio-recite-bubble-play").click();
+	await playing(page);
+	const again = await page.evaluate(async () => { const R = (await import("/framework/audio/Recite/Recite.js")).default.shared; return { state: R.state, t: R.audio.currentTime }; });
+	check(`${name}: playing it again starts where it stopped (${paused.place?.t}s), not at 0`, again.state === "playing" && again.t >= (paused.place?.t ?? 0) - 0.3, { again, place: paused.place });
+
+	// ↺10 in a 3 s sentence goes to the bubble's start
+	await bubble.locator(".audio-recite-bubble-back").click();
+	await page.waitForTimeout(300);
+	const back = await page.evaluate(async () => (await import("/framework/audio/Recite/Recite.js")).default.shared.audio.currentTime);
+	check(`${name}: ↺10 steps back to the start of a short bubble`, back < 1.0, back);
+
+	if (shots){ mkdirSync(shots, { recursive: true }); await page.screenshot({ path: `${shots}/${name}.png` }); }
+	await page.close();
+}
+
+try {
+	// V3 and V2 draw their replies through ChatV3.reply(); V1 is the dictation widget's thread
+	await view("chat-v3", `${base}/framework/ext/Chat/v3/`, ".chat-v3-reply", ".chat-v3-reply-text", p => p.waitForSelector(".chat-v3-reply", { timeout: 15000 }));
+	await view("chat-v2", `${base}/framework/ext/Chat/v2/`, ".chat-v3-reply", ".chat-v3-reply-text", p => p.waitForSelector(".chat-v3-reply", { timeout: 15000 }));
+	await view("chat-v1", `${base}/framework/start/`, ".chatbox-reply", ".chatbox-text", async p => {
+		await p.evaluate(async () => {
+			document.body.innerHTML = '<div id="box" style="max-width:40em;margin:1em auto"></div>';
+			const { View } = await import("/framework/core/View/View.js");
+			const { default: Widget } = await import("/framework/ux/Dictate/Widget.js");
+			new View({ el: document.getElementById("box"), capture: false }).append(() => { window.w = new Widget({ placeholder: "say something", deliver: () => true }); });
+			window.w.say({ chat: { at: new Date().toISOString(), from: { kind: "owner" }, via: "voice", text: "Can you read me something?" } });
+			window.w.say({ chat: { at: new Date(Date.now() + 1000).toISOString(), from: { kind: "assistant", id: "smart" }, text: "Yes, here is a reply to read aloud. It has a second sentence, so it can be paused." } });
+		});
+	});
+	check("no page errors", errors.length === 0, errors);
+} catch (e) {
+	check("the test ran to the end", false, String(e?.stack ?? e).slice(0, 1500));
+}
+console.log(`${pass} passed, ${fail} failed`);
+await browser.close();
+process.exit(fail ? 1 : 0);

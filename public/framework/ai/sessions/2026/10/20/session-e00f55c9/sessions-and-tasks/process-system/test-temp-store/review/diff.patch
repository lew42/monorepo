diff --git a/Servex/agents/test-store.mjs b/Servex/agents/test-store.mjs
new file mode 100644
index 000000000..8ebebee05
--- /dev/null
+++ b/Servex/agents/test-store.mjs
@@ -0,0 +1,25 @@
+/* Import this FIRST in any test that spawns through the real Agents class (a bare `import "./test-store.mjs";`
+ * before every other import, or at the top of the file for dynamic imports).
+ *
+ * Why: Agents.spawn() with no `task: false` files a folder under the session store,
+ * ai/sessions/<day>/spawned/<id>/. Run as a test, that put fake agents (minion-x, minion-dead, task-mastermind-z...)
+ * into the real store, 36 folders by 2026-10-22.
+ *
+ * What: points the store's root at a scratch dir. LEDGER_ROOT is the switch Server/TaskDirs.mjs already honours
+ * (it also sets DatedFiles.ROOT). Set before Agents.js loads, which it is, because imports run in order.
+ * Exports: STORE (the scratch root), spawned_in_real_store() (today's folder names in the real store), clean(). */
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+export const REAL = path.resolve(import.meta.dirname, "../..");
+export const STORE = process.env.LEDGER_ROOT || fs.mkdtempSync(path.join(os.tmpdir(), "test-store-"));
+process.env.LEDGER_ROOT = STORE;
+
+/** Names under the REAL <repo>/public/framework/ai/sessions/<today>/spawned/ (what a leaking test would add to). */
+export const spawned_in_real_store = () => {
+	const d = new Date(), p = n => String(n).padStart(2, "0");
+	const f = path.join(REAL, "public/framework/ai/sessions", String(d.getFullYear()), p(d.getMonth() + 1), p(d.getDate()), "spawned");
+	return fs.existsSync(f) ? fs.readdirSync(f) : [];
+};
+export const clean = () => fs.rmSync(STORE, { recursive: true, force: true });
diff --git a/public/framework/ai/sessions/2026/10/20/session-e00f55c9/sessions-and-tasks/process-system/test-temp-store/move-aside.mjs b/public/framework/ai/sessions/2026/10/20/session-e00f55c9/sessions-and-tasks/process-system/test-temp-store/move-aside.mjs
new file mode 100644
index 000000000..9cddea12a
--- /dev/null
+++ b/public/framework/ai/sessions/2026/10/20/session-e00f55c9/sessions-and-tasks/process-system/test-temp-store/move-aside.mjs
@@ -0,0 +1,21 @@
+// node move-aside.mjs <spawned dir> <dest dir> [--apply]
+// Moves every folder in <spawned dir> whose name is a known test-agent id (or its -2/-3/-4 copy) to <dest dir>.
+// Dry run unless --apply. Never deletes; refuses a name that already exists in dest. Writes moves.jsonl in dest.
+import fs from "node:fs";
+import path from "node:path";
+
+const [src, dest] = process.argv.slice(2), apply = process.argv.includes("--apply");
+if (!src || !dest) throw new Error("usage: move-aside.mjs <spawned dir> <dest dir> [--apply]");
+const TEST = /^(minion-(dead|held|race|starting|stuck|v|x|y)|task-mastermind-z|minion-lib-h1-page-nvidia-nemotron-3-5-lightning-free-179089)(-\d+)?$/;
+const names = fs.readdirSync(src, { withFileTypes: true }).filter(e => e.isDirectory() && TEST.test(e.name)).map(e => e.name);
+const left = fs.readdirSync(src).filter(n => !names.includes(n));
+console.log(`${apply ? "MOVING" : "dry run:"} ${names.length} folders ${src} -> ${dest}; left in place: ${left.length ? left.join(", ") : "none"}`);
+if (apply) fs.mkdirSync(dest, { recursive: true });
+for (const n of names) {
+	const to = path.join(dest, n);
+	if (apply) {
+		if (fs.existsSync(to)) throw new Error(`${to} exists`);
+		fs.renameSync(path.join(src, n), to);
+		fs.appendFileSync(path.join(dest, "moves.jsonl"), JSON.stringify({ from: path.join(src, n), to, at: new Date().toISOString() }) + "\n");
+	} else console.log("  " + n);
+}

+
+const put = (rel, text) => { const f = path.join(repo, rel); fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, text); return f; };
+const line1 = (id, at) => JSON.stringify({ session: { id, home: "/framework/ext/drawer/", at } }) + "\n";

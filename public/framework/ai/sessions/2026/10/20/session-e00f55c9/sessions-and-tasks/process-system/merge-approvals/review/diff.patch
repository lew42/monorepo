+@layer base, theme, site, util;
+@layer site {
+	.page.rm-page { --measure: 44em; }
+	.rm-list { padding: 0.8em clamp(0.6em, 3cqi, 1.5em) 2em; }
+	.rm-body { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24em), 1fr)); gap: 0.8em; align-items: start; }
+	.rm-card { display: flex; flex-direction: column; gap: 0.4em; min-width: 0; padding: 0.8em 1em; border: 1px solid var(--line); border-radius: 0.5em; }

diff --git a/public/framework/ext/Chat/v3/placement.js b/public/framework/ext/Chat/v3/placement.js
new file mode 100644
index 000000000..695146888
--- /dev/null
+++ b/public/framework/ext/Chat/v3/placement.js
@@ -0,0 +1,29 @@
+// placement.js — the two pieces of ChatV3 that are plain data logic, no View, no DOM (chunks.js's pattern): which Prompt a Reply
+// answers, and where a Prompt's words break into paragraphs. ChatV3.js imports these; placement.test.mjs runs them in plain node.
+import Prompt from "../../../core/Session/Chat/Prompt.js";
+
+export const PARAGRAPH_GAP_MS = 4000;   // a pause this long between two sentences' `at` starts a new paragraph (views-on-messages.md)
+
+/** The Prompt a Reply answers: the one whose `sentences` holds `re.to`, else the newest Prompt before it in `list` (session.messages.messages). */
+export function owning_prompt(list, reply){
+	const to = reply.re?.to ?? null, prompts = list.filter(m => m instanceof Prompt);
+	if (to) { const hit = prompts.find(p => p.sentences.includes(to)); if (hit) return hit; }
+	const i = list.indexOf(reply);
+	for (let j = i - 1; j >= 0; j--) if (list[j] instanceof Prompt) return list[j];
+	return prompts.at(-1) ?? null;
+}
+
+/** One paragraph per run of sentences with no long pause between them: a gap to the previous sentence's `at` of `gap_ms` or more starts
+ *  a new paragraph. `clean` prefers the fast seat's cleaned text per sentence id (Prompt.clean), else the sentence's own raw words. */
+export function paragraphs(sentence_items, clean = {}, gap_ms = PARAGRAPH_GAP_MS){
+	const out = [];
+	let cur = [], prev_at = null;
+	for (const s of sentence_items) {
+		const gap = prev_at && s.at ? Date.parse(s.at) - Date.parse(prev_at) : 0;
+		if (cur.length && gap >= gap_ms) { out.push(cur.join(" ")); cur = []; }
+		cur.push(clean[s.id] ?? s.text);
+		if (s.at) prev_at = s.at;
+	}
+	if (cur.length) out.push(cur.join(" "));
+	return out;
+}
diff --git a/public/framework/ext/Chat/v3/placement.test.mjs b/public/framework/ext/Chat/v3/placement.test.mjs
new file mode 100644
index 000000000..a807998ea
--- /dev/null
+++ b/public/framework/ext/Chat/v3/placement.test.mjs
@@ -0,0 +1,50 @@
+// node ChatV3.test.mjs — plain node, no browser: ChatV3's two pieces of data logic (placement.js) against a real voice session
+// (a range copied from public/framework/ai/sessions/2026/11/01/v-u48msei/session.jsonl into fixture/messages-session.jsonl, the
+// original untouched), replayed through the real Session: every Reply lands under the Prompt holding its `re.to`, in list order;
+// a pause between two sentences starts a new paragraph.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import Session from "../../../core/Session/Session.js";
+import Prompt from "../../../core/Session/Chat/Prompt.js";
+import Reply from "../../../core/Session/Chat/Reply.js";
+import { owning_prompt, paragraphs } from "./placement.js";
+
+let pass = 0, fail = 0;
+const check = (name, ok, got) => { ok ? pass++ : fail++; console.log(`${ok ? "PASS" : "FAIL"} ${name}${ok ? "" : "  got: " + JSON.stringify(got)}`); };
+
+const fixture = fileURLToPath(new URL("./fixture/messages-session.jsonl", import.meta.url));
+const before = readFileSync(fixture, "utf8");
+const lines = before.split("\n").filter(Boolean).map(l => JSON.parse(l));
+
+const session = Session.replay(lines);
+const list = session.messages.messages;
+
+// 1. every Reply lands under the Prompt holding its re.to
+const prompts = list.filter(m => m instanceof Prompt), replies = list.filter(m => m instanceof Reply);
+check("the fixture has 6 prompts and 9 replies", prompts.length === 6 && replies.length === 9, { prompts: prompts.length, replies: replies.length });
+for (const r of replies) {
+	const owner = owning_prompt(list, r);
+	check(`reply ${r.id} lands under the prompt holding its re.to (${r.re?.to})`, !!owner && owner.sentences.includes(r.re.to), { re: r.re, owner: owner?.id });
+}
+const first = prompts[0], second = prompts[1];
+check("two replies to the same prompt both land under it", replies.filter(r => owning_prompt(list, r) === first).length === 2);
+check("a reply never lands under the wrong prompt", owning_prompt(list, replies[0]) !== second);
+
+// 2. order is list order: replies_of (filter preserving list order) matches each prompt's own replies in file order
+const replies_of = p => list.filter(m => m instanceof Reply && owning_prompt(list, m) === p);
+const first_replies = replies_of(first);
+check("a prompt's replies come back in the list's own order", first_replies[0].at < first_replies[1].at, first_replies.map(r => r.at));
+check("list order holds across the whole chat (each root's index increases)", list.every((m, i) => i === 0 || list.indexOf(m) > list.indexOf(list[i - 1])));
+
+// 3. a pause makes a paragraph: the first prompt was grown by the fixture's two synthetic sentences (s-test-2, no pause; s-test-3, a long pause)
+const paras = paragraphs(first.sentence_items, first.clean);
+check("no pause: the original sentence and the quick follow-up share one paragraph", paras[0].includes("Can you hear me?") && paras[0].includes("A second thought"), paras);
+check("a long pause starts a new paragraph", paras.length === 2 && paras[1] === "A third thought, after a long pause.", paras);
+check("a prompt with one sentence and no pause is a single paragraph", paragraphs(second.sentence_items, second.clean).length === 1);
+
+// 4. the fixture file was only ever read, never changed by this test
+check("the fixture was not modified", readFileSync(fixture, "utf8") === before);
+
+console.log(`${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/public/framework/ext/Chat/v3/readme.md b/public/framework/ext/Chat/v3/readme.md
index 539e11514..10f646636 100644
--- a/public/framework/ext/Chat/v3/readme.md
+++ b/public/framework/ext/Chat/v3/readme.md
@@ -1,20 +1,22 @@
 # Chat v3: a session's chat as a card per Prompt, with every reply inside it
 
-Chat v3 draws a session's `tasks` list, plus the replies written as old-style `{chat}` lines. It never writes and never reshapes a Prompt. It ignores the `{place}`, `{summary}` and `{refined}` lines Chat v1 uses. Pick it as **V3** in the chat version dropdown; V1 stays the default.
+Chat v3 draws `session.messages` (`core/Session/Chat/readme.md`): one card per Prompt, in the chat list's own order, with the Replies that answer it (found by `re.to`, a sentence id of that Prompt) drawn inside. It never writes and never reshapes a message. It is the one chat view ([views-on-messages.md](/framework/core/Session/Chat/doc/views-on-messages.md) step 1 of 6; step 2 makes Chat v2 its subclass). Pick it as **V3** in the chat version dropdown; V1 stays the default.
 
-Try it: [/framework/ext/Chat/v3/](/framework/ext/Chat/v3/) draws Chat v2's [fixture](../v2/fixture/session.jsonl); `?src=<url of any session.jsonl>` draws that session, live.
+Try it: [/framework/ext/Chat/v3/](/framework/ext/Chat/v3/) draws [fixture/messages-session.jsonl](fixture/messages-session.jsonl) (a copy of a real voice session, `session.messages`-shaped); `?src=<url of any session.jsonl>` draws that session, live.
 
 ## How it works
 
-- `ChatV3.js`: `class ChatV3 extends JSONL`. Every line of the session file that is a task delta (`tasks`, `session`, `start`, `stop`, `decide`, `task`, or a line keyed by an id already in the list) is replayed into a real `Session` (`core/Session`) with `replay_line`, the same replay the item tool uses. Everything else is skipped. The Prompts are drawn as they are: the `raw` chunks, the `paragraphs`, the `replies`.
-- **A card per Prompt**, in time order, newest last: its title (or, until the AI writes one, its first words, muted), then the body described below. Its replies (🧠, markdown) and the Questions and Tasks that name it (`from`, or nested under it) sit inside the card. "show raw" opens the raw chunks, which are append-only and never edited.
-- **The card body** (2026-11-01): the AI's cleaned `text` when it exists; until then the dictation itself (the owner still needs the raw words), one paragraph per sent chunk, a long chunk cut every three sentences, clamped to a few lines with "show all (N words)", under a muted title of its first words. A 6,760-character Prompt had come up as one wall of text.
-- **Every reply** (`chat_line()`, 2026-11-01): most smart-seat replies are `{chat}` lines, not Prompt replies. An owner `{chat}` line carries `prompt`; a reply carries `re` = that owner line's `at`, so the reply joins that Prompt's card (a reply with no known `re` joins the newest Prompt). A `{chat}` reply with the same text as one of the Prompt's own replies is drawn once.
-- **The reply being written:** V3 follows the session's live wire (`stream()` in `ext/Session/Session.js`, the one V1 reads) and draws the partial reply at the end of the newest card until its settled line arrives.
-- **Gray only for unsent words** (the owner, 2026-10-26: "light gray to black reserved only for the whisper finalization"): a sentence in the file is final, so it is solid at once. The words still being spoken show as a faint dashed draft at the end (the composer's mic fires a `chat-live` window event, one line in `ux/Dictate/Widget.js`).
-- **Windowed:** the newest 40 cards, with "show earlier (N)" (a 392-card real log stays quick).
-- **In place:** a live line redraws only the card it touched. The scroll lock is the drawer's own (`ext/drawer/ChatView.js`).
-- **Per-task link:** there is no route per task yet; each card carries its id, so `#<id>` on the chat's url scrolls to it. The link icon is gone (the owner, 2026-11-01: it was not clear where it went).
+- `ChatV3.js`: `class ChatV3 extends JSONL`. Every line is replayed into a real `Session` (`core/Session`) with `replay_line`, the same replay the item tool uses, except V1's own `{chat}`/`{place}` lines (skipped: the real update is the separate `messages`/`sentences` mirror line `ChatWriter` already writes beside them).
+- **A card per Prompt**, in the chat list's own order: its title (or, until the AI writes one, its first words, muted), then the body described below. Its Replies (🧠, markdown, found by `re.to`) and the Tasks/Questions that name its Prompt TASK (through the message Prompt's `prompt` link) sit inside the card. A plain `Message` (a note with no more structure) is its own small card. "show raw" opens the sentences' own raw words, when a `clean` override exists.
+- **The card body:** the AI's cleaned `text` when it exists; until then the dictation itself, in paragraphs (see below), clamped to a few lines with "show all (N words)", under a muted title of its first words. A 6,760-character Prompt had come up as one wall of text.
+- **Paragraphs** ([placement.js](placement.js), `ChatV3.paragraphs`/`PARAGRAPH_GAP_MS`): a new paragraph starts where the gap between two sentences' `at` is a long pause (4000ms default) — not the old "one paragraph per sent chunk, cut every 3 sentences". Pure logic, no DOM, node-testable ([placement.test.mjs](placement.test.mjs)).
+- **Every reply** ([placement.js](placement.js), `owning_prompt`): a Reply's Prompt is the one whose `sentences` holds its `re.to`; a reply with no match joins the newest Prompt before it in the list.
+- **The reply being written:** V3 follows the session's live wire (`stream()` in `ext/Session/Session.js`, the one V1 reads) and draws the partial reply at the end of the newest card until its settled Reply message arrives.
+- **Gray only for unsent words** (the owner, 2026-10-26): a sentence in the file is final, so it is solid at once; the words still being spoken show as a faint draft at the end (`chat-live` window event).
+- **Windowed:** the newest 40 cards, with "show earlier (N)".

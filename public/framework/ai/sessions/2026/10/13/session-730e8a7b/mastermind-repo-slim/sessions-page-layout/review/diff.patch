+
+/* THE SESSIONS LAYOUT (2026-10-13): a left rail, a one-line scope trail, compact controls, a one-line status footer.
+   Why: the first grid row sat 48% down at 1200 and a 200 px footer cut the grid to a third (doc/ui/compact-layout.md). */
+@layer site {
+	.sessions-body { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 0 var(--gap-50, .5rem); align-items: start; }
+	.sessions-main { position: relative; min-width: 0; display: flex; flex-direction: column; gap: var(--gap-25, .25rem); }
+	.sessions-nav { display: flex; flex-direction: column; gap: .1rem; position: sticky; top: .5rem; padding-block: .25rem; border-inline-end: 1px solid var(--line); padding-inline-end: .35rem; }
+	.sessions-nav-item { display: flex; align-items: center; gap: .4rem; padding: .25rem .4rem; border-radius: var(--radius); text-decoration: none; color: inherit; font-size: .9em; }
+	.sessions-nav-item:hover { background: var(--tint); }
+	.sessions-nav-on { font-weight: 600; background: var(--tint); }
+	.sessions-nav .icon { font-size: 1.1em; }
+	@container (width < 40em) {
+		.sessions-body { grid-template-columns: minmax(0, 1fr); }
+		.sessions-nav { position: static; flex-direction: row; flex-wrap: wrap; border-inline-end: none; }
+	}
+
+	.sessions-scope { font-size: .9em; }
+	.sessions-crumb { text-decoration: none; }
+	.sessions-crumb-on { font-weight: 700; }
+	.sessions-crumb-step { border: 1px solid var(--line); background: none; border-radius: var(--radius); padding: 0 .5em; cursor: pointer; color: inherit; font-size: .9em; }
+	.sessions-crumb-step:first-of-type { margin-inline-start: .5rem; }
+
+	.sessions-controls { flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 1rem; row-gap: .25rem; margin-block-end: .25rem; }
+	.sessions-controls .sessions-filters { gap: .5rem 1rem; }
+	.sessions-controls .sessions-search { inline-size: 11em; padding-block: .1em; }
+	.sessions-controls .sessions-filters label { font-size: .75em; }
+	.sessions-page .sessions-chip { font-size: .75em; padding: .05em .55em; }
+	.sessions-page .sessions-chip-head { font-size: .75em; }
+	.sessions-page .datagrid { position: static; }
+	.sessions-page .datagrid-bar { position: absolute; inset-block-start: 0; inset-inline-end: 0; margin: 0; }   /* the Table / Rail toggle rides on the scope line */
+	.sessions-page .datagrid-toggle-btn { padding: .1em .6em; font-size: .85em; }
+	.sessions-page .sessions-kinds .sessions-chip { font-size: .8em; padding: .05em .6em; }
+
+	.sessions-status { position: sticky; inset-block-end: 0; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1rem; padding: .25rem .5rem; margin-block-start: .5rem; background: var(--surface); border-block-start: 1px solid var(--line); font-size: .8em; }
+	.sessions-status .sessions-stats { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1rem; }
+	.sessions-status .sessions-stats-text { display: flex; flex-wrap: wrap; gap: 0 1rem; }
+	.sessions-status .sessions-counts { margin: 0; }
+	.sessions-status .ai-usage { display: flex; gap: 1rem; }
+	.sessions-status .ai-meter { flex-direction: row; align-items: center; gap: .4rem; }
+	.sessions-status .ai-meter .flex { gap: .4rem; }
+	.sessions-status .ai-gauge { inline-size: 5rem; }
+	.sessions-status .ai-note { display: none; }
+	.sessions-status-open { margin-inline-start: auto; position: relative; }
+	.sessions-status-open .page-open-line { padding: .05em .6em; }
+	.sessions-status-open .page-open-rows { position: absolute; inset-block-end: 100%; inset-inline-end: 0; min-inline-size: 22em; padding: .5rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 .25rem 1rem rgb(0 0 0 / .15); }
+
+}
+
+/* Hides, in util so they beat `.flex`: the cache link and the date pickers (the scope trail replaces them); the ancestor
+   page's footer chips (open tasks, "Inbox · 1, 1 new", AI cost) go: the open tasks return as a chip in the status line. */
+@layer util {
+	.sessions-controls .sessions-summary, .sessions-controls .sessions-daterange { display: none; }
+	.page:has(.sessions-page) > :is(.page-open, .page-inbox-chip, .page-ai-cost) { display: none; }
+}

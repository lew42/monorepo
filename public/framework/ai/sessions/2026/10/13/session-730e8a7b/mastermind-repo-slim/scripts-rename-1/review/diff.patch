diff --git a/Server/BrowserCheck.mjs b/Server/BrowserCheck.mjs
new file mode 100644
index 000000000..eb4f928b8
--- /dev/null
+++ b/Server/BrowserCheck.mjs
@@ -0,0 +1,88 @@
+/* Server/BrowserCheck.mjs — what a developer tools console would show, for one URL, without
+ * opening a tab yourself. Built for the Servex `check_page` MCP tool (Servex/Servex.js), so the
+ * owner can say "this page isn't loading" and get the console/network truth back instead of a
+ * guess. Uses the ONE shared browser from Server/browser.mjs — never a second browser instance.
+ *
+ *   import { check_page, browser_rss } from "./BrowserCheck.mjs";
+ *   const report = await check_page("http://monorepo.localhost/framework/");
+ *
+ * Doc: doc/browser.md. Owner's ask: public/framework/ai/sessions/2026/10/03/0df64c47-b244-4a73-babb-16d86535c9b8/playwright-reap/requirements.md. */
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { browser, close, pid as browser_pid } from "./browser.mjs";
+
+export default class BrowserCheck {
+/** Navigate a fresh tab to `url`, wait for load + 2s (late console lines land too), then report
+ * console lines (deduped, with counts), failed requests, HTTP 4xx/5xx responses, page errors
+ * (uncaught JS exceptions) and load time. Closes the TAB when done, never the shared browser.
+ * `opts.shot` also saves a screenshot and returns its path. */
+static async check_page(url, opts = {}){
+	BrowserCheck.touch();
+	const b = await browser();
+	const context = await b.newContext();
+	const page = await context.newPage();
+	const console_lines = new Map();   // text -> {type, text, count}
+	const failed = [], http_errors = [], page_errors = [];
+
+	page.on("console", m => {
+		const key = `${m.type()}: ${m.text()}`;
+		const hit = console_lines.get(key);
+		if (hit) hit.count++; else console_lines.set(key, { type: m.type(), text: m.text(), count: 1 });
+	});
+	page.on("requestfailed", r => failed.push({ url: r.url(), why: r.failure()?.errorText ?? "failed" }));
+	page.on("response", r => { if (r.status() >= 400) http_errors.push({ url: r.url(), status: r.status() }); });
+	page.on("pageerror", e => page_errors.push(String(e?.message ?? e)));
+
+	const started = Date.now();
+	let shot = null;
+	try {
+		await page.goto(url, { waitUntil: "load", timeout: 30000 });
+		await page.waitForTimeout(2000);   // late console lines (a fetch that resolves after load) land too
+		if (opts.shot){
+			const dir = path.join(process.env.LOCALAPPDATA || "", "lew42", "playwright", "shots");
+			fs.mkdirSync(dir, { recursive: true });
+			shot = path.join(dir, `check-${Date.now()}.png`);
+			await page.screenshot({ path: shot });
+		}
+	} finally {
+		await context.close();   // the TAB's context, not the shared browser
+	}
+
+	return {
+		url, load_ms: Date.now() - started,
+		console: [...console_lines.values()],
+		failed, http_errors, page_errors,
+		shot
+	};
+}
+
+/** The shared Chromium's total RSS right now (itself + every child process), in MB, or null if
+ * it isn't running. Same `Get-CimInstance Win32_Process` query `node-reap.mjs` already uses —
+ * one way to read process memory, not a second one. */
+static browser_rss(pid){
+	if (!pid) return null;
+	try {
+		const ps = `Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -eq ${pid} -or $_.ParentProcessId -eq ${pid} } | Measure-Object WorkingSetSize -Sum | Select-Object -ExpandProperty Sum`;
+		const r = spawnSync("powershell", ["-NoProfile", "-NonInteractive", "-Command", ps], { encoding: "utf8", windowsHide: true });
+		const bytes = Number(r.stdout.trim());
+		return Number.isFinite(bytes) ? Math.round(bytes / 1048576) : null;
+	} catch { return null; }
+}
+
+/** Close the shared browser if it's grown past `max_mb` RSS or sat idle past `max_idle_ms`.
+ * Call this after each `check_page` — the next call relaunches a fresh one. Returns what (if
+ * anything) it did, for the caller to log. */
+static last_used = Date.now();
+static touch(){ BrowserCheck.last_used = Date.now(); }
+static async cap({ max_mb = 600, max_idle_ms = 30 * 60 * 1000 } = {}){
+	const rss_mb = BrowserCheck.browser_rss(browser_pid());
+	const idle_ms = Date.now() - BrowserCheck.last_used;
+	if (rss_mb !== null && rss_mb > max_mb) { await close(); return { closed: true, why: `RSS ${rss_mb} MB over the ${max_mb} MB cap`, rss_mb }; }
+	if (idle_ms > max_idle_ms) { await close(); return { closed: true, why: `idle ${Math.round(idle_ms / 60000)} min`, rss_mb }; }
+	return { closed: false, rss_mb };
+}
+}
+
+/** Old names, kept until 2026-10-20 (callers: Servex/Servex.js). */
+export const check_page = BrowserCheck.check_page, browser_rss = BrowserCheck.browser_rss, touch = BrowserCheck.touch, cap = BrowserCheck.cap;
diff --git a/Server/CardCheck.mjs b/Server/CardCheck.mjs
new file mode 100644
index 000000000..d7f7977fc
--- /dev/null
+++ b/Server/CardCheck.mjs
@@ -0,0 +1,137 @@
+/* `node Server/CardCheck.mjs <card-dir or card page.jsonl>` — checks a card against the card standard:
+ *   1. A state line
+ *   2. A preview of 60 characters or less
+ *   3. A checklist
+ *   4. Every item ticked on a done card
+ *   5. Objects on group and module cards
+ *   6. No paragraph over 60 words above the fold (reusing text_flags logic)
+ *   7. First mentions linked
+ *
+ * Runs in on-landing.mjs next to layout-check; failures report to task.jsonl and servex-mastermind.
+ * No model, never throws, prints JSON flags when executed directly. */
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const MAX_PREVIEW = 60;
+const MAX_PARA = 60;
+
+const words = s => s.replace(/\]\([^)]*\)/g, "]").replace(/`[^`]*`/g, "x").split(/\s+/).filter(w => /\w/.test(w)).length;
+
+export default class CardCheck {
+static parse_lines(filePath){
+	try {
+		return fs.readFileSync(filePath, "utf8").split("\n").flatMap(l => {
+			try { return l.trim() ? [JSON.parse(l)] : []; } catch { return []; }
+		});
+	} catch {
+		return [];
+	}
+}
+
+static card_flags(targetPath){
+	const flags = [];
+	let jsonlPath = targetPath;
+	try {
+		const stat = fs.statSync(targetPath);
+		if (stat.isDirectory()) {
+			jsonlPath = path.join(targetPath, "page.jsonl");
+		}
+	} catch {
+		return [`card-check: path not found: ${targetPath}`];
+	}
+
+	if (!fs.existsSync(jsonlPath)) {
+		return [`card-check: page.jsonl not found in ${targetPath}`];
+	}
+
+	const lines = CardCheck.parse_lines(jsonlPath);
+	if (!lines.length) return ["card-check: empty card log"];
+
+	const card = {
+		id: null,
+		title: null,
+		type: "card",
+		status: "open",
+		state: null,
+		preview: null,
+		objects: null,
+		checklist: [],
+		items: [],
+		text: "",
+		description: ""
+	};
+
+	for (const line of lines){
+		if (line.id) card.id = line.id;
+		if (line.title) card.title = line.title;
+		if (line.type) card.type = line.type;
+		if (line.status) card.status = line.status;
+		if (line.state) card.state = line.state;
+		if (line.preview) card.preview = line.preview;
+		if (line.objects) card.objects = line.objects;
+		if (line.text) card.text = line.text;
+		if (line.description) card.description = line.description;
+		if (Array.isArray(line.checklist)) card.checklist = line.checklist;
+		if (line.item) card.items.push(line.item);
+	}
+
+	// 1. A state line
+	if (!card.state) {
+		flags.push("missing state line ({\"state\": \"...\"})");
+	}
+
+	// 2. A preview of 60 characters or less
+	if (!card.preview) {
+		flags.push("missing preview line ({\"preview\": \"...\"})");
+	} else if (String(card.preview).length > MAX_PREVIEW) {
+		flags.push(`preview exceeds ${MAX_PREVIEW} characters (${String(card.preview).length})`);
+	}
+
+	// 3. A checklist
+	const hasChecklist = card.checklist.length > 0 || card.items.length > 0;
+	if (!hasChecklist) {
+		flags.push("missing checklist ({\"checklist\": [...]} or item lines)");
+	}
+
+	// 4. Every item ticked on a done card
+	const isDone = ["done", "complete", "completed", "closed", "landed"].includes(card.status);
+	if (isDone) {
+		const pendingChecklist = card.checklist.filter(i => !i.done);
+		const pendingItems = card.items.filter(i => !i.done);
+		if (pendingChecklist.length > 0 || pendingItems.length > 0) {
+			flags.push(`card is ${card.status} but has unticked checklist items`);
+		}
+	}
+
+	// 5. Objects on group and module cards
+	const isGroupOrModule = card.type === "group" || card.type === "module" ||
+		(card.id && (card.id.includes("group") || card.id.includes("module")));
+	if (isGroupOrModule && !card.objects) {
+		flags.push("group/module card missing objects declaration ({\"objects\": \"...\"})");
+	}
+
+	// 6. No paragraph over 60 words above the fold
+	const prose = [card.description, card.text].filter(Boolean).join("\n\n");
+	if (prose) {
+		const paragraphs = prose.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean);
+		for (const p of paragraphs) {
+			const n = words(p);
+			if (n > MAX_PARA) {
+				flags.push(`paragraph over ${MAX_PARA} words (${n} words: "${p.slice(0, 40)}…")`);
+			}
+		}
+	}
+
+	return flags;
+}
+}
+
+/** Old names, kept until 2026-10-20 (callers: on-landing.mjs). */
+export const card_flags = CardCheck.card_flags;
+
+if (path.resolve(process.argv[1] || "") === fileURLToPath(import.meta.url)){
+	const target = path.resolve(process.argv[2] || ".");
+	const flags = card_flags(target);
+	console.log(JSON.stringify(flags, null, 1));
+}
diff --git a/Server/HttpsCert.mjs b/Server/HttpsCert.mjs
new file mode 100644
index 000000000..ce23465a3
--- /dev/null
+++ b/Server/HttpsCert.mjs
@@ -0,0 +1,39 @@
+// Makes a self-signed https certificate for the LAN IP + localhost, with the openssl that ships in Git Bash.
+// Files go to %LOCALAPPDATA%/lew42/https/ (never the repo). Safe to run again: it keeps a cert that already exists.
+// Decision and the mkcert alternative: public/framework/ux/Dictate/doc/https-lan.md
+import fs from "fs";
+import os from "os";
+import path from "path";
+import { execFileSync } from "child_process";
+
+export default class HttpsCert {
+    static dir = path.join(process.env.LOCALAPPDATA || path.join(os.homedir(), ".local", "share"), "lew42", "https");
+    static key = path.join(this.dir, "key.pem");
+    static cert = path.join(this.dir, "cert.pem");
+
+    static lan_ips() {
+        return Object.values(os.networkInterfaces()).flat().filter(i => i.family === "IPv4" && !i.internal).map(i => i.address);
+    }
+
+    static exists() { return fs.existsSync(this.key) && fs.existsSync(this.cert); }
+
+    // { key, cert } for https.createServer, or null when none has been made yet
+    static load() { return this.exists() ? { key: fs.readFileSync(this.key), cert: fs.readFileSync(this.cert) } : null; }
+
+    static make() {
+        if (this.exists()) return false;
+        fs.mkdirSync(this.dir, { recursive: true });
+        const san = ["DNS:localhost", "IP:127.0.0.1", ...this.lan_ips().map(ip => "IP:" + ip)].join(",");
+        const openssl = ["C:/Program Files/Git/usr/bin/openssl.exe", "openssl"].find(p => p === "openssl" || fs.existsSync(p));
+        // MSYS would rewrite the leading "/CN=" as a path, so the subject is passed with MSYS_NO_PATHCONV
+        execFileSync(openssl, ["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "825",
+            "-keyout", this.key, "-out", this.cert, "-subj", "/CN=lew42-dev", "-addext", `subjectAltName=${san}`],
+            { stdio: "pipe", env: { ...process.env, MSYS_NO_PATHCONV: "1" } });
+        return true;
+    }
+}
+
+if (process.argv[1] && import.meta.url.endsWith(path.basename(process.argv[1]))) {
+    const made = HttpsCert.make();
+    console.log(made ? "made" : "kept", HttpsCert.cert, "for", HttpsCert.lan_ips().join(", "));
+}
diff --git a/Server/RenameScript.mjs b/Server/RenameScript.mjs
new file mode 100644
index 000000000..0fe6cc47a
--- /dev/null
+++ b/Server/RenameScript.mjs
@@ -0,0 +1,83 @@
+// RenameScript — rename scripts to their class name, rewrite every caller, keep a manifest, undo it.
+// Detail: Server/doc/scripts.md. History logs (*.jsonl) and session dirs are never rewritten.
+//   node Server/RenameScript.mjs --plan  <old=New,old2=New2>   dry run: list files to move and callers to rewrite
+//   node Server/RenameScript.mjs --apply <old=New,...> [--manifest <file.json>]
+//   node Server/RenameScript.mjs --undo  <manifest.json>
+// Paths are repo-relative, e.g. Server/card-check.mjs=Server/CardCheck.mjs. Set RENAME_ROOT to run on a copy.
+import fs from "node:fs";
+import path from "node:path";
+import zlib from "node:zlib";
+import { execFileSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+export default class RenameScript {
+	static TEXT = /\.(mjs|js|json|md|html|css|txt|cmd|ps1|sh|yml|yaml)$/i;
+	static SKIP = /(^|\/)(node_modules|\.git)\/|\.jsonl$|^public\/framework\/ai\/sessions\/|^public\/framework\/ai\/\d{4}-/;
+
+	constructor(root = process.env.RENAME_ROOT || path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..")) {
+		this.root = root;
+	}
+
+	git(...args) { return execFileSync("git", args, { cwd: this.root, encoding: "utf8", windowsHide: true, maxBuffer: 1 << 28 }); }
+
+	static parse(spec) { return spec.split(",").map(s => s.split("=")).map(([from, to]) => ({ from, to })); }
+
+	// "./card-check.mjs", "Server/card-check.mjs" and a bare "card-check.mjs" after a space, quote or backtick all match.
+	static pattern(from) {
+		const base = path.posix.basename(from).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+		return new RegExp(`(^|[/\\s\`"'(<])${base}(?![\\w-])`, "g");
+	}
+
+	callers(moves) {
+		const hits = [];
+		for (const file of this.git("ls-files").split("\n").filter(f => f && RenameScript.TEXT.test(f) && !RenameScript.SKIP.test(f))) {
+			let text; try { text = fs.readFileSync(path.join(this.root, file), "utf8"); } catch { continue; }
+			for (const { from, to } of moves) {
+				const re = RenameScript.pattern(from); let n = 0;
+				text.split("\n").forEach((line, i) => { if (re.test(line)) { n++; hits.push({ file, line: i + 1, from, to }); } re.lastIndex = 0; });
+			}
+		}
+		return hits;
+	}
+
+	plan(moves) { return { moves, callers: this.callers(moves) }; }
+
+	apply(moves, manifestPath) {
+		const { callers } = this.plan(moves);
+		const edits = [];
+		for (const { from, to } of moves) this.git("mv", from, to);
+		for (const file of [...new Set(callers.map(c => c.file))]) {
+			const current = moves.some(m => m.from === file) ? moves.find(m => m.from === file).to : file;
+			const abs = path.join(this.root, current);
+			const before = fs.readFileSync(abs, "utf8");
+			let text = before, changed = 0;
+			for (const { from, to } of moves) {
+				text = text.replace(RenameScript.pattern(from), (_, lead) => { changed++; return lead + path.posix.basename(to); });
+			}
+			if (changed) { fs.writeFileSync(abs, text); edits.push({ file: current, replaced: changed, before: zlib.gzipSync(before).toString("base64") }); }
+		}
+		const manifest = { when: new Date().toISOString(), moves, edits, callers };
+		if (manifestPath) fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 1));
+		return manifest;
+	}
+
+	undo(manifest) {
+		for (const { from, to } of [...manifest.moves].reverse()) this.git("mv", to, from);
+		for (const { file, before } of manifest.edits) {
+			const now = manifest.moves.find(m => m.to === file)?.from || file; // the edit's exact original text is in the manifest
+			fs.writeFileSync(path.join(this.root, now), zlib.gunzipSync(Buffer.from(before, "base64")).toString("utf8"));
+		}
+		return manifest.edits.length;
+	}
+
+	static main(argv) {
+		const [mode, arg] = [argv[0], argv[1]], rs = new RenameScript();
+		const mi = argv.indexOf("--manifest"), manifestPath = mi > -1 ? argv[mi + 1] : null;
+		if (mode === "--plan") console.log(JSON.stringify(rs.plan(RenameScript.parse(arg)), null, 1));
+		else if (mode === "--apply") { const m = rs.apply(RenameScript.parse(arg), manifestPath); console.log(`moved ${m.moves.length}, rewrote ${m.edits.length} files`); }
+		else if (mode === "--undo") console.log(`undone, ${rs.undo(JSON.parse(fs.readFileSync(arg, "utf8")))} files restored`);
+		else console.log("usage: --plan|--apply <old=New,...> [--manifest f] | --undo <manifest>");
+	}
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) RenameScript.main(process.argv.slice(2));

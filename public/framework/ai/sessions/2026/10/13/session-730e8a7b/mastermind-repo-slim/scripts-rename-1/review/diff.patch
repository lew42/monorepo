diff --git a/Server/AntigravityUsage.mjs b/Server/AntigravityUsage.mjs
new file mode 100644
index 000000000..802b031da
--- /dev/null
+++ b/Server/AntigravityUsage.mjs
@@ -0,0 +1,201 @@
+#!/usr/bin/env node
+/* AntigravityUsage.mjs — Fetches Antigravity model quotas and plan status.
+ * Communicates with the local Antigravity LanguageServerService via gRPC-Web.
+ * Usage:
+ *   node Server/AntigravityUsage.mjs          # Formatted console summary
+ *   node Server/AntigravityUsage.mjs --json   # Machine-readable JSON
+ *   node Server/AntigravityUsage.mjs --sync   # Write public/framework/ai/antigravity-usage.json & append .jsonl
+ */
+
+import fs from "fs";
+import path from "path";
+import https from "https";
+import { execSync } from "child_process";
+import { fileURLToPath } from "url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const REPO_ROOT = path.join(__dirname, "..");
+const AI_DIR = path.join(REPO_ROOT, "public/framework/ai");
+
+const stamp = () => {
+	const d = new Date(), o = -d.getTimezoneOffset(), p = n => String(Math.floor(Math.abs(n))).padStart(2, "0");
+	return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}${o < 0 ? "-" : "+"}${p(o / 60)}:${p(o % 60)}`;
+};
+
+export default class AntigravityUsage {
+static discoverCredentials() {
+	try {
+		// Discover language_server.exe process and command line
+		const psCmd = 'Get-CimInstance Win32_Process -Filter \\"Name = \'language_server.exe\'\\" | Select-Object -First 1 ProcessId, CommandLine | ConvertTo-Json';
+		const out = execSync(`powershell -NoProfile -Command "${psCmd}"`, { encoding: "utf8", windowsHide: true });
+		const proc = JSON.parse(out);
+		if (!proc?.CommandLine) return null;
+
+		const m = proc.CommandLine.match(/--csrf_token\s+([a-f0-9\-]+)/);
+		const csrfToken = m ? m[1] : null;
+
+		// Discover listening TCP ports for this PID
+		const netOut = execSync(`netstat -ano`, { encoding: "utf8", windowsHide: true });
+		const pid = String(proc.ProcessId);
+		const lines = netOut.split(/\r?\n/).filter(l => l.includes("LISTENING") && l.trim().endsWith(pid));
+
+		// Find 127.0.0.1 ports
+		const ports = [];
+		for (const l of lines) {
+			const match = l.match(/127\.0\.0\.1:(\d+)/);
+			if (match) ports.push(parseInt(match[1], 10));
+		}
+
+		return {
+			pid: proc.ProcessId,
+			csrfToken,
+			ports: [...new Set(ports)]
+		};
+	} catch (e) {
+		return null;
+	}
+}
+
+static fetchStatus({ port = 53301, csrfToken } = {}) {
+	return new Promise((resolve, reject) => {
+		const payload = Buffer.from("{}", "utf8");
+		const envelope = Buffer.alloc(5 + payload.length);
+		envelope.writeUInt8(0, 0); // 0 = uncompressed
+		envelope.writeUInt32BE(payload.length, 1);
+		payload.copy(envelope, 5);
+
+		const options = {
+			hostname: "127.0.0.1",
+			port,
+			path: "/exa.language_server_pb.LanguageServerService/GetUserStatus",
+			method: "POST",
+			rejectUnauthorized: false,
+			headers: {
+				"x-codeium-csrf-token": csrfToken,
+				"content-type": "application/grpc-web+json",
+				"x-grpc-web": "1"
+			}
+		};
+
+		const req = https.request(options, (res) => {
+			const chunks = [];
+			res.on("data", c => chunks.push(c));
+			res.on("end", () => {
+				const buf = Buffer.concat(chunks);
+				if (buf.length < 5) return reject(new Error("Empty or truncated response"));
+				const len = buf.readUInt32BE(1);
+				try {
+					const jsonStr = buf.slice(5, 5 + len).toString("utf8");
+					resolve(JSON.parse(jsonStr));
+				} catch (err) {
+					reject(err);
+				}
+			});
+		});
+
+		req.on("error", reject);
+		req.write(envelope);
+		req.end();
+	});
+}
+
+static async getAntigravityUsage() {
+	const creds = AntigravityUsage.discoverCredentials();
+	if (!creds || !creds.csrfToken) {
+		throw new Error("Antigravity language_server process not running or CSRF token not found");
+	}
+
+	let lastErr = null;
+	for (const port of creds.ports) {
+		try {
+			const raw = await AntigravityUsage.fetchStatus({ port, csrfToken: creds.csrfToken });
+			const userStatus = raw?.userStatus || {};
+			const planInfo = userStatus?.planStatus?.planInfo || {};
+			const configs = userStatus?.cascadeModelConfigData?.clientModelConfigs || [];
+
+			const models = {};
+			for (const c of configs) {
+				const label = c.label || c.modelId;
+				models[label] = {
+					modelId: c.modelId,
+					remainingFraction: c.quotaInfo?.remainingFraction ?? null,
+					resetTime: c.quotaInfo?.resetTime ?? null
+				};
+			}
+
+			return {
+				at: stamp(),
+				user: userStatus.name || "Unknown",
+				email: userStatus.email || "",
+				tier: planInfo.planName || userStatus.userTier?.name || "Unknown",
+				availablePromptCredits: userStatus.planStatus?.availablePromptCredits ?? null,
+				availableFlowCredits: userStatus.planStatus?.availableFlowCredits ?? null,
+				models
+			};
+		} catch (e) {
+			lastErr = e;
+		}
+	}
+	throw lastErr || new Error("Failed to connect to Antigravity gRPC service");
+}
+
+static async main() {
+	const args = process.argv.slice(2);
+	const wantJson = args.includes("--json");
+	const wantSync = args.includes("--sync");
+
+	try {
+		const usage = await AntigravityUsage.getAntigravityUsage();
+
+		if (wantSync) {
+			const targetJson = path.join(AI_DIR, "antigravity-usage.json");
+			const targetJsonl = path.join(AI_DIR, "antigravity-usage.jsonl");
+
+			fs.writeFileSync(targetJson, JSON.stringify(usage, null, 2));
+
+			// Extract brief snapshot for append stream
+			const snap = {
+				log: {
+					at: usage.at,
+					tier: usage.tier,
+					prompt_credits: usage.availablePromptCredits,
+					flow_credits: usage.availableFlowCredits,
+					gemini_fraction: usage.models["Gemini 3.8 Flash (High)"]?.remainingFraction ?? null,
+					gemini_reset: usage.models["Gemini 3.8 Flash (High)"]?.resetTime ?? null,
+					claude_reset: usage.models["Claude Sonnet 5.5 (Medium)"]?.resetTime ?? null
+				}
+			};
+			fs.appendFileSync(targetJsonl, JSON.stringify(snap) + "\n");
+			console.log(`Synced to ${targetJson} and appended to ${targetJsonl}`);
+			return;
+		}
+
+		if (wantJson) {
+			console.log(JSON.stringify(usage, null, 2));
+			return;
+		}
+
+		// Formatted terminal display
+		console.log(`\nAntigravity Status (${usage.at}):`);
+		console.log(`  User: ${usage.user} (${usage.email}) | Tier: ${usage.tier}`);
+		console.log(`  Credits: Prompt=${usage.availablePromptCredits}, Flow=${usage.availableFlowCredits}\n`);
+		console.log(`  Model Quotas:`);
+		for (const [name, info] of Object.entries(usage.models)) {
+			const pct = info.remainingFraction !== null ? `${Math.round(info.remainingFraction * 100)}% remaining` : "Rate-limited / Reset-tracked";
+			const reset = info.resetTime ? `(resets ${info.resetTime})` : "";
+			console.log(`    - ${name.padEnd(28)} : ${pct.padEnd(26)} ${reset}`);
+		}
+		console.log("");
+	} catch (e) {
+		console.error("Antigravity usage fetch failed:", e.message);
+		process.exit(1);
+	}
+}
+}
+
+/** Old names, kept until 2026-10-20. */
+export const discoverCredentials = AntigravityUsage.discoverCredentials, fetchStatus = AntigravityUsage.fetchStatus, getAntigravityUsage = AntigravityUsage.getAntigravityUsage;
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
+	AntigravityUsage.main();
+}
diff --git a/Server/ArchiveSessions.mjs b/Server/ArchiveSessions.mjs
new file mode 100644
index 000000000..74ac5faba
--- /dev/null
+++ b/Server/ArchiveSessions.mjs
@@ -0,0 +1,235 @@
+#!/usr/bin/env node
+// Move a month's untracked session pictures to the archive drive; tracked records stay. Doc: public/framework/ai/sessions/doc/picture-archive.md
+//   node Server/ArchiveSessions.mjs --plan  [--months 08,09]   what would move: per day, files, MB, destination
+//   node Server/ArchiveSessions.mjs --copy                     copy to the archive, sha1 every file, write its manifest + README
+//   node Server/ArchiveSessions.mjs --apply                    re-verify both sides, remove the C: copy, write the repo stub
+//   node Server/ArchiveSessions.mjs --undo [--drawn]           copy every file back (or only the ones a page.js draws) and verify (archive kept)
+// A picture a page.js draws on load stays on C: (a copy still goes to the archive): an archived one would 404 and fail merge.mjs's smoke.
+// Flags: --root <repo> (default: this repo)  --dest <archive root> (default E:/Projects/lew42/archive)  --year 2026
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+export default class ArchiveSessions {
+	static PICTURE = /\.(png|jpe?g|webp|gif)$/i;
+	static STORE = "public/framework/ai/sessions";
+
+	constructor({ root, dest, year = "2026", months = ["08", "09"] } = {}) {
+		this.root = path.resolve(root || path.join(path.dirname(fileURLToPath(import.meta.url)), ".."));
+		this.dest = path.resolve(dest || "E:/Projects/lew42/archive");
+		this.year = year;
+		this.months = months;
+	}
+
+	monthDir(m) { return `${ArchiveSessions.STORE}/${this.year}/${m}`; }       // repo-relative, forward slashes
+	archiveDir(m) { return path.join(this.dest, "sessions", this.year, m); }
+	manifestPath(m) { return path.join(this.archiveDir(m), "archive.jsonl"); }
+
+	git(args) { return execFileSync("git", args, { cwd: this.root, maxBuffer: 1 << 28, windowsHide: true }).toString(); }
+
+	static sha1(file) { return createHash("sha1").update(fs.readFileSync(file)).digest("hex"); }
+
+	static walk(dir, out = []) {
+		if (!fs.existsSync(dir)) return out;
+		for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+			const f = path.join(dir, e.name);
+			if (e.isDirectory()) ArchiveSessions.walk(f, out); else out.push(f);
+		}
+		return out;
+	}
+
+	// Untracked pictures under the month (tracked ones, e.g. inside doc/, stay with git).
+	scan(m) {
+		const rel = this.monthDir(m);
+		const tracked = new Set(this.git(["ls-files", "-z", "--", rel]).split("\0").filter(Boolean));
+		const abs = path.join(this.root, rel);
+		return ArchiveSessions.walk(abs)
+			.map(f => path.relative(abs, f).split(path.sep).join("/"))
+			.filter(p => ArchiveSessions.PICTURE.test(p) && !tracked.has(`${rel}/${p}`))
+			.map(p => ({ path: p, bytes: fs.statSync(path.join(abs, p)).size }))
+			.sort((a, b) => a.path.localeCompare(b.path));
+	}
+
+	static mb(b) { return (b / 1e6).toFixed(1) + " MB"; }
+
+	// Pictures a page shows when it opens, so they never leave: named in an ancestor page.js, or embedded as a picture
+	// (markdown ![](…), <img src>, a {"shot"} line) in an ancestor's task.jsonl, page.jsonl or .md.
+	static EMBED = /!\[[^\]]*\]\(([^)\s]+)|<img[^>]*src=\\?["']([^"'\\]+)|"shot":\s*\{[^}]*"(?:path|url|file)":\s*"([^"]+)"/g;
+	drawn(m, list) {
+		const rel = this.monthDir(m);
+		const srcs = this.git(["ls-files", "--", rel]).split("\n").filter(f => /(^|\/)(page\.js|page\.jsonl|task\.jsonl|[^/]+\.md)$/.test(f))
+			.map(f => {
+				const text = fs.readFileSync(path.join(this.root, f), "utf8");
+				const refs = f.endsWith("page.js") ? null : [...text.matchAll(ArchiveSessions.EMBED)].map(x => x[1] || x[2] || x[3]);
+				return { dir: path.posix.dirname(f), text, refs };
+			});
+		return new Set(list.filter(r => {
+			const dir = path.posix.dirname(`${rel}/${r.path}`), name = path.posix.basename(r.path);
+			return srcs.some(s => (dir + "/").startsWith(s.dir + "/") && (s.refs ? s.refs.some(u => u.endsWith(name)) : s.text.includes(name)));
+		}).map(r => r.path));
+	}
+
+	static byDay(rows) {
+		const days = {};
+		for (const r of rows) {
+			const [day, folder] = r.path.split("/");
+			const d = days[day] ||= { files: 0, bytes: 0, folders: new Set() };
+			d.files++; d.bytes += r.bytes; if (folder && r.path.split("/").length > 2) d.folders.add(folder);
+		}
+		return days;
+	}
+
+	plan() {
+		const out = {};
+		for (const m of this.months) {
+			const rows = this.scan(m);
+			const bytes = rows.reduce((s, r) => s + r.bytes, 0);
+			out[m] = { files: rows.length, bytes, from: this.monthDir(m), to: this.archiveDir(m) };
+			console.log(`${this.year}/${m}: ${rows.length} pictures, ${ArchiveSessions.mb(bytes)}  ${this.monthDir(m)} -> ${this.archiveDir(m)}`);
+			for (const [day, d] of Object.entries(ArchiveSessions.byDay(rows)).sort())
+				console.log(`  ${day}: ${d.files} files, ${ArchiveSessions.mb(d.bytes)}, ${d.folders.size} folders`);
+		}
+		return out;
+	}
+
+	readManifest(m) {
+		const f = this.manifestPath(m);
+		if (!fs.existsSync(f)) throw new Error(`no manifest at ${f}: run --copy first`);
+		return fs.readFileSync(f, "utf8").split("\n").filter(Boolean).map(l => JSON.parse(l));
+	}
+
+	copy() {
+		for (const m of this.months) {
+			const src = path.join(this.root, this.monthDir(m)), dst = this.archiveDir(m);
+			const rows = this.scan(m);
+			let copied = 0;
+			for (const r of rows) {
+				const a = path.join(src, r.path), b = path.join(dst, r.path);
+				fs.mkdirSync(path.dirname(b), { recursive: true });
+				r.sha1 = ArchiveSessions.sha1(a);
+				if (!(fs.existsSync(b) && fs.statSync(b).size === r.bytes && ArchiveSessions.sha1(b) === r.sha1)) {
+					fs.copyFileSync(a, b); copied++;
+					const st = fs.statSync(a); fs.utimesSync(b, st.atime, st.mtime);
+				}
+			}
+			// merge with an earlier manifest so a re-run never forgets a file already archived
+			const prior = fs.existsSync(this.manifestPath(m)) ? this.readManifest(m) : [];
+			const all = new Map(prior.map(r => [r.path, r]));
+			for (const r of rows) all.set(r.path, r);
+			const list = [...all.values()].sort((a, b) => a.path.localeCompare(b.path));
+			fs.writeFileSync(this.manifestPath(m), list.map(r => JSON.stringify(r)).join("\n") + "\n");
+			const v = this.verify(m, list);
+			console.log(`${this.year}/${m}: copied ${copied} of ${rows.length} (the rest were already there); archive holds ${v.files} files, ${v.bytes} bytes; manifest ${list.length} files, ${list.reduce((s, r) => s + r.bytes, 0)} bytes; sha1 bad ${v.bad.length}`);
+			if (v.bad.length) throw new Error(`verify failed: ${v.bad.slice(0, 5).join(", ")}`);
+		}
+		this.writeArchiveReadme();
+	}
+
+	// Every manifest file is on the archive with its size and sha1; the archive's own count and bytes equal the manifest's.
+	verify(m, list = this.readManifest(m)) {
+		const dst = this.archiveDir(m);
+		const files = ArchiveSessions.walk(dst).filter(f => ArchiveSessions.PICTURE.test(f));
+		const bytes = files.reduce((s, f) => s + fs.statSync(f).size, 0);
+		const bad = list.filter(r => { const b = path.join(dst, r.path); return !fs.existsSync(b) || fs.statSync(b).size !== r.bytes || ArchiveSessions.sha1(b) !== r.sha1; }).map(r => r.path);
+		const want = list.reduce((s, r) => s + r.bytes, 0);
+		if (files.length !== list.length || bytes !== want) bad.push(`count/bytes: archive ${files.length}/${bytes} vs manifest ${list.length}/${want}`);
+		return { files: files.length, bytes, bad };
+	}
+
+	apply() {
+		for (const m of this.months) {
+			const list = this.readManifest(m), src = path.join(this.root, this.monthDir(m));
+			const v = this.verify(m, list);
+			if (v.bad.length) throw new Error(`${m}: archive does not verify, nothing removed: ${v.bad.slice(0, 5).join(", ")}`);
+			const left = this.scan(m).filter(r => !list.some(x => x.path === r.path));
+			if (left.length) throw new Error(`${m}: ${left.length} pictures are not on the archive yet (run --copy): ${left[0].path}`);
+			let removed = 0, bytes = 0;
+			const keep = this.drawn(m, list);
+			for (const r of list) {
+				const a = path.join(src, r.path);
+				if (!fs.existsSync(a) || keep.has(r.path)) continue;
+				if (ArchiveSessions.sha1(a) !== r.sha1) throw new Error(`${a} changed since --copy; re-run --copy`);
+				fs.unlinkSync(a); removed++; bytes += r.bytes;
+				ArchiveSessions.pruneEmpty(path.dirname(a), src);
+			}
+			this.writeStub(m, list, keep);
+			fs.copyFileSync(this.manifestPath(m), path.join(this.root, this.monthDir(m), "archive.jsonl"));   // the record of what left stays in git
+			console.log(`${this.year}/${m}: removed ${removed} pictures (${ArchiveSessions.mb(bytes)}) from the working tree; stub ${this.monthDir(m)}/readme.md`);
+		}
+	}
+
+	static pruneEmpty(dir, stop) {
+		while (path.resolve(dir) !== path.resolve(stop) && fs.existsSync(dir) && fs.readdirSync(dir).length === 0) {
+			fs.rmdirSync(dir); dir = path.dirname(dir);
+		}
+	}
+
+	undo(onlyDrawn = false) {
+		for (const m of this.months) {
+			let list = this.readManifest(m);
+			if (onlyDrawn) { const keep = this.drawn(m, list); list = list.filter(r => keep.has(r.path)); }
+			const src = path.join(this.root, this.monthDir(m)), dst = this.archiveDir(m);
+			let restored = 0, bad = 0;
+			for (const r of list) {
+				const a = path.join(src, r.path), b = path.join(dst, r.path);
+				if (fs.existsSync(a) && ArchiveSessions.sha1(a) === r.sha1) continue;
+				fs.mkdirSync(path.dirname(a), { recursive: true });
+				fs.copyFileSync(b, a);
+				const st = fs.statSync(b); fs.utimesSync(a, st.atime, st.mtime);
+				if (ArchiveSessions.sha1(a) !== r.sha1) bad++; else restored++;
+			}
+			console.log(`${this.year}/${m}: restored ${restored} of ${list.length} pictures, sha1 bad ${bad}; the stub readme.md stays (git keeps it), the archive copy stays`);
+		}
+	}
+
+	// The repo side: one readme per month saying what left, where to, and how to bring it back.
+	writeStub(m, all, keep = new Set()) {
+		const list = all.filter(r => !keep.has(r.path)), kept = all.length - list.length;
+		const days = ArchiveSessions.byDay(list);
+		const bytes = list.reduce((s, r) => s + r.bytes, 0);
+		const dst = this.archiveDir(m).split(path.sep).join("/");
+		const lines = [
+			`# ${this.year}/${m}: the pictures are archived`,
+			"",
+			`The ${list.length.toLocaleString("en-US")} untracked pictures of this month (${ArchiveSessions.mb(bytes)}, mostly review screenshots in \`shots/\`) moved to the archive drive at \`${dst}/\`, same paths below it, to free the working disk. ${kept ? `The ${kept} pictures a page draws when it opens stayed here (a copy is on the drive too). ` : ""}Every record (task.jsonl, page.jsonl, docs, pages) is still here, so the [Sessions page](/framework/ai/sessions/) and every search still read this month. An old report shows a broken picture until it is copied back.`,
+			"",
+			`- **Every file, its size and sha1:** [archive.jsonl](archive.jsonl), the same file as \`${dst}/archive.jsonl\` on the drive (whose own README says what it is).`,
+			`- **Bring it back:** \`node Server/ArchiveSessions.mjs --undo --months ${m}\` (the drive plugged in) copies every file back and checks its sha1.`,
+			`- **How it works:** [picture-archive.md](../../doc/picture-archive.md).`,
+			"",
+			"| Day | Pictures | Size | Folders |",
+			"|---|---|---|---|",
+			...Object.entries(days).sort().map(([d, x]) => `| [${m}/${d}](${d}/) | ${x.files} | ${ArchiveSessions.mb(x.bytes)} | ${x.folders.size} |`),
+			"",
+		];
+		fs.writeFileSync(path.join(this.root, this.monthDir(m), "readme.md"), lines.join("\n"));
+	}
+
+	writeArchiveReadme() {
+		const f = path.join(this.dest, "sessions", "README.md");
+		fs.mkdirSync(path.dirname(f), { recursive: true });
+		const months = fs.readdirSync(path.join(this.dest, "sessions", this.year)).sort();
+		fs.writeFileSync(f, [
+			"# Archived session pictures from the lew42 monorepo",
+			"",
+			"These are the untracked screenshots that lived under `public/framework/ai/sessions/<year>/<month>/` in `C:/Code/lew42/monorepo`, moved here to free the working disk. The records themselves (task logs, pages, docs) stayed in the repo and in git.",
+			"",
+			`- Months here: ${months.map(m => `${this.year}/${m}`).join(", ")}. Each month folder has \`archive.jsonl\`: one line per file, its path below the month, bytes and sha1.`,
+			"- Restore: in the repo, `node Server/ArchiveSessions.mjs --undo --months <MM>` copies them back to the same paths and checks every sha1. Or copy a folder back by hand: the paths are the same.",
+			"- Written by `Server/ArchiveSessions.mjs`; the repo doc is `public/framework/ai/sessions/doc/picture-archive.md`.",
+			"",
+		].join("\n"));
+	}
+
+	static cli(argv) {
+		const flag = n => argv.includes(n) ? argv[argv.indexOf(n) + 1] : undefined;
+		const a = new ArchiveSessions({ root: flag("--root"), dest: flag("--dest"), year: flag("--year"), months: flag("--months")?.split(",") });

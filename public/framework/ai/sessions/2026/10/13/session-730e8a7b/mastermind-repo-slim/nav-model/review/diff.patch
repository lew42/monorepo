+@layer base, theme, site, util;
+
+/* The navigation model page's demos (NavModelPage.js) and its workspace child. ASCII only. */
+@layer site {
+	.page-navm-qa { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
+	@media (max-width: 40em) { .page-navm-qa { grid-template-columns: 1fr; } }
+	.page-navm-q { display: flex; flex-direction: column; gap: 0.4em; }
+	.page-navm-q > p { margin: 0; }
+	.page-navm-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr)); gap: var(--gap); }
+	.page-navm-cell { display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }
+
+	/* An embedded Sidebar: the real component, boxed to a fixed height instead of the screen. */
+	.page-navm-rail { height: 26em; border: 1px solid var(--line); border-radius: 0.4em; overflow: hidden; }
+	.page-navm-rail > .sidebar { height: 100%; width: 100%; }
+	@media (max-width: 52em) { .page-navm-rail { height: auto; } }
+
+	.page-navm-room { display: flex; flex-direction: column; gap: 0.6em; }
+	.page-navm-bar { display: grid; grid-template-columns: 16em 1fr; gap: 0.8em; align-items: center; }
+	.page-navm-track { display: flex; height: 2em; border: 1px solid var(--line); border-radius: 0.3em; overflow: hidden; }
+	.page-navm-seg { flex: 0 0 auto; background: var(--fill-a08, #0001); border-right: 1px solid var(--line); }
+	.page-navm-left { display: flex; align-items: center; padding: 0 0.6em; white-space: nowrap; overflow: hidden; font-size: 0.85em; }
+	@media (max-width: 40em) { .page-navm-bar { grid-template-columns: 1fr; gap: 0.2em; } }
+
+	.page-navm-frame { display: grid; grid-template-columns: 7em 1fr; min-height: 5em; border: 1px solid var(--line); border-radius: 0.4em; overflow: hidden; font-size: 0.85em; }
+	.page-navm-mini-rail { padding: 0.6em; background: var(--fill-a08, #0001); overflow-wrap: anywhere; }
+	.page-navm-mini-main { display: flex; flex-direction: column; gap: 0.3em; padding: 0.6em; min-width: 0; }
+	.page-navm-crumb { font-weight: 600; overflow-wrap: anywhere; }
+
+	.page-navm-kind { height: 10em; border: 1px solid var(--line); border-radius: 0.4em; overflow: hidden; }
+	.page-navm-doc { display: flex; flex-direction: column; gap: 0.6em; padding: 1.2em 22%; }
+	.page-navm-line { height: 0.5em; border-radius: 0.25em; background: var(--fill-a08, #0001); }
+	.page-navm-ws { display: grid; grid-template-columns: 1fr 2.5fr 1fr; }
+	.page-navm-pane { border-right: 1px solid var(--line); background: var(--fill-a08, #0001); }
+	.page-navm-pane:nth-child(2) { background: none; }
+	.page-navm-pane:last-child { border-right: 0; }
+
+	/* The workspace child: fills its region, no padding, three panes edge to edge. */
+	.pages > .page.page-navm-workspace { display: grid; grid-template-columns: minmax(12em, 1fr) 3fr minmax(12em, 1fr); grid-template-rows: 1fr; align-content: stretch; min-height: 100dvh; padding: 0; gap: 0; max-width: none; }
+	.page-navm-workspace > .page-navm-wpane { grid-column: auto; }
+	.page-navm-wpane { display: flex; flex-direction: column; gap: 0.6em; padding: 1em; border-right: 1px solid var(--line); min-width: 0; }
+	.page-navm-wpane:last-child { border-right: 0; }
+	.page-navm-wcanvas { background: var(--surface, #fff); }
+	.page-navm-wtitle { font-weight: 700; }
+	@media (max-width: 52em) { .pages > .page.page-navm-workspace { grid-template-columns: 1fr; grid-template-rows: auto; min-height: 0; } .page-navm-wpane { border-right: 0; border-bottom: 1px solid var(--line); } }
+}

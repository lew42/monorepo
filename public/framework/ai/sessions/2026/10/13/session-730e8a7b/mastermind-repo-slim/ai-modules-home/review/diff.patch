+/* Layout and the expando mechanism only — the looks are `surface` / `wash` /
+   `muted` off framework.css. */
+@layer theme {
+
+	/* The AI page's head: the title and the version picker on one row (2026-09-19).
+	   The picker hugs its label; the row wraps only when a phone has no room. */
+	.ai-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25em 1em; }
+	/* Moved out of the page's own box, the h1 lost the size the catalog gave it and
+	   fell back to the theme's flat 3em; this is the size it had. */
+	.page .ai-head > h1.page-title { margin: 0; font-size: 1.5rem; line-height: 1.2; }   /* outranks Page.css's `.page h1.page-title` */
+	.ai-head > .ai-version-trigger { flex: 0 0 auto; }
+	/* framework.css spaces whatever FOLLOWS a page title (`.page-title + *`); in a row
+	   that pushed the picker 30px below the title it sits beside. */
+	.ai-head > .page-title + * { margin-block-start: 0; }
+
+
+	/* ⚠ A task page claims the `wide` track (AITask.js `content()`) because it is a
+	   wall of cards, a conversation and four tables of figures — none of which fit
+	   the 602px reading column at 1280. Prose is the exception and keeps its
+	   measure, exactly as `.page-column-prose` does in core/Page/Page.css: the
+	   frame is wide, the sentences are not. `.wide` on a block opts back out. */
+	/* ⚠ And the measure has to be handed BACK first. `ext/tabs`' own rule says
+	     `.tab-panel { --measure: none }` — a tab's content is meant to fill its
+	     panel — and this page borrows those classes for its tab bar, so a cap
+	     read from the token inside a panel resolves to `none` and silently does
+	     nothing: paragraphs measured 858px at 1280 with the rule matching and
+	     the browser reporting `max-width: none` (2026-09-17). Re-declared here,
+	     scoped to this page, so `ext/tabs` keeps its own behaviour everywhere
+	     else. 40em is the number `--measure` carries, said out loud. */
+	.ai-task .tab-panel { --measure: 40em; }
+
+	.ai-task :is(p, h1, h2, h3, h4, h5, h6, ul, ol, blockquote) {
+		max-width: var(--measure, 40em);
+	}
+	.ai-task :is(.wide, .bleed) { max-width: none; }
+
+	.ai-header { display: flex; align-items: baseline; gap: var(--gap-50); flex-wrap: wrap; }   /* was gap .5em - 2026-09-05 ramps */
+
+	/* One line each, ellipsis past the fold; `title` carries what this clips.
+	   ⚠ It lives on `wide` now (`.ai-timeline`, dashboard.js) — clipping a
+	     one-line row inside the 40em `main` track cut every entry at x≈910 at
+	     390, 1280 AND 3440 (vision-after, 2026-08-17). A row that will not wrap
+	     must be given the width it is not allowed to wrap in.
+	   ⚠ A line naming a task IS that task's link now — an <a>, so it wears link
+	     colour. As grey <p> text it read as the task list and wasn't one. */
+	.ai-day-line { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+		min-width: 0; text-decoration: none; }
+	.ai-day-line:hover { color: var(--prime); }
+
+	/* A disclosure marker, because "timeline — 111 log lines today" read as a
+	   caption: `card-ux-v1` could not tell whether it navigated, was a stat, or
+	   did nothing. The triangle says "there is more inside me" without pretending
+	   to be a link, which is exactly what it is. */
+	.ai-timeline .ai-fold-bar::before { content: "▸ "; }
+	.ai-timeline .ai-fold.open .ai-fold-bar::before { content: "▾ "; }
+
+	/* ── The Asks tab — what the owner asked for, as preview cards ─────────────
+	   A wall, so `auto-fill`: `auto-fit` would collapse the empty tracks and hand
+	   a lone card the whole 2,900px at 3440 (framework.css says the same, with the
+	   measurements). 17em is three columns at 1280, which is one screen for a
+	   dozen asks — the whole point of the tab. */
+	/* ⚠ Cards STRETCH to their row, they are not content-sized: one ask whose task
+	     logged several links is twice the height of its neighbours, and with
+	     `align-items: start` that left a ragged hole in the wall at 1280. Equal
+	     heights plus `margin-block-start: auto` on the foot puts every chip row on
+	     the same baseline instead. */
+	.ai-asks {
+		display: grid;
+		grid-template-columns: repeat(auto-fill, minmax(min(17em, 100%), 1fr));
+		gap: var(--gap);
+	}
+	.ai-asks > * { margin: 0; }
+
+	.ai-asks-head { margin-block-end: var(--gap-50); }
+
+	/* A topic heading belongs to the wall UNDER it. The flow owl would put a
+	   full `--flow` between heading and wall AND between wall and next heading,
+	   which reads as three unrelated boxes; pulling the wall up to a half-gap
+	   binds each label to its own cards. The owl is `:where()` — zero
+	   specificity — so a plain class pair wins with nothing to fight. */
+	.ai-asks-topic + .ai-asks { margin-block-start: var(--gap-50); }
+
+	/* ⚠ THE GRIP NEEDS ITS OWN GUTTER on a heading too, same reason as the card and
+	     the decision row below: `:has()`, so a read-only page (no socket) keeps
+	     exactly the padding it had. */
+	.ai-asks-topic:has(> .ai-rank-grip) { position: relative; padding-inline-end: 1.8em; }
+	.ai-asks-topic > .ai-rank-grip { top: .1em; }
+
+	/* ── FOOTNOTES — a band's own tail, folded ─────────────────────────────────
+	   A `rank` line's `fold` cuts a band to its first N cards; the rest stay
+	   ordinary grid items (so the grip on every one keeps working, and dragging
+	   never has to reach into a nested box) and CSS alone hides them until the
+	   bar below is clicked. Full width, like the detail sheet it sits beside. */
+	.ai-asks-fold-toggle {

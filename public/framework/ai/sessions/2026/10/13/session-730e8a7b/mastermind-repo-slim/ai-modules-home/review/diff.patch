index 000000000..297d3603e
--- /dev/null
+++ b/public/framework/ai/AITask/dashboard.js
@@ -0,0 +1,368 @@
+import { a, div, p, span } from "../../core/View/View.js";
+import { TaskJSONL } from "../../ext/JSONL/JSONL.js";
+import { usage_rail } from "./usage.js";
+import { dated, group, list, newest } from "./board.js";
+import { efforts, tally } from "./effort.js";
+import { compose } from "./compose.js";
+import { fold } from "./message.js";
+import { state } from "./stats.js";
+import { when } from "./card.js";
+import { highlights, more } from "./highlights.js";
+import { needs_all, needs_strip } from "./needs.js";
+import { day_costs, total_line } from "./cost.js";
+import { spend_summary, module_list } from "./module-spend.js";
+import { prompts_section } from "./day-prompts.js";
+
+// history and reasons: doc/dashboard-notes.md
+function mark_read(id){
+	try {
+		const key = "ai2-read-ids";
+		const set = new Set(JSON.parse(localStorage.getItem(key) ?? "[]"));
+		set.add(id);
+		localStorage.setItem(key, JSON.stringify([...set]));
+	} catch {}
+}
+
+const running = t => state(t.m) === "running";
+
+/* ⚠ The SPA fallback answers every miss with index.html — content-type is the 404. */
+const json = url => fetch(url)
+	.then(res => res.ok && !res.headers.get("content-type")?.includes("html") ? res.json() : null)
+	.catch(() => null);
+
+async function manifest(base, files, live){
+	if (!files || files.includes("task.jsonl")){
+		const t = new TaskJSONL({ url: base + "task.jsonl" });
+		await (live ? t.live(live) : t.load());
+		if (t.loaded) return t;
+	}
+	return !files || files.includes("session.json") ? json(base + "session.json") : null;
+}
+
+const ai_dir = dir => dir?.files?.find(f => f.name === "ai")?.children ?? [];
+const kids_of = day => (day.children ?? []).filter(kid => kid.type === "dir");
+
+const day_cache = new Map();
+
+// ⚠ Silent off localhost (no socket); ⚠ el.isConnected: navigated-away boards must not redraw
+function on_directory(page, $v, reread){
+	page?.app?.socket?.on("data", path => {
+		if (!path.endsWith("/directory.json") || !$v.el.isConnected) return;
+		day_cache.clear();
+		reread();
+	});
+}
+
+export function warm(date){
+	if (!day_cache.has(date)){
+		const entry = { value: undefined };
+		json("/framework/directory.json").then(dir => {
+			const day = ai_dir(dir).find(d => d.name === date);
+			entry.value = Object.fromEntries(kids_of(day ?? { children: [] })
+				.map(kid => [kid.name, kid.children?.map(k => k.name) ?? []]));
+		});
+		day_cache.set(date, entry);
+	}
+	return day_cache.get(date);
+}
+
+// Sync fetch for route() which must return immediately, not a Promise
+function fetch_sync(url){
+	const xhr = new XMLHttpRequest();
+	xhr.open("GET", url, false);
+	try { xhr.send(); } catch { return null; }
+	return xhr.status >= 200 && xhr.status < 300 && !(xhr.getResponseHeader("content-type") ?? "").includes("html")
+		? JSON.parse(xhr.responseText) : null;
+}
+
+/** Does `name`'s task dir carry its own `page.js`? Answers from the async
+    cache once warm() has landed; falls back to one synchronous fetch the
+    first time it's asked cold, so a fresh deep link is never a guess. */
+export function has_page_js(date, name){
+	const entry = warm(date);
+	if (entry.value === undefined){
+		const dir = fetch_sync("/framework/directory.json");
+		const day = dir && ai_dir(dir).find(d => d.name === date);
+		entry.value = Object.fromEntries(kids_of(day ?? { children: [] })
+			.map(kid => [kid.name, kid.children?.map(k => k.name) ?? []]));
+	}
+	return entry.value?.[name]?.includes("page.js");
+}
+
+/* day.jsonl is plain JSONL, not a directory manifest — its own small reader,
+   same SPA-fallback guard as json() above. */
+async function day_log(date){
+	const res = await fetch(`/framework/ai/sessions/${date.replaceAll("-", "/")}/day.jsonl`).catch(() => null);   // the day log lives in the sessions store (ai/doc/task-folders.md)
+	if (!res?.ok || (res.headers.get("content-type") ?? "").includes("html")) return [];
+	const text = await res.text();
+	return text.split("\n").filter(Boolean).flatMap(line => {
+		try { const l = JSON.parse(line).log; return l ? [l] : []; } catch { return []; }
+	});
+}
+
+export function timeline(date){
+	return div.c("ai-timeline wide", async $t => {
+		const lines = (await day_log(date)).sort((a, b) => Date.parse(b.at) - Date.parse(a.at));
+		$t.append(() => lines.length && fold(`timeline — ${lines.length} log lines today`, () =>
+			lines.forEach(l => {
+				const text = `${when(l.at)} — ${l.task ? l.task + ": " : ""}${l.msg}`;
+				(l.task ? a.c("ai-day-line").href(`/framework/ai/${date}/${l.task}/`)
+					: div.c("ai-day-line muted")).text(text).attr("title", text);
+			})));
+	});
+}
+
+async function load(base, name, files, child, nav, live){
+	const m = await manifest(base, files, live);
+	const brief = !m && files?.includes("requirements.md")
+		? await fetch(base + "requirements.md").then(r => r.ok ? r.text() : "").catch(() => "")
+		: "";
+	return { name, m, files: files ?? [], url: base, child, nav, title: child?.title ?? name,
+		brief: brief.split("\n").map(s => s.trim()).find(s => s && !s.startsWith("#"))?.replaceAll("**", "") };
+}
+
+async function tasks(page, live){
+	const date = page.url.split("/").filter(Boolean).at(-1);
+	const day = ai_dir(await json("/framework/directory.json")).find(d => d.name === date);
+	const dirs = day && kids_of(day);
+	const names = dirs?.map(kid => kid.name) ?? [...page.children.keys()];
+
+	return Promise.all(names.map(name => load(page.url + name + "/", name,
+		dirs ? dirs.find(kid => kid.name === name)?.children?.map(kid => kid.name) ?? [] : null,
+		page.children.get(name), page.nav_for(name), live)));
+}
+
+/** Every task of every day — the ai index's rail reaches across dates. */
+async function all_tasks(){
+	const days = ai_dir(await json("/framework/directory.json"))
+		.filter(d => d.type === "dir" && /^\d{4}-\d{2}-\d{2}$/.test(d.name));
+
+	return Promise.all(days.flatMap(day => kids_of(day).map(kid =>
+		load(`/framework/ai/${day.name}/${kid.name}/`, kid.name,
+			kid.children?.map(c => c.name) ?? [], null, null))));
+}
+
+const GROUPS = [
+	["Active", t => state(t.m) === "running"],
+	["Landed", t => state(t.m) === "landed"],
+	["Proposed", t => state(t.m) === "proposed" && (t.m || t.files.includes("requirements.md"))],
+];
+
+function groups(rows_of){
+	const found = GROUPS.map(([title, match]) => [title, rows_of.filter(match).sort(newest)]);
+
+	if (!found.some(([, rows]) => rows.length))
+		return p.c("muted", "Nothing yet — a task appears when its directory holds a requirements.md or a task.jsonl.");
+
+	day_costs(rows_of.filter(t => t.m));
+
+	found.forEach(([title, rows]) => {
+		if (!rows.length) return;
+		if (title === "Proposed") return fold(`${title} — ${rows.length} not started`, () => list(rows));
+		group(title, rows).ac(title === "Landed" && "ai-compact");
+	});
+}
+
+// Pure UTC date arithmetic; see doc/dashboard-notes.md for timezone traps
+function addDays(dateStr, delta){
+	const [y, m, d] = dateStr.split("-").map(Number);
+	const dt = new Date(Date.UTC(y, m - 1, d));
+	dt.setUTCDate(dt.getUTCDate() + delta);
+	return dt.toISOString().slice(0, 10);
+}
+
+// Local calendar day, not UTC; see doc/dashboard-notes.md
+function todayStr(){
+	const d = new Date();
+	return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+}
+
+// Never a link into the future — tomorrow has no page yet
+export function day_nav(date){
+	return div.c("flex gap v-center ai-day-nav", () => {
+		a("‹ " + addDays(date, -1)).href(`/framework/ai/${addDays(date, -1)}/`);
+		span.c("muted", date);
+		if (addDays(date, 1) <= todayStr()) a(addDays(date, 1) + " ›").href(`/framework/ai/${addDays(date, 1)}/`);
+	});
+}
+
+// Month view; see doc/dashboard-notes.md for timezone details
+export function monthPage(page, month){
+	const [y, m] = month.split("-").map(Number);
+	const title = new Date(y, m - 1, 1).toLocaleDateString(undefined, { month: "long", year: "numeric" });
+	const daysInMonth = new Date(y, m, 0).getDate();   // day 0 of next month = this month's last day
+	div.c("flex v gap", $m => {
+		p.c("doc-title h2", title);
+		$m.append(async () => {
+			const days = Array.from({ length: daysInMonth }, (_, i) => `${month}-${String(i + 1).padStart(2, "0")}`);
+			const spends = (await Promise.all(days.map(d =>
+				fetch(`/framework/ai/${d}/spend.json`).then(r => r.ok ? r.json() : null).catch(() => null)))).filter(Boolean);
+			if (!spends.length) return void p.c("muted", "No day in this month has computed spend yet — node Server/day-spend.mjs <date> per day.");
+			const claude_usd = spends.reduce((s, d) => s + (d.claude_usd ?? 0), 0);
+			const real_usd = spends.reduce((s, d) => s + (d.real_usd ?? 0), 0);
+			div.c("flex gap wrap", () => {
+				span(() => { span.c("muted", "Claude $ "); span("$" + claude_usd.toFixed(2)); });
+				span(() => { span.c("muted", "real $ (OpenRouter etc.) "); span("$" + real_usd.toFixed(2)); });
+			}).style("--gap", "1.5em");
+			p.c("muted", `${spends.length} of ${days.length} day(s) this month computed so far.`);
+		});
+	});
+}
+
+export function daySystemPage(page){
+	const date = page.url.split("/").filter(Boolean).at(-2);
+	day_nav(date);
+	prompts_section(date, "system");
+}
+
+/* A day's own tasks. No usage meters here — the ai index is always this page's
+   ancestor, so its rail is already showing them beside this. Every task.jsonl
+   here streams: an append redraws the groups, so a task that lands moves out of
+   Active without a reload. */
+export function dashboard(page){
+	const date = page.url.split("/").filter(Boolean).at(-1);
+	warm(date);   // route()'s has_page_js, warmed now so a click into a task already has the answer
+	// Opening the day marks its pinned "Today"/"Yesterday" row read (rail.js's own
+	// `is_read`/`mark_read`, the same per-browser flag every other row already uses) —
+	// harmless for a day with no pinned row at all.
+	mark_read("day-" + date);
+
+	day_nav(date);
+
+	p.c("muted", () => a("See this day as a tree: what ran together, what waited →").attr("href", `/framework/ai/AITask/tree/?date=${date}`));
+
+	spend_summary(date);
+	module_list(date);
+
+	prompts_section(date, "time");
+
+	// ⚠ `wide` not `bleed` — bleed spends the page's two gutter tracks
+	const $board = div.c("ai-dashboard flex v gap wide", async $d => {
+		let rows;
+		const redraw = () => rows && $d.empty(() => groups(rows));
+		rows = await tasks(page, redraw);
+		$d.append(() => groups(rows));
+
+		on_directory(page, $d, async () => { rows = await tasks(page, redraw); redraw(); });
+	});
+
+	timeline(date);
+	return $board;
+}
+
+const strip = rows => {
+	const live = rows.filter(running);
+	return live.length ? group("Active", live, dated) : p.c("muted", "Nothing running right now.");
+};
+
+// What is running right now, above everything else
+export function active_strip(list){
+	return div.c("ai-active", async $a => {
+		let rows;
+		const redraw = () => rows && $a.empty(() => strip(rows));
+		rows = await Promise.all(list.filter(running)
+			.map(t => load(t.url, t.name, t.files, null, null, redraw)));
+		$a.append(() => strip(rows));
+	});
+}
+
+// ⚠ Returns synchronously (catalog needs no await); fills inside a callback
+// The ai index: running now, usage, then HIGHLIGHTS — newest first
+// see doc/dashboard-notes.md for archive rationale
+function merge_usage(claude, openrouter){
+	const limits = [...(claude?.utilization?.limits ?? []), ...(openrouter?.utilization?.limits ?? [])];
+	return limits.length ? { utilization: { limits } } : null;
+}
+
+export function rail(page){
+	return div.c("ai-index-rail flow", async $r => {
+		let [usage, or_usage, list] = await Promise.all(
+			[json("/framework/ai/usage.json"), json("/framework/ai/openrouter-usage.json"), all_tasks()]);
+
+		const draw = () => $r.empty(() => {
+			// ⚠ Blocker items first: they stop whole threads until the owner acts
+			needs_strip(needs_all(list));
+			active_strip(list);
+			// Dollar figures from raw limit, ride as label override
+			const or_week = or_usage?.utilization?.limits?.find(l => l.kind === "openrouter_weekly");
+			const money = v => typeof v === "number" ? "$" + v.toFixed(2) : "?";
+			usage_rail(merge_usage(usage, or_usage), or_week ? {
+				openrouter_weekly: `OpenRouter — this week, ${money(or_week.usage_weekly)} of ${money(or_week.cap)} (${money(or_week.monthly)}/month)`
+			} : undefined);
+			highlights(list);
+			div.c("ai-out", () => {
+				span.c("muted", "Every task of every day, newest first — ");
+				a.c("ai-link", "the whole log").href("/framework/ai/log/");
+			});
+
+			// ⚠ Mark links inside draw() because cold deep links missed the mark pass
+			page?.app?.router?.mark_links();
+		});
+
+		draw();
+
+		on_directory(page, $r, async () => { list = await all_tasks(); draw(); });
+	});
+}
+
+const PAGE = 40;   // roughly two screens at 1920
+
+// `shown` lives in closure; re-sorts through dated()
+function paged(rows){
+	const sorted = [...rows].sort(newest);
+	let shown = PAGE;
+
+	return div.c("ai-paged", $p => {
+		const draw = () => $p.empty(() => {
+			dated(sorted.slice(0, shown));
+			if (sorted.length > shown) more(PAGE, sorted.length - shown, () => { shown += PAGE; draw(); });
+			else div.c("muted", `All ${sorted.length} tasks.`);
+		});
+
+		draw();
+	});
+}
+
+// Everything in-flight first, then newest first, PAGE at a time
+export function log_board(page){
+	// ⚠ `wide` not `bleed` — bleed spends the page's two gutter tracks
+	return div.c("ai-all flow wide", async $l => {
+		const list = await all_tasks();
+		$l.append(() => {
+			active_strip(list);
+			compose(efforts(list));
+			paged(list.filter(t => !running(t)));
+		});
+
+		page?.app?.router?.mark_links();
+	});
+}
+
+// The same spine, filtered to one effort
+export function effort_board(page, slug){
+	return div.c("ai-effort", async $e => {
+		const list = (await all_tasks()).filter(t => t.m?.group === slug);
+
+		$e.append(() => {
+			if (!list.length) return void p.c("muted", "No task claims this effort — a task joins one by naming it as `group` in its log.");
+			total_line(list, "on this effort, every day");
+			dated(list);
+		});
+
+		page?.app?.router?.mark_links();
+	});
+}
+
+export function glance(page){
+	return div.c("ai-glance flex v gap", async $g => {
+		const known = (await tasks(page)).filter(t => t.m || t.files.includes("requirements.md"));
+		const counts = tally(known);
+
+		$g.append(() => known.length
+			? div.c("flex gap wrap v-center", () => ["live", "landed", "idea"].forEach(k => counts[k] &&
+				div.c("flex gap v-center", () => { span.c("ai-dot").ac(k !== "landed" && k); span.c("muted", counts[k] + " " + k); })))
+			: span.c("muted", "no tasks yet"));
+	});
+}
+
+export default dashboard;
diff --git a/public/framework/ai/AITask/day-prompts.js b/public/framework/ai/AITask/day-prompts.js
new file mode 100644
index 000000000..4c566b4f4
--- /dev/null
+++ b/public/framework/ai/AITask/day-prompts.js
@@ -0,0 +1,186 @@
+import { div, p, span, a, small, h3, button } from "../../core/View/View.js";
+import { GLOSSARY } from "../../ext/Refine/engine.js";
+import { mentions } from "../../ext/Mention/Mention.js";
+
+// History and reasons: doc/day-prompts-notes.md
+// Day page shows owner's own words, refined (Echo.js pipeline, law 7)
+
+const json = url => fetch(url)
+	.then(res => res.ok && !res.headers.get("content-type")?.includes("html") ? res.json() : null)
+	.catch(() => null);
+
+function sessionDirs(dir, date){
+	const [y, m, d] = date.split("-");
+	return (dir?.find(x => x.name === y)?.children ?? [])
+		.find(x => x.name === m)?.children?.find(x => x.name === d)?.children
+		?.filter(c => c.name.startsWith("session-")).map(c => `/framework/ai/${y}/${m}/${d}/${c.name}/`) ?? [];
+}
+
+// Y -> M -> D -> session walk (duplicated from dashboard.js to avoid circular imports)
+async function sessionsFor(date){
+	const dir = await json("/framework/directory.json");
+	const ai = dir?.files?.find(f => f.name === "ai")?.children ?? [];
+	return sessionDirs(ai, date);
+}
+
+// Reason: search yesterday too (sessions can log prompts after midnight); filter by ts. See doc/day-prompts-notes.md.
+function prevDay(date){
+	const [y, m, d] = date.split("-").map(Number);
+	const dt = new Date(Date.UTC(y, m - 1, d));
+	dt.setUTCDate(dt.getUTCDate() - 1);
+	return dt.toISOString().slice(0, 10);
+}
+
+// Reads every Prompt item + its deltas; handles both old & new wire shapes (See doc/day-prompts-notes.md)
+async function readPrompts(url){
+	const res = await fetch(url + "page.jsonl").catch(() => null);
+	if (!res?.ok) return [];
+	const text = await res.text();
+	const byId = new Map(), order = [];
+	for (const raw of text.split(/\r?\n/)){
+		if (!raw.trim()) continue;
+		let line; try { line = JSON.parse(raw); } catch { continue; }
+		const add = line.at === "content" ? line.add : line.content?.add;
+		if (add?.type === "Prompt"){ byId.set(add.id, { ...add, url }); order.push(add.id); continue; }
+		for (const id of Object.keys(line)) if (byId.has(id)) Object.assign(byId.get(id), line[id]);
+	}
+	return order.map(id => byId.get(id)).filter(it => it.by === "owner");
+}
+
+/** Every owner prompt said on `date` (YYYY-MM-DD) by `ts`, oldest first, with Echo's refinement data.
+    Returns `refined: false` for prompts not yet refined, so the page shows them. */
+export async function dayPrompts(date){
+	const urls = new Set([...(await sessionsFor(prevDay(date))), ...(await sessionsFor(date))]);
+	const items = (await Promise.all([...urls].map(readPrompts))).flat();
+	return items
+		.filter(it => typeof it.ts === "string" && it.ts.startsWith(date))
+		.map(it => ({ ...it, refined: Array.isArray(it.sentences) && it.sentences.length > 0 }))
+		.sort((a, b) => Date.parse(a.ts) - Date.parse(b.ts));
+}
+
+const time = ts => new Date(ts).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
+const shortId = id => String(id ?? "").slice(0, 8);
+
+// Renders sections/sentences/preview; mentions() turns #/@ and / into links (no new model calls)
+function bullet(text){ return mentions(p.c("day-prompt-bullet").text(text).el); }
+function promptBody(it){
+	if (it.sections?.length) return div.c("flow", () => it.sections.forEach(s => {
+		if (s.heading) h3.c("day-prompt-heading", s.heading);
+		s.items.forEach(b => bullet(b.text));
+	}));
+	if (it.sentences?.length) return bullet(it.sentences.map(s => s.text).join(" "));
+	return p.c("muted", (it.text ?? "").slice(0, 200) + ((it.text ?? "").length > 200 ? "…" : "") + " — not refined yet");
+}
+
+/** Low-confidence sentences (< 0.6): coverage.confidence (placement) and flags (wording).
+    See doc/day-prompts-notes.md for what each measures. Silent if none. */
+function checkThese(prompts){
+	const rows = prompts.map(it => {
+		const low = Object.entries(it.coverage?.confidence ?? {}).filter(([, c]) => c < 0.6);
+		return { it, low, flags: it.flags ?? [] };
+	}).filter(r => r.low.length || r.flags.length);
+	if (!rows.length) return null;
+	return div.c("day-check-these flow", () => {
+		h3("Check these — low confidence");
+		rows.forEach(({ it, low, flags }) => div.c("flex v", () => {
+			a(`${time(it.ts)} —`).href(it.url).ac("muted");
+			low.forEach(([n, c]) => p.c("muted", `S${n}: not clearly placed under one heading (confidence ${c})`));
+			flags.forEach(f => p.c("muted", `S${f.sentence_n}: ${f.question} (wording confidence ${f.confidence})`));
+		}));
+	});
+}
+
+// Dominant topic per prompt (reused GLOSSARY, not a second idea: law 6); context marker only
+function topicOf(it){
+	const text = (it.sections?.length ? it.sections.flatMap(s => s.items.map(i => i.text)) : (it.sentences ?? []).map(s => s.text)).join(" ");
+	return text ? bucketOf(text) : null;
+}
+
+/** BY TIME: one row per prompt at its ts, topic markers between switches, fold/unfold per prompt.
+    See doc/day-prompts-notes.md for toggle and marker behavior. */
+function byTime(prompts){
+	if (!prompts.length) return p.c("muted", "No prompts logged for this day yet.");
+	const seen = new Set();
+	let last = null;
+	return div.c("day-prompts flow", $t => {
+		prompts.forEach(it => {
+			const topic = topicOf(it);
+			if (topic && topic !== last){
+				p.c("muted day-topic-marker", seen.has(topic) ? `← back to ${topic}` : `→ ${topic}`);
+				seen.add(topic);
+				last = topic;
+			}
+			div.c("day-prompt flex v gap-25", () => {
+				div.c("flex gap v-center", () => {
+					a.c("muted").href(it.url).text(time(it.ts));
+					small.c("muted", "#" + shortId(it.id));
+				});
+				promptBody(it);
+			});
+		});
+		// Show/hide bullets after first (no refetch, instant toggle)
+		$t.toggle_condensed = on => $t.el.querySelectorAll(".day-prompt").forEach(row =>
+			row.querySelectorAll(".day-prompt-bullet").forEach((b, i) => { b.style.display = on && i > 0 ? "none" : ""; }));
+	});
+}
+
+// BY SYSTEM: bucket by GLOSSARY name (reused from engine.js, law 6); biggest first, "General" last
+function bucketOf(text){
+	const low = String(text).toLowerCase();
+	for (const name of GLOSSARY) if (low.includes(name.toLowerCase())) return name;
+	return "General";
+}
+function bySystem(prompts){
+	if (!prompts.length) return p.c("muted", "No prompts logged for this day yet.");
+	const buckets = new Map();
+	for (const it of prompts){
+		const points = it.sections?.length ? it.sections.flatMap(s => s.items) :
+			(it.sentences ?? []).map(s => ({ text: s.text }));
+		for (const pt of points){
+			const key = bucketOf(pt.text);
+			if (!buckets.has(key)) buckets.set(key, []);
+			buckets.get(key).push({ ...pt, at: it.ts, url: it.url });
+		}
+	}
+	const sorted = [...buckets.entries()].sort((a, b) => b[1].length - a[1].length);
+	if (!sorted.length) return p.c("muted", "Nothing refined yet to group by system.");
+	return div.c("day-by-system flow", () => sorted.forEach(([name, points]) => div.c("flow", () => {
+		h3(`${name} — ${points.length}`);
+		points.forEach(pt => div.c("flex gap v-center", () => {
+			small.c("muted").text(time(pt.at));
+			p(pt.text);
+		}));
+	})));
+}
+
+/** Section showing prompts; `view` is "time" (default) or "system", each its own url. */
+export function prompts_section(date, view = "time"){
+	// Fetch before draw to avoid DOM-after-await bug; see doc/day-prompts-notes.md
+	return div.c("day-prompts-section flow", async $s => {
+		div.c("flex gap wrap v-center", () => {
+			h3("Your prompts, refined");
+			span.c("muted", "— ");
+			a("by time").ac(view === "system" && "muted").href(`/framework/ai/${date}/`);
+			span("·");
+			a("by system").ac(view === "time" && "muted").href(`/framework/ai/${date}/by-system/`);
+			// Condense button for time view only (stripped button, no extra CSS class)
+			if (view === "time"){
+				span("·");
+				let condensed = false;
+				const $btn = button.c("muted").attr("type", "button").text("condense")
+					.style({ border: "none", background: "none", padding: "0", font: "inherit", color: "inherit", textDecoration: "underline", cursor: "pointer" })
+					.click(() => { condensed = !condensed; $btn.text(condensed ? "show detail" : "condense"); $list?.toggle_condensed?.(condensed); });
+			}
+		});
+		let $list;
+		const prompts = await dayPrompts(date);
+		$s.append(() => {
+			const unrefined = prompts.filter(it => !it.refined).length;
+			if (unrefined) p.c("muted", `${unrefined} of ${prompts.length} not refined yet — node Server/day-prompts-refine.mjs ${date}`);
+			$list = (view === "system" ? bySystem : byTime)(prompts);
+			checkThese(prompts);
+		});
+	});
+}
+
+export default prompts_section;

diff --git a/Servex/agents/page_tools.js b/Servex/agents/page_tools.js
index e71de6d20..e34717b1b 100644
--- a/Servex/agents/page_tools.js
+++ b/Servex/agents/page_tools.js
@@ -582,6 +582,8 @@ export async function run_item({ path: url, target, delta } = {}, ctx = {}, alia
 	if (delta === undefined) return { ok: true, ...(await extra()), ...(alias ? { state: state() } : {}) };
 	if (!is_plain(delta)) return { ok: false, why: "`delta` must be one object (a log line)" };
 	const flat = expand_dots(delta);
+	// A verdict verb given as a bare note ({"approve":"ok"}) would be written but ignored on replay (Task.replay_line reads verbs as objects): make it {note}.
+	for (const v of ["approve", "improve", "reject"]) if (typeof flat[v] === "string") flat[v] = { note: flat[v] };
 	if (Object.keys(flat).length === 1 && flat.help){
 		told.set(`${ctx.caller}|${kind}`, true);
 		return { ok: true, instructions: await instructions_for(kind, Class) };
diff --git a/Servex/agents/verb-note.test.mjs b/Servex/agents/verb-note.test.mjs
new file mode 100644
index 000000000..fe5d15f41
--- /dev/null
+++ b/Servex/agents/verb-note.test.mjs
@@ -0,0 +1,23 @@
+/* node Servex/agents/verb-note.test.mjs — {"approve":"note"} through the item tool is written as {note} and takes effect (core/Task/doc/templates.md). */
+import assert from "node:assert";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { run_item } from "./page_tools.js";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..", "..");
+const REL = "public/framework/ai/sessions/2026/10/16/.verb-note-test-" + process.pid;
+const DIR = path.join(ROOT, REL), FILE = path.join(DIR, "task.jsonl"), URL = "/" + REL.slice("public/".length) + "/";
+const call = delta => run_item({ path: URL, delta }, { caller: "t1" });
+
+fs.mkdirSync(DIR, { recursive: true });
+fs.writeFileSync(FILE, JSON.stringify({ assign: { slug: "fixture", title: "Fixture" } }) + "\n");
+try {
+	await call({ wait: { on: "mastermind", what: "plan review" } });
+	const r = await call({ approve: "looks good" });
+	const last = fs.readFileSync(FILE, "utf8").trim().split("\n").map(l => JSON.parse(l)).filter(l => l.approve).at(-1);
+	assert.equal(last.approve.note, "looks good", "a string approve is written as {note}");
+	assert.equal(r.state.state, "running", "and it takes effect: waiting -> running");
+	console.log("verb-note.test.mjs: all checks passed");
+} finally { fs.rmSync(DIR, { recursive: true, force: true }); }
+process.exit(0);

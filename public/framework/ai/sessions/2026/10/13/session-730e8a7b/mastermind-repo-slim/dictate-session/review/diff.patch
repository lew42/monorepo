+/* ux/Dictate/MicIndicator — hidden until the mic is open (`.open`, set from Dictate.js). */
+@layer base, theme, site, util;
+@layer theme {
+	.ux-dictate-mic-indicator { display: none; align-items: center; gap: 0.5em; font-size: 0.85em; }
+	.ux-dictate-mic-indicator.open { display: flex; }
+	.ux-dictate-mic-indicator-dot { inline-size: 0.6em; block-size: 0.6em; border-radius: 50%; background: var(--error); flex: none;
+		animation: ux-dictate-mic-pulse 1.2s ease-in-out infinite; }
+	.ux-dictate-mic-indicator-bar { flex: 1; min-inline-size: 4em; block-size: 0.35em; border-radius: 1em; background: color-mix(in srgb, currentColor 15%, transparent); overflow: hidden; }
+	.ux-dictate-mic-indicator-fill { inline-size: 100%; block-size: 100%; background: var(--error); transform-origin: left; transform: scaleX(var(--ux-dictate-mic-level, 0)); transition: transform 90ms linear; }
+	.ux-dictate-mic-indicator.compact { position: absolute; inset-block-start: 0.1em; inset-inline-end: 0.1em; pointer-events: none; }
+	@keyframes ux-dictate-mic-pulse { 50% { opacity: 0.35; } }
+}
diff --git a/public/framework/ux/Dictate/MicIndicator.js b/public/framework/ux/Dictate/MicIndicator.js
new file mode 100644
index 000000000..99d30b1aa
--- /dev/null
+++ b/public/framework/ux/Dictate/MicIndicator.js
@@ -0,0 +1,49 @@
+import { View, div, span } from "../../core/View/View.js";
+
+View.stylesheet(import.meta, "MicIndicator.css");
+
+/** The one "the mic is open" indicator: a red dot, the word "listening" and a level bar. Every mic
+ *  surface shows this same class (chat composer in the sheet and the drawer, the floating mic); the
+ *  `compact` variant is the dot alone, for a collapsed tab or button. State is global, set by
+ *  `Dictate.js` (`set_open`, `set_level`), so any instance anywhere follows it. Doc: doc/surfaces.md. */
+export default class MicIndicator extends View {
+	static open = false;
+	static level = 0;
+	static views = new Set();
+
+	static set_open(open){
+		if (open === this.open) return;
+		this.open = open;
+		if (!open) this.level = 0;
+		this.views.forEach(v => v.sync());
+	}
+
+	static set_level(level){
+		this.level = level;
+		this.views.forEach(v => v.paint());
+	}
+
+	render(){
+		this.ac("ux-dictate-mic-indicator" + (this.compact ? " compact" : ""));
+		this.attr("role", "status").attr("aria-label", "Microphone open — listening");
+		div.c("ux-dictate-mic-indicator-dot");
+		if (!this.compact){
+			span.c("ux-dictate-mic-indicator-label", "listening");
+			div.c("ux-dictate-mic-indicator-bar", () => { this.$fill = div.c("ux-dictate-mic-indicator-fill"); });
+		}
+		this.born = performance.now();
+		MicIndicator.views.add(this);
+		this.sync();
+	}
+
+	sync(){
+		if (this.el.isConnected) this.seen = true;
+		else if (this.seen || performance.now() - this.born > 2000){ MicIndicator.views.delete(this); return; }   // gone, or never mounted
+		this.el.classList.toggle("open", MicIndicator.open);
+		this.paint();
+	}
+
+	paint(){
+		this.$fill?.style("--ux-dictate-mic-level", Math.min(1, MicIndicator.level).toFixed(3));
+	}
+}

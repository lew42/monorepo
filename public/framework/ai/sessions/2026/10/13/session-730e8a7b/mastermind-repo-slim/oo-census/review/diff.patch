+		row_span: { names: ["1", "2", "3"], cols: 3, modes: ["grid"], var: "--item-row-span", css: PanelGlyphs.SPAN_CSS, default: "1" },
+		self:     { names: ["auto", "start", "center", "end", "stretch"], cols: 5, modes: ["flex", "grid"], var: "--item-self", default: "auto" },
+	};

diff --git a/public/framework/ai/sessions/2026/09/24/cards/prompt-mechanics-2/curated-chat-bubbles-from-raw-dictation/page.jsonl b/public/framework/ai/sessions/2026/09/24/cards/prompt-mechanics-2/curated-chat-bubbles-from-raw-dictation/page.jsonl

+{"prompt":{"id":"p-mugbdp9q2i","at":"2026-09-24T21:00:54-05:00","by":"owner","on":"2026/09/24/cards-content","raw":"Why is this card full width and some of the others are not?","text":"Why is this card full width and some of the others are not?","via":"whisper","url":"/framework/ai2/2026/09/24/cards-content/"}}

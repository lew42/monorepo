diff --git a/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.css b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.css
new file mode 100644
index 000000000..c632f89b8
--- /dev/null
+++ b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.css
@@ -0,0 +1,140 @@
+/* Card 6 — UI Controls. A scaled recreation, not a reflowed one — see the note
+   at the top of view.js. Every number below is `em`, converted from the
+   Figma's own pixels at its 856px canvas (16px = 1em there), so
+   `ui-scale-body`'s own font-size (from `ui/scale`, set from the container's
+   width) carries every size in this file down or up together. Every class
+   carries this card's own `figma-ctrl-` prefix (review finding 1). */
+@layer site {
+
+	.figma-ctrl-panel {
+		border-radius: 0.5em;
+		padding: 2.25em 2em;   /* 36px / 32px at the Figma's own width */
+		display: flex;
+		flex-direction: column;
+		gap: 3.4em;   /* ~1.5x the section padding, more air between groups */
+	}
+
+	.figma-ctrl-title { font-size: 1.5em; font-weight: 600; }
+
+	.figma-ctrl-section { display: flex; flex-direction: column; gap: 0.9em; }
+
+	.figma-ctrl-group-title {
+		font-size: 0.7em;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.05em;
+		color: var(--subtle);
+	}
+
+	/* ── toggles — fine as they were, now scaled by the panel's own em ───────── */
+	.figma-ctrl-toggles { display: flex; flex-direction: column; gap: 0.9em; }
+
+	.figma-ctrl-toggle { display: flex; align-items: center; gap: 0.7em; cursor: pointer; }
+
+	.figma-ctrl-toggle-input {
+		position: absolute;
+		width: 1px; height: 1px;
+		opacity: 0;
+		pointer-events: none;
+	}
+
+	.figma-ctrl-toggle-track {
+		position: relative;
+		display: inline-block;
+		width: 2.4em; height: 1.3em;
+		border-radius: 999px;
+		background: var(--darken-1);
+		transition: background 0.15s;
+		flex-shrink: 0;
+	}
+
+	.figma-ctrl-toggle-track::before {
+		content: "";
+		position: absolute;
+		top: 0.15em; left: 0.15em;
+		width: 1em; height: 1em;
+		border-radius: 50%;
+		background: var(--surface);
+		transition: transform 0.15s;
+	}
+
+	.figma-ctrl-toggle-input:checked + .figma-ctrl-toggle-track { background: var(--prim); }
+	.figma-ctrl-toggle-input:checked + .figma-ctrl-toggle-track::before { transform: translateX(1.1em); }
+	.figma-ctrl-toggle-input:focus-visible + .figma-ctrl-toggle-track { outline: 2px solid var(--prim); outline-offset: 2px; }
+
+	/* ── chips — accent-filled vs a light box with a thin border, both small caps ── */
+	.figma-ctrl-chips { display: flex; flex-wrap: wrap; gap: 0.5em; }
+
+	.figma-ctrl-chip {
+		font-size: 0.7em;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.03em;
+		padding: 0.4em 0.9em;
+		border-radius: 999px;
+		background: var(--wash);
+		border: 1px solid var(--line);
+	}
+
+	.figma-ctrl-chip.accent { background: var(--prim); color: var(--surface); border-color: transparent; }
+
+	/* ── progress — a thin light track, three titled groups (one plain, one dark,
+	   one light), each square-ish with ~32px (2em) padding ────────────────────── */
+	.figma-ctrl-progress-section { gap: 0.9em; }
+
+	.figma-ctrl-progress-group { display: flex; flex-direction: column; gap: 0.9em; }
+	.figma-ctrl-progress-group.dark, .figma-ctrl-progress-group.light { padding: 2em; border-radius: 0.5em; }
+	.figma-ctrl-progress-group.dark { background: var(--darken-2); }
+	.figma-ctrl-progress-group.light { background: var(--surface); }   /* near-white, clearly lighter than the panel */
+
+	/* Sentence case, semibold, ~h3 size — not the small uppercase group label. */
+	.figma-ctrl-progress-title { font-size: 1.4em; font-weight: 600; }
+
+	.figma-ctrl-bar { display: flex; flex-direction: column; gap: 0.5em; }
+
+	.figma-ctrl-bar-row {
+		display: flex;
+		justify-content: space-between;
+		font-size: 0.7em;
+		font-weight: 700;
+		text-transform: uppercase;
+		letter-spacing: 0.03em;
+		color: var(--subtle);
+	}
+
+	.figma-ctrl-bar-track {
+		width: 100%;
+		height: 0.375em;   /* 6px at the Figma's own width */
+		border-radius: 999px;
+		background: var(--darken-1);
+		overflow: hidden;
+	}
+
+	.figma-ctrl-bar-fill { height: 100%; border-radius: 999px; background: var(--prim); }
+
+	/* ── badges — compact light boxes, a small square accent count ───────────── */
+	.figma-ctrl-badges { display: flex; flex-wrap: wrap; gap: 0.6em; }
+
+	.figma-ctrl-badge {
+		display: flex;
+		align-items: center;
+		gap: 0.6em;
+		background: var(--wash);
+		border-radius: 0.4em;
+		padding: 0.6em 0.8em;
+		font-size: 0.9em;
+	}
+
+	.figma-ctrl-count {
+		display: inline-flex;
+		align-items: center;
+		justify-content: center;
+		min-width: 1.5em;
+		padding: 0.15em 0.4em;
+		border-radius: 0.3em;
+		background: var(--prim);
+		color: var(--surface);
+		font-size: 0.75em;
+		font-weight: 700;
+	}
+}
diff --git a/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.js b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.js
new file mode 100644
index 000000000..e63429a97
--- /dev/null
+++ b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/6-ui-controls/view.js
@@ -0,0 +1,100 @@
+import { View, div, span, label, input } from "/app.js";
+import { compare } from "../compare.js";
+import "/framework/ui/scale/scale.js";
+
+// Recreation of the Figma section "UI Controls" — four little galleries: toggles,
+// chips, three separately-boxed "Progress & Sliders" groups (metadata.xml really
+// has three, each with its own heading — plain, then darken-2, then a lighter
+// fill), and counter badges.
+//
+// SCALES, does not reflow (mastermind correction, 2026-09-28, same as card 5),
+// via the shared `ui/scale` component (review finding 8): `ui-scale`'s own
+// font-size is set from its own width (16px at the Figma's real 856px), and
+// every padding, gap, radius and font-size below it is `em` — none of the
+// site's own type scale or --gap/--pad tokens, which are viewport- not
+// container-relative. See `ui-reuse.md` beside the task brief for why these
+// controls are hand-built rather than `ui/badge`/`ui/progress` (review finding 2).
+View.stylesheet(import.meta, "view.css");
+
+const TOGGLES = [
+	["Dark mode", true],
+	["Notifications", false],
+	["Auto-save", true],
+];
+
+const CHIPS = [
+	["Design", true], ["Tokens", false], ["Variables", true],
+	["Themes", false], ["Mobile", false], ["Adaptive", true],
+];
+
+const BARS = [["Upload", 72], ["Processing", 45]];
+
+const BADGES = [["Inbox", 12], ["Updates", 3], ["Tasks", 28]];
+
+// One toggle: a real checkbox (so it actually flips on a click) hidden under a
+// styled track. `label` already puts a click on the whole row onto the input.
+const toggle = (text, checked) => label.c("figma-ctrl-toggle", () => {
+	const box = input().attr("type", "checkbox").ac("figma-ctrl-toggle-input");
+	if (checked) box.attr("checked", "");
+	span.c("figma-ctrl-toggle-track");
+	span(text);
+});
+
+// One progress row: a label + its percent on one line, then a thin track with a
+// fill sized by the percent.
+const bar = (text, pct) => div.c("figma-ctrl-bar", () => {
+	div.c("figma-ctrl-bar-row", () => {
+		span(text);
+		span(pct + "%");
+	});
+	div.c("figma-ctrl-bar-track", () => div.c("figma-ctrl-bar-fill").style("width", pct + "%"));
+});
+
+// The two BOXED "Progress & Sliders" groups (one darker, one lighter) — each
+// gets its own sentence-case heading, unlike the section's own small uppercase
+// label above the first, plain group.
+const progress_group = extra => div.c("figma-ctrl-progress-group " + extra, () => {
+	div.c("figma-ctrl-progress-title", "Progress & Sliders");
+	BARS.forEach(([text, pct]) => bar(text, pct));
+});
+
+export default class Default extends View {
+
+	render(){
+		div.c("ui-scale", () => {
+			div.c("ui-scale-body figma-ctrl-panel darken-1", () => {
+
+				div.c("figma-ctrl-title", "UI Controls");
+
+				div.c("figma-ctrl-section", () => {
+					div.c("figma-ctrl-group-title", "Toggles");
+					div.c("figma-ctrl-toggles", () => TOGGLES.forEach(([text, on]) => toggle(text, on)));
+				});
+
+				div.c("figma-ctrl-section", () => {
+					div.c("figma-ctrl-group-title", "Tags & Chips");
+					div.c("figma-ctrl-chips", () => CHIPS.forEach(([text, accent]) =>
+						span.c("figma-ctrl-chip" + (accent ? " accent" : ""), text)));
+				});
+
+				div.c("figma-ctrl-section figma-ctrl-progress-section", () => {
+					div.c("figma-ctrl-group-title", "Progress & Sliders");
+					BARS.forEach(([text, pct]) => bar(text, pct));
+					progress_group("dark");
+					progress_group("light");
+				});
+
+				div.c("figma-ctrl-section", () => {
+					div.c("figma-ctrl-group-title", "Badges & Counters");
+					div.c("figma-ctrl-badges", () => BADGES.forEach(([text, count]) =>
+						div.c("figma-ctrl-badge", () => {
+							span(text);
+							span.c("figma-ctrl-count", String(count));
+						})));
+				});
+			});
+		}).style("--scale-width", "53.5");
+
+		compare(new URL("figma.png", import.meta.url).href, "Figma: UI Controls section");
+	}
+}
diff --git a/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/7-task-management-ai-patterns/ai.css b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/7-task-management-ai-patterns/ai.css
new file mode 100644
index 000000000..72a0eaf55
--- /dev/null
+++ b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/7-task-management-ai-patterns/ai.css
@@ -0,0 +1,354 @@
+@layer site {
+
+	/* Figma "AI feedback patterns" (78:13866) — the bottom band of section 7:
+	   the compact/expanded composer pair, then a full conversation with code
+	   blocks and a reply composer at the bottom. Every colour, avatar shape
+	   and button style below was checked against sections/7-task-management-
+	   ai-patterns.png by the mastermind and corrected once already
+	   (2026-09-28) — see that round's report in the task log before changing
+	   any of it again. */
+
+	/* SCALE, DON'T REFLOW: the card column is ~400px at 1920, half the
+	   Figma frame's 856px — too narrow for the compact/expanded pair to sit
+	   side by side at the site's own spacing. So this band keeps Figma's
+	   exact layout and just shrinks it, via the shared `ui/scale` component
+	   (review finding 8): `ui-scale` opens the container-query context,
+	   `ui-scale-body`'s font-size is that width ÷ 53.5 (856px ÷ 16px, so
+	   1em = 16px at the Figma's own size and less below it), and every
+	   length inside this band — padding, gap, radius, avatar size, border —
+	   is written in `em`, always relative to an element's own font-size.
+	   Shrink the one variable and the whole panel shrinks together, same
+	   proportions Figma drew. `--gap`/`--pad`/`--flow` are the site's
+	   page-rhythm tokens, tuned for a full page width, not a 400px card —
+	   overridden here to plain `em` so every `gap`/`pad` class already in
+	   ai.js becomes scale-safe for free. */
+	.figma-ai-band {
+		--gap: 1em;
+		--pad: 2em;
+		--flow: 1.5em;
+		/* No status-green in framework.css (`ui/badge`'s own doc calls this
+		   "a third done") — defined locally, light-dark aware like the
+		   site's own tokens, used only inside this band. */
+		--figma-ai-green: light-dark(#1a8a5f, #34d399);
+		--figma-ai-green-bg: light-dark(#e3f6ec, #113826);
+		background: var(--darken-1);
+		border-radius: var(--radius);
+		padding: 2.25em 2em;   /* Figma's pad-y 36 / pad-x 32, at 16px = 1em */
+	}
+
+	/* ── chips: three different shapes, not one reused three ways ── */
+
+	.figma-ai-eyebrow {
+		background: var(--ink);
+		color: var(--prim);
+		font-weight: 700;
+		letter-spacing: 0.05em;
+		border-radius: 0.3em;
+		padding: 0.4em 0.7em;
+	}
+
+	.figma-ai-status {
+		background: var(--prim);
+		color: white;
+		font-weight: 700;
+		border-radius: 999px;
+		padding: 0.3em 0.8em;
+		display: inline-block;
+		/* A flex COLUMN's children stretch to its full width by default
+		   (align-items: stretch) — without this the pill spans the whole
+		   card instead of hugging "In review". */
+		align-self: flex-start;
+	}
+
+	.figma-ai-tests-pass {
+		background: var(--figma-ai-green-bg);
+		color: var(--figma-ai-green);
+		font-weight: 700;
+		border-radius: 999px;
+		padding: 0.3em 0.8em;
+	}
+
+	.figma-ai-state-label {
+		letter-spacing: 0.05em;
+	}
+
+	/* `h4` (framework.css) is bold, tracked AND UPPERCASE — right for the
+	   eyebrow/status chips above, wrong for plain small text like a branch
+	   path or "You · 10:44", which Figma draws in normal case. This is just
+	   `h4`'s font-size, nothing else. */
+	.figma-ai-meta {
+		font-size: 0.8em;
+	}
+
+	/* framework.css has no `.bold` — a component may not invent one either, so
+	   this is scoped to the figures this band actually needs bold. */
+	.figma-ai-strong {
+		font-weight: 600;
+	}
+
+	/* The card column is ~400px at 1920 — a 15em min column never gets two
+	   across. 10em does, and still wraps to one below that. */
+	.figma-ai-states {
+		--column: 10em;
+	}
+
+	/* ── the compact footer example ── */
+
+	.figma-ai-compact-footer {
+		border-top: 1px solid var(--line);
+		margin-top: var(--gap);
+		padding-top: 0.6em;
+	}
+
+	.figma-ai-icon-btn {
+		color: var(--ink);
+		opacity: 0.6;
+		cursor: pointer;
+	}
+
+	.figma-ai-icon-btn:hover {
+		opacity: 1;
+	}
+
+	/* ── the four avatar voices ── */
+
+	.figma-ai-face-ai {
+		background: var(--ink);
+		color: white;
+	}
+
+	.figma-ai-face-bot {
+		background: var(--figma-ai-green);
+		color: white;
+	}
+
+	.figma-ai-face-mate {
+		background: light-dark(#7c5cff, #a78bfa);
+		color: white;
+	}
+
+	.figma-ai-face-you {
+		background: var(--prim);
+		color: white;
+		font-size: 0.6em;   /* "YOU" is three letters, not two initials */
+		font-weight: 700;
+	}
+
+	/* ── the expanded composer, reused for the standalone example AND the
+	   live reply box under the transcript ── */
+
+	.figma-ai-composer {
+		border: 1px solid var(--prim);
+		border-radius: var(--radius);
+		background: var(--surface);
+	}
+
+	.figma-ai-composer textarea {
+		width: 100%;
+		border: none;
+		background: none;
+		resize: none;
+		font: inherit;
+		color: var(--ink);
+		padding: 0;
+		/* `rows="2"` in ai.js reserves the room; this is what actually lets
+		   the placeholder wrap onto that second line instead of clipping. */
+		white-space: pre-wrap;
+		overflow: hidden;
+	}
+
+	.figma-ai-composer textarea:focus {
+		outline: none;
+	}
+
+	.figma-ai-send {
+		width: 2em;
+		height: 2em;
+		border-radius: 0.4em;
+		background: var(--prim);
+		color: white;
+		border: none;
+		display: grid;
+		place-items: center;
+		cursor: pointer;
+		flex: none;
+	}
+
+	.figma-ai-dictate {
+		border-radius: 999px;
+		background: var(--darken-1);
+		color: var(--ink);
+		padding: 0.3em 0.7em;
+		font-weight: 700;
+		text-transform: uppercase;
+		font-size: 0.75em;
+	}
+
+	.figma-ai-new-session {
+		border: 1px solid var(--line);
+		border-radius: 0.35em;
+		width: 1.8em;
+		height: 1.8em;
+		display: grid;
+		place-items: center;
+		background: none;
+		color: var(--ink);
+		cursor: pointer;
+	}
+
+	/* ── the conversation panel ── */
+
+	.figma-ai-conversation {
+		background: var(--surface);
+		border: 1px solid var(--line);
+		border-radius: var(--radius);
+		overflow: hidden;
+	}
+
+	.figma-ai-conv-header {
+		border-bottom: 1px solid var(--line);
+		padding: 0.75em var(--pad);
+	}
+
+	.figma-ai-messages {
+		padding: var(--pad);
+	}
+
+	.figma-ai-message + .figma-ai-message {
+		margin-top: var(--gap);
+	}
+
+	.figma-ai-message > .ui-avatar {
+		flex: none;
+	}
+
+	/* ── the message bubble — a bordered surface, the avatar sits OUTSIDE it
+	   (a "gutter"), not inside — and the two voices get two border colours ── */
+
+	.figma-ai-bubble {
+		flex: 1;
+		min-width: 0;
+		border: 1px solid var(--line);
+		border-radius: var(--radius);
+		background: var(--surface);
+		padding: 1em;
+	}
+
+	.figma-ai-bubble-you {
+		border-color: var(--prim);
+	}
+
+	.figma-ai-action-row {
+		justify-content: flex-end;
+	}
+
+	/* ── action buttons: small, bold, uppercase, right-aligned ── */
+
+	.figma-ai-action {
+		font-weight: 700;
+		text-transform: uppercase;
+		font-size: 0.75em;
+		padding: 0.5em 1em;
+		border-radius: 0.4em;
+	}
+
+	.figma-ai-action.chosen {
+		box-shadow: inset 0 0 0 2px var(--darken-2);
+	}
+
+	.figma-ai-action-prim {
+		background: var(--prim);
+		border-color: var(--prim);
+		color: white;
+	}
+
+	.figma-ai-action-reject {
+		background: none;
+		border-color: var(--error);
+		color: var(--error);
+	}
+
+	.figma-ai-action-approve {
+		background: var(--figma-ai-green);
+		border-color: var(--figma-ai-green);
+		color: white;
+	}
+
+	/* ── an inline code block: a dark header row + a dark body, both the
+	   same near-black fill — the header just one step lighter ── */
+
+	.figma-ai-code {
+		border-radius: var(--radius);
+		overflow: hidden;
+	}
+
+	.figma-ai-code-head {
+		background: color-mix(in srgb, var(--ink) 90%, white);
+		color: var(--surface);
+		padding: 0.5em 0.9em;
+	}
+
+	.figma-ai-code-lang {
+		text-transform: uppercase;
+		letter-spacing: 0.05em;
+		opacity: 0.7;
+	}
+
+	.figma-ai-code pre {
+		margin: 0;
+		padding: 0.9em;
+		overflow-x: auto;
+		background: var(--ink);
+	}
+
+	.figma-ai-code code {
+		background: none;
+		box-shadow: none;
+		color: var(--surface);
+		white-space: pre;
+		font-family: ui-monospace, "SF Mono", Consolas, monospace;
+	}
+
+	.figma-ai-copy {
+		border: none;
+		background: none;
+		color: inherit;
+		cursor: pointer;
+		opacity: 0.85;
+	}
+
+	/* ── a linked reference: underlined bold text with a small check icon,
+	   not a bordered chip (a task chip LOOKS like a link because it is one) ── */
+
+	.figma-ai-task-link {
+		font-weight: 700;
+		text-decoration: underline;
+		color: var(--ink);
+		cursor: pointer;
+	}
+
+	.figma-ai-task-link .icon {
+		color: var(--prim);
+	}
+
+	/* ── the embedded follow-up task card — an accent border, unlike the
+	   grey-bordered bubble it sits inside ── */
+
+	.figma-ai-task-embed {
+		border: 1px solid var(--prim);
+		border-radius: var(--radius);
+		padding: 0.75em;
+	}
+
+	.figma-ai-task-embed a.figma-ai-icon-btn {
+		text-decoration: none;
+	}
+
+	/* ── the reply composer sits in its own grey strip at the panel's foot ── */
+
+	.figma-ai-conv-footer {
+		background: var(--darken-1);
+		border-top: 1px solid var(--line);
+		padding: var(--pad);
+	}
+}
diff --git a/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/7-task-management-ai-patterns/ai.js b/public/framework/ai/sessions/2026/09/28/cards/figma-sept-2026/7-task-management-ai-patterns/ai.js

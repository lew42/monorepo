+		this.dash_built = this.dash.rows;
+		this.dash_items = this.dash.rows.map(r => ({ ...r, dash: true, id: "dash:" + r.id, key: r.id, at: r.when, plain: true, icon: AIRail.ICONS[r.kind], live: DashChips.is_live(r, s) }))

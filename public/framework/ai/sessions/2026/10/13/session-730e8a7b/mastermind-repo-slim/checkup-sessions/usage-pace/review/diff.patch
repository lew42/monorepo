--- /dev/null
+++ b/public/framework/ai/usage/UsagePace.js
@@ -0,0 +1,44 @@
+import { div, span } from "../../core/View/View.js";
+import { pace } from "../AITask/usage.js";
+
+/* Usage against pace, three ways. `ai/AITask/usage.js` (usage_rail) keeps the meter that shows spend with a clock marker;
+ * these variants show spend RELATIVE to the clock, so early in a window (when 3% of the bar is all there is) the answer is still readable.
+ * 100% of pace = exactly on the clock. Doc: readme.md. */
+export default class UsagePace {
+
+	static KINDS = { session: "5-hour session", weekly_all: "weekly, all models", weekly_scoped: "weekly, one model" };
+
+	/* One limit -> the numbers every variant draws. `ratio` is null in the first tenth of a window (noise, same rule as usage_rail). */
+	static of(limit, now = Date.now()){
+		const s = pace(limit, now), at = (s.elapsed ?? 0) * 100;
+		return { label: UsagePace.KINDS[limit.kind] ?? limit.kind, used: limit.percent, at, gap: limit.percent - at,
+			ratio: s.elapsed > 0.1 ? limit.percent / at : null, tone: s.tone, remaining: s.remaining };
+	}
+
+	static words(n){ return n.ratio == null ? "too early to tell" : Math.round(n.ratio * 100) + "% of pace"; }
+
+	/* A: the bar IS used ÷ pace. The middle line is "on pace"; the track is 0–200%. */
+	static ratio(n){
+		return div.c("up-meter", () => {
+			span.c("up-head", () => { span(n.label); span.c("up-num", UsagePace.words(n)); });
+			div.c("up-track up-ratio", () => div.c("up-fill " + n.tone).style("--w", Math.min(100, (n.ratio ?? 0) * 50) + "%"));
+		}).attr("title", `${n.used}% used, ${Math.round(n.at)}% of the window gone`);
+	}
+
+	/* B: the bar is the GAP in points from the clock. Left of the centre = under pace, right = over. The scale zooms to the gap (at least ±10 points). */
+	static gap(n){
+		const range = Math.max(10, Math.abs(n.gap)), w = Math.abs(n.gap) / range * 50;
+		return div.c("up-meter", () => {
+			span.c("up-head", () => { span(n.label); span.c("up-num", (n.gap > 0 ? "+" : "") + Math.round(n.gap) + " points"); });
+			div.c("up-track up-gap", () => div.c("up-fill " + n.tone + (n.gap < 0 ? " under" : " over")).style("--w", w + "%"));
+		}).attr("title", `${n.used}% used, ${Math.round(n.at)}% of the window gone`);
+	}
+
+	/* C: one big word, no bar. */
+	static chip(n){
+		return div.c("up-meter up-chip", () => {
+			span.c("up-head", () => span(n.label));
+			span.c("up-big " + n.tone, UsagePace.words(n));
+		}).attr("title", `${n.used}% used, ${Math.round(n.at)}% of the window gone`);
+	}
+}
diff --git a/public/framework/ai/usage/UsagePage.js b/public/framework/ai/usage/UsagePage.js
new file mode 100644
index 000000000..381723d86
--- /dev/null
+++ b/public/framework/ai/usage/UsagePage.js
@@ -0,0 +1,32 @@
+import { Page, div, p, h2 } from "/app.js";
+import { View } from "../../core/View/View.js";
+import { usage_rail } from "../AITask/usage.js";
+import UsagePace from "./UsagePace.js";
+
+View.stylesheet(import.meta, "usage.css");
+
+/* The existing meter, then three pace-relative variants of the SAME limits, so you compare them on one screen. Doc: readme.md. */
+export default class UsagePage extends Page {
+	static DATA = new URL("../usage.json", import.meta.url);
+
+	content(){
+		const $box = div.c("block wide");   // captured now, filled after the fetch (no DOM after an await)
+		fetch(UsagePage.DATA).then(r => r.json()).catch(() => null).then(u => $box.append(() => {
+			const limits = u?.utilization?.limits;
+			if (!limits?.length) return p("No usage.json yet.");
+			const nums = limits.map(l => UsagePace.of(l));
+			h2("Today's meter (unchanged)");
+			p("The bar is spend; the ▼ is the clock. Early in a window the bar is a few pixels wide, so being ahead or behind is hard to see.");
+			usage_rail(u);
+			h2("A. Used ÷ pace");
+			p("The bar is how far ahead of the clock you are. The line in the middle is on pace; empty is idle, full is double pace.");
+			div.c("up-set", () => nums.forEach(n => UsagePace.ratio(n)));
+			h2("B. The gap from pace");
+			p("The bar grows left of the line when you are under pace and right of it when you are over. Its scale zooms to the gap, so a small gap is still visible.");
+			div.c("up-set", () => nums.forEach(n => UsagePace.gap(n)));
+			h2("C. One word");
+			p("No bar, only the answer.");
+			div.c("up-set", () => nums.forEach(n => UsagePace.chip(n)));
+		}));
+	}
+}

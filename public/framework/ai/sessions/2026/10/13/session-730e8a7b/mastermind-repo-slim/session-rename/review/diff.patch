+		this.store = path.join(this.root, SessionRecord.STORE);
+		this.manifest = path.join(this.root, SessionRecord.MANIFEST);
+	}
+	git(...a){ return execFileSync("git", ["-C", this.root, ...a], { encoding: "utf8", windowsHide: true, maxBuffer: 1 << 28 }); }

+			let first = ""; try { const fd = fs.openSync(f, "r"), b = Buffer.alloc(2048), k = fs.readSync(fd, b, 0, 2048, 0); fs.closeSync(fd); first = b.toString("utf8", 0, k).split("\n", 1)[0]; } catch {}

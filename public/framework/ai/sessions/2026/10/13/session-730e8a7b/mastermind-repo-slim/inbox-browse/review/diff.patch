diff --git a/public/framework/ux/Browse/Browse.css b/public/framework/ux/Browse/Browse.css
new file mode 100644
index 000000000..78822533a
--- /dev/null
+++ b/public/framework/ux/Browse/Browse.css
@@ -0,0 +1,108 @@
+@layer base, theme, site, util;
+
+/* BROWSE — the list-and-detail shell (Browse.js). The shell's grid, the phone rule and the
+   detail's scrolling are ux/Inbox/Inbox.css's `.inbox-shell` rules, which Browse wears too;
+   this file holds what Browse changes: the list's default width, its container, the pins. */
+@layer theme {
+
+	/* A THIRD OF THE SCREEN by default (640px at 1920, 1146px at 3440), never under 20em,
+	   always leaving the detail 28em. The grip's px, once dragged, replaces it (Browse.size()). */
+	.browse.inbox-shell {
+		--inbox-rail: clamp(20em, 33.3vw, 100% - 28em);
+	}
+
+	/* The list is a container, so its rows widen into columns by the LIST's width, not the screen's. */
+	.browse-list {
+		container: browse-list / inline-size;
+	}
+
+	/* ── the pinned lists: a titled box above the rows, one line each ── */
+	.browse-pins:empty { display: none; }
+
+	.browse-pinned {
+		background: var(--surface);
+		border-block-end: 2px solid var(--prime);
+	}
+
+	.browse-pinned-head {
+		display: flex;
+		align-items: center;
+		gap: 0.5em;
+		padding: 0.55em calc(var(--pad-card) + 3px);
+		cursor: pointer;
+		font-weight: 700;
+		list-style-position: inside;
+		/* a heading line, not the theme's button-like summary */
+		inline-size: 100%;
+		box-sizing: border-box;
+		margin: 0;
+		border: 0;
+		border-radius: 0;
+		background: none;
+		box-shadow: none;
+	}
+
+	/* flex drops the disclosure marker; this is it */
+	.browse-pinned-head::before { content: "▸"; font-weight: 400; }
+	.browse-pinned-box[open] > .browse-pinned-head::before { content: "▾"; }
+
+	.browse-pinned-all { margin-inline-start: auto; font-weight: 400; }
+
+	/* A long list scrolls inside itself, so the rows below stay one flick away. */
+	.browse-pinned-rows {
+		max-block-size: 45vh;
+		overflow-y: auto;
+		padding-block-end: 0.3em;
+	}
+
+	.browse-pinned-row {
+		display: flex;
+		align-items: baseline;
+		gap: 0.5em;
+		padding: 0.2em calc(var(--pad-card) + 3px);
+		border-block-start: 1px solid var(--line);
+		font-size: 0.9em;
+	}
+
+	.browse-pinned-row:hover { background: var(--fill-a04); }
+
+	.browse-tick {
+		flex: none;
+		inline-size: 1.5em;
+		block-size: 1.5em;
+		min-block-size: 0;
+		padding: 0;
+		border: 1px solid var(--line);
+		border-radius: var(--radius);
+		background: var(--surface);
+		color: var(--muted, inherit);
+		line-height: 1;
+		cursor: pointer;
+	}
+
+	.browse-tick:hover { border-color: var(--prime); color: var(--prime); }
+
+	/* One line each: the title, then as much of its summary as fits. */
+	.browse-pinned-link {
+		flex: 1 1 auto;
+		min-width: 0;
+		display: flex;
+		align-items: baseline;
+		gap: 0.6em;
+		color: inherit;
+		text-decoration: none;
+		white-space: nowrap;
+		overflow: hidden;
+	}
+
+	.browse-pinned-link.active { color: var(--prime); }
+	.browse-pinned-name { flex: none; max-inline-size: 100%; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
+	.browse-pinned-sub { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+	.browse-pinned-when { flex: none; font-size: 0.85em; }
+
+	/* Narrow: the summary goes, the title keeps the line. */
+	@container browse-list (width < 30em) {
+		.browse-pinned-sub { display: none; }
+		.browse-pinned-name { flex: 1 1 auto; }
+	}
+}

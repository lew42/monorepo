@@ -0,0 +1,16 @@
+import { View, button } from "/app.js";
+import SessionTree from "./SessionTree.js";
+import SessionRow from "./SessionRow.js";
+
+/** OriginChips — one chip per origin with its count and rolled-up cost, plus Live. Picking one writes `?origin=` (none picked = all). */
+export default class OriginChips extends View {
+	get classes(){ return "ad-strip"; }
+
+	render(){
+		const { dash } = this, t = dash.store.tree.totals();
+		button.c("ad-chip" + (!dash.q.origin ? " ad-chip-on" : ""), "All").attr("type", "button").on("click", () => dash.set({ origin: null }));
+		Object.entries(SessionTree.ORIGINS).forEach(([key, o]) => t[key].roots && button.c("ad-chip" + (dash.q.origin === key ? " ad-chip-on" : ""),
+			`${o.icon} ${o.label} ${t[key].roots} · ${SessionRow.usd(t[key].usd)}`).attr("type", "button").attr("title", o.hint).on("click", () => dash.set({ origin: key })));
+		button.c("ad-chip" + (dash.q.live ? " ad-chip-on" : ""), "● Live").attr("type", "button").attr("title", "Working now, or active in the last 10 minutes").on("click", () => dash.set({ live: !dash.q.live }));
+	}
+}
diff --git a/public/framework/ai/AIDashboard/SessionRow.js b/public/framework/ai/AIDashboard/SessionRow.js
new file mode 100644
index 000000000..70537f097
--- /dev/null
+++ b/public/framework/ai/AIDashboard/SessionRow.js
@@ -0,0 +1,31 @@
+import { View, div, span, a, button } from "/app.js";
+import { age } from "/framework/core/Page/ext/Inbox/Inbox.js";
+import { dur } from "/framework/ai/AITask/stats.js";
+import SessionTree from "./SessionTree.js";
+
+/** SessionRow — one session in the dashboard: a node of the SessionTree, with its children nested under it when open.
+ *  Line 1: fold arrow, origin icon, live dot, name, cost (rolled up through its children).
+ *  Line 2: when, how long, model, children and own cost. Phone-first: two short lines, nothing else. Doc: doc/ai-dashboard-plan.md */
+export default class SessionRow extends View {
+	static MAX_DEPTH = 3;
+	static usd(n){ return n >= 100 ? "$" + Math.round(n) : n >= 1 ? "$" + n.toFixed(2) : n > 0 ? "$" + n.toFixed(2) : "$0"; }
+
+	// Getters, not fields: prerender() runs inside View's constructor, before a subclass's fields exist.
+	get classes(){ return "ad-row ad-depth-" + Math.min(this.node.depth, SessionRow.MAX_DEPTH) + (this.node.live ? " ad-row-live" : ""); }
+
+	render(){
+		const { node: n, dash } = this, s = n.s, open = dash.q.open.has(s.id), kids = n.kids.length, origin = SessionTree.ORIGINS[n.origin];
+		div.c("ad-row-main", () => {
+			if (kids) button.c("ad-fold", open ? "▾" : "▸").attr("type", "button").attr("title", open ? "Hide " + kids + " below" : "Show " + kids + " below").on("click", () => dash.toggle(s.id));
+			else span.c("ad-fold");
+			span.c("ad-origin", origin.icon).attr("title", origin.label);
+			span.c("ad-dot" + (n.live ? " ad-dot-live" : "")).attr("title", n.live ? "working now" : s.state);
+			a.c("ad-name").href("/framework/ai/sessions/" + s.id + "/").text(s.title || s.agent || s.folder || s.id.slice(0, 8));
+			span.c("ad-usd", SessionRow.usd(n.rolled)).attr("title", kids ? `own ${SessionRow.usd(n.own)}, with ${n.count - 1} below ${SessionRow.usd(n.rolled)}` : "cost");
+		});
+		const bits = [s.last_activity ? age(s.last_activity) : null, s.wall_ms ? dur(s.wall_ms) : null, s.model?.split(" · ")[0], s.agent && s.agent !== s.title ? s.agent : null,
+			kids ? `${n.count - 1} below · own ${SessionRow.usd(n.own)}` : null].filter(Boolean);
+		div.c("ad-row-sub", bits.join(" · "));
+		if (kids && open) div.c("ad-kids", () => n.kids.forEach(k => new SessionRow({ node: k, dash })));
+	}
+}
diff --git a/public/framework/ai/AIDashboard/SessionStore.js b/public/framework/ai/AIDashboard/SessionStore.js
new file mode 100644
index 000000000..b09d9d669
--- /dev/null
+++ b/public/framework/ai/AIDashboard/SessionStore.js
@@ -0,0 +1,49 @@
+import Day from "/framework/core/Session/Day.js";
+import DashState from "../rail/DashState.js";
+import SessionTree from "./SessionTree.js";
+
+/** SessionStore — reads the one store (sessions/YYYY/MM/DD/index.json, written only by AISessionIndex) for a day and builds its SessionTree.
+ *  It streams: each new line on ai/tasks/state.jsonl (DashState) reloads the day, so the page never needs an agent or a timer. */
+export default class SessionStore {
+	static DAYS = 7;
+	static url(day){ return new URL(`../sessions/${Day.path(day)}/index.json`, import.meta.url).pathname; }
+
+	day = null; tree = null; ok = true; tasks = null;
+	listeners = new Set();
+
+	on(fn){ this.listeners.add(fn); return () => this.listeners.delete(fn); }
+
+	/** The seven days ending today, newest first. */
+	static days(today = Day.of()){
+		const base = new Date(today + "T12:00:00");
+		return Array.from({ length: SessionStore.DAYS }, (_, i) => Day.of(new Date(base.getTime() - i * 864e5)));
+	}
+
+	async open(day){
+		this.day = day;
+		await this.load();
+		if (!this.dash){
+			this.dash = new DashState();
+			this.dash.on(d => { this.tasks = d.full?.counts?.tasks ?? null; this.load(); });
+			this.dash.start();
+		}
+	}
+
+	/** One fetch at a time; a stream line that lands mid-fetch asks for one more after it. */
+	async load(){
+		if (this.loading) return void (this.again = true);
+		this.loading = true;
+		try {
+			const day = this.day, res = await fetch(SessionStore.url(day), { cache: "no-store" }).catch(() => null);
+			const json = res?.ok && !(res.headers.get("content-type") ?? "").includes("html") ? await res.json().catch(() => null) : null;
+			if (day === this.day){
+				this.ok = !!json;
+				this.tree = new SessionTree(json?.snapshots ?? []);
+				this.listeners.forEach(fn => fn(this));
+			}
+		} finally {
+			this.loading = false;
+			if (this.again){ this.again = false; this.load(); }
+		}
+	}
+}
diff --git a/public/framework/ai/AIDashboard/SessionTree.js b/public/framework/ai/AIDashboard/SessionTree.js
new file mode 100644
index 000000000..bf88eae58
--- /dev/null
+++ b/public/framework/ai/AIDashboard/SessionTree.js
@@ -0,0 +1,67 @@
+import AISessionBuckets from "../AISession/AISessionBuckets.js";
+
+/** SessionTree — one day's session snapshots (sessions/YYYY/MM/DD/index.json) as a tree: who spawned whom, each node's own cost and the cost rolled up through its children.
+ *  Plain code, no DOM. The join and the roll-up live here for slice 1; the plan moves them into AISessionIndex (doc/ai-dashboard-plan.md, fixes 1 to 4). */
+export default class SessionTree {
+	static ORIGINS = {
+		cloud:   { icon: "☁", label: "Voice",            hint: "The Claude app, by voice, through the Servex MCP" },
+		code:    { icon: "⌨", label: "VS Code",          hint: "A VS Code sidebar or remote-control tab, phone or PC" },
+		servex:  { icon: "⚙", label: "Servex",           hint: "Agents Servex spawned for a task" },
+		routine: { icon: "·", label: "Scheduled",        hint: "Clarity, cleaners, reviewers, quick fixes: cheap and plentiful" },
+	};
+	static LIVE_MS = 10 * 60000;
+
+	/** Where a root session came from. A child takes its root's origin. */
+	static origin(s){
+		if (s.parent === "voice-app" || /^cloud-voice/.test(s.folder ?? "")) return "cloud";
+		const kind = AISessionBuckets.kind_of(s);
+		if (kind === "owner-tab") return "code";
+		return AISessionBuckets.KINDS.find(k => k.key === kind)?.routine ? "routine" : "servex";
+	}
+
+	nodes = new Map();   // id -> { s, kids, own, rolled, origin, depth }
+	roots = [];
+	by_agent = new Map();
+
+	constructor(snaps, now = Date.now()){
+		this.now = now;
+		snaps.forEach(s => this.nodes.set(s.id, { s, kids: [], own: s.usd ?? 0, rolled: s.usd ?? 0, origin: null, depth: 0 }));
+		snaps.forEach(s => { if (s.agent) this.by_agent.set(s.agent, this.nodes.get(s.id)); });   // a session's `parent` is an agent name, not a session id
+		this.nodes.forEach(n => {
+			const up = this.parent_of(n);
+			if (up) up.kids.push(n); else this.roots.push(n);
+		});
+		this.roots.forEach(r => this.settle(r, SessionTree.origin(r.s), 0));
+		this.sort(this.roots);
+	}
+
+	/** The parent node, or null when it is a root. A parent that is not a session (voice-app) or a loop makes a root. */
+	parent_of(n){
+		const name = n.s.parent;
+		const up = name && this.by_agent.get(name);
+		if (!up || up === n) return null;
+		for (let x = up; x; x = x.up) if (x === n) return null;   // never a cycle
+		n.up = up;
+		return up;
+	}
+
+	settle(n, origin, depth){
+		n.origin = origin; n.depth = depth;
+		n.rolled = n.own + n.kids.reduce((sum, k) => sum + this.settle(k, origin, depth + 1), 0);
+		n.count = 1 + n.kids.reduce((sum, k) => sum + k.count, 0);
+		n.last = Math.max(Date.parse(n.s.last_activity ?? "") || 0, ...n.kids.map(k => k.last));
+		n.live = n.s.state === "active" || this.now - n.last < SessionTree.LIVE_MS;
+		return n.rolled;
+	}
+	sort(list){ list.sort((a, b) => b.last - a.last); list.forEach(n => this.sort(n.kids)); }
+
+	/** Servex agents with no parent that look spawned: a minion or reviewer nobody owns. The plan's "unattached". */
+	unattached(){ return this.roots.filter(r => r.origin === "servex" && /^(minion|reviewer|checker|voter)/.test(r.s.agent ?? "")); }
+
+	/** Per-origin totals over the roots: { cloud: { n, usd, live }, ... }. */
+	totals(){
+		const t = Object.fromEntries(Object.keys(SessionTree.ORIGINS).map(k => [k, { roots: 0, n: 0, usd: 0, live: 0 }]));
+		this.roots.forEach(r => { const o = t[r.origin]; o.roots++; o.n += r.count; o.usd += r.rolled; if (r.live) o.live++; });
+		return t;
+	}
+}

-		$tip.style("left", left + "%").rc("ai2-proc-hide")
-			.html_unsafe(`${clock(h.at)} — ours ${gb(h.ours_mb)}, other ${gb(h.other_mb)} · cpu ours ${pct(h.ours_cpu)}, total ${pct(h.cpu)}`);

+// Proof for ext/Chat/doc/duplicate-bubbles.md — mounts the REAL shared chat() widget (ux/Dictate/chat.js), mocks only
+// Servex's session endpoints, and makes the stream/poll copy of the owner's line arrive BEFORE the send call answers.
+// Counts the owner's bubbles and how often the text appears. Usage: node prove-dup-bubble.mjs <base url> [tag]
+import { browser, close } from "file:///C:/Code/lew42/monorepo/Server/browser.mjs";
+const BASE = process.argv[2] || "http://localhost:54923", TAG = process.argv[3] || "run";
+const SHOTS = new URL("./shots/", import.meta.url).pathname.replace(/^\/(\w:)/, "$1");
+const b = await browser();
+let bad = 0;
+
+async function run(name, { via, text, reload = false, navigate = false, width = 1200 }){
+	const ctx = await b.newContext({ viewport: { width, height: 800 } }), page = await ctx.newPage();
+	page.on("pageerror", e => console.log("PAGEERROR", e.message)); page.on("console", m => m.type()==="error" && console.log("CONSOLE", m.text().slice(0,150)));
+	const lines = []; let said = false;
+	await page.route("http://127.0.0.1:8090/api/**", route => route.fulfill({ json: { ok: true, sessions: [] } }));
+	await page.route("http://127.0.0.1:8090/api/session/*", async route => {
+		const verb = route.request().url().split("/").pop();
+		const body = JSON.parse(route.request().postData() || "{}");
+		if (verb === "new") return route.fulfill({ json: { ok: true, session: "v-test", file: BASE + "/mock/v-test.jsonl", resumed: false } });
+		if (verb === "say"){
+			const at = new Date().toISOString();
+			lines.push(JSON.stringify({ chat: { at, session: "v-test", from: { kind: "owner" }, via: body.via, text: body.text } }));
+			said = true;
+			await new Promise(r => setTimeout(r, 2600));      // the answer is slow: the poll copy lands first
+			return route.fulfill({ json: { ok: true, at } });
+		}
+		return route.fulfill({ json: { ok: true } });
+	});
+	await page.route(BASE + "/mock/v-test.jsonl", route => route.fulfill({ body: lines.join("\n") + "\n", contentType: "text/plain" }));
+	await page.goto(BASE + "/framework/ext/Chat/", { waitUntil: "load" });
+	await page.evaluate(k => { window.__keep = k; sessionStorage.clear(); }, navigate);
+	await page.evaluate(async () => {
+		const { default: chat } = await import("/framework/ux/Dictate/chat.js");
+		const el = document.createElement("div"); el.id = "proof"; el.style.cssText = "height:520px;margin:1em";
+		document.body.prepend(el); window.mount = chat(el, { placeholder: "say", keep: !!window.__keep });
+	});
+	await page.waitForTimeout(400);
+	// warm-up send: the session exists before the line under test, as in the owner's long-open chat
+	await page.evaluate(() => window.mount.panel.submit_entry({ text: "warm up line", via: "typed" }));
+	await page.waitForTimeout(3600); lines.length && null;
+	await page.evaluate(({ via, text }) => { const w = window.mount.widget ?? window.mount.panel ?? window.mount; (w.submit_entry ? w : w.widget).submit_entry({ text, via, raw: text }); }, { via, text });
+	if (reload){ await page.waitForTimeout(3500); await page.evaluate(() => window.mount.reset?.()); }
+	for (let i = 0; i < 7; i++){ await page.waitForTimeout(700); if (process.env.TRACE) console.log(i, JSON.stringify(await page.evaluate(() => document.querySelector("#proof").innerText.split(String.fromCharCode(10)).join(" / ").slice(0, 160)))); }
+	if (navigate){   // the owner moved to another page: the old mount goes, a new one on the SAME session draws the history
+		await page.evaluate(async () => {
+			window.mount.remove(); document.querySelector("#proof").remove();
+			const { default: chat } = await import("/framework/ux/Dictate/chat.js");
+			const el = document.createElement("div"); el.id = "proof"; el.style.cssText = "height:520px;margin:1em";
+			document.body.prepend(el); window.mount = chat(el, { placeholder: "say", keep: true });
+		});
+		await page.waitForTimeout(4000);
+	}
+	const found = await page.evaluate(t => {
+		const root = document.querySelector("#proof"), txt = root.innerText;
+		return { count: txt.split(t).length - 1, bubbles: [...root.querySelectorAll("*")].filter(e => e.children.length === 0 && e.textContent.includes(t)).length };
+	}, text);
+	await page.screenshot({ path: `${SHOTS}${TAG}-${name}-${width}.png`, clip: undefined });
+	const dup = found.count !== 1;
+	if (dup) bad++;
+	console.log((dup ? "DUPLICATE " : "ok        ") + name + " @" + width + "  text shown " + found.count + "x");
+	await ctx.close();
+}
+for (const w of [1920, 400]){
+	await run("typed", { via: "typed", text: "ask not what your country can do for you", width: w });
+	await run("voice", { via: "voice", text: "so the green checkmark comes after the first line", width: w });
+	await run("navigate", { via: "voice", text: "What is minion-kaq?", navigate: true, width: w });
+}
+await close();
+process.exit(bad ? 1 : 0);
diff --git a/public/framework/ext/Chat/doc/proof/prove-dup-send.mjs b/public/framework/ext/Chat/doc/proof/prove-dup-send.mjs
new file mode 100644
index 000000000..52da7fb66
--- /dev/null
+++ b/public/framework/ext/Chat/doc/proof/prove-dup-send.mjs
@@ -0,0 +1,68 @@
+// Proof for ext/Chat/doc/duplicate-bubbles.md — drives a REAL ComposerMic (no mic, no Whisper: a fake Capture
+// and a scripted transcribe) through the exact sequence behind the owner's duplicate bubbles, and counts what
+// reaches deliver(). Usage: node prove-dup-send.mjs <base url>   (exit 1 when any scenario sent a duplicate)
+import { browser, close } from "file:///C:/Code/lew42/monorepo/Server/browser.mjs";
+const BASE = process.argv[2] || "http://localhost:54923";
+const b = await browser(), page = await (await b.newContext()).newPage();
+page.on("pageerror", e => console.log("PAGEERROR", e.message));
+await page.goto(BASE + "/framework/ext/Chat/", { waitUntil: "load" });
+
+const out = await page.evaluate(async () => {
+	const { composer } = await import("/framework/ext/Chat/Composer.js");
+	const wait = ms => new Promise(r => setTimeout(r, ms));
+	// One scenario: the guess is on screen, the segment closes, Send/auto-send fires while the FINAL is still in flight,
+	// then the final arrives worded a little differently from the guess (Whisper always does this).
+	async function scenario(name, guess, final, { send_before_close = false, final_ms = 150 } = {}){
+		const sent = [];
+		const view = composer({ deliver: async e => { sent.push(e.text); return true; } });
+		document.body.append(view.el ?? view);
+		const m = view.mic;
+		m.state = "listening"; m.engine = "whisper"; m.segment_epoch = 0; m.req_seq = 0; m.applied_seq = 0;
+		m.mic = { snapshot: () => new Float32Array(16), cut(){}, loudness: () => ({ loud_ms: 999 }), wav: () => new Blob(), rate: () => 16000, stop(){} };
+		m.dump = () => {}; m.last_speech = performance.now();
+		let answer = guess;
+		m.transcribe = async () => { await wait(answer === guess ? 5 : final_ms); return answer; };
+		m.has_speech = true;
+		await m.partial_tick();                       // the grey guess appears
+		if (send_before_close) { await m.send_screen(); }
+		answer = final;
+		const closing = m.close_segment("pause");     // segment closes, final in flight
+		await wait(20);
+		if (!send_before_close) await m.send_screen();// Send / natural-pause send reads the screen: guess included
+		await closing; await wait(400);
+		await m.send_screen();                        // the next natural-pause tick sends whatever is left
+		await m.send_sentences?.(1); await wait(300);
+		return { name, sent };
+	}
+	const rows = [];
+	// expect = how many messages a correct mic sends for ONE spoken segment
+	rows.push({ expect: 1, ...await scenario("guess sent, final re-punctuated",
+		"Holy smokes. Okay. So you just responded. Okay.", "Holy smokes. Okay, so you just responded.") });
+	rows.push({ expect: 1, ...await scenario("guess sent, final one word off",
+		"ask not what your country can do for you", "Ask not what your county can do for you.") });
+	rows.push({ expect: 1, ...await scenario("guess sent, final hears two words differently",
+		"so the green check mark comes after the first line", "So the green checkmark comes after the first lime.") });
+	rows.push({ expect: 2, ...await scenario("guess sent, final adds a NEW sentence (must still go out)",
+		"There's a green check mark after the first line", "There's a green check mark after the first line. There's a microphone after that.") });
+	// The owner's real session (v-0kfikyu, 2026-10-09): a doubled raw, then the same question re-heard one letter off, 300 ms later.
+	async function direct(name, expect, items){
+		const sent = [];
+		const view = composer({ deliver: async e => { sent.push(e.text + (e.raw ? "  [raw: " + e.raw + "]" : "")); return true; } });
+		document.body.append(view.el ?? view);
+		for (const it of items){ await view.mic.post_held(it); await wait(300); }
+		return { name, sent, expect };
+	}
+	rows.push(await direct("doubled raw, then re-heard one letter off", 1, [
+		{ text: "What is minion-kak?", raw: "What is minion-kak? What is minion-kak?" }, { text: "What is minion-kaq?" }]));
+	rows.push(await direct("a real repeat of a different sentence still goes out", 2, [{ text: "Turn on the lights." }, { text: "Now turn them off please." }]));
+	return rows;
+});
+let bad = 0;
+for (const r of out){
+	const words = r.sent.join(" ").toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, "").split(/\s+/).filter(Boolean);
+	const dup = r.sent.length !== r.expect;
+	if (dup) bad++;
+	console.log((dup ? "DUPLICATE " : "ok        ") + r.name + "\n    sent " + r.sent.length + ": " + JSON.stringify(r.sent));
+}
+await close();
+process.exit(bad ? 1 : 0);

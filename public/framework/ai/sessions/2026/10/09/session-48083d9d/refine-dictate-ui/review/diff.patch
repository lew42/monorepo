@@ -0,0 +1,18 @@
+@layer base, theme, site, util;
+
+/* The connection row: five equal fixed columns (two on a phone), each a dot, a name and at most three
+   lines of reason, so nothing moves while words arrive. */
+@layer site {
+	.voice-conn { display: grid; grid-template-columns: repeat(var(--steps, 5), minmax(0, 1fr)); gap: 0.5em 0.75em; font-size: 0.85em; margin-block-end: 0.75em; }
+	.voice-conn-step { display: grid; gap: 0.15em; align-content: start; min-inline-size: 0; border-inline-start: 2px solid var(--wash, #ccc); padding-inline-start: 0.5em; }
+	.voice-conn-head { display: flex; align-items: center; gap: 0.4em; font-weight: 600; block-size: 1.6em; }
+	.voice-conn-dot { inline-size: 0.7em; block-size: 0.7em; border-radius: 50%; background: var(--wash, #bbb); flex: none; }
+	.voice-conn-step[data-state="ok"] .voice-conn-dot { background: #2a9d4b; }
+	.voice-conn-step[data-state="bad"] .voice-conn-dot { background: var(--error, #d33); }
+	.voice-conn-step[data-state="wait"] .voice-conn-dot { background: #e0a000; }
+	.voice-conn-why { opacity: 0.75; block-size: 4.2em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
+	.voice-conn-step[data-state="bad"] .voice-conn-why { color: var(--error, #d33); opacity: 1; }
+	.voice-conn-retry { margin-inline-start: auto; padding: 0 0.4em; line-height: 1.4; }
+	.voice-conn .audio-levelmeter { margin-block-start: 0.3em; }
+	@media (max-width: 700px) { .voice-conn { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+}

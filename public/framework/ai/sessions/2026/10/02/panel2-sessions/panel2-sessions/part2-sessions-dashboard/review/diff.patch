diff --git a/public/framework/ai/dashboard/page.js b/public/framework/ai/dashboard/page.js
new file mode 100644
index 00000000..13d51e86
--- /dev/null
+++ b/public/framework/ai/dashboard/page.js
@@ -0,0 +1,177 @@
+import { Page, div, a, p, span, small, View } from "/app.js";
+import Panel2 from "/framework/ext/panel2/Panel2.js";
+import { watch_needs } from "/framework/ai2/needs.js";
+import { age } from "/framework/core/Page/ext/Inbox/Inbox.js";
+import { log_board } from "/framework/ext/AITask/dashboard.js";
+import { row_view as session_row, merge as merge_sessions, get_json } from "../sessions/page.js";
+
+View.stylesheet(import.meta, "dashboard.css");
+
+/* THE DASHBOARD TAB — the owner's own words (owner-words.md): "/framework/ai's
+ * default tab could show a grid-like dashboard that includes the inbox, but
+ * also the log next to it, in a responsive way." Built as ONE Panel2 (Part 1):
+ * its header is the full-width, minimal-height toolbar the owner asked for
+ * ("a separate toolbar for the left and right side... that should be our
+ * panel system"); its main is `.panel2-grid` holding five small tiles —
+ * Stalled first (top priority), then In flight + queued, Inbox, Log, Sessions.
+ * Each tile reuses a REAL source, never a second copy of its data or render
+ * (CLAUDE.md law 6): `watch_needs()` (Inbox), `log_board()` (Log), this same
+ * folder's own `sessions/page.js` row (Sessions), and `tasks.json` — a file a
+ * sibling task (`stalled-and-budgets`) owns and writes, read here defensively
+ * since it may not exist yet (see doc/decisions.md).
+ */
+
+const TASKS_URL = "/framework/ai/tasks.json";
+const SESSIONS_URL = "/framework/ai/sessions/";
+
+function progress_bar(spent, budget){
+	if (typeof budget !== "number" || budget <= 0)
+		return div.c("dash-bar dash-bar-indeterminate").attr("title", "no budget set");
+	const pct = Math.max(0, Math.min(100, Math.round(((spent ?? 0) / budget) * 100)));
+	return div.c("dash-bar").attr("title", `$${(spent ?? 0).toFixed(2)} of $${budget.toFixed(2)}`)
+		.append(() => div.c("dash-bar-fill").style("width", pct + "%"));
+}
+
+function task_row(t){
+	const href = t.card ? "/framework/ai2/" + t.card + "/" : t.dir ? "/framework/ai/" + t.dir + "/" : null;
+	const inner = () => {
+		div.c("flex gap-50 v-center", () => {
+			span.c("dash-task-title", t.title || t.dir || "Untitled task");
+			if (t.agent) small.c("muted", t.agent);
+		});
+		if (t.why) small.c("muted dash-task-why", t.why);
+		progress_bar(t.spent, t.budget);
+	};
+	return href ? a.c("dash-task-row flex v").href(href).append(inner) : div.c("dash-task-row flex v", inner);
+}
+
+async function load_tasks(){
+	const data = await get_json(TASKS_URL);
+	return Array.isArray(data) ? data : Array.isArray(data?.tasks) ? data.tasks : null;
+}
+
+function empty_tile(text){ return () => p.c("muted dash-empty", text); }
+
+function stalled_tile(tasks){
+	const panel = new Panel2({ title: "Stalled" });
+	if (tasks === null) panel.main.append(empty_tile("No data yet — tasks.json hasn't been written."));
+	else {
+		const rows = tasks.filter(t => t.state === "stalled");
+		if (!rows.length) panel.main.append(empty_tile("Nothing stalled."));
+		else rows.forEach(t => panel.main.append(() => task_row(t)));
+	}
+	return panel;
+}
+
+function inflight_tile(tasks){
+	const panel = new Panel2({ title: "In flight + queued" });
+	if (tasks === null) panel.main.append(empty_tile("No data yet — tasks.json hasn't been written."));
+	else {
+		const rows = tasks.filter(t => t.state === "building");
+		if (!rows.length) panel.main.append(empty_tile("Nothing running or queued."));
+		else rows.forEach(t => panel.main.append(() => task_row(t)));
+	}
+	return panel;
+}
+
+// Live — `watch_needs()` is the SAME shared scan the Inbox tab's score floor
+// reads (needs.js's `score_for()`), already sorted highest-importance first.
+// Returns a teardown so the page can unsubscribe on deactivate.
+function inbox_tile(root){
+	const panel = new Panel2({ title: "Inbox" });
+	panel.header.append(() => a.c("page-link", "See all").href(root.url + "inbox/"));
+	const stop = watch_needs(state => {
+		panel.main.empty(() => {
+			const top = state.rows.slice(0, 5);
+			if (!top.length) return void empty_tile("Nothing needs you right now.")();
+			top.forEach(r => a.c("dash-need-row flex v").href(r.url).append(() => {
+				span(r.title || r.question || "Untitled");
+				small.c("muted", r.at ? age(r.at) : "");
+			}));
+		});
+	});
+	return { panel, stop };
+}
+
+// A capped-height preview of the SAME render `/framework/ai/all-tasks/` and
+// the old board's `/log/` use (`log_board()`, ext/AITask/dashboard.js) — not
+// a second "every task" reader. It draws its own active strip and a compose
+// box too (it's the real thing, just short); `.dash-log-tile`'s max-height
+// crops it to a preview, with "See all" for the whole, uncapped page.
+function log_tile(root){
+	const panel = new Panel2({ title: "Log" });
+	panel.header.append(() => a.c("page-link", "See all").href("/framework/ai/all-tasks/"));
+	panel.main.ac("dash-log-tile").append(() => log_board(root));
+	return panel;
+}
+
+// Live-ish — the same row the Sessions tab draws (`sessions/page.js`), top 5,
+// re-polled on the same cadence. Returns a teardown, same shape as the Inbox tile.
+function sessions_tile(root){
+	const panel = new Panel2({ title: "Sessions" });
+	panel.header.append(() => a.c("page-link", "See all").href(SESSIONS_URL));
+	const $list = div.c("dash-sessions-tile");
+	panel.main.append($list);
+
+	let snapshot_rows = [], live = true;
+	const draw = agents => $list.empty(() => {
+		const rows = merge_sessions(snapshot_rows, agents).slice(0, 5);
+		if (!rows.length) return void empty_tile("No sessions with an id yet.")();
+		rows.forEach(r => session_row(r, SESSIONS_URL));
+	});
+	const poll = async () => {
+		if (!live) return;
+		if (!document.hidden) draw((await get_json("/api/agents")) ?? []);
+		if (live) setTimeout(poll, 20000);
+	};
+	get_json(SESSIONS_URL + "sessions.json").then(snap => {
+		snapshot_rows = snap?.rows ?? [];
+		if (live) poll();
+	});
+
+	return { panel, stop: () => { live = false; } };
+}
+
+export default new Page({
+	meta: import.meta,
+	title: "Dashboard",
+	description: "A grid of live previews: what's stalled, what's running, the top of the inbox and the log, and every session.",
+	icon: "dashboard",
+
+	// `{"settings":{"tab":true,...}}` lives in settings.jsonl beside this file.
+
+	content(){
+		// ⚠ `wide`: a plain Page's own track is the narrow prose column
+		// (~38em) — a dashboard of tiles left on it measured 606px wide at a
+		// 1920 viewport, one column only, no matter what `--column` said
+		// (design/layout's own commonest failure: "a grid, table or dashboard
+		// squeezed into 52em"). `wide` is main + breakout, grows rightward.
+		const shell = new Panel2({ title: "Dashboard" }).ac("wide");
+		shell.header.append(() => small.c("muted", "stalled first — it's the one thing waiting on you"));
+
+		this.$grid = div.c("grid auto gap panel2-grid dashboard-tiles");
+		shell.main.append(this.$grid);
+	},
+
+	// ⚠ The tile population is ONE synchronous `.empty(fn)` call, after the
+	// `await` — never a bare factory call floating after it. Each tile
+	// function's `new Panel2(...)` auto-captures into whatever `$grid` was
+	// set as the captor for THIS fn's call, which `empty()`/`append()` does
+	// correctly around the whole synchronous body; nothing here is a second,
+	// later append relying on a captor that has already been restored
+	// (`code` skill: "capturing is synchronous").
+	activated(){
+		this.stops = [];
+		load_tasks().then(tasks => {
+			this.$grid.empty(() => {
+				stalled_tile(tasks);
+				inflight_tile(tasks);
+				const inbox = inbox_tile(this); this.stops.push(inbox.stop);
+				log_tile(this);
+				const sess = sessions_tile(this); this.stops.push(sess.stop);
+			});
+		});
+	},
+
+	deactivated(){ this.stops?.forEach(stop => stop()); this.stops = []; },
+});

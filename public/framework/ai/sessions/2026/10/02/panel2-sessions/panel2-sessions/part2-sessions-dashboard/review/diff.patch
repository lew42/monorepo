+/* The Sessions tab — one row per Claude session, newest activity first.
+   `sessions-` is a brand new prefix (confirmed free, 2026-10-02 — see
+   doc/decisions.md for the census and the css-scopes.txt reservation note). */
+@layer theme {
+
+	.sessions-list { padding: var(--pad); }
+
+	.sessions-row {
+		display: flex; align-items: center; gap: var(--gap-50);
+		padding-block: var(--gap-50);
+		border-block-end: 1px solid var(--line);
+		text-decoration: none; color: inherit;
+	}
+	.sessions-row:last-child { border-block-end: none; }
+
+	.sessions-row-main { flex: 1 1 auto; min-width: 0; }
+	.sessions-row-title { font-weight: 600; }
+	.sessions-row-prompt { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+	.sessions-row-end { align-items: flex-end; text-align: end; flex: none; }
+
+	/* One colour per source, so "what kind of session is this" reads before the
+	   words do — the owner's own ask ("a tag that says VS Code on it"). */
+	.sessions-tag {
+		flex: none; font-size: 0.75em; font-weight: 600; text-transform: uppercase;
+		padding-inline: 0.5em; padding-block: 0.2em; border-radius: var(--radius);
+		letter-spacing: 0.02em;
+	}
+	.sessions-tag-servex { background: color-mix(in srgb, var(--prim) 20%, transparent); color: var(--prim); }
+	.sessions-tag-vscode { background: color-mix(in srgb, #0072B2 20%, transparent); color: #0072B2; }
+	.sessions-tag-cli    { background: color-mix(in srgb, #767676 25%, transparent); color: var(--ink); }
+
+	.sessions-state { text-transform: lowercase; }
+	.sessions-state-working, .sessions-state-active { color: var(--prim); }
+
+	.sessions-prompt { padding: var(--gap-50); }
+
+	.sessions-full-id { display: block; font-family: monospace; margin-block: var(--gap-35) var(--gap); }
+}

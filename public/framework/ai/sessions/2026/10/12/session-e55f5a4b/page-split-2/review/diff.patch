@@ -0,0 +1,36 @@
+# page-split-2: STATE (steps 5-6 done)
+
+Columns and Links are out of `Page.class.js`, one commit each on `worktree/page-split-2`. Step 7 (jsonl) is out of scope here and stays open in [split-plan.md](/framework/core/Page/doc/split-plan.md). Follows [page-split-1](/framework/ai/2026-10-12/page-split-1/STATE.md).
+
+## Measure (`node public/framework/core/Page/doc/split-measure.mjs`)
+
+| After | Page.class.js lines | code | comment | blank | methods | New file |
+|---|---|---|---|---|---|---|
+| before (end of page-split-1) | 1315 | 830 | 235 | 250 | 114 | |
+| 5 Columns | 1173 | n/a | n/a | n/a | n/a | `Columns.js` (`PageColumns`, 162 lines) |
+| 6 Links | 1086 | 690 | 191 | 205 | 114 | `Links.js` (`PageLinks`) |
+
+Net this task: 1315 to 1086 lines (-17%), code 830 to 690. Whole split so far: 2270 to 1086 (-52%). Method count stays 114 because every moved method keeps a facade on Page.
+
+## Proof per step
+
+- **Columns (5):** old (`monorepo.localhost`) against new (worktree server) in headless Chromium at 400/1200/1920/3440 on about 20 pages, including `/imagine/paging/`, `core/Page/overview/columns`, a markdown page, `/framework/ai/` and a session page. Column count, widths and `.page-column-body` structure were identical (0 diffs), and so was click first item, back button, reload on the deep link.
+- **Links (6):** same old-vs-new comparison on `/framework/ext/markdown/open/` and `.../open/columns/` (400/1200/1920), the Finder demo and `/framework/ai/` (400/1920): click an `.md` link, back, forward, reload; URL, column count, `.page-swap` count and link count matched every time. `check_page` on both markdown demos, the columns demo and `/imagine/paging/`: 0 page errors, 0 JS errors; the only errors are 404s for missing gitignored data files.
+- **Smoke:** `node Server/smoke.mjs <worktree> --port 57899` after each step: 0 JS errors. The only FAIL lines (`/framework/`, `/framework/ai2/` and the page linked from them) are 404s for the worktree's own gitignored data files (`directory.json`, `settings.jsonl`, `weight.jsonl`, `page.jsonl`); they fail the same way before the change.
+
+## Decisions (alternative in brackets)
+
+- `PageColumns` and `PageLinks` follow the part shape of page-split-1: `new this.constructor.Columns({ page: this })`, attached as `Page.Columns` / `Page.Links`, so a subclass can swap one. They call back through `this.page.*`, so a page that overrides `column(host)` or `open_link` still wins.
+- Facades stay for every moved method, not only the three the brief names (`columns`, `column`, `column_host`; `open_link`, `swap_link`): `swap_url`, `md_files` and the statics `md_page`, `md_file`, `md_url` too, because docs and pages call them. [Removing the extras would break those callers for under 10 lines saved.]
+- `child_md`, `md_folder`, `fs_folder`, `md_dir` stay on Page: they are about the page's folder and are used outside the link path. [Moving them into `Links.js` was the alternative; the plan did not require it.]
+- `Links.files()` still loads `Markdown.js` lazily with `import()`, as before, so there is no new import cycle.
+
+## Pre-existing, not caused by this task
+
+- `/imagine/paging/templates/` and `/framework/ai/cards/` show an error page on old and new alike.
+- The headless browser sometimes reports "Page crashed" late in a long probe at 3440 or 1920 (about 3 times in ~60 runs, on both old and new). It does not reproduce when the same page is loaded alone (5 runs, no crash, same timings old vs new), so it is browser memory, not the code.
+- `check_page` once returned a blank screenshot for the columns demo; the DOM probe showed the columns present, so it is a screenshot timing artifact.
+
+## Open
+
+Step 7, Jsonl (470 lines, the core path of every page, replay order matters): later task, see [split-plan.md](/framework/core/Page/doc/split-plan.md).
diff --git a/public/framework/core/Page/Columns.js b/public/framework/core/Page/Columns.js
new file mode 100644
index 000000000..8fa87ec88
--- /dev/null
+++ b/public/framework/core/Page/Columns.js
@@ -0,0 +1,162 @@
+import { div, span, a, icon, is } from "../View/View.js";
+
+// The Finder shape: how a page draws itself as a column, and how its host row sizes, scrolls and resizes them. (doc/columns.md)
+// `page.columns()`, `column(host)`, `render_column(host)` and the rest are facades on Page: a page overrides `column(host)`,
+// so every call back into the page goes through `this.page.*` and the override still wins.
+export default class PageColumns {
+
+	page = null;
+
+	constructor(...args){ this.assign(...args); }
+	assign(...args){ return Object.assign(this, ...args); }
+
+	// The page as a column, then the region its children mount in. ⚠ No `page-title` or `flow` here; `classes` is additive. (doc/watch-out.md)
+	render(host){
+		const page = this.page;
+
+		const stack = () => {
+			page.column_grab(page.column(host));
+			// ⚠ The host builds a `default` child (nothing routes to it) and hands down `app`. (doc/decisions.md)
+			page.$pages = div.c("page-column-pages", () => page.default_column()?.assign({ app: page.app }).render());
+		};
+
+		// The mode is the HOST's, so the class is the host's too: Page.css reads `.page.columns.page-columns-even`.
+		page.view = div.c("page")
+			.ac(page === host ? "columns" : "column")
+			.ac(page === host && page.column_even && "page-columns-even");
+
+		page.view.append(page === host ? () => {
+			page.$crumbs = div.c("page-columns-bar");
+			page.$row = div.c("page-columns-row", stack);
+		} : stack);
+
+		// ⚠ No `page-w-*` here: `column()` stamps the width, and a columns host has no page grid. (doc/watch-out.md)
+		page.constructor.views.set(page.view.el, page);
+		return page.view.ac(page.name && "page--" + page.name).ac(...page.word_classes()).ac(page.classes);
+	}
+
+	// The child that opens when nothing deeper is routed (the `default` word). ⚠ Not `opens()`. (doc/decisions.md)
+	default(){ return [...this.page.children.values()].find(child => child?.classes?.split(/\s+/).includes("default")); }
+
+	// ONE COLUMN: a sticky head, my own content, my children as rows. `width` is the page's own word.
+	body(host){
+		const page = this.page;
+
+		return div.c("page-column-body", () => {
+			div.c("page-column-head", () => {
+				span.c("page-column-title", page.title);
+				if (page !== host) a.c("page-column-close", () => icon("close")).href(page.parent.url);
+			});
+
+			// ⚠ `render_content()`, not a hand-written two-branch copy: one reader decides what is in the box. (doc/decisions.md)
+			const tabbed = page.navigation === "tabs" && is.fn(page.tabs);
+			if (tabbed) page.tabs(undefined, { home: () => div.c("page-column-prose flow", () => page.render_content()) });
+			else if (page.content)
+				div.c("page-column-prose flow", () => page.render_content());
+
+			// ⚠ `index: true` — my content already shows my children, so no rail. A field, not a method. (doc/watch-out.md)
+			if (!page.index && !tabbed) page.children.forEach((child, name) => {
+				const nav = page.nav_for(name);
+
+				a.c("page-column-item").href(nav.url).append(() => {
+					if (nav.icon) icon(nav.icon);
+					span.c("page-column-label", nav.label);
+					if (child?.children.size) icon("chevron_right");
+				});
+			});
+
+			// A column is already a rail, so `related:` is a short list at its end. (doc/columns.md)
+			if (page.related) div.c("page-column-prose", () => page.related_aside());
+		}).ac(page.width && "page-column-" + page.width);
+	}
+
+	// The seam: drag it and this column keeps the width you left it at. ⚠ `lostpointercapture` ends the drag; `preventDefault` on the DOWN. (doc/watch-out.md)
+	grab($body){
+		const $grab = div.c("page-column-grab");
+		let from, width;
+
+		$grab.on("pointerdown", e => {
+			from = e.clientX;
+			width = $body.el.getBoundingClientRect().width;
+			$grab.el.setPointerCapture(e.pointerId);
+			$grab.ac("page-column-grabbing");
+			e.preventDefault();
+		});
+
+		$grab.on("pointermove", e => is.num(from) && this.resize($body, width + e.clientX - from));
+		$grab.on("lostpointercapture", () => { from = undefined; $grab.rc("page-column-grabbing"); });
+		$grab.on("dblclick", () => this.resize($body));
+
+		return $grab;
+	}
+
+	// The width a drag leaves behind, as the same three tokens the width words set. ⚠ No `px` = back to the page's word. (doc/watch-out.md)
+	resize($body, px){
+		const row = this.page.column_host()?.$row?.el;
+		const width = px && Math.round(Math.max(this.page.column_floor, Math.min(px, row?.clientWidth ?? px)));
+
+		return $body.style({
+			"--page-column-flex": width ? `0 0 ${width}px` : "",
+			"--page-column-min":  width ? "0" : "",
+			"--page-column-max":  width ? "none" : "",
+		});
+	}
+
+	// `even`: N columns of equal width, N computed from the ROW's room.
+	// ⚠ STATIC, so the lab sizes with the host's own arithmetic. The stamp comes off BEFORE the read. `max-width: none` = the phone regime. (doc/watch-out.md)
+	static even(row, fit = "floor"){
+		if (!row) return null;
+
+		row.style.removeProperty("--page-column-even-w");
+
+		const body = row.querySelector(".page-column-body");
+		const recommended = parseFloat(body && getComputedStyle(body).maxWidth);
+		const available = row.clientWidth;
+		if (!(recommended > 0) || !available) return null;
+
+		// `floor` never falls under the recommendation, `round` fills tighter; never below 1 column.
+		const slots = available / recommended;
+		const n = Math.max(1, fit === "round" ? Math.round(slots) : Math.floor(slots));
+		const width = available / n;
+
+		row.style.setProperty("--page-column-even-w", width + "px");
+		return { n, width, available, recommended, fit };
+	}
+
+	// My row's N and column width, or null when I am not in the mode.
+	even(){ return this.page.column_even ? this.constructor.even(this.page.$row?.el, this.page.column_fit) : null; }
+
+	// The room changed, or a column opened: size first, scroll second. `slide` is true only for a navigation. (doc/decisions.md)
+	settle(slide){ this.even(); this.scroll(slide); }
+
+	// Slide or jump? ⚠ Reduced motion is read HERE. Only `even` slides. (doc/watch-out.md)
+	slide(){ return !!this.page.column_even && !matchMedia("(prefers-reduced-motion: reduce)").matches; }
+
+	// Called on the HOST after every activation in its tree: the trail says where you are, then the newest column scrolls in.
+	reveal(page){
+		const host = this.page;
+		host.$crumbs?.empty(() => page.crumbs(host));
+
+		const row = host.$row?.el;
+		if (!row) return;
+
+		// ⚠ The row has no box on a cold load: the observer fires when it gets one, and on every resize. (doc/watch-out.md)
+		if (!host.watching) (host.watching = new ResizeObserver(() => this.settle())).observe(row);
+
+		// ⚠ One frame later: Router.mark() marks after activate(). This is the one settle that SLIDES. (doc/watch-out.md)
+		requestAnimationFrame(() => this.settle(true));
+	}
+
+	// The deepest column on screen, by the smallest move. ⚠ `scrollBy` on the row, never `scrollIntoView`. (doc/watch-out.md)
+	scroll(slide){
+		const row = this.page.$row?.el;
+		const body = [...row?.querySelectorAll(".page-column-body") ?? []].filter(el => el.offsetWidth).at(-1);
+		if (!body) return;
+
+		const to = body.getBoundingClientRect(), from = row.getBoundingClientRect();
+		const dx = to.right > from.right ? to.right - from.right
+			: to.left < from.left ? to.left - from.left : 0;
+
+		if (dx) row.scrollBy({ left: dx, behavior: slide && this.slide() ? "smooth" : "auto" });
+	}
+}
diff --git a/public/framework/core/Page/Links.js b/public/framework/core/Page/Links.js
new file mode 100644
index 000000000..268641f81
--- /dev/null
+++ b/public/framework/core/Page/Links.js
@@ -0,0 +1,110 @@
+import { div, p, h2, span, ul, li, a, button, icon } from "../View/View.js";
+
+// Where a clicked link opens, and the .md-file helpers it uses. The Router hands every in-app click to the page that
+// holds the link; the page decides, the link carries no target. (doc/open.md)
+// `page.open_link(link)`, `swap_link(link)`, `md_files(names)` and `Page.md_file/md_url/md_page` are facades on Page:
+// a page overrides `open_link` (`return this.swap_link(link)`), so these only ever run through the page.
+export default class PageLinks {
+
+	page = null;
+
+	constructor(...args){ this.assign(...args); }
+	assign(...args){ return Object.assign(this, ...args); }
+
+	// A url to navigate to, or nothing when the page showed the link itself. The default navigates;
+	// in a columns tree, a doc from the page's own folder opens as the next column.
+	open(link){
+		const page = this.page, file = this.constructor.md_file(link);
+		if (!file) return link.pathname;
+
+		const dir = page.md_dir(), rel = dir && file.startsWith(dir) && file.slice(dir.length);
+		if (!rel || !page.column_host()) return this.constructor.md_url(file);
+
+		// A doc beside me becomes my child, so it opens as the very next column.
+		// One in a subfolder goes through my md/, which is a column of its own.
+		if (rel.includes("/")) return page.url + "md/" + rel.replace(/\.md$/i, "/");
+
+		const name = rel.slice(0, -3);
+		if (!page.children.has(name)) page.add(name, this.constructor.md_page(file));
+		return page.url + name + "/";
+	}
+
+	// Draw the doc inside the page with a way back, at its own address `<page url>md/<doc>/`. (doc/decisions.md)
+	swap(link){
+		const page = this.page, file = this.constructor.md_file(link);
+		if (!file) return link.pathname;
+
+		page.swap_close?.();
+		const shown = [...page.view.el.children].filter(el => !el.matches(".page-swap"));
+		shown.forEach(el => el.style.display = "none");
+
+		const url = this.swap_url(file);
+		const back = () => location.pathname === url ? history.back() : close();
+		const on_pop = () => { if (location.pathname !== url) close(); };
+		let $shell;
+		const close = () => {
+			$shell?.el.remove();
+			shown.forEach(el => el.style.display = "");
+			removeEventListener("popstate", on_pop);
+			page.swap_close = null;
+		};
+
+		page.view.append(() => {
+			div.c("page-swap pad", $swap => {
+				$shell = $swap;
+				button.c("page-swap-back flex v-center gap", () => { icon("arrow_back"); span("Back"); }).on("click", back);
+				page.constructor.file(file).then(doc => {
+					$swap.append(() => { doc ? doc.title && h2(doc.title) : p.c("muted", "Nothing could be read at " + file + "."); });
+					if (doc) $swap.append(doc.content());
+				});
+			});
+		});
+
+		page.swap_close = close;
+		if (location.pathname !== url) history.pushState({}, "", url + link.hash);
+		addEventListener("popstate", on_pop);
+	}
+
+	// Where a swapped doc lives: the page's own md/ when the doc is in its folder, else its module's.
+	swap_url(file){
+		const dir = this.page.md_dir();
+		return dir && file.startsWith(dir) ? this.page.url + "md/" + file.slice(dir.length).replace(/\.md$/i, "/") : this.constructor.md_url(file);
+	}
+
+	// The page's own folder's .md files, as links: the Router hands each click back to the page.
+	// `names` when the caller knows them; else the dev server's file list, which production does not have (so: nothing there).
+	files(names){
+		const dir = this.page.md_dir();
+
+		return ul.c("page-md-files", $list => {
+			const list = names ? Promise.resolve(names)
+				: import("./Markdown.js").then(({ default: PageMarkdown }) => PageMarkdown.files(dir));
+
+			list.then(files => $list.append(() => {
+				(files ?? []).filter(name => /\.md$/i.test(name) && !name.includes("/"))
+					.forEach(name => li(() => { a(name.slice(0, -3)).href(dir + name); }));
+			}));
+		});
+	}
+
+	// A page that is one .md file, headed by its file name; the file keeps its own h1.
+	static md_page(file){
+		return {
+			folder: file.replace(/[^/]*$/, ""),
+			content(){ return import("../../ext/markdown/md.js").then(({ md }) => md.file({ url: location.href }, file)); },
+		};
+	}
+
+	// The .md file a link points at: its href, or what md.route() rewrote it from.
+	static md_file(link){
+		return link.dataset?.md ?? (/\.md$/i.test(link.pathname) && !link.search ? link.pathname : null);
+	}
+
+	// A .md file's page when nothing nearer claims it: `<module>/md/<path>/` (module = the folder above doc/).
+	// ⚠ The trailing slash is load-bearing: a url ending in `.js` is answered as a file.
+	static md_url(file){
+		const doc = file.indexOf("/doc/");
+		const base = doc >= 0 ? file.slice(0, doc + 1) : file.replace(/[^/]*$/, "");
+		return base + "md/" + file.slice(base.length).replace(/\.md$/i, "/");
+	}
+}

new file mode 100644
index 000000000..badd001eb
--- /dev/null
+++ b/public/framework/ext/Refine/stages/ThingsIndex.mjs
@@ -0,0 +1,47 @@
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+/**
+ * class ThingsIndex — builds `things.json`, the list of named things ThingsStage listens for while you talk
+ * ("where is Dictate?" -> a link to /framework/ux/Dictate/). Computed from the folders, never typed by hand
+ * (CLAUDE.md law 7): every folder under core, ext, ui, ux, audio, dev and the ai systems that has a `page.js` is one thing.
+ *
+ *   node public/framework/ext/Refine/stages/ThingsIndex.mjs        // rewrites things.json; rerun when a module is added
+ *
+ * Single lowercase words (table, icon, toolbar) are skipped: spoken, they are just English. Hyphenated ones (push-to-talk) stay.
+ * `common: true` marks a name that is also an ordinary English word (Page, Tree, Filter): ThingsStage only
+ * matches those when they are spoken with a capital letter, so "the page should" does not light up #Page.
+ */
+export default class ThingsIndex {
+
+	static ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");   // public/framework
+	static TIERS = { core: "data_object", ext: "extension", ui: "widgets", ux: "touch_app", audio: "graphic_eq", dev: "terminal", ai: "smart_toy" };
+	static COMMON = new Set("page view list item app doc files tabs tags tree card content course auth menu filter rename layout research session task chat panel editor timeline drawer highlight markdown router sidebar wizard popover pagination understand inbox revise objects hotkeys log logs local process health errors council dashboard archive audits collab classes cards rail asks docs test tests try demo fixture start faq lab old audit search section shell ask claim socket system voice classify refine record recorder".split(" "));
+
+	static build(){
+		const things = {};
+		for (const [tier, icon] of Object.entries(ThingsIndex.TIERS)){
+			const dir = path.join(ThingsIndex.ROOT, tier);
+			if (!fs.existsSync(dir)) continue;
+			for (const e of fs.readdirSync(dir, { withFileTypes: true })){
+				if (!e.isDirectory() || /^\d{4}|^\.|^v\d*$|^new$/.test(e.name) || /^[a-z]+\d*$/.test(e.name) || !fs.existsSync(path.join(dir, e.name, "page.js"))) continue;
+				const key = e.name;
+				if (things[key] && tier === "ai") continue;   // a core/ext/ui/ux name wins over a same-named ai folder
+				things[key] = { url: `/framework/${tier}/${e.name}/`, icon, ...(ThingsIndex.COMMON.has(key.toLowerCase()) ? { common: true } : {}) };
+			}
+		}
+		return things;
+	}
+
+	static write(){
+		const things = ThingsIndex.build();
+		fs.writeFileSync(path.join(path.dirname(fileURLToPath(import.meta.url)), "things.json"), JSON.stringify(things, null, "\t") + "\n");
+		return things;
+	}
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)){
+	const things = ThingsIndex.write();
+	console.log(Object.keys(things).length + " things written to things.json");
+}
diff --git a/public/framework/ext/Refine/stages/ThingsStage.js b/public/framework/ext/Refine/stages/ThingsStage.js
new file mode 100644
index 000000000..e0f312d49
--- /dev/null
+++ b/public/framework/ext/Refine/stages/ThingsStage.js
@@ -0,0 +1,57 @@
+import { div, small } from "../../../core/View/View.js";
+import { maps, build_row } from "../../Mention/Mention.js";
+import VoiceStage from "./VoiceStage.js";
+
+/**
+ * Things spoken of: every named class, module or page you mention, shown as a linked card the moment the words arrive.
+ * No model, no cost: the names come from `things.json` (built from the folders by `ThingsIndex.mjs`) plus the Mention maps,
+ * and are matched in the browser against the raw words. Say "where is Dictate" and `ux/Dictate` is on screen as you finish the sentence.
+ *
+ *   ThingsStage.find("open the Dictate widget. then Page")   // [{ name: "Dictate", entry, sentence }, ...] first mention first
+ */
+export default class ThingsStage extends VoiceStage {
+	static key = "things";
+	static label = "Things you mentioned";
+	static fields = ["raw"];
+
+	static index = null;     // name -> { url, icon, common? }, filled once things.json has loaded
+	static views = new Set();
+	static loading = fetch(new URL("things.json", import.meta.url)).then(r => r.json()).then(j => {
+		ThingsStage.index = { ...j };
+		for (const [name, e] of Object.entries(maps["#"] ?? {})) if (e.url) ThingsStage.index[name] = { ...e, common: ThingsStage.index[name]?.common };
+		ThingsStage.views.forEach(v => v.draw());
+	}).catch(() => {});   // no index: the stage just stays empty
+
+	/** The words of a name as it would be spoken: "DesignTool" is also "design tool". */
+	static pattern(name){
+		const parts = name.replace(/\.md$/, "").split(/(?<=[a-z])(?=[A-Z])|[-_ ]/).filter(Boolean);
+		return parts.map(w => w.replace(/\W/g, c => "\\" + c)).join("[-_ ]?");
+	}
+
+	static find(text, index = ThingsStage.index){
+		if (!index || !text) return [];
+		const sentences = String(text).split(/(?<=[.!?])\s+/), found = [];
+		for (const [name, entry] of Object.entries(index)){
+			if (!entry.url || name.length < 3) continue;
+			const re = new RegExp("(?<![\\w/#@])" + ThingsStage.pattern(name) + "(?![\\w/])", entry.common ? "" : "i");   // a common word must be spoken with its capital
+			const at = sentences.findIndex(s => re.test(s));
+			if (at >= 0) found.push({ name, entry, sentence: sentences[at], at, pos: sentences[at].search(re) });
+		}
+		const seen = new Set();   // push-to-talk and PushToTalk are one spoken thing: the first mention wins
+		return found.sort((a, b) => a.at - b.at || a.pos - b.pos).filter(t => { const k = t.name.toLowerCase().replace(/\W|_/g, ""); return !seen.has(k) && seen.add(k); });
+	}
+
+	get things(){ return ThingsStage.find(this.data.raw); }
+	get ready(){ return this.things.length > 0; }
+}
+
+ThingsStage.View = class ThingsStageView extends VoiceStage.View {
+	render(){ super.render(); ThingsStage.views.add(this); }
+
+	body(){
+		div.c("voice-things", () => this.stage.things.forEach(t => div.c("voice-thing", $t => {
+			$t.el.append(build_row(t.name, { ...t.entry, class_card: t.entry.class_card ?? true }, "mention"));
+			small.c("muted voice-thing-said", "“" + t.sentence.slice(0, 140) + "”");
+		})));
+	}
+};

diff --git a/public/framework/ext/Figma/slug.js b/public/framework/ext/Figma/slug.js
new file mode 100644
index 000000000..a904bc860
--- /dev/null
+++ b/public/framework/ext/Figma/slug.js
@@ -0,0 +1,13 @@
+/* A Figma name, made safe for a url: lowercase, dashes, nothing else. Two siblings
+   that slugify to the same word keep the first's plain slug; every later one gets
+   its own id appended, so a collision never shadows the thing that got there first. */
+export function slugify(name){
+	return String(name ?? "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "item";
+}
+
+export function unique_slug(item, list){
+	const base = slugify(item.name);
+	const dupes = list.filter(x => slugify(x.name) === base);
+	return dupes.length > 1 && dupes.indexOf(item) > 0 ? `${base}-${String(item.id ?? item.key).replace(/[^a-z0-9]/gi, "")}` : base;
+}
+export default slugify;
diff --git a/public/framework/ext/Figma/sync.js b/public/framework/ext/Figma/sync.js
new file mode 100644
index 000000000..d37cf2b60
--- /dev/null
+++ b/public/framework/ext/Figma/sync.js
@@ -0,0 +1,13 @@
+/* A same-origin, blocking GET — used only for a cold deep link that lands straight on
+   a dynamic route() before the normal async cache has had a tick to warm (the exact
+   trade ext/AITask/dashboard.js's fetch_sync makes for the AI day pages: route() must
+   answer now, never with a Promise — Page.child() checks its result with a plain `if`). */
+export function fetch_text_sync(url){
+	const xhr = new XMLHttpRequest();
+	xhr.open("GET", url, false);
+	try { xhr.send(); } catch { return null; }
+	if (xhr.status < 200 || xhr.status >= 300) return null;
+	if ((xhr.getResponseHeader("content-type") ?? "").includes("html")) return null;   // SPA fallback
+	return xhr.responseText;
+}
+export default fetch_text_sync;

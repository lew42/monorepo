index 000000000..6451182a5
--- /dev/null
+++ b/public/framework/ext/Query/Query.js
@@ -0,0 +1,51 @@
+/* One query as plain JSON, run over an array of objects. Works in node and the browser (no imports).
+ * Doc: doc/architecture.md. Spec: { where: [{ field, op, value, fields? }], sort: { by, dir }, offset, limit, sum: [fields] }.
+ * ops: eq in gte lte contains (contains = case-insensitive substring over `field`, or over every name in `fields`). */
+export default class Query {
+
+	static OPS = {
+		eq: (v, w) => v === w,
+		in: (v, w) => Array.isArray(w) && w.includes(v),
+		gte: (v, w) => v != null && v >= w,
+		lte: (v, w) => v != null && v <= w,
+	};
+
+	constructor(spec = {}) {
+		this.where = spec.where ?? [];
+		this.sort = spec.sort ?? null;
+		this.offset = Math.max(0, spec.offset ?? 0);
+		this.limit = spec.limit ?? 50;
+		this.sum = spec.sum ?? [];
+		this.tests = this.where.map(w => Query.test(w));
+	}
+
+	/** A predicate for one `where` clause. */
+	static test({ field, fields, op, value }) {
+		if (op === "contains") {
+			const needle = String(value ?? "").toLowerCase(), names = fields ?? [field];
+			return item => !needle || names.some(n => item[n] != null && String(item[n]).toLowerCase().includes(needle));
+		}
+		const fn = Query.OPS[op];
+		if (!fn) throw new Error("Query: unknown op " + op);
+		return item => fn(item[field], value);
+	}
+
+	matches(item) { return this.tests.every(t => t(item)); }
+
+	/** `items` is any iterable. Returns { rows (the page), total (all matches), totals ({field: sum over ALL matches}), offset }. */
+	run(items) {
+		const hit = [];
+		for (const item of items) if (this.matches(item)) hit.push(item);
+		const totals = {};
+		for (const f of this.sum) totals[f] = hit.reduce((n, r) => n + (typeof r[f] === "number" ? r[f] : 0), 0);
+		if (this.sort?.by) {
+			const { by, dir } = this.sort, sign = dir === "asc" ? 1 : -1;
+			hit.sort((a, b) => {
+				const x = a[by], y = b[by];
+				if (x == null || y == null) return x == null ? (y == null ? 0 : 1) : -1;   // nulls last either way
+				return (x < y ? -1 : x > y ? 1 : 0) * sign;
+			});
+		}
+		return { rows: hit.slice(this.offset, this.offset + this.limit), total: hit.length, totals, offset: this.offset };
+	}
+}
diff --git a/public/framework/ext/Query/QueryClient.js b/public/framework/ext/Query/QueryClient.js
new file mode 100644
index 000000000..0ea68784a
--- /dev/null
+++ b/public/framework/ext/Query/QueryClient.js
@@ -0,0 +1,36 @@
+import Socket from "/framework/dev/Socket/Socket.js";
+
+/* The browser half of ext/Query: asks the dev server (QueryServer.mjs) one query over the socket and hands back the page of rows.
+ *   const q = new QueryClient("sessions", { row: (qid, item) => …, stale: qid => … });
+ *   const res = await q.ask({ where, sort, offset, limit, sum });   // { rows, total, totals, offset, qid, ms } or { error }
+ * The server then pushes `query_row` (a shown row changed) and `query_stale` (the page may have new matches) for the last qid. Doc: doc/architecture.md. */
+export default class QueryClient {
+
+	static current = null;
+	static counter = 0;
+
+	/** The dev socket, or null off localhost (a static host): the caller falls back to reading files. */
+	static socket() {
+		if (typeof location === "undefined" || !/^(localhost|127\.0\.0\.1|.*\.localhost)$/.test(location.hostname)) return null;
+		try { return Socket.singleton(); } catch { return null; }
+	}
+
+	constructor(source, { row, stale } = {}) {
+		this.source = source; this.on_row = row; this.on_stale = stale;
+		this.qid = 0;
+		QueryClient.current = this;
+	}
+
+	/** `more`: the next page of the same query (same qid); otherwise a fresh query. */
+	async ask(spec, { more = false } = {}) {
+		const socket = QueryClient.socket();
+		if (!socket) return { error: "no socket" };
+		if (!more) this.qid = ++QueryClient.counter + Date.now() % 1e6 * 1e3;
+		await Promise.race([socket.ready, new Promise(r => setTimeout(r, 1500))]);
+		const answer = await Promise.race([socket.request({ method: "query", args: [{ ...spec, source: this.source, qid: this.qid }] }), new Promise(r => setTimeout(() => r({ response: { error: "timeout" } }), 5000))]);
+		return answer?.response ?? { error: "no answer" };
+	}
+}
+
+Socket.prototype.query_row = function (qid, item) { const q = QueryClient.current; if (q?.qid === qid) q.on_row?.(item); };
+Socket.prototype.query_stale = function (qid) { const q = QueryClient.current; if (q?.qid === qid) q.on_stale?.(); };
diff --git a/public/framework/ext/Query/QueryServer.mjs b/public/framework/ext/Query/QueryServer.mjs
new file mode 100644
index 000000000..ab138358f
--- /dev/null
+++ b/public/framework/ext/Query/QueryServer.mjs
@@ -0,0 +1,112 @@
+import Query from "./Query.js";
+
+/* The node half of ext/Query: a registry of named SOURCES (each holds items in memory) and a socket plugin that answers
+ * rpc:query for them and keeps each browser's shown page current. Doc: doc/architecture.md, core/Page/doc/server.md.
+ *   QueryServer.source("sessions", { load, items, on, unload, unload_after, available })
+ *     load()          async; run on the first query, never again while loaded
+ *     items()         an iterable of plain objects (each with an `id`)
+ *     on(fn)          subscribe to changes: fn(item, changed, before); returns the unsubscribe
+ *     unload()        drop what load() built (optional); runs after `unload_after` ms (default 5 min) with no query and no watcher
+ *     available()     false = answer { error: "no source" } (optional) */
+export default class QueryServer {
+
+	static sources = new Map();
+	static STALE_MS = 1000;
+	static counter = 0;
+
+	static source(name, def) {
+		const src = new QueryServer.Source(name, def);
+		QueryServer.sources.set(name, src);
+		return src;
+	}
+
+	static setup(socket) { new QueryServer(socket); }
+
+	constructor(socket) {
+		this.socket = socket;
+		this.last = null;       // { qid, src, query, ids:Set } - the one query this browser is showing
+		this.src = null; this.off = null;
+		this.stale_at = 0; this.stale_timer = null;
+		socket.on("rpc:query", (args, index) => this.answer(args?.[0] ?? {}, index));
+		socket.on("closed", () => this.close());
+	}
+
+	async answer(spec, index) {
+		const t0 = performance.now(), src = QueryServer.sources.get(spec.source);
+		if (!src || src.available?.() === false) return this.socket.send({ response: { error: "no source", source: spec.source }, index });
+		try {
+			await src.ensure();
+			const query = new Query(spec), res = query.run(src.items());
+			const same = this.last?.qid === spec.qid && this.last?.src === src;
+			const qid = spec.qid ?? ++QueryServer.counter;
+			const ids = same ? this.last.ids : new Set();
+			res.rows.forEach(r => ids.add(r.id));
+			this.last = { qid, src, query, ids };
+			this.watch(src);
+			this.socket.send({ response: { ...res, qid, ms: +(performance.now() - t0).toFixed(1) }, index });
+		} catch (e) {
+			this.socket.send({ response: { error: e.message }, index });
+		}
+	}
+
+	/** One change listener per browser, on the source it last asked. */
+	watch(src) {
+		if (this.src === src) return;
+		this.close();
+		this.src = src;
+		this.off = src.subscribe(item => this.changed(item));
+	}
+
+	changed(item) {
+		const last = this.last;
+		if (!last) return;
+		if (last.ids.has(item.id)) return this.socket.rpc("query_row", last.qid, item);
+		if (last.query.matches(item)) this.stale(last.qid);
+	}
+
+	/** query_stale at most once a second; the browser re-asks for its page. */
+	stale(qid) {
+		const wait = QueryServer.STALE_MS - (Date.now() - this.stale_at);
+		const send = () => { this.stale_timer = null; this.stale_at = Date.now(); this.socket.rpc("query_stale", this.last?.qid ?? qid); };
+		if (wait <= 0) return send();
+		this.stale_timer ??= setTimeout(send, wait);
+	}
+
+	close() {
+		this.off?.(); this.off = null; this.src = null;
+		clearTimeout(this.stale_timer); this.stale_timer = null;
+	}
+}
+
+/* One named source: loads on demand, unloads when idle. */
+QueryServer.Source = class Source {
+
+	constructor(name, { load, items, on, unload, unload_after = 5 * 60000, available }) {
+		Object.assign(this, { name, load, items, on, unload, unload_after, available });
+		this.loaded = null; this.watchers = 0; this.timer = null;
+	}
+
+	ensure() {
+		this.loaded ??= Promise.resolve(this.load?.());
+		this.idle();
+		return this.loaded;
+	}
+
+	/** (Re)start the idle clock; at the end, unload if nobody is watching. */
+	idle() {
+		clearTimeout(this.timer);
+		this.timer = setTimeout(() => {
+			if (this.watchers > 0) return this.idle();
+			this.loaded = null;
+			this.unload?.();
+		}, this.unload_after);
+		this.timer.unref?.();
+	}
+
+	subscribe(fn) {
+		this.watchers++;
+		const off = this.on?.(fn);
+		let done = false;
+		return () => { if (done) return; done = true; this.watchers--; off?.(); };
+	}
+};

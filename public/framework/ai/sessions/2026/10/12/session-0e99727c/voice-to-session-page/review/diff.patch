+/* The five stages of a spoken prompt on a session page (ext/Refine/stages). Tokens only. */
+@layer site {
+	.voice-flow { display: grid; gap: var(--gap); margin-block-end: var(--gap); }
+	.voice-prompt { display: grid; gap: .5em; padding: .6em; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: .5em; min-width: 0; }
+	.voice-prompt-h { display: flex; gap: .5em; align-items: baseline; flex-wrap: wrap; font-weight: 600; }
+	.voice-stages { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr)); gap: .6em; align-items: start; }
+	.voice-stage { min-width: 0; padding: .4em .5em; border-inline-start: 2px solid color-mix(in srgb, currentColor 25%, transparent); }
+	.voice-stage[hidden] { display: none; }
+	.voice-stage-h { display: flex; justify-content: space-between; gap: .5em; font-weight: 600; margin-block-end: .25em; }
+	.voice-stage-tag { font-weight: 400; font-size: .85em; }
+	.voice-raw, .voice-refined { white-space: pre-wrap; overflow-wrap: anywhere; }
+	.voice-sentence { display: flex; gap: .4em; align-items: baseline; padding-block: .1em; }
+	.voice-s-num, .voice-cites { font-size: .75em; }
+	.voice-section { margin-block: .3em; }
+	.voice-section-t, .voice-card-t, .voice-subject { font-weight: 600; }
+	.voice-leaf { padding-inline-start: .6em; }
+	.voice-sub { margin-inline-start: .6em; }
+	.voice-cards { display: grid; gap: .4em; }
+	.voice-card { padding: .3em .5em; border-radius: .3em; background: color-mix(in srgb, currentColor 6%, transparent); }
+	.voice-card-i { padding-inline-start: .4em; }
+	.voice-card-f { display: flex; gap: .5em; flex-wrap: wrap; font-size: .8em; }
+	.voice-flag { color: var(--warn); margin-inline-start: .4em; cursor: help; }
+	.voice-copy { margin-block-start: .4em; }
+}
diff --git a/public/framework/ext/Refine/stages/VoiceStage.js b/public/framework/ext/Refine/stages/VoiceStage.js
new file mode 100644
index 000000000..5a1cb6400
--- /dev/null
+++ b/public/framework/ext/Refine/stages/VoiceStage.js
@@ -0,0 +1,54 @@
+import { View, div, span } from "../../../core/View/View.js";
+
+View.stylesheet(import.meta, "VoiceStage.css");
+
+/**
+ * class VoiceStage — ONE step of a spoken prompt as it passes through the pipeline, and how it looks.
+ * A subclass names its `key`, its `label`, and the `fields` of the voice-prompt item (VoicePrompt.js) it shows;
+ * its `View` draws them. The five: RawStage → CleanStage → StructureStage → RefinedStage → CardsStage.
+ *
+ *   new CleanStage(voice_prompt).ready      // true once any of its fields has a value
+ *   new CleanStage.View({ stage })           // redraws itself with `view.draw()` when its fields change
+ *
+ * Class map and the wire format: ../doc/voice-to-page.md
+ */
+export default class VoiceStage {
+
+	static key = "";
+	static label = "";
+	static hint = "";
+	static fields = [];
+
+	constructor(prompt){ this.prompt = prompt; }
+
+	get data(){ return this.prompt.data; }
+	get ready(){ return this.constructor.fields.some(f => { const v = this.data[f]; return Array.isArray(v) ? v.length > 0 : !!v; }); }
+	/** True while later words may still replace this stage's content. */
+	get live(){ return false; }
+	/** Milliseconds this stage took (from the server's timing), or null. */
+	get ms(){ return this.data.ms?.[this.constructor.key] ?? null; }
+}
+
+VoiceStage.View = class VoiceStageView extends View {
+
+	render(){
+		const S = this.stage.constructor;
+		this.ac("voice-stage").attr("data-stage", S.key);
+		div.c("voice-stage-h", () => {
+			span.c("voice-stage-label", S.label);
+			this.$tag = span.c("voice-stage-tag muted");
+		});
+		this.$body = div.c("voice-stage-body");
+		this.draw();
+	}
+
+	draw(){
+		const stage = this.stage;
+		this.el.hidden = !stage.ready;
+		this.$tag.text(stage.live ? "live" : stage.ms != null ? (stage.ms / 1000).toFixed(1) + " s" : "");
+		this.$body.empty(() => { if (stage.ready) this.body(); });   // a stage with nothing yet draws nothing (its body reads fields that are not there)
+	}
+
+	/** Subclasses draw their fields here (inside the body box). */
+	body(){}
+};

+import { div, span } from "../../../core/View/View.js";
+import VoiceStage from "./VoiceStage.js";
+import Outline from "../Outline.js";
+
+/** Stage 3 · Structure: the sentences grouped under headings; every `S#` points back at a clean sentence. */

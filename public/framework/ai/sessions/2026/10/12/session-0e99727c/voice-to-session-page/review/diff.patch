diff --git a/public/framework/ext/Refine/stages/VoiceFlow.js b/public/framework/ext/Refine/stages/VoiceFlow.js
new file mode 100644
index 000000000..3afa21f18
--- /dev/null
+++ b/public/framework/ext/Refine/stages/VoiceFlow.js
@@ -0,0 +1,64 @@
+import { View, div } from "../../../core/View/View.js";
+import VoicePrompt from "./VoicePrompt.js";
+import Socket from "/framework/dev/Socket/Socket.js";
+import { servex_url } from "/framework/dev/servex_url.js";
+
+/**
+ * class VoiceFlow — every spoken prompt on one session page, drawn live, newest first.
+ * It reads the session's page.jsonl lines (the page tool's deltas) and keeps one VoicePrompt per
+ * `voice-prompt` item: `{"content":{"add":{"id":"voice-x","type":"voice-prompt",...}}}` creates it,
+ * `{"voice-x":{"clean":[...]}}` updates it. A line it does not know is ignored.
+ *
+ *   const flow = new VoiceFlow();
+ *   mount(flow.view); log.read = entries => flow.read(entries);
+ */
+export default class VoiceFlow {
+
+	prompts = new Map();
+	view = new VoiceFlow.View({ flow: this });
+
+	/** Off localhost the dev socket is off (it carries rpc:write), so the page file is only loaded once; a phone follows Servex's read-only voice stream instead (`GET /api/voice/stream`). */
+	follow(session){
+		if (!Socket.singleton().disabled || this.source || typeof EventSource === "undefined") return this;
+		this.source = new EventSource(servex_url(`/api/voice/stream?session=${encodeURIComponent(session)}`));
+		this.source.onmessage = e => { try { this.read(JSON.parse(e.data)); } catch {} };
+		return this;
+	}
+
+	read(entries){
+		const touched = new Map();
+		const note = (p, keys) => touched.set(p, new Set([...(touched.get(p) ?? []), ...keys]));
+		for (const line of [entries].flat()){
+			if (!line || typeof line !== "object") continue;
+			const add = line.content?.add;
+			if (add?.type === "voice-prompt" && add.id){
+				const fresh = !this.prompts.has(add.id);
+				if (fresh) this.prompts.set(add.id, new VoicePrompt(add.id));
+				const p = this.prompts.get(add.id);
+				note(p, p.apply(add));
+				if (fresh) touched.get(p).add("*");
+				continue;
+			}
+			for (const key of Object.keys(line)) if (this.prompts.has(key) && line[key] && typeof line[key] === "object") note(this.prompts.get(key), this.prompts.get(key).apply(line[key]));
+		}
+		if (touched.size) this.view.update(touched);
+		return this;
+	}
+}
+
+VoiceFlow.View = class VoiceFlowView extends View {
+
+	render(){ this.ac("voice-flow"); this.el.hidden = true; this.pv = new Map(); }
+
+	update(touched){
+		this.el.hidden = false;
+		for (const [prompt, keys] of touched){
+			let v = this.pv.get(prompt);
+			if (!v){
+				this.append(() => { v = new VoicePrompt.View({ prompt }); });   // built inside this view, so the page it is read from can never capture it (View.captor)
+				this.pv.set(prompt, v); this.el.prepend(v.el);
+			}
+			else v.draw(keys.has("*") ? undefined : keys);
+		}
+	}
+};
diff --git a/public/framework/ext/Refine/stages/VoicePrompt.js b/public/framework/ext/Refine/stages/VoicePrompt.js
new file mode 100644
index 000000000..92d987007
--- /dev/null
+++ b/public/framework/ext/Refine/stages/VoicePrompt.js
@@ -0,0 +1,63 @@
+import { View, div, span } from "../../../core/View/View.js";
+import RawStage from "./RawStage.js";
+import CleanStage from "./CleanStage.js";
+import StructureStage from "./StructureStage.js";
+import RefinedStage from "./RefinedStage.js";
+import CardsStage from "./CardsStage.js";
+
+/**
+ * class VoicePrompt — one spoken prompt on a session page: the folded state of a `voice-prompt` item
+ * and its five stages. A delta merges shallowly into `data` (the same rule the page replay uses), and
+ * `apply()` says which stages it touched so only those redraw.
+ *
+ *   const p = new VoicePrompt("voice-ab12", { raw: "so the page should" });
+ *   p.apply({ raw: "so the page should show", raw_final: true });   // -> ["raw"]
+ *   p.stages        // [RawStage, CleanStage, StructureStage, RefinedStage, CardsStage]
+ *
+ * Wire format and who writes it: ../doc/voice-to-page.md (server half: Servex/ext/refine/VoicePage.js).
+ */
+export default class VoicePrompt {
+
+	static STAGES = [RawStage, CleanStage, StructureStage, RefinedStage, CardsStage];
+
+	data = {};
+
+	constructor(id, data = {}){
+		this.id = id;
+		this.stages = VoicePrompt.STAGES.map(S => new S(this));
+		this.apply(data);
+	}
+
+	apply(delta){
+		const touched = new Set(["status"]);
+		for (const [key, value] of Object.entries(delta ?? {})){
+			if (key === "id" || key === "type" || key === "by" || key === "ts") continue;
+			this.data[key] = value;
+			for (const s of this.stages) if (s.constructor.fields.includes(key) || (key === "raw_final" && s instanceof RawStage) || (key === "clean_final" && s instanceof CleanStage) || key === "ms") touched.add(s.constructor.key);
+		}
+		return touched;
+	}
+
+	/** One plain sentence saying where this prompt is. */
+	get status(){
+		const d = this.data;
+		return d.error ? "Stopped: " + d.error : d.status === "done" ? "Done" : d.status ?? "Hearing you";
+	}
+}
+
+VoicePrompt.View = class VoicePromptView extends View {
+
+	render(){
+		const p = this.prompt;
+		this.ac("voice-prompt");
+		div.c("voice-prompt-h", () => { span.c("voice-mic", "🎙"); this.$status = span.c("voice-status"); span.c("muted", p.data.source ?? ""); });
+		this.views = {};
+		div.c("voice-stages", () => p.stages.forEach(s => this.views[s.constructor.key] = new s.constructor.View({ stage: s })));
+		this.draw();
+	}
+
+	draw(touched){
+		this.$status.text(this.prompt.status);
+		for (const [key, view] of Object.entries(this.views)) if (!touched || touched.has(key)) view.draw();
+	}
+};

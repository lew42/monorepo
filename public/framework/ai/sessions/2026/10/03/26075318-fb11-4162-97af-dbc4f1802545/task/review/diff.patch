+
+	.refine-modes-condensed, .refine-modes-clean { margin: 0; padding-inline-start: 1.4em; }
+	.refine-modes-condensed-item { cursor: pointer; }
+	.refine-modes-condensed-item:hover, .refine-modes-condensed-item:focus-visible { text-decoration: underline; }
+	.refine-modes-section { margin-block-end: 0.5em; }
+	.refine-modes-heading { font-weight: 600; margin-block-end: 0.2em; }
+	.refine-modes-bullets { margin: 0; padding-inline-start: 1.4em; }

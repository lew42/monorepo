@@ -0,0 +1,36 @@
+/* THE MODE SWITCH (`prompt-card.js`'s `prompt_modes()`) — Condensed, Structured, Clean,
+   Raw. Loaded by `prompt-card.js` itself (`View.stylesheet`), so every page that imports
+   the component gets this for free, with nothing to add to its own stylesheet. Moved out
+   of `ai/v/3/v3.css` on 2026-10-02 once `ai2` needed the same component too. */
+@layer theme {
+
+	/* Same quiet toggle look as `ai2`'s and `ai/v/3`'s own view-switch tabs
+	   (law 6, reused rather than re-invented): a pressed-looking tab for the
+	   mode you're on, plain text for the rest. */
+	.refine-modes-tabs { display: flex; gap: 0.2em; padding: 0.15em; margin-block-end: 0.4em; background: var(--wash); border-radius: 0.4em; width: fit-content; }
+	.refine-modes-tab {
+		display: inline-block; padding: 0.15em 0.6em; font: inherit; font-size: 0.8125rem;
+		cursor: pointer; color: var(--subtle); background: none; border: 0; border-radius: 0.3em;
+	}

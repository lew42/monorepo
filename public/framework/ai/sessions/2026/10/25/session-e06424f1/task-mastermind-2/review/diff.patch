+#!/usr/bin/env node
+// Server/lines-per-thought.mjs <session.jsonl> — how many session.jsonl lines, and bytes, one
+// spoken thought (one Prompt) costs. Written for chat-live (build-brief.md, 2026-10-25): the
+// baseline was 511 thoughts / 1214 chunks / ~10.5 lines each in a real voice session's file.
+// Run it before and after a write-path change to see the real effect, in lines AND bytes — a
+// line can shrink a lot (dropping `cues`) without its count changing at all.
+//
+//   node Server/lines-per-thought.mjs public/framework/ai/sessions/2026/10/25/v-sq8y7db/session.jsonl
+import fs from "node:fs";
+
+const file = process.argv[2];
+if (!file) { console.error("usage: node Server/lines-per-thought.mjs <session.jsonl>"); process.exit(1); }
+
+const bytes = s => Buffer.byteLength(s, "utf8");
+
+/* Every line's KIND, by its one top-level verb; a `{"<id>": {...}, ts, by}` prompt-record delta
+ * (PromptLines.js's own shape) is told apart by having exactly `ts` and `by` alongside the id key. */
+function kind_of(j){
+	if (j.chat) return "chat";
+	if (j.sent) return "sent";
+	if (j.place) return "place";
+	if (j.done) return "done";
+	if (j.quiet) return "quiet";
+	if (j.nav) return "nav";
+	if (j.react) return "react";
+	if (j.log) return "log";
+	if (j.refined) return "refined";
+	if (j.backing) return "backing";
+	if (j.session) return "session-head";
+	const keys = Object.keys(j);
+	if (keys.length === 3 && keys.includes("ts") && keys.includes("by")) return "prompt-record";
+	return "other";
+}
+
+const lines = fs.readFileSync(file, "utf8").split("\n").filter(Boolean);
+const chunks = new Set();      // owner chat lines' own `at` (one per spoken/typed chunk)
+const prompts = new Set();     // Prompt ids seen (tasks.add type:"Prompt")
+const kind_n = {}, kind_bytes = {};
+let raw_bytes = 0, cues_bytes = 0, chat_text_bytes = 0, total_bytes = 0;
+
+for (const l of lines){
+	let j; try { j = JSON.parse(l); } catch { continue; }
+	const k = kind_of(j), b = bytes(l);
+	kind_n[k] = (kind_n[k] ?? 0) + 1;
+	kind_bytes[k] = (kind_bytes[k] ?? 0) + b;
+	total_bytes += b;
+	if (j.chat){
+		chunks.add(j.chat.at);
+		chat_text_bytes += bytes(j.chat.text ?? "");
+		if (j.chat.raw) raw_bytes += bytes(JSON.stringify(j.chat.raw));
+		if (j.chat.cues) cues_bytes += bytes(JSON.stringify(j.chat.cues));
+	}
+	if (k === "prompt-record"){
+		const key = Object.keys(j).find(x => x !== "ts" && x !== "by"), body = j[key];
+		if (key === "tasks" && body?.add?.type === "Prompt"){
+			prompts.add(body.add.id);
+			if (body.add.raw) raw_bytes += bytes(JSON.stringify(body.add.raw));
+		} else if (body?.raw?.push !== undefined) raw_bytes += bytes(JSON.stringify(body.raw.push));   // push_raw / set_raw
+	}
+}
+
+const n_prompts = prompts.size || 1, n_chunks = chunks.size || 1, n_lines = lines.length;
+
+console.log(`file: ${file}`);
+console.log(`total lines: ${n_lines}   total bytes: ${total_bytes.toLocaleString()}`);
+console.log(`thoughts (Prompts): ${prompts.size}   chunks (owner chat lines): ${chunks.size}`);
+console.log("");
+console.log("by kind:  count   lines/thought   bytes   bytes/thought");
+for (const k of Object.keys(kind_n).sort((a, b) => kind_bytes[b] - kind_bytes[a])){
+	console.log(`  ${k.padEnd(14)} ${String(kind_n[k]).padStart(5)}   ${(kind_n[k] / n_prompts).toFixed(2).padStart(6)}        `
+		+ `${kind_bytes[k].toLocaleString().padStart(9)}   ${Math.round(kind_bytes[k] / n_prompts).toLocaleString().padStart(7)}`);
+}
+console.log("");
+console.log(`lines per thought (all kinds): ${(n_lines / n_prompts).toFixed(2)}`);
+console.log(`lines per chunk:               ${(n_lines / n_chunks).toFixed(2)}`);
+console.log(`bytes per thought (all kinds): ${Math.round(total_bytes / n_prompts).toLocaleString()}`);
+console.log("");
+console.log(`chat.text bytes:  ${chat_text_bytes.toLocaleString()} (${(100 * chat_text_bytes / total_bytes).toFixed(1)}% of file)`);
+console.log(`chat/record .raw bytes: ${raw_bytes.toLocaleString()} (${(100 * raw_bytes / total_bytes).toFixed(1)}% of file)`);
+console.log(`chat.cues bytes:  ${cues_bytes.toLocaleString()} (${(100 * cues_bytes / total_bytes).toFixed(1)}% of file)`);

+import { Page, md, div } from "/app.js";
+import { item } from "../../../ui/item/item.js";
+import { inspect } from "../../Content/Object/Inspect.js";
+import Dictate from "../Dictate.js";
+import { Floor } from "../Floor.js";
+import { ChatController } from "../ChatController.js";
+
+// **One stable key per live instance** — every tick throws away the whole tree and
+// rebuilds it from `Klass.instances()` (a fresh array each time), so a plain array
+// index can't tell "the same mic, read again" from "a different mic" across two
+// ticks. A `WeakMap` gives each real object one id, made once, the first time this
+// page ever sees it — review round 1, finding 1: without this, a row the owner
+// opened to read its properties snapped shut on the very next tick.
+const IDS = new WeakMap();
+let next_id = 1;
+function key_for(obj){
+	if (!IDS.has(obj)) IDS.set(obj, "k" + next_id++);
+	return IDS.get(obj);
+}
+
+/**
+ * **Live** — the running Dictate SYSTEM, drawn from its own real objects, not a diagram of
+ * them. The owner, 2026-10-04: "use icon items in a hierarchical way to render the actual
+ * instances... a good default view for the instance should show all the properties and the
+ * current state." `item()` (`ui/item/item.js`) is the hierarchy — the same file-tree row
+ * every other tree on this site uses, nested here as **Dictate → its parts**; `inspect()`
+ * (`ux/Content/Object/Inspect.js`) is the instance/class card inside each row — both reused
+ * whole (CLAUDE.md law 6), neither rebuilt. Each class below opted in to being listed at all
+ * with ONE line, `core/track/track.js`'s `track(Klass)` — most classes never do this;
+ * `Dictate`/`Floor`/`ChatController` now do, just for this tab.
+ *
+ * `Klass.weights` (set once, beside each class — `Dictate.js`/`Floor.js`/`ChatController.js`'s
+ * own bottom lines) is the simplest form of "a weight decides the order": a named list of
+ * properties, read here and handed straight to `inspect()`'s own `properties:` option —
+ * `ux/Content/Object`'s existing mechanism, not a new one.
+ */
+export default new Page({
+	meta: import.meta,
+	title: "Live",
+	description: "The running Dictate system — every mic, the floor, every chat session — as real, live objects, nested.",
+	icon: "visibility",
+
+	content(){
+		md("**What is actually running right now**, nested the way the parts actually relate — the Dictate SYSTEM is the root; its mic(s), the one shared `Floor`, and every open chat session are its children. No mic pressed yet means `state: \"idle\"` really is what the object says, not a guess. Updates every second. Beside it: the three classes themselves, API first.");
+
+		// SIDE BY SIDE ON A WIDE SCREEN, STACKED ON A NARROW ONE (review round 2 finding 2,
+		// round 3 finding 1: a plain `flex gap` with no `wrap` held the two columns side by
+		// side even at 400, clipping the right one instead of dropping it below). `wide`
+		// escapes `.page`'s own measure cap so this row can use a 1920/3440 screen; the
+		// `26em`/`20em` flex bases are each column's own natural width, so `wrap` drops the
+		// second one below the first the moment they can no longer both fit.
+		// `0 1 <em>` on BOTH columns (review round 6, finding 1): `grow > 0` on either one let
+		// it eat whatever space the row had left, so the two drifted 600px apart at 3440
+		// instead of sitting together. Neither column grows now — each keeps its own width,
+		// and the row's own leftover space (there's plenty, at 3440) collects after them,
+		// not between them.
+		div.c("wide flex gap wrap", () => {
+			this.$live = div.c("ux-dictate-live").style("flex", "0 1 34em");
+			div.c("ux-dictate-live-classes flex v gap", () => {
+				md("#### The three classes, API first");
+				md("The owner's own rule: \"a good default view for any class should show all the methods.\" `inspect(Klass)` is the class card: same icon, every property NAME a fresh instance will have (most with no value yet — those are only set once it is actually used), every method it answers to.");
+				inspect(Dictate, { properties: Dictate.weights?.properties, doc: "/framework/ux/Dictate/" });
+				inspect(Floor, { properties: Floor.weights?.properties, doc: "/framework/ux/Dictate/" });
+				inspect(ChatController, { properties: ChatController.weights?.properties, doc: "/framework/ux/Dictate/" });
+			}).style("flex", "0 1 26em");
+		});
+
+		// WHICH ROWS ARE OPEN SURVIVES A REDRAW (review round 1, finding 1) — every real
+		// `<details>` this tree draws gets `data-key` (below); the native `toggle` event
+		// doesn't bubble, so this listens in the CAPTURE phase on the one container instead
+		// of one listener per row.
+		this.open_keys = new Set();
+		// Open by default (review round 4, note 3: "the default view never shows an
+		// instance's properties") — seeded ONCE, into the same `open_keys` a later close
+		// removes from, so a reader who closes it stays closed across the next redraw
+		// too, instead of a hardcoded `open: true` snapping it back every tick.
+		const first_floor = Floor.instances?.()[0];
+		if (first_floor) this.open_keys.add(key_for(first_floor));
+		this.$live.el.addEventListener("toggle", e => {
+			const key = e.target?.dataset?.key;
+			if (!key) return;
+			e.target.open ? this.open_keys.add(key) : this.open_keys.delete(key);
+		}, true);
+		this.redraw();
+		this.timer = setInterval(() => this.redraw(), 1000);
+		// No framework-wide "unmount" hook (`Dictate.js`'s own `hotkey()` doc names the same
+		// gap) — stop the interval once this page's own box leaves the DOM, the same
+		// `MutationObserver` trick `page.js`'s own `demo_mount()` already uses.
+		const mo = new MutationObserver(() => {
+			if (this.$live.el.isConnected) return;
+			mo.disconnect();
+			clearInterval(this.timer);
+		});
+		mo.observe(document.body, { childList: true, subtree: true });
+
+		md.details(import.meta, "readme.md", "Readme");
+	},
+
+	/** Redrawn every tick — one tree, `Dictate` at the root, every live instance nested
+	 *  under the part it belongs to (`item()`'s own `children`, `ui/item/item.js`). Nested
+	 *  `inspect()` cards stay closed by default (a tick never re-opens something the reader
+	 *  had open); the whole tree is rebuilt each tick (`empty()` first) — the same cost any
+	 *  live list on this site already pays (`ai2/live.js`). */
+	redraw(){
+		const mics = Dictate.instances?.() ?? [];
+		const floors = Floor.instances?.() ?? [];
+		const sessions = ChatController.instances?.() ?? [];
+		const is_open = key => this.open_keys.has(key);
+
+		this.$live.empty(() => {
+			item({
+				// "The Dictate system" (review round 2, note 7), not bare "Dictate" — `Floor`
+				// and the chat sessions are not parts of any ONE `Dictate` instance, they are
+				// parts of the system `Dictate` is the front door of.
+				icon: Dictate.icon, name: "The Dictate system", open: true,
+				children: () => {
+					item({
+						icon: "mic", name: `mic${mics.length === 1 ? "" : "s"} (${mics.length})`, open: true,
+						children: () => mics.length
+							? mics.forEach((d, i) => {
+								const key = key_for(d);
+								// A bare "idle" repeated N times can't be told apart (review round 1,
+								// note 5) — `mode` (open mic vs the typed box) is the one real
+								// difference this page can read without a caller naming its own
+								// surface; the index keeps every row unique either way.
+								const name = `#${i + 1} ${d.state}` + (d.mode ? ` · ${d.mode}` : "");
+								item({ icon: Dictate.icon, name, open: is_open(key),
+									children: () => inspect(d, { properties: Dictate.weights?.properties }) }).attr("data-key", key);
+							})
+							: md("*none on this page right now*"),
+					});
+					item({
+						icon: Floor.icon, name: "floor — who has the mic", open: true,
+						// There is only ever ONE `Floor` (one shared instance, `Floor.js`'s own
+						// class doc) — open it by default, so this page shows at least one real
+						// instance's properties without a click (review round 4, note 3: "the
+						// default view never shows an instance's properties").
+						children: () => floors.forEach(f => {
+							const key = key_for(f);
+							item({ icon: Floor.icon, name: f.owner ? "someone has the floor" : "idle", open: is_open(key),
+								children: () => inspect(f, { properties: Floor.weights?.properties }) }).attr("data-key", key);
+						}),
+					});
+					item({
+						icon: ChatController.icon, name: `chat session${sessions.length === 1 ? "" : "s"} (${sessions.length})`, open: true,
+						children: () => sessions.forEach(s => {
+							const key = key_for(s);
+							item({ icon: ChatController.icon, name: s.ctl.session ? "started" : "none yet", open: is_open(key),
+								children: () => inspect(s, { properties: ChatController.weights?.properties }) }).attr("data-key", key);
+						}),
+					});
+				},
+			});
+		});
+	},
+});

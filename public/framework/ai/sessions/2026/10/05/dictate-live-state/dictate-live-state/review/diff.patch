+			this.heard = true;
+			this.silent_at = null;
+			this.fired = 0;
+		} else {
+			if (this.quiet_since == null) this.quiet_since = now;
+			this.silent_at ??= now;
+			while (this.fired < this.quiet_marks.length && now - this.silent_at >= this.quiet_marks[this.fired]) this.quiet(this.quiet_marks[this.fired++]);
+		}
+		this.last_at = now;
+	}

diff --git a/public/framework/ux/Dictate/ChatController.js b/public/framework/ux/Dictate/ChatController.js
new file mode 100644
index 000000000..932ada474
--- /dev/null
+++ b/public/framework/ux/Dictate/ChatController.js
@@ -0,0 +1,150 @@
+import floor from "./Floor.js";
+import * as Session from "/framework/ext/Session/Session.js";
+import { track } from "../../core/track/track.js";
+
+// The sessionStorage key a `persist: true` controller reads/writes — see the class doc.
+const SESSION_KEY = "lew42-voice-session";
+
+function read_saved(){
+	try { return JSON.parse(sessionStorage.getItem(SESSION_KEY) || "null"); }
+	catch { return null; }
+}
+function write_saved(v){
+	try { v ? sessionStorage.setItem(SESSION_KEY, JSON.stringify(v)) : sessionStorage.removeItem(SESSION_KEY); }
+	catch {}
+}
+
+/**
+ * class ChatController — the one conversation, however many mounts show it. `chat.js`'s
+ * `chat(el, opts)` builds exactly two kinds: `GLOBAL` (`persist: true`, one per browser
+ * tab, shared by every `keep: true` mount — the ✦ sheet, the ☰ drawer, every card
+ * sidebar) and a fresh, page-local one (`persist: false`) for each `keep: false` mount
+ * (a demo's own "never remembered" session). A `persist: false` controller never touches
+ * `sessionStorage`, so it can never be read back by a later mount — "coming back starts
+ * fresh" (the owner's own words). Nothing about the SHAPE of a controller changes between
+ * the two; only whether it reads/writes the shared storage key.
+ *
+ * **Was a factory function returning a bag of closures** (`create_controller()`, inside
+ * `chat.js`) until this task (dictate-live-state, 2026-10-04) made it a real class, moved
+ * into its own file — folder = file = class name, same rule `Dictate.js`/`Capture.js`
+ * beside it already follow (CLAUDE.md: "a lowercase file never holds a class someone will
+ * look for"). Every method below is the same function `create_controller()` used to
+ * build, just reached through `this` instead of a closure. `track()`-ed so the Live tab
+ * (`live/page.js`) can list every one that exists right now, `GLOBAL` included.
+ *
+ * `ctl` stays one nested object (not flattened onto `this` directly) because `chat.js`'s
+ * own `chat()` function, and a couple of outside readers (`window`'s own `selection-change`
+ * listener), reach into `owner.ctl.session`/`.file`/`.selection` directly — flattening
+ * those would touch every one of those call sites for no behaviour change, so it stayed.
+ */
+export class ChatController {
+
+	constructor({ persist }){
+		this.persist = persist;
+		this.ctl = {
+			session: null,
+			file: null,
+			starting: null,   // a pending Session.start() promise — two mounts' first sentence at once share ONE session
+			nav_path: null,   // the path last actually reported to the session (report_nav's own dedupe)
+			nav_card: null,   // the card last actually reported alongside it (item 1, one-dictation)
+			selection: null,  // the reader's last picked element, `{kind, label, text, selector}` or null (item 6) — GLOBAL only, see chat.js
+		};
+		this.listeners = new Set();   // every live mount's own re-sync — see `subscribe()`/`broadcast()`
+		this.floor_watch = null;
+		this.sync_from_storage();
+		this.constructor.track?.(this);
+	}
+
+	sync_from_storage(){
+		if (!this.persist || this.ctl.session) return;
+		const saved = read_saved();
+		if (saved?.session && saved?.file){ this.ctl.session = saved.session; this.ctl.file = saved.file; }
+	}
+
+	// Called whenever THIS controller's session changes (a first start, a resume, a
+	// reset), so every open mount sharing it notices, not just the one that caused the
+	// change. A `keep: false` controller usually has only one mount listening (its own),
+	// but the shape costs nothing to share.
+	subscribe(fn){ this.listeners.add(fn); return () => this.listeners.delete(fn); }
+	broadcast(){ for (const fn of this.listeners) fn(); }
+
+	// The ONE real navigation report, whoever calls it — deduped against `ctl.nav_path` so
+	// the rail's own `navigated()` hook AND a fresh mount noticing a new path never both
+	// send the same move twice. `card` (item 1, one-dictation) is the card selected right
+	// now, or undefined for none — it travels with every nav report so a refinement
+	// written later can be attributed to the right card even after the owner has since
+	// moved on (`doc/sessions.md`'s "Refinement goes to the card selected at the time").
+	report_nav(path, card){
+		if (!this.ctl.session){ this.ctl.nav_path = path; this.ctl.nav_card = card; return; }
+		if (path === this.ctl.nav_path && card === this.ctl.nav_card) return;
+		const from = this.ctl.nav_path;
+		this.ctl.nav_path = path; this.ctl.nav_card = card;
+		Session.nav({ session: this.ctl.session, from, to: path, card }).catch(() => {});
+	}
+
+	// The first sentence, from any mount sharing THIS controller, starts (or silently
+	// resumes, inside `Session.start()` itself) the one session it will ever use until a
+	// reset. For a `keep: false` controller this really does call the server and really
+	// does start two real agents (`rail.js`'s own note on `start()`) — a page-local
+	// session is still a REAL session, just not a remembered one.
+	//
+	// A plain `ChatController` has no screen of its own to log onto — several mounts
+	// (several `Widget`s, each with its own `$diag` line) can share ONE controller, so
+	// "which mount's status line says this" is a question only `chat.js`'s own `deliver`
+	// closure can answer (it calls `stage("session", …)` right around this call —
+	// `doc/status-signals.md`'s "session" row, the console trail AND the on-screen line
+	// both, through `Dictate.js`'s own `log_step()`). This method stays plain data-layer
+	// code.
+	async ensure(target){
+		this.sync_from_storage();
+		if (this.ctl.session) return;
+		if (!this.ctl.starting){
+			this.ctl.starting = Session.start({ path: target.path, card: target.card }).then(made => {
+				this.ctl.session = made.session; this.ctl.file = made.file;
+				write_saved({ session: made.session, file: made.file });
+				this.broadcast();
+			}).finally(() => { this.ctl.starting = null; });
+		}
+		return this.ctl.starting;
+	}
+
+	// The mic held a sentence back while the owner kept talking (`entry.floor ===
+	// "speaking"`) — watch the mic's OWN floor state until it settles, then say so once, so
+	// the fast assistant's held reply lands. One watcher per controller, not one per mount.
+	watch_floor(){
+		clearInterval(this.floor_watch);
+		const session = this.ctl.session, started = Date.now();
+		this.floor_watch = setInterval(() => {
+			if (session !== this.ctl.session || Date.now() - started > 30000) return clearInterval(this.floor_watch);
+			if (floor.state() !== "done") return;
+			clearInterval(this.floor_watch);
+			Session.floor({ session, floor: "done" }).catch(() => {});
+		}, 250);
+	}
+
+	// Continue an OLDER session by id — the resume-offer's own "yes", and `tabs/sessions.js`'s
+	// click on a past voice session. Every open mount sharing this controller hears about it.
+	async resume_to(session){
+		const made = await Session.resume(session);
+		this.ctl.session = made.session; this.ctl.file = made.file;
+		write_saved({ session: made.session, file: made.file });
+		this.broadcast();
+	}
+
+	// "New session" — drops this controller's own session id; the NEXT sentence said, from
+	// whichever mount it comes from, starts a fresh one. For `keep: false` there is nothing
+	// saved to drop — this just clears the in-memory id, same effect.
+	reset(){
+		this.ctl.session = null; this.ctl.file = null; this.ctl.starting = null;
+		write_saved(null);
+		this.broadcast();
+	}
+
+	current(){ return this.ctl.session; }
+}
+
+ChatController.icon = "forum";
+ChatController.weights = { properties: "persist ctl" };   // order for the Live tab's inspect() — see Dictate.js's own note
+track(ChatController);
+
+export default ChatController;

+Floor.icon = "hearing";
+Floor.weights = { properties: "owner heard speaking_ms mic_on_at silent_at pauses" };   // order for the Live tab's inspect() — see Dictate.js's own note; real own fields only, "state()"/"quiet_ms()" are methods, not values to list here
+track(Floor);
+
+/** The one shared instance — same name, same import, as before this task made it a class. */
+export const floor = new Floor();
+
+export default floor;

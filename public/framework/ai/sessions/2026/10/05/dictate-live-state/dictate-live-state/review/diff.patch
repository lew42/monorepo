+		const ms = now - this.quiet_since;
+		if (ms >= this.min_pause_ms || (this.split && ms > 0)) this.pauses.push({ start: Math.round(this.quiet_since - this.on_at), end: Math.round(now - this.on_at), ms: Math.round(ms) });

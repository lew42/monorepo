--- a/Server/plugins/PageFiles.js
+++ b/Server/plugins/PageFiles.js
@@ -54,12 +54,21 @@ function inside_task_interior(segs) {
     return after.length > 2;   // deeper than day/task (after[0]=day, after[1]=task)
 }
 
+// ai/sessions/<uuid>/ and ai/sessions/YYYY/MM/DD/<uuid>/ are machine cache folders (thousands of them, one per Claude
+// session): never listed, so the server writes no files.jsonl into them and the git tree stays clean.
+function in_session_cache(segs) {
+    const i = segs.findIndex((s, k) => s === "sessions" && segs[k - 1] === "ai" && segs[k - 2] === "framework");
+    const first = i === -1 ? "" : segs[i + 1] ?? "";
+    return /^\d{4}$/.test(first) || /^[0-9a-f]{8}-[0-9a-f]{4}-/.test(first);
+}
+
 function covers(full) {
     const rel = path.relative(PUBLIC, full);
     if (rel.startsWith("..")) return false;   // outside public/ entirely
     const segs = rel ? rel.split(path.sep) : [];
     if (segs.some(s => s === "node_modules" || s.startsWith("."))) return false;
     if (inside_task_interior(segs)) return false;
+    if (in_session_cache(segs)) return false;
     return true;
 }
 
diff --git a/Server/session-place.mjs b/Server/session-place.mjs
new file mode 100644
index 000000000..b84903a76
--- /dev/null
+++ b/Server/session-place.mjs
@@ -0,0 +1,39 @@
+// Moves every flat session folder (ai/sessions/<id>/) into its day (ai/sessions/YYYY/MM/DD/<id>/), the day of its
+// first_at. A plain rename: nothing is regenerated or deleted except the stray files.jsonl folder listings, which are noise.
+// Safe to run again: a folder already in its day is left alone. Folders with no known first_at (empty sessions, test fixtures) stay where they are.
+//   node Server/session-place.mjs [--dry]
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import Session from "../public/framework/ai/sessions/Session.js";
+
+const DIR = process.env.SESSIONS_ROOT || path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "public", "framework", "ai", "sessions");
+const dry = process.argv.includes("--dry");
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+
+// first_at from the cache's newest summary, else the earliest `at` in the hand-written record.
+function first_at_of(dir){
+	let first = null;
+	try { for (const l of fs.readFileSync(path.join(dir, "cache.jsonl"), "utf8").split("\n")) if (l.startsWith('{"summary"')) { try { first = JSON.parse(l).summary.first_at ?? first; } catch {} } } catch {}
+	if (first) return first;
+	try { for (const l of fs.readFileSync(path.join(dir, "session.jsonl"), "utf8").split("\n")) if (l.trim()) { try { const at = JSON.parse(l).at; if (at && (!first || at < first)) first = at; } catch {} } } catch {}
+	return first;
+}
+
+let moved = 0, undated = 0, listings = 0;
+for (const id of fs.readdirSync(DIR)){
+	if (!UUID.test(id)) continue;
+	const dir = path.join(DIR, id);
+	if (!fs.statSync(dir).isDirectory()) continue;
+	const listing = path.join(dir, "files.jsonl");
+	if (fs.existsSync(listing)){ listings++; if (!dry) fs.rmSync(listing); }
+	const day = Session.day(first_at_of(dir));
+	if (!day){ undated++; continue; }
+	const to = path.join(DIR, ...day.split("/"), id);
+	if (dry){ moved++; continue; }
+	if (fs.existsSync(to)){ console.error("exists, left alone:", id); continue; }
+	fs.mkdirSync(path.dirname(to), { recursive: true });
+	fs.renameSync(dir, to);
+	moved++;
+}
+console.log(`${dry ? "would move" : "moved"} ${moved} session folders (${undated} left flat: no first_at), removed ${listings} files.jsonl listings`);
diff --git a/Server/session-place.test.mjs b/Server/session-place.test.mjs
new file mode 100644
index 000000000..cffc7a55e
--- /dev/null
+++ b/Server/session-place.test.mjs
@@ -0,0 +1,43 @@
+// The day layout: a flat session folder is moved into its first_at day by the first writer, and the record survives the move.
+//   node Server/session-place.test.mjs
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { execFileSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), "sess-place-"));
+process.env.SESSIONS_ROOT = root;
+const { default: Session } = await import("../public/framework/ai/sessions/Session.js");
+let fails = 0;
+const check = (ok, what) => { console.log((ok ? "PASS " : "FAIL ") + what); if (!ok) fails++; };
+
+const id = "11111111-2222-4333-8444-555555555555", id2 = "66666666-7777-4888-8999-aaaaaaaaaaaa";
+fs.mkdirSync(path.join(root, id));
+fs.writeFileSync(path.join(root, id, "cache.jsonl"), JSON.stringify({ summary: { first_at: "2026-10-03T23:30:00.000Z" } }) + "\n");
+fs.writeFileSync(path.join(root, id, "files.jsonl"), "{}\n");
+fs.mkdirSync(path.join(root, id2));                          // no first_at anywhere: stays flat
+execFileSync("node", [path.join(path.dirname(fileURLToPath(import.meta.url)), "session-place.mjs")], { env: process.env });
+const dated = path.join(root, "2026", "10", "03", id);
+check(fs.existsSync(path.join(dated, "cache.jsonl")), "the folder moved to its first_at day (UTC)");
+check(!fs.existsSync(path.join(root, id)), "the flat folder is gone");
+check(!fs.existsSync(path.join(dated, "files.jsonl")), "the stray files.jsonl listing was dropped");
+check(fs.existsSync(path.join(root, id2)), "a folder with no first_at stays flat");
+
+await Session.log(id, { tag: "x" }, "test");
+check(fs.readFileSync(path.join(dated, "session.jsonl"), "utf8").includes('"tag":"x"'), "the record is written into the dated folder");
+check(!fs.existsSync(path.join(root, id)), "the writer did not recreate a flat folder");
+check((await Session.read_text(id, "cache.jsonl")).includes("first_at"), "the reader finds the dated cache");
+
+const id3 = "99999999-aaaa-4bbb-8ccc-dddddddddddd";           // old flat folder, moved lazily by a writer
+fs.mkdirSync(path.join(root, id3));
+fs.writeFileSync(path.join(root, id3, "session.jsonl"), "{}\n");
+fs.writeFileSync(path.join(root, id3, "cache.jsonl"), JSON.stringify({ summary: { first_at: "2026-09-01T10:00:00.000Z" } }) + "\n");
+Session.days.clear();
+await Session.close(id3, "test");
+const lazy = path.join(root, "2026", "09", "01", id3);
+check(fs.existsSync(path.join(lazy, "session.jsonl")) && !fs.existsSync(path.join(root, id3)), "a flat folder is moved by the first writer that touches it");
+
+fs.rmSync(root, { recursive: true, force: true });
+console.log(fails ? `${fails} failed` : "all passed");
+process.exit(fails ? 1 : 0);

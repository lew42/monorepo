+import { Page, p, a, div } from "/app.js";
+import { page_work } from "/framework/core/Page/ai/work.js";
+
+/* The test library: five small tasks, each with a known good outcome, run on
+ * both Claude and OpenRouter models to find which model is good enough —
+ * and cheapest — for each kind of work. The tests themselves live in
+ * Servex/ext/openrouter/evals/library/ (one folder per test: test.json +
+ * fixture/); `library.mjs` runs them and appends one result line per run to
+ * Servex/ext/openrouter/evals/results.jsonl.
+ *
+ * THIS FILE, NOT AN AITask: every run under runs/<name>/ needs its own real
+ * url a spawned model can navigate to and "study" or "fix" (a broken page,
+ * a quick fix, a new page) — so this page is a plain hand-written Page, with
+ * no custom `route()`. That means `runs/` and anything under it resolve the
+ * ordinary way every undeclared name on this site does: Page.child()'s own
+ * filesystem probe, which dynamically imports `<url><name>/page.js` the
+ * moment that file exists on disk. `library.mjs` copies a test's fixture/
+ * into a fresh folder there, and the folder is a real page the instant it
+ * has a page.js — nothing here has to be told a run happened. */
+export default new Page({
+	meta: import.meta,
+	title: "Test library",
+	description: "Five small tasks with known good outcomes, run across models to see which is cheapest and good enough.",
+	icon: "science",
+
+	content(){
+		p("The five tests: ",
+			a("broken-overflow").href("/framework/ai/2026-09-30/openrouter-harness/test-library/#broken-overflow"), ", ",
+			a("broken-import").href("/framework/ai/2026-09-30/openrouter-harness/test-library/#broken-import"), ", ",
+			a("new-page-glossary").href("/framework/ai/2026-09-30/openrouter-harness/test-library/#new-page-glossary"), ", ",
+			a("fix-label").href("/framework/ai/2026-09-30/openrouter-harness/test-library/#fix-label"), " and ",
+			a("plan-counter").href("/framework/ai/2026-09-30/openrouter-harness/test-library/#plan-counter"),
+			" — each a folder under ",
+			a("Servex/ext/openrouter/evals/library/").href("https://github.com/search"), " with a ", a("test.json").href("#"), " and a ", a("fixture/").href("#"), ".");
+		p("Run it: ", a("node Servex/ext/openrouter/evals/library.mjs --models a,b [--effort low] [--only id] [--judge]").href("#"), ". Results land one line per run in ", a("Servex/ext/openrouter/evals/results.jsonl").href("#"), ".");

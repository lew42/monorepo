diff --git a/public/framework/core/System/System.js b/public/framework/core/System/System.js
new file mode 100644
index 00000000..f2ff4ef0
--- /dev/null
+++ b/public/framework/core/System/System.js
@@ -0,0 +1,246 @@
+import { div, ul, li, strong, span, small, a } from "../View/View.js";
+import { Doc } from "../../ext/Doc/Doc.js";
+import { Page } from "../Page/Page.class.js";
+import md from "../../ext/markdown/md.js";
+
+/**
+ * System — a page that is a whole system of rules: Design, Code, UI, UX, AI.
+ *
+ *   export default new System({
+ *       meta: import.meta,
+ *       title: "Design", icon: "palette",
+ *       children: "layout color navigation content ui",
+ *       concepts: [{ name: "Layout", slug: "layout", icon: "view_quilt" }, …],
+ *       omit: "parts",          // the parts are tiles on the Overview, not tabs
+ *       content(){ md("…"); },  // the intro, between the tiles and the readme
+ *   });
+ *
+ * or, with no page.js at all, line 1 of a page.jsonl:
+ *
+ *   {"class": "/framework/core/System/System.js", "title": "Demo", "concepts": […]}
+ *
+ * It IS a Doc (ext/Doc), so it has Doc's routed top tabs; what it adds:
+ *   - the Overview is: the `concepts` as tiles, then `content()`, then the readme;
+ *   - an Inbox tab, on every System (`inbox: false` turns it off) — the page's
+ *     `{"ext": "Inbox"}` extension, switched on here, so messaging a system is easy;
+ *   - `omit:` — one word to drop a tab that does not apply ("api", "overview", or
+ *     "parts" for every declared child). Its url still answers when it is a child.
+ *
+ * An upgrade made here reaches every system at once — that is the point of the class.
+ * Docs: core/System/readme.md, doc/system.md.
+ */
+export class System extends Doc {
+
+	// ⚠ Runs inside the Page constructor (Doc's note: no class fields, ever).
+	// `leaf`: the tabs ARE my navigation, so the site's sidebar shows me as one link
+	// rather than spilling Overview · Inbox · Docs into it as if they were pages.
+	//
+	// ⚠ A REAL COLLISION, found cold (not guessed) landing this class: Doc's own
+	//   `notes:` config word (a space-separated list of doc names — "job", "system
+	//   decisions", …) and the Inbox extension's `page.notes` (an ARRAY it collects
+	//   `{"note": …}` lines into, added 2026-10-02, after this class was written)
+	//   share one property name. `ext("Inbox")` is async (Page.ext()'s dynamic
+	//   import), so it clobbers `this.notes` into `[]` sometime after this method
+	//   returns — too late for docs_section() (which already read the right string,
+	//   synchronously, below) but in time to break every LATER read, such as
+	//   bar()'s own `Doc.names(this.notes)` at render. Captured once, here, before
+	//   Inbox ever runs, and bar() (below) reads this copy instead of the live
+	//   (clobberable) `this.notes`. The two-`notes`-names problem belongs to
+	//   Doc/Inbox, not this class — logged as a `need` line, not fixed there.
+	initialize(){
+		this.leaf ??= true;
+		this._doc_notes = this.notes;
+
+		// ⚠ ANOTHER REAL GAP, found cold landing this: `Page.log_pages` (Page.class.js)
+		//   is only ever filled by the page.jsonl build path — a page.js page (every
+		//   System except the demo) is never in it. The Inbox extension's own
+		//   `own_notes()` (Inbox.js) reads this registry FIRST, before fetching
+		//   `<url>page.jsonl` as a fallback — a fallback that always 404s for a page.js
+		//   page, since there is no such file. Registering myself here (same Map, same
+		//   key the jsonl path already uses, `log_folder()`) makes that lookup hit
+		//   instead of fetching — zero 404s, and `live.notes` then reads the exact
+		//   array Inbox collects into. The broader fix (every page registering itself,
+		//   not just System) belongs to core/Page, not this class — logged as a `need`.
+		(Page.log_pages ??= new Map()).set(this.log_folder(), this);
+
+		if (this.inbox !== false) this.ext("Inbox");
+		this.sections();
+	}
+
+	// An extension runs once, however many times it is asked for: I switch Inbox on
+	// myself, and a page.jsonl may ALSO carry `{"ext": "Inbox"}` — a second setup()
+	// would empty `page.inbox` and collect every later line twice.
+	ext(name){
+		if ((this.exts ??= new Set()).has(name)) return;
+		this.exts.add(name);
+		return super.ext(name);
+	}
+
+	sections(){
+		this.overview_section();
+		this.inbox_section();
+		if (!this.omitted("api")) this.api_section();
+		if (!this.omitted("doc")) this.docs_section();
+		if (!this.omitted("files")) this.files_section();
+		return this;
+	}
+
+	// ════ THE DOCS TAB — Doc's own, but reading the captured string ═══════════
+	// ⚠ Same collision as bar() above: Doc.js's docs_section() closes over `this.notes`
+	//   inside its render() callback, which runs LATE (whenever the reader actually
+	//   clicks into /doc/) — by then Inbox has long since clobbered it. Copied here
+	//   reading `this._doc_notes` instead, flat-list only (none of the five systems
+	//   nest a note name with "/", so note_tree() — Doc.js-private, unexported — never
+	//   needs to be reached). Doc/Inbox still own the real fix; see the `need` above.
+	docs_section(){
+		const has_notes = Doc.names(this._doc_notes).length > 0;
+		const has_members = [...(this.member_index?.values() ?? [])].some(names => names.size);
+		if (!has_notes && !has_members) return;
+
+		const doc = this;
+		return this.section("doc", "Docs", {
+			initialize(){ if (has_notes) doc.docs(this); },
+			render(){
+				const names = Doc.names(doc._doc_notes);
+				return this.view ??= div.c("page doc-section", () => {
+					if (!names.length) return;
+					this.tabs(names.join(" ")).ac("vertical");
+				})
+					.ac("page--" + this.name);
+			},
+			route(name){ return (name === "method" || name === "property") && doc.member_group(name); },
+		});
+	}
+
+	// ════ OMIT — the one config word that drops a tab ═════════════════════════
+	// A derived tab (overview, inbox, api, doc, files) named here is never built.
+	// A declared child named here — or every one, with "parts" — stays a real page
+	// at its own url; it is only left off the strip.
+	omitted(name){
+		const words = Doc.names(this.omit);
+		return words.includes(name)
+			|| words.includes("parts") && this.children.has(name) && !System.SECTIONS.includes(name);
+	}
+
+	// My declared children, without the tabs I derived — what the Overview's wall shows.
+	parts(){
+		return new Map([...this.children].filter(([name]) => !System.SECTIONS.includes(name)));
+	}
+
+	wall(){ return this.previews(this.parts()); }
+
+	// ════ THE OVERVIEW — tiles, the intro, the readme ═════════════════════════
+	// Doc binds `this.content` into its Overview section at construction; handing it
+	// overview_content() instead, for that one call, puts the tiles above and the readme below
+	// whatever the page wrote. `content` itself is untouched afterwards — overview_content()
+	// reads it LATE, so a page.jsonl page (whose `content` is only set after the
+	// constructor, Log.js jsonl()) still gets its own.
+	overview_section(){
+		if (this.omitted("overview")) return;
+
+		const own = this.content;
+		this.content = System.prototype.overview_content;
+		try { return super.overview_section(); }
+		finally { this.content = own; }
+	}
+
+	overview_content(){
+		if (this.concepts?.length) this.concept_tiles();
+		const out = typeof this.content === "function" ? this.content() : this.content && md(this.content);
+		this.readme();
+		return out;
+	}
+
+	// The Concepts tiles (ux/Content/Concepts). Imported on demand, so the ~every page
+	// that loads /app.js does not pay for a module only five pages draw. The box is
+	// captured NOW and filled after the import (no DOM after an await).
+	concept_tiles(){
+		const $box = div.c("pad system-concepts");
+		import("../../ux/Content/Concepts/Concepts.js")
+			.then(({ default: Concepts }) => $box.append(() => new Concepts({ items: this.concepts, page: this })));
+		return $box;
+	}
+
+	// The module's readme.md, folded, at the end of the Overview — the same readme
+	// chain every agent reads, shown to the reader where they already are.
+	// ⚠ A page.jsonl System has no `meta`, so its folder stands in for one.
+	readme(){
+		if (this.readme_file === false) return;
+		return md.details(this.meta ?? { url: new URL(this.url, location.origin).href }, this.readme_file ?? "readme.md", "Readme");
+	}
+
+	// ════ THE INBOX TAB ═══════════════════════════════════════════════════════
+	inbox_section(){
+		if (this.inbox === false || this.omitted("inbox")) return;
+
+		const system = this;
+		return this.section("inbox", "Inbox", {
+			render(){
+				return this.view ??= div.c("page doc-section", () => system.inbox_content(this))
+					.ac("page--" + this.name);
+			},
+		});
+	}
+
+	// What the Inbox tab shows. ONE seam: the InboxRail (task-mastermind-inbox-ext)
+	// replaces this method's body, and every System gets it.
+	//   1. the page's own `{"inbox": …}` lines, collected by the Inbox extension;
+	//   2. "Leave a note": the Servex-backed notes on this path, the drawer's own box;
+	//   3. the way to the full inbox, AI 2.
+	inbox_content(){
+		md(`**Messages to ${this.title}.** A note left here reaches the agent that owns this system.`);
+
+		const $lines = div.c("system-inbox flex v gap-50");
+		Promise.all(this.ext_ready ?? []).then(() => $lines.append(() => {
+			const list = [...this.inbox ?? []].reverse();
+			if (!list.length) return small.c("muted", "No messages in this page's log yet.");
+			ul.c("system-inbox-list", () => list.forEach(m => li(() => {
+				strong(m.author ?? "someone");
+				small.c("muted", ` ${m.type ?? "message"}${m.at ? " · " + m.at.slice(0, 16).replace("T", " ") : ""} `);
+				span(m.text ?? "");
+			})));
+		}));
+
+		const $notes = div.c("system-inbox-notes flex v gap-50");
+		import("../Page/ext/Inbox/Inbox.js").then(({ DrawerInbox }) => $notes.append(() => {
+			const inbox = new DrawerInbox({ page: this.url });
+			inbox.button();
+			inbox.view();
+		}));
+
+		div(() => a("Open the full inbox, on AI 2").href("/framework/ai2/"));
+	}
+
+	// The strip: Overview, Inbox, my parts, then Doc's reference tabs — minus `omit`.
+	// Written out rather than built on Doc.bar(): that one asks tab_visible() of EVERY
+	// child, and /framework/ai/ has forty dated children that are never tabs.
+	bar(){
+		const parts = [...this.parts().keys()]
+			.filter(name => !this.omitted(name) && this.tab_visible(name))
+			.sort((a, b) => this.tab_order(a) - this.tab_order(b));
+
+		return ["overview", "inbox", ...parts, "api", "doc", "files"]
+			.filter(name => name === "doc" ? this.children.has("doc") && Doc.names(this._doc_notes).length > 0 : this.children.has(name))
+			.filter(name => !this.omitted(name));
+	}
+
+	// A part left off the strip still needs a region. tabs() registers one only for
+	// the names it draws, so without this container() walks up to the site's own
+	// `$pages` and draws the part OVER the sidebar (ext/Doc's own warning; ui/ hit it).
+	// It mounts in the Overview's panel, under my title. With no Overview (AI), a part
+	// mounts where it always did.
+	render(){
+		const $view = super.render();
+		const $panel = this.regions?.get("overview");
+
+		if ($panel) for (const name of this.parts().keys())
+			if (!this.regions.has(name)) this.regions.set(name, $panel);
+
+		return $view;
+	}
+}
+
+// The tabs a System derives, as opposed to the parts a page declared.
+System.SECTIONS = [...Doc.SECTIONS, "inbox"];
+
+export default System;

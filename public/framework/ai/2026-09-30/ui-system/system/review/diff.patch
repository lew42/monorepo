+import { Doc, md, code } from "/app.js";
+import { Concepts } from "../../ux/Content/Concepts/Concepts.js";
+import { System } from "./System.js";
+
+// Show, don't tell: the five systems the class already builds, as the same tile row
+// System.js's own concept_tiles() draws — this page eats its own dog food rather than
+// describing the tiles in prose.
+const SYSTEMS = [
+	{ name: "Design", slug: "design", icon: "palette", href: "/framework/design/" },
+	{ name: "Code", slug: "code", icon: "code", href: "/framework/code/" },
+	{ name: "UI", slug: "ui", icon: "widgets", href: "/framework/ui/" },
+	{ name: "UX", slug: "ux", icon: "layers", href: "/framework/ux/" },
+	{ name: "AI", slug: "ai", icon: "smart_toy", href: "/framework/ai/" },
+];
+
+// A Doc (NOT a System) — this page documents the System *class*, the exact shape
+// ext/Doc/page.js documents Doc and core/Page/page.js documents Page.
+export default new Doc({
+	meta: import.meta,
+	title: "System",
+	description: "The shared top-tab template behind Design, Code, UI, UX and (soon) AI — one class, five pages.",
+	icon: "hub",
+
+	// The tabs below (Overview · Demo · API · Docs) ARE my navigation — without this,
+	// the site sidebar would spill them into it as if they were pages of their own
+	// (every other doc page, e.g. ext/Doc/page.js, sets it for the same reason).
+	leaf: true,
+	subject: System,
+	methods: "omitted parts wall overview_content concept_tiles readme inbox_section inbox_content bar render",
+	notes: "system",
+	files: "System.js readme.md",
+	children: "demo/page.jsonl",
+
+	content(){
+
+		md("**A System is a page that is a whole system of rules.** Click any of the five below to see one running — they all share the same tabs, the same tiles, the same Inbox, because they are all built from this one class.");
+
+		new Concepts({ items: SYSTEMS });
+
+		md("**AI is not a System yet.** Its `page.js` is still a plain `Page`; converting it is the next step, not part of this page.");
+
+		md("A page becomes a System one of two ways — construct it in a `page.js`, or name the class on line 1 of a `page.jsonl` with no `page.js` at all:");
+
+		code.js(`export default new System({
+    meta: import.meta,
+    title: "Design", icon: "palette",
+    children: "layout color navigation content ui",
+    concepts: [{ name: "Layout", slug: "layout", icon: "view_quilt" }, …],
+    omit: "parts",          // the parts are tiles on the Overview, not tabs
+    content(){ md("…"); },  // the intro, between the tiles and the readme
+});`);
+
+		md("The same class, with no `page.js` at all — line 1 of a bare `page.jsonl` names it instead: [see it live](./demo/) (that whole page is [one line](./demo/page.jsonl)).");
+
+		md("`System extends Doc` (`core/System/System.js`), so it inherits every top tab Doc already builds — API, Docs, Files — and adds three things of its own: the **concept tiles** above (the same [Concepts](/framework/ux/Content/Concepts/) component this page just used on itself), an **Inbox** tab so any agent can leave a note on the system, and `omit:` — the one config word that drops a derived tab (`\"api\"`, `\"overview\"`) or every declared child at once (`\"parts\"`) without hiding its url.");
+

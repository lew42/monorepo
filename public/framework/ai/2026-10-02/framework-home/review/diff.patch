+				div.c("page-previews bleed", () => {
+					if (page.leaf) return void page.preview_card(nav);   // itself: one card
+
+					page.children.forEach((child, child_name) => {
+						const child_nav = page.nav_for(child_name);
+						(child ?? page).preview_card(child_nav);
+					});
+				});
+			}).style("--gap", "1em"));
+		});
+
+		return rungs;
+	} finally {
+		View.captor = saved;
+	}
+}
 
